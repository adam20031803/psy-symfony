APP_ENV=dev
APP_SECRET=a3f8c2e1b4d5f6a7b8c9d0e1f2a3b4c5
DATABASE_URL="mysql://root:@127.0.0.1:3306/psy_db?serverVersion=8.0&charset=utf8mb4"

# Email : null://null = aucun envoi réel. Pour Gmail, créez .env.local avec (le @ de l’email doit être %40 dans le DSN) :
#   MAILER_DSN="smtp://vous%40gmail.com:MOT_DE_PASSE_APPLICATION@smtp.gmail.com:587"
#   MAILER_FROM="PsyApp <vous@gmail.com>"
# Mot de passe = mot de passe d’application Google (16 caractères, sans espaces).
MAILER_DSN=null://null
# URL utilisée pour générer le lien dans l’email (adapter port si besoin)
DEFAULT_URI=http://127.0.0.1:8000
# Expéditeur affiché dans l’email (souvent la même adresse que le compte SMTP)
MAILER_FROM="PsyApp <noreply@example.com>"
# Vide = mail envoyé à l’email du compte utilisateur. Sinon = tout part uniquement vers cette boîte.
MAILER_FORCE_TO=adam.banaoues@esprit.tn

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# null://null = dev mode (email visible dans le Symfony Profiler)
# smtp://login%40gmail.com:APP_PASS@smtp.gmail.com:587 = Gmail réel
MAILER_DSN=null://null
###< symfony/mailer ###
