# Copiez ce fichier en .env.local et remplissez vos vraies valeurs.
# Ce fichier ne doit PAS être commité (il est dans .gitignore).

# === SMTP Gmail ===
# Prérequis: activez "Mots de passe d'application" dans votre compte Google.
# Le @ de l'adresse email doit être encodé en %40 dans le DSN.
# Exemple pour un compte Gmail adam.banaoues@esprit.tn :
MAILER_DSN=smtp://adam.banaoues%40esprit.tn:VOTRE_MOT_DE_PASSE_APP@smtp.gmail.com:587

# === Expéditeur par défaut ===
MAILER_FROM="Challenge Manager Pro <adam.banaoues@esprit.tn>"
