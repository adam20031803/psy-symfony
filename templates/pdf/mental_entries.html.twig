<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Mental Entries — Atomic You</title>
    <style>
        @page { margin: 18mm 14mm; }
        body { font-family: DejaVu Sans, sans-serif; font-size: 10pt; color: #111; }
        h1 { font-size: 16pt; margin: 0 0 4px; }
        .muted { color: #555; font-size: 9pt; margin-bottom: 14px; }
        table.entries { width: 100%; border-collapse: collapse; margin-top: 8px; }
        table.entries th, table.entries td { border: 1px solid #ccc; padding: 5px 6px; text-align: left; vertical-align: top; }
        table.entries th { background: #eee; font-size: 8.5pt; }
        .section { margin-top: 18px; }
        .section h2 { font-size: 11pt; margin: 0 0 6px; }
        .kv { margin: 2px 0; font-size: 9.5pt; }
    </style>
</head>
<body>
    <h1>Atomic You — Liste des entries</h1>
    <p class="muted">Généré le {{ generated_at|date('d/m/Y à H:i') }}</p>

    <table class="entries">
        <thead>
        <tr>
            <th>Mood</th>
            <th>Date</th>
            <th>Niveau</th>
            <th>Activité</th>
            <th>Note</th>
        </tr>
        </thead>
        <tbody>
        {% for e in entries %}
            <tr>
                <td>{{ e.mood.moodName }}</td>
                <td>{{ e.entryDate|date('d/m/Y') }}</td>
                <td>{{ e.emotionLevel }}</td>
                <td>{{ e.activity }}</td>
                <td>{{ e.note|default('—') }}</td>
            </tr>
        {% else %}
            <tr><td colspan="5">Aucune entry.</td></tr>
        {% endfor %}
        </tbody>
    </table>

    {% if highlight_entry %}
        <div class="section">
            <h2>Entry mise en avant (édition)</h2>
            <p class="kv"><strong>ID</strong> : {{ highlight_entry.id }}</p>
            <p class="kv"><strong>Mood</strong> : {{ highlight_entry.mood.moodName }}</p>
            <p class="kv"><strong>Date</strong> : {{ highlight_entry.entryDate|date('d/m/Y') }}</p>
            <p class="kv"><strong>Niveau</strong> : {{ highlight_entry.emotionLevel }} / 10</p>
            <p class="kv"><strong>Activité</strong> : {{ highlight_entry.activity }}</p>
            <p class="kv"><strong>Note</strong> : {{ highlight_entry.note|default('—') }}</p>
        </div>
    {% endif %}
</body>
</html>
