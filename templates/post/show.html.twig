{% extends 'base.html.twig' %}

{% block title %}{{ post.titre }} — Atomic You{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Post Styles */
        .post-header { margin-bottom: 30px; }
        .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); text-decoration: none; font-size: 0.85rem; font-weight: 500; margin-bottom: 20px; transition: color .2s; }
        .back-link:hover { color: var(--accent2); }

        .post-title { font-size: 2.2rem; font-weight: 800; line-height: 1.25; margin-bottom: 16px; letter-spacing: -0.02em; }
        .post-meta-top { display: flex; align-items: center; gap: 16px; color: var(--muted); font-size: 0.9rem; }
        .post-badge { background: rgba(108,99,255,0.12); color: var(--accent); padding: 4px 12px; border-radius: 999px; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
        .post-author-top { display: flex; align-items: center; gap: 8px; }
        .post-author-top .avatar { width: 24px; height: 24px; background: var(--surface); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; border: 1px solid var(--border); }

        .post-image-container { width: 100%; border-radius: 20px; overflow: hidden; margin-bottom: 32px; border: 1px solid var(--border); box-shadow: 0 20px 40px rgba(0,0,0,0.25); }
        .post-image-container img { width: 100%; height: auto; display: block; object-fit: cover; max-height: 500px; }

        .post-content { font-size: 1.1rem; line-height: 1.8; color: rgba(226,232,240,0.9); margin-bottom: 40px; }

        /* Actions Bar */
        .post-actions-bar {
            display: flex; align-items: center; justify-content: space-between;
            background: var(--card); border: 1px solid var(--border); border-radius: 16px;
            padding: 12px 24px; margin-bottom: 48px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }
        .reactions { display: flex; align-items: center; gap: 8px; }
        .btn-reaction {
            display: flex; align-items: center; gap: 8px;
            background: transparent; border: 1px solid transparent;
            color: var(--muted); font-family: 'Inter', sans-serif;
            font-size: 0.9rem; font-weight: 600; padding: 8px 16px;
            border-radius: 10px; cursor: pointer; transition: all .2s;
        }
        .btn-reaction:hover { background: rgba(255,255,255,0.04); color: var(--text); }
        .btn-reaction .count { font-weight: 700; color: var(--text); }

        .btn-like.active-like { background: rgba(34,211,165,0.1); color: var(--success); border-color: rgba(34,211,165,0.2); }
        .btn-dislike.active-dislike { background: rgba(239,68,68,0.1); color: #ef4444; border-color: rgba(239,68,68,0.2); }
        .btn-repost.shared { background: rgba(0,210,255,0.1); color: var(--accent2); border-color: rgba(0,210,255,0.2); }

        .post-actions { display: flex; gap: 10px; }
        .btn-edit-post { text-decoration: none; background: rgba(245,158,11,0.1); color: var(--warning); padding: 8px 16px; border-radius: 10px; font-size: 0.85rem; font-weight: 600; border: 1px solid rgba(245,158,11,0.2); transition: all .2s; }
        .btn-edit-post:hover { background: rgba(245,158,11,0.2); }
        .btn-delete-post { background: rgba(239,68,68,0.1); color: #ef4444; border: 1px solid rgba(239,68,68,0.2); padding: 8px 16px; border-radius: 10px; font-size: 0.85rem; font-weight: 600; cursor: pointer; font-family: 'Inter', sans-serif; transition: all .2s; }
        .btn-delete-post:hover { background: rgba(239,68,68,0.2); }

        /* Comments Section */
        .comments-section { border-top: 1px solid var(--border); padding-top: 40px; }
        .comments-section h2 { font-size: 1.4rem; font-weight: 700; margin-bottom: 24px; display: flex; align-items: center; gap: 10px; }
        .comments-section h2 .badge { background: var(--accent); color: #fff; font-size: 0.75rem; padding: 2px 8px; border-radius: 6px; }

        .comment-form-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px; margin-bottom: 40px; }
        .comment-form-card textarea { width: 100%; background: var(--bg); border: 1px solid var(--border); color: var(--text); border-radius: 12px; padding: 14px; font-family: 'Inter', sans-serif; font-size: 0.95rem; resize: vertical; min-height: 100px; margin-bottom: 16px; outline: none; transition: border-color .2s; }
        .comment-form-card textarea:focus { border-color: var(--accent); }
        .btn-comment { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; border: none; border-radius: 10px; padding: 10px 24px; font-size: 0.9rem; font-weight: 700; cursor: pointer; font-family: 'Inter', sans-serif; transition: opacity .2s; box-shadow: 0 4px 15px rgba(108,99,255,0.25); }
        .btn-comment:hover { opacity: 0.9; }

        .comment-item { padding: 20px 0; border-bottom: 1px solid var(--border); }
        .comment-item:last-child { border-bottom: none; }
        .comment-meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
        .comment-author { font-weight: 600; font-size: 0.9rem; color: var(--accent2); }
        .comment-date { font-size: 0.8rem; color: var(--muted); }
        .comment-body { font-size: 0.95rem; line-height: 1.6; color: rgba(226,232,240,0.8); }

        .no-comments { text-align: center; color: var(--muted); padding: 40px 0; font-style: italic; }
        .login-prompt { background: rgba(108,99,255,0.05); border: 1px dashed var(--accent); border-radius: 12px; padding: 20px; text-align: center; color: var(--muted); margin-bottom: 40px; font-size: 0.9rem; }
        .login-prompt a { color: var(--accent); text-decoration: none; font-weight: 500; }
        .login-prompt a:hover { color: var(--accent2); }

        /* ── Comment actions ── */
        .comment-actions { display: flex; gap: 6px; margin-top: 10px; flex-wrap: wrap; }
        .btn-comment-edit { display: inline-flex; align-items: center; gap: 4px; background: rgba(245,158,11,.1); color: var(--warning); border: 1px solid rgba(245,158,11,.2); font-size: 0.7rem; font-weight: 600; padding: 4px 10px; border-radius: 7px; cursor: pointer; font-family: 'Inter', sans-serif; transition: all .2s; }
        .btn-comment-edit:hover { background: rgba(245,158,11,.2); }
        .btn-comment-delete { display: inline-flex; align-items: center; gap: 4px; background: rgba(239,68,68,.08); color: #ef4444; border: 1px solid rgba(239,68,68,.2); font-size: 0.7rem; font-weight: 600; padding: 4px 10px; border-radius: 7px; cursor: pointer; font-family: 'Inter', sans-serif; transition: all .2s; }
        .btn-comment-delete:hover { background: rgba(239,68,68,.18); }

        /* Inline edit form */
        .comment-edit-form { display: none; margin-top: 10px; }
        .comment-edit-form.open { display: block; }
        .comment-edit-form textarea { width: 100%; background: var(--surface); border: 1px solid var(--accent); color: var(--text); border-radius: 9px; padding: 10px 12px; font-family: 'Inter', sans-serif; font-size: 0.83rem; resize: vertical; min-height: 70px; outline: none; }
        .comment-edit-actions { display: flex; gap: 8px; margin-top: 8px; }
        .btn-save-comment { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; border: none; border-radius: 8px; padding: 6px 14px; font-size: 0.76rem; font-weight: 600; cursor: pointer; font-family: 'Inter', sans-serif; transition: opacity .2s; }
        .btn-save-comment:hover { opacity: .85; }
        .btn-cancel-edit { background: var(--surface); color: var(--muted); border: 1px solid var(--border); border-radius: 8px; padding: 6px 12px; font-size: 0.76rem; font-weight: 600; cursor: pointer; font-family: 'Inter', sans-serif; transition: all .2s; }
        .btn-cancel-edit:hover { color: var(--text); }

        /* Toast feedback */
        .toast { position: fixed; bottom: 28px; right: 28px; z-index: 9999; background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 12px 20px; font-size: 0.82rem; font-weight: 500; color: var(--text); box-shadow: 0 8px 32px rgba(0,0,0,.4); transform: translateY(20px); opacity: 0; transition: all .3s cubic-bezier(.4, 0, .2, 1); pointer-events: none; }
        .toast.show { transform: translateY(0); opacity: 1; }
        .toast.toast-success { border-color: rgba(34,211,165,0.3); color: var(--success); }
        .toast.toast-error { border-color: rgba(239,68,68,0.3); color: #ef4444; }
        .toast.toast-info { border-color: rgba(0,210,255,0.3); color: var(--accent2); }
    </style>
{% endblock %}

{% block body %}
    <div class="w-medium">
        <a href="{{ path('post_index') }}" class="back-link">← Retour au forum</a>

        <article class="post-detail">
            <header class="post-header">
                <h1 class="post-title">{{ post.titre }}</h1>
                <div class="post-meta-top">
                    {% if post.categorie %}
                        <span class="post-badge">{{ post.categorie.nom }}</span>
                    {% endif %}
                    <div class="post-author-top">
                        <div class="avatar">👤</div>
                        <span>Par <strong>{% if post.isAnonymous %}Anonyme{% else %}{{ post.user.prenom }} {{ post.user.nom }}{% endif %}</strong></span>
                    </div>
                    <span>•</span>
                    <span>{{ post.createdAt|date('d F Y') }}</span>
                </div>
            </header>

            {% if post.image %}
            <div class="post-image-container">
                <img src="/uploads/posts/{{ post.image }}" alt="{{ post.titre }}">
            </div>
            {% endif %}

            <div class="post-content">
                {{ post.contenu|raw }}
            </div>

            <div class="post-actions-bar">
                <div class="reactions">
                    <button type="button" class="btn-reaction btn-like {{ userVote == 'like' ? 'active-like' }}" id="btn-like" onclick="vote('like')">
                        👍 <span class="count" id="likes-count">{{ post.countLikes }}</span>
                    </button>
                    <button type="button" class="btn-reaction btn-dislike {{ userVote == 'dislike' ? 'active-dislike' }}" id="btn-dislike" onclick="vote('dislike')">
                        👎 <span class="count" id="dislikes-count">{{ post.countDislikes }}</span>
                    </button>
                    <button type="button" class="btn-reaction btn-repost {{ hasShared ? 'shared' }}" id="btn-repost" onclick="{{ hasShared ? '' : 'repost()' }}">
                        🔁 <span id="repost-label">{{ hasShared ? 'Reposté' : 'Repost' }}</span> <span class="count" id="shares-count">{{ post.countShares }}</span>
                    </button>
                    <button type="button" class="btn-reaction" id="btn-translate-view" onclick="translatePost()">
                        <span class="spinner" id="translate-spinner" style="display:none; width:12px; height:12px; border:2px solid rgba(255,255,255,0.3); border-radius:50%; border-top-color:#fff; animation:spin 0.8s linear infinite; margin-right:5px;"></span>
                        🌐 Traduire en FR
                    </button>
                </div>

                {# ── Boutons Modifier / Supprimer (auteur uniquement) #}
                {% if app.user and app.user == post.user %}
                <div class="post-actions">
                    <a href="{{ path('post_edit', {id: post.id}) }}" class="btn-edit-post">✏️ Modifier</a>
                    <form method="post" action="{{ path('post_delete', {id: post.id}) }}"
                          onsubmit="return confirm('Supprimer définitivement ce post ?')" style="display:contents">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete'~post.id) }}">
                        <button type="submit" class="btn-delete-post">🗑️ Supprimer</button>
                    </form>
                </div>
                {% endif %}
            </div>
        </article>

        <section class="comments-section">
            <h2>💬 Commentaires <span class="badge">{{ post.commentaires|length }}</span></h2>

            {% if app.user %}
                <div class="comment-form-card">
                    <form action="{{ path('post_add_comment', {id: post.id}) }}" method="post">
                        <textarea name="commentaire[contenu]" placeholder="Exprimez-vous avec bienveillance..." required></textarea>
                        <div style="text-align: right;">
                            <button type="submit" class="btn-comment">Publier mon commentaire</button>
                        </div>
                    </form>
                </div>
            {% else %}
                <div class="login-prompt">
                    Vous devez être <a href="{{ path('app_login') }}">connecté</a> pour participer à la discussion.
                </div>
            {% endif %}

            {% if post.commentaires is empty %}
                <div class="no-comments">Aucun commentaire pour l'instant. Soyez le premier !</div>
            {% else %}
                <div class="comment-list">
                    {% for commentaire in post.commentaires %}
                    <div class="comment-item" id="comment-{{ commentaire.id }}">
                        <div class="comment-meta">
                            <span class="comment-author">👤 {{ commentaire.user.prenom }} {{ commentaire.user.nom }}</span>
                            <span class="comment-date">{{ commentaire.createdAt|date('d/m/Y à H:i') }}</span>
                        </div>
                        <div class="comment-body" id="comment-body-{{ commentaire.id }}">{{ commentaire.contenu }}</div>

                        {# ── Actions auteur ── #}
                        {% if app.user and app.user == commentaire.user %}
                        <div class="comment-actions">
                            <button type="button" class="btn-comment-edit" onclick="toggleEdit({{ commentaire.id }})">✏️ Modifier</button>
                            <form method="post" action="{{ path('post_delete_comment', {postId: post.id, id: commentaire.id}) }}" style="display:contents" onsubmit="return confirm('Supprimer ce commentaire ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ commentaire.id) }}">
                                <button type="submit" class="btn-comment-delete">🗑️ Supprimer</button>
                            </form>
                        </div>

                        {# Formulaire d'édition inline #}
                        <div class="comment-edit-form" id="edit-form-{{ commentaire.id }}">
                            <form method="post" action="{{ path('post_edit_comment', {postId: post.id, id: commentaire.id}) }}">
                                <textarea name="contenu" rows="3">{{ commentaire.contenu }}</textarea>
                                <div class="comment-edit-actions">
                                    <button type="submit" class="btn-save-comment">💾 Enregistrer</button>
                                    <button type="button" class="btn-cancel-edit" onclick="toggleEdit({{ commentaire.id }})">Annuler</button>
                                </div>
                            </form>
                        </div>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>

    {# ── Toast de feedback ── #}
    <div class="toast" id="toast"></div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if app.user %}
    <script>
        const LIKE_URL   = '{{ path('post_like',   {id: post.id}) }}';
        const REPOST_URL = '{{ path('post_repost', {id: post.id}) }}';
        const TRANS_URL  = '{{ path('api_post_translate') }}';
        let currentVote  = '{{ userVote ?? '' }}';
        let isShared     = {{ hasShared ? 'true' : 'false' }};

        /* ── Toast helper ── */
        function showToast(msg, type = 'success') {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.className = `toast toast-${type}`;
            void t.offsetWidth;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 2800);
        }

        /* ── Traduction ── */
        async function translatePost() {
            const titre   = document.querySelector('.post-title').textContent.trim();
            const contenu = document.querySelector('.post-content').innerHTML.trim();
            const btn     = document.getElementById('btn-translate-view');
            const spinner = document.getElementById('translate-spinner');

            btn.style.opacity = '0.7';
            btn.style.pointerEvents = 'none';
            spinner.style.display = 'inline-block';

            try {
                const res = await fetch(TRANS_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ titre, contenu })
                });
                const data = await res.json();

                if (data.error) {
                    showToast('❌ ' + data.error, 'error');
                } else {
                    document.querySelector('.post-title').textContent = data.titre;
                    document.querySelector('.post-content').innerHTML = data.contenu;
                    showToast('🌐 Traduit en Français !');
                    btn.style.display = 'none'; // Cacher le bouton après traduction
                }
            } catch (e) {
                showToast('❌ Erreur réseau.', 'error');
            } finally {
                btn.style.opacity = '1';
                btn.style.pointerEvents = 'auto';
                spinner.style.display = 'none';
            }
        }

        /* ── Like / Dislike ── */
        async function vote(type) {
            const body = new URLSearchParams({ type });
            try {
                const res  = await fetch(LIKE_URL, { method: 'POST', body, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const data = await res.json();

                document.getElementById('likes-count').textContent    = data.likes;
                document.getElementById('dislikes-count').textContent = data.dislikes;

                const btnLike    = document.getElementById('btn-like');
                const btnDislike = document.getElementById('btn-dislike');
                btnLike.classList.remove('active-like');
                btnDislike.classList.remove('active-dislike');

                currentVote = data.userVote;
                if (data.userVote === 'like')    { btnLike.classList.add('active-like'); showToast('👍 Like enregistré !'); }
                else if (data.userVote === 'dislike') { btnDislike.classList.add('active-dislike'); showToast('👎 Dislike enregistré !'); }
                else { showToast('Vote annulé.', 'info'); }
            } catch (e) { showToast('Erreur réseau.', 'info'); }
        }

        /* ── Repost ── */
        async function repost() {
            if (isShared) return;
            try {
                const res  = await fetch(REPOST_URL, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const data = await res.json();

                document.getElementById('shares-count').textContent = data.shares;
                document.getElementById('repost-label').textContent = 'Reposté';
                const btn = document.getElementById('btn-repost');
                btn.classList.add('shared');
                btn.setAttribute('onclick', '');
                isShared = true;
                showToast('🔁 ' + data.message);
            } catch (e) { showToast('Erreur réseau.', 'info'); }
        }

        /* ── Toggle inline comment edit form ── */
        function toggleEdit(commentId) {
            const form = document.getElementById('edit-form-' + commentId);
            if (form) form.classList.toggle('open');
        }
    </script>
    {% endif %}
{% endblock %}
