{# templates/post/show.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ post.titre }} — PsyApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg: #0a0c1a; --surface: #111328; --card: #181b30; --sidebar: #0e1025;
            --border: rgba(255,255,255,0.06); --accent: #6c63ff; --accent2: #00d2ff;
            --success: #22d3a5; --warning: #f59e0b; --pink: #ec4899; --orange: #f97316;
            --text: #e2e8f0; --muted: #64748b; --radius: 16px; --sidebar-w: 280px;
        }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; display: flex; flex-direction: column; }
        body::before { content: ''; position: fixed; inset: 0; background: radial-gradient(ellipse 60% 40% at 20% 10%, rgba(108,99,255,.10) 0%, transparent 70%), radial-gradient(ellipse 50% 35% at 80% 80%, rgba(0,210,255,.06) 0%, transparent 70%); pointer-events: none; z-index: 0; }

        /* ── Navbar ── */
        .top-nav { position: sticky; top: 0; z-index: 100; background: rgba(14,16,37,.92); backdrop-filter: blur(18px); border-bottom: 1px solid var(--border); padding: 0 32px; height: 60px; display: flex; align-items: center; justify-content: space-between; }
        .nav-logo { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.1rem; }
        .nav-logo .icon { width: 34px; height: 34px; background: linear-gradient(135deg, var(--accent), var(--accent2)); border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: 0.95rem; }
        .nav-logo span { color: var(--accent2); } .nav-logo strong { color: var(--text); }
        .nav-actions { display: flex; align-items: center; gap: 14px; }
        .nav-user { display: flex; align-items: center; gap: 10px; background: var(--card); border: 1px solid var(--border); border-radius: 999px; padding: 5px 14px 5px 5px; }
        .nav-avatar { width: 28px; height: 28px; background: linear-gradient(135deg, var(--accent), var(--pink)); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.7rem; }
        .nav-name { font-size: 0.8rem; font-weight: 500; }
        .btn-logout { text-decoration: none; color: var(--muted); font-size: 0.78rem; font-weight: 500; padding: 6px 12px; border-radius: 8px; border: 1px solid var(--border); transition: all .2s; }
        .btn-logout:hover { color: var(--text); border-color: rgba(255,255,255,.15); background: var(--card); }

        /* ── Layout ── */
        .app-layout { display: flex; flex: 1; position: relative; z-index: 1; }

        /* ── Sidebar ── */
        .sidebar { width: var(--sidebar-w); min-height: calc(100vh - 60px); background: var(--sidebar); border-right: 1px solid var(--border); display: flex; flex-direction: column; padding: 24px 0; position: sticky; top: 60px; height: calc(100vh - 60px); overflow-y: auto; flex-shrink: 0; }
        .sidebar-section-label { font-size: 0.65rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); padding: 0 24px; margin-bottom: 10px; margin-top: 8px; }
        .sidebar-nav { display: flex; flex-direction: column; gap: 2px; padding: 0 12px; }
        .sidebar-link { display: flex; align-items: center; gap: 14px; padding: 12px 16px; border-radius: 12px; text-decoration: none; color: rgba(255,255,255,0.6); font-size: 0.85rem; font-weight: 500; transition: all .25s cubic-bezier(.4,0,.2,1); position: relative; overflow: hidden; }
        .sidebar-link:hover { background: rgba(108,99,255,.08); color: var(--text); transform: translateX(4px); }
        .sidebar-link.active { background: linear-gradient(135deg, rgba(108,99,255,.15), rgba(0,210,255,.08)); color: #fff; font-weight: 600; border: 1px solid rgba(108,99,255,.2); box-shadow: 0 4px 16px rgba(108,99,255,.12); animation: pulse-glow 3s ease-in-out infinite; }
        .sidebar-link.active::before { content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 3px; height: 60%; background: linear-gradient(180deg, var(--accent), var(--accent2)); border-radius: 0 4px 4px 0; }
        .sidebar-icon { width: 38px; height: 38px; border-radius: 11px; display: flex; align-items: center; justify-content: center; font-size: 1.15rem; flex-shrink: 0; transition: transform .25s; }
        .sidebar-link:hover .sidebar-icon { transform: scale(1.1); }
        .si-purple { background: rgba(108,99,255,.12); } .si-teal { background: rgba(0,210,255,.10); } .si-green { background: rgba(34,211,165,.10); } .si-pink { background: rgba(236,72,153,.10); } .si-orange { background: rgba(249,115,22,.10); } .si-blue { background: rgba(59,130,246,.10); } .si-yellow { background: rgba(245,158,11,.10); }
        .sidebar-link-text { display: flex; flex-direction: column; gap: 1px; }
        .sidebar-link-title { font-size: 0.84rem; line-height: 1.3; }
        .sidebar-link-sub { font-size: 0.68rem; color: var(--muted); font-weight: 400; }
        .sidebar-link:hover .sidebar-link-sub, .sidebar-link.active .sidebar-link-sub { color: rgba(255,255,255,.45); }
        .sidebar-badge { margin-left: auto; font-size: 0.65rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; background: rgba(108,99,255,.18); color: var(--accent); }
        .sidebar-divider { height: 1px; background: var(--border); margin: 16px 24px; }
        .sidebar-footer { margin-top: auto; padding: 20px 20px 0; }
        .sidebar-pro-card { background: linear-gradient(135deg, rgba(108,99,255,.12), rgba(0,210,255,.08)); border: 1px solid rgba(108,99,255,.18); border-radius: 14px; padding: 18px; text-align: center; }
        .sidebar-pro-card .pro-emoji { font-size: 2rem; margin-bottom: 8px; display: block; }
        .sidebar-pro-card h4 { font-size: 0.82rem; font-weight: 700; margin-bottom: 4px; background: linear-gradient(90deg, var(--accent), var(--accent2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .sidebar-pro-card p { font-size: 0.7rem; color: var(--muted); line-height: 1.4; }

        /* ── Main ── */
        .main-content { flex: 1; padding: 36px 40px 80px; max-width: 820px; }
        .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); text-decoration: none; font-size: 0.8rem; font-weight: 500; margin-bottom: 20px; transition: color .2s; }
        .back-link:hover { color: var(--accent2); }

        /* ── Flash ── */
        .flash { padding: 12px 18px; border-radius: 10px; font-size: 0.82rem; font-weight: 500; margin-bottom: 16px; }
        .flash-success { background: rgba(34,211,165,.12); border: 1px solid rgba(34,211,165,.3); color: var(--success); }
        .flash-error   { background: rgba(239,68,68,.12); border: 1px solid rgba(239,68,68,.3); color: #ef4444; }

        /* ── Post article card ── */
        .post-article { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; margin-bottom: 28px; }
        .post-article-img { width: 100%; max-height: 360px; object-fit: cover; display: block; }
        .post-article-body { padding: 32px 36px; }

        .post-badge { display: inline-flex; align-items: center; gap: 5px; background: rgba(108,99,255,.12); color: var(--accent); border: 1px solid rgba(108,99,255,.2); font-size: 0.7rem; font-weight: 600; padding: 3px 11px; border-radius: 999px; margin-bottom: 16px; }

        .post-article-body h1 { font-size: 1.55rem; font-weight: 700; line-height: 1.35; margin-bottom: 16px; }

        .post-meta-row { display: flex; align-items: center; flex-wrap: wrap; gap: 18px; font-size: 0.75rem; color: var(--muted); margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--border); }
        .post-meta-row .meta-item { display: flex; align-items: center; gap: 5px; }
        .meta-modified { font-style: italic; color: var(--muted); font-size: 0.7rem; }

        .post-body-text { font-size: 0.88rem; line-height: 1.8; color: #c8d3e0; white-space: pre-wrap; }

        /* ── Reaction bar ── */
        .reaction-bar {
            display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
            margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border);
        }
        .reaction-btn {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 9px 18px; border-radius: 999px; border: 1px solid var(--border);
            background: var(--surface); color: var(--muted);
            font-family: 'Inter', sans-serif; font-size: 0.82rem; font-weight: 600;
            cursor: pointer; transition: all .2s; user-select: none;
        }
        .reaction-btn:hover { border-color: rgba(255,255,255,.18); color: var(--text); transform: scale(1.04); }
        .reaction-btn.active-like   { background: rgba(34,211,165,.12); border-color: var(--success); color: var(--success); }
        .reaction-btn.active-dislike { background: rgba(239,68,68,.1); border-color: #ef4444; color: #ef4444; }
        .reaction-btn.shared        { background: rgba(0,210,255,.1); border-color: var(--accent2); color: var(--accent2); cursor: default; }
        .reaction-btn .count { font-size: 0.78rem; }
        .reaction-separator { width: 1px; height: 24px; background: var(--border); }

        /* ── Post actions (edit/delete) ── */
        .post-actions { display: flex; gap: 10px; margin-top: 14px; flex-wrap: wrap; }
        .btn-edit-post { display: inline-flex; align-items: center; gap: 7px; background: rgba(245,158,11,.1); color: var(--warning); border: 1px solid rgba(245,158,11,.25); font-size: 0.8rem; font-weight: 600; padding: 9px 16px; border-radius: 9px; text-decoration: none; transition: all .2s; }
        .btn-edit-post:hover { background: rgba(245,158,11,.2); }
        .btn-delete-post { display: inline-flex; align-items: center; gap: 7px; background: rgba(239,68,68,.1); color: #ef4444; border: 1px solid rgba(239,68,68,.25); font-size: 0.8rem; font-weight: 600; padding: 9px 16px; border-radius: 9px; cursor: pointer; font-family: 'Inter', sans-serif; transition: all .2s; }
        .btn-delete-post:hover { background: rgba(239,68,68,.2); }

        /* ── Toast notification ── */
        .toast {
            position: fixed; bottom: 28px; right: 28px; z-index: 9999;
            background: var(--card); border: 1px solid var(--border);
            border-radius: 12px; padding: 12px 20px;
            font-size: 0.82rem; font-weight: 500; color: var(--text);
            box-shadow: 0 8px 32px rgba(0,0,0,.4);
            transform: translateY(20px); opacity: 0;
            transition: all .3s cubic-bezier(.4,0,.2,1);
            pointer-events: none;
        }
        .toast.show { transform: translateY(0); opacity: 1; }
        .toast.toast-success { border-color: rgba(34,211,165,.3); color: var(--success); }
        .toast.toast-info    { border-color: rgba(0,210,255,.3); color: var(--accent2); }

        /* ── Comments section ── */
        .comments-section { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 28px 32px; }
        .comments-header { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
        .comments-header h2 { font-size: 1rem; font-weight: 700; }
        .comments-count { background: rgba(108,99,255,.15); color: var(--accent); border: 1px solid rgba(108,99,255,.2); font-size: 0.7rem; font-weight: 700; padding: 2px 9px; border-radius: 999px; }
        .comment-list { display: flex; flex-direction: column; gap: 12px; margin-bottom: 28px; }
        .comment-item { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 16px 18px; transition: border-color .2s; }
        .comment-item:hover { border-color: rgba(108,99,255,.18); }
        .comment-meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
        .comment-author { font-size: 0.8rem; font-weight: 600; color: var(--text); }
        .comment-date { font-size: 0.7rem; color: var(--muted); }
        .comment-body { font-size: 0.83rem; color: #b0bec5; line-height: 1.6; white-space: pre-wrap; }
        .no-comments { text-align: center; padding: 28px; color: var(--muted); font-size: 0.82rem; font-style: italic; margin-bottom: 24px; }
        .comment-form-section { border-top: 1px solid var(--border); padding-top: 22px; }
        .comment-form-title { font-size: 0.8rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 12px; }
        .comment-form-section textarea { width: 100%; background: var(--surface); border: 1px solid var(--border); color: var(--text); border-radius: 10px; padding: 12px 14px; font-family: 'Inter', sans-serif; font-size: 0.84rem; resize: vertical; min-height: 90px; outline: none; transition: border-color .2s, box-shadow .2s; }
        .comment-form-section textarea::placeholder { color: var(--muted); }
        .comment-form-section textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(108,99,255,.15); }
        .comment-form-error { color: #ef4444; font-size: 0.75rem; margin: 4px 0; }
        .btn-comment-submit { margin-top: 10px; display: inline-flex; align-items: center; gap: 7px; background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; font-size: 0.8rem; font-weight: 600; padding: 9px 20px; border-radius: 9px; border: none; cursor: pointer; font-family: 'Inter', sans-serif; transition: opacity .2s; box-shadow: 0 3px 12px rgba(108,99,255,.25); }
        .btn-comment-submit:hover { opacity: .88; }
        .login-prompt { text-align: center; padding: 20px; color: var(--muted); font-size: 0.83rem; border-top: 1px solid var(--border); margin-top: 4px; }
        .login-prompt a { color: var(--accent); text-decoration: none; font-weight: 500; }
        .login-prompt a:hover { color: var(--accent2); }

        @media (max-width: 900px) { .sidebar { display: none; } .main-content { padding: 24px 16px 60px; } }
        @keyframes pulse-glow { 0%, 100% { box-shadow: 0 0 0 0 rgba(108,99,255,.15); } 50% { box-shadow: 0 0 18px 4px rgba(108,99,255,.12); } }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="top-nav">
    <div class="nav-logo">
        <div class="icon">🧠</div>
        <div><strong>Psy</strong><span>App</span></div>
    </div>
    <div class="nav-actions">
        {% if app.user %}
        <div class="nav-user">
            <div class="nav-avatar">{{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}</div>
            <span class="nav-name">{{ app.user.prenom }} {{ app.user.nom }}</span>
        </div>
        {% endif %}
        <a href="{{ path('app_logout') }}" class="btn-logout">🚪 Déconnexion</a>
    </div>
</nav>

<div class="app-layout">

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-section-label">🏠 Tableau de bord</div>
        <div class="sidebar-nav">
            <a href="{{ path('app_dashboard') }}" class="sidebar-link">
                <div class="sidebar-icon si-blue">📊</div>
                <div class="sidebar-link-text"><span class="sidebar-link-title">Dashboard</span><span class="sidebar-link-sub">Vue d'ensemble</span></div>
            </a>
        </div>
        <div class="sidebar-divider"></div>
        <div class="sidebar-section-label">⚙️ Gestion</div>
        <div class="sidebar-nav">
            <a href="{{ path('app_challenge_index') }}" class="sidebar-link">
                <div class="sidebar-icon si-purple">🔥</div>
                <div class="sidebar-link-text"><span class="sidebar-link-title">Motivation</span><span class="sidebar-link-sub">Challenges & objectifs</span></div>
                <span class="sidebar-badge">PRO</span>
            </a>
            <a href="#" class="sidebar-link"><div class="sidebar-icon si-green">🔄</div><div class="sidebar-link-text"><span class="sidebar-link-title">Habitudes</span><span class="sidebar-link-sub">Suivi quotidien</span></div></a>
            <a href="#" class="sidebar-link"><div class="sidebar-icon si-orange">🏋️</div><div class="sidebar-link-text"><span class="sidebar-link-title">Fitness</span><span class="sidebar-link-sub">Workouts & plans</span></div></a>
            <a href="{{ path('post_index') }}" class="sidebar-link active">
                <div class="sidebar-icon si-pink">💬</div>
                <div class="sidebar-link-text"><span class="sidebar-link-title">Posts</span><span class="sidebar-link-sub">Communauté & partage</span></div>
            </a>
            <a href="#" class="sidebar-link"><div class="sidebar-icon si-teal">🧠</div><div class="sidebar-link-text"><span class="sidebar-link-title">Mentalité</span><span class="sidebar-link-sub">Journal & bien-être</span></div></a>
        </div>
        <div class="sidebar-divider"></div>
        <div class="sidebar-section-label">📋 Support</div>
        <div class="sidebar-nav">
            <a href="{{ path('app_reclamation_index') }}" class="sidebar-link">
                <div class="sidebar-icon si-yellow">📬</div>
                <div class="sidebar-link-text"><span class="sidebar-link-title">Réclamations</span><span class="sidebar-link-sub">Mes demandes</span></div>
            </a>
        </div>
        <div class="sidebar-footer">
            <div class="sidebar-pro-card"><span class="pro-emoji">🌟</span><h4>PsyApp Pro</h4><p>Votre bien-être mental est notre priorité quotidienne.</p></div>
        </div>
    </aside>

    <!-- Main content -->
    <div class="main-content">

        <a href="{{ path('post_index') }}" class="back-link">← Retour au forum</a>

        <!-- Flash messages -->
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash flash-{{ type }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <!-- Post article -->
        <article class="post-article">

            {% if post.image %}
                <img src="/uploads/posts/{{ post.image }}" alt="{{ post.titre }}" class="post-article-img">
            {% endif %}

            <div class="post-article-body">

                {% if post.categorie %}
                    <span class="post-badge">{{ post.categorie.icon ? post.categorie.icon ~ ' ' }}{{ post.categorie.nom }}</span>
                {% endif %}

                <h1>{{ post.titre }}</h1>

                <div class="post-meta-row">
                    <span class="meta-item">
                        👤
                        {% if post.isAnonymous %}
                            <em>Anonyme</em>
                        {% else %}
                            {{ post.user.prenom }} {{ post.user.nom }}
                        {% endif %}
                    </span>
                    <span class="meta-item">📅 {{ post.createdAt|date('d/m/Y à H:i') }}</span>
                    {% if post.updatedAt %}
                        <span class="meta-modified">(modifié le {{ post.updatedAt|date('d/m/Y') }})</span>
                    {% endif %}
                </div>

                <div class="post-body-text">{{ post.contenu }}</div>

                {# ── Barre de réactions ─────────────────────────────── #}
                <div class="reaction-bar" id="reaction-bar">
                    {% if app.user %}
                        {# Bouton LIKE #}
                        <button
                            class="reaction-btn {% if userVote == 'like' %}active-like{% endif %}"
                            id="btn-like"
                            onclick="vote('like')">
                            👍 <span class="count" id="likes-count">{{ likesCount }}</span>
                        </button>

                        {# Bouton DISLIKE #}
                        <button
                            class="reaction-btn {% if userVote == 'dislike' %}active-dislike{% endif %}"
                            id="btn-dislike"
                            onclick="vote('dislike')">
                            👎 <span class="count" id="dislikes-count">{{ dislikesCount }}</span>
                        </button>

                        <div class="reaction-separator"></div>

                        {# Bouton REPOST #}
                        <button
                            class="reaction-btn {% if hasShared %}shared{% endif %}"
                            id="btn-repost"
                            onclick="{% if not hasShared %}repost(){% endif %}"
                            title="{% if hasShared %}Déjà reposté{% else %}Reposer ce post{% endif %}">
                            🔁 <span class="count" id="shares-count">{{ sharesCount }}</span>
                            <span id="repost-label">{% if hasShared %}Reposté{% else %}Repost{% endif %}</span>
                        </button>
                    {% else %}
                        {# Affichage read-only pour les non-connectés #}
                        <span class="reaction-btn" style="cursor:default">👍 {{ likesCount }}</span>
                        <span class="reaction-btn" style="cursor:default">👎 {{ dislikesCount }}</span>
                        <div class="reaction-separator"></div>
                        <span class="reaction-btn" style="cursor:default">🔁 {{ sharesCount }}</span>
                    {% endif %}
                </div>

                {# ── Boutons Modifier / Supprimer (auteur uniquement) #}
                {% if app.user and app.user == post.user %}
                <div class="post-actions">
                    <a href="{{ path('post_edit', {id: post.id}) }}" class="btn-edit-post">✏️ Modifier</a>
                    <form method="post" action="{{ path('post_delete', {id: post.id}) }}"
                          onsubmit="return confirm('Supprimer définitivement ce post ?')" style="display:contents">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete'~post.id) }}">
                        <button type="submit" class="btn-delete-post">🗑️ Supprimer</button>
                    </form>
                </div>
                {% endif %}

            </div>
        </article>

        <!-- Comments section -->
        <section class="comments-section">

            <div class="comments-header">
                <h2>💬 Commentaires</h2>
                <span class="comments-count">{{ post.commentaires|length }}</span>
            </div>

            {% if post.commentaires is empty %}
                <div class="no-comments">Aucun commentaire pour l'instant. Soyez le premier !</div>
            {% else %}
                <div class="comment-list">
                    {% for commentaire in post.commentaires %}
                    <div class="comment-item">
                        <div class="comment-meta">
                            <span class="comment-author">👤 {{ commentaire.user.prenom }} {{ commentaire.user.nom }}</span>
                            <span class="comment-date">{{ commentaire.createdAt|date('d/m/Y à H:i') }}</span>
                        </div>
                        <div class="comment-body">{{ commentaire.contenu }}</div>
                    </div>
                    {% endfor %}
                </div>
            {% endif %}

            <!-- Comment form or login prompt -->
            {% if app.user %}
                <div class="comment-form-section">
                    <div class="comment-form-title">Laisser un commentaire</div>
                    {{ form_start(commentaireForm, {
                        action: path('post_add_comment', {id: post.id}),
                        method: 'POST'
                    }) }}
                        {{ form_widget(commentaireForm.contenu, {attr: {placeholder: 'Votre commentaire...'}}) }}
                        {% if form_errors(commentaireForm.contenu) is not empty %}
                            <div class="comment-form-error">{{ form_errors(commentaireForm.contenu) }}</div>
                        {% endif %}
                        <button type="submit" class="btn-comment-submit">💬 Commenter</button>
                    {{ form_end(commentaireForm) }}
                </div>
            {% else %}
                <div class="login-prompt">
                    <a href="{{ path('app_login') }}">Connectez-vous</a> pour laisser un commentaire.
                </div>
            {% endif %}

        </section>

    </div>
</div>

{# ── Toast de feedback ── #}
<div class="toast" id="toast"></div>

{% if app.user %}
<script>
    const LIKE_URL   = '{{ path('post_like',   {id: post.id}) }}';
    const REPOST_URL = '{{ path('post_repost', {id: post.id}) }}';
    let currentVote  = '{{ userVote ?? '' }}';
    let isShared     = {{ hasShared ? 'true' : 'false' }};

    /* ── Toast helper ── */
    function showToast(msg, type = 'success') {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.className = `toast toast-${type}`;
        void t.offsetWidth; // reflow
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2800);
    }

    /* ── Like / Dislike ── */
    async function vote(type) {
        const body = new URLSearchParams({ type });
        try {
            const res  = await fetch(LIKE_URL, { method: 'POST', body, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const data = await res.json();

            document.getElementById('likes-count').textContent    = data.likes;
            document.getElementById('dislikes-count').textContent = data.dislikes;

            const btnLike    = document.getElementById('btn-like');
            const btnDislike = document.getElementById('btn-dislike');
            btnLike.classList.remove('active-like');
            btnDislike.classList.remove('active-dislike');

            currentVote = data.userVote;
            if (data.userVote === 'like')    { btnLike.classList.add('active-like'); showToast('👍 Like enregistré !'); }
            else if (data.userVote === 'dislike') { btnDislike.classList.add('active-dislike'); showToast('👎 Dislike enregistré !'); }
            else { showToast('Vote annulé.', 'info'); }
        } catch (e) { showToast('Erreur réseau.', 'info'); }
    }

    /* ── Repost ── */
    async function repost() {
        if (isShared) return;
        try {
            const res  = await fetch(REPOST_URL, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const data = await res.json();

            document.getElementById('shares-count').textContent = data.shares;
            document.getElementById('repost-label').textContent = 'Reposté';
            const btn = document.getElementById('btn-repost');
            btn.classList.add('shared');
            btn.setAttribute('onclick', '');
            isShared = true;
            showToast('🔁 ' + data.message);
        } catch (e) { showToast('Erreur réseau.', 'info'); }
    }
</script>
{% endif %}

</body>
</html>
