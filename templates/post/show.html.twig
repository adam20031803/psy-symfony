{% extends 'base.html.twig' %}

{% block title %}{{ post.titre }} — Atomic You{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); text-decoration: none; font-size: 0.8rem; font-weight: 500; margin-bottom: 20px; transition: color .2s; }
        .back-link:hover { color: var(--accent2); }

        .show-post-container { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
        .post-header-img { width: 100%; max-height: 400px; object-fit: cover; }
        .post-content { padding: 40px; }
        .post-meta { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; font-size: 0.85rem; color: var(--muted); }
        .post-badge { background: rgba(108,99,255,0.15); color: var(--accent); padding: 4px 12px; border-radius: 99px; font-size: 0.75rem; font-weight: 700; }
        .post-title { font-size: 2rem; font-weight: 800; color: #fff; margin-bottom: 20px; line-height: 1.2; }
        .post-body { font-size: 1.05rem; line-height: 1.8; color: #cbd5e1; }
        .post-actions { display: flex; gap: 14px; margin-top: 30px; padding-top: 24px; border-top: 1px solid var(--border); }
        .btn-action { background: rgba(255,255,255,0.04); border: 1px solid var(--border); color: #fff; padding: 10px 18px; border-radius: 10px; cursor: pointer; transition: 0.2s; display: flex; align-items: center; gap: 8px; font-size: 0.85rem; }
        .btn-action:hover { background: rgba(255,255,255,0.08); border-color: var(--accent); }
        .btn-action.active-like { background: rgba(34,211,165,0.15); border-color: var(--success); color: var(--success); }
        .btn-action.active-dislike { background: rgba(239,68,68,0.15); border-color: #ef4444; color: #ef4444; }

        .comments-section { margin-top: 40px; }
        .section-title { font-size: 1.2rem; font-weight: 700; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; }
        .comment-card { background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 16px; position: relative; transition: 0.3s; }
        .comment-card:hover { background: rgba(255,255,255,0.04); border-color: rgba(108,99,255,0.2); }
        .comment-header { display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 0.8rem; }
        .comment-content { font-size: 0.92rem; line-height: 1.6; color: #e2e8f0; }
        .comment-actions { display: flex; gap: 12px; margin-top: 12px; }
        .btn-small { background: transparent; border: none; color: var(--muted); cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; transition: 0.2s; }
        
        .translation-panel { background: rgba(0,210,255,0.05); border: 1px dashed var(--accent2); border-radius: 12px; padding: 20px; margin-top: 20px; display: none; }
        .translation-panel.visible { display: block; animation: fadeIn 0.4s ease; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .toast { background: rgba(24,27,48,0.9); backdrop-filter: blur(10px); border: 1px solid var(--accent); color: #fff; padding: 12px 24px; border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); margin-top: 10px; display: flex; align-items: center; gap: 10px; animation: slideIn 0.3s ease; }
    </style>
{% endblock %}

{% block body %}
    <a href="{{ path('post_index') }}" class="back-link">← Retour au forum</a>

    <div class="show-post-container">
        {% if post.image %}
            <img src="/uploads/posts/{{ post.image }}" class="post-header-img" alt="{{ post.titre }}">
        {% endif %}

        <div class="post-content">
            <div class="post-meta">
                <span class="post-badge">{{ post.categorie.nom ?? 'Général' }}</span>
                <span>• Par <strong>{{ post.isAnonymous ? 'Anonyme' : (post.user ? post.user.prenom ~ ' ' ~ post.user.nom : 'Utilisateur') }}</strong></span>
                <span>• {{ post.createdAt|date('d/m/Y H:i') }}</span>
                {% if app.user and post.user == app.user %}
                    <a href="{{ path('post_edit', {id: post.id}) }}" style="margin-left: auto; color: var(--accent2); text-decoration: none; font-size: 0.8rem; font-weight: 700;">[Modifier]</a>
                {% endif %}
            </div>

            <h1 class="post-title">{{ post.titre }}</h1>
            
            <div class="post-body">
                <div class="post-body-text">{{ post.contenu|raw }}</div>
                
                <div id="translation-panel" class="translation-panel">
                    <p style="font-size: 0.7rem; color: var(--accent2); margin-bottom:10px; font-weight: 800; text-transform: uppercase;">AI Translation (English) 🌐</p>
                    <h2 id="tr-title" style="font-size: 1.4rem; margin-bottom: 15px;"></h2>
                    <div id="tr-content" style="font-style: italic; color: #e2e8f0;"></div>
                </div>
            </div>

            <div class="post-actions">
                <button class="btn-action {{ userVote == 'like' ? 'active-like' }}" onclick="vote('like')" id="btn-like">
                    👍 <span id="likes-count">{{ likesCount }}</span>
                </button>
                <button class="btn-action {{ userVote == 'dislike' ? 'active-dislike' }}" onclick="vote('dislike')" id="btn-dislike">
                    👎 <span id="dislikes-count">{{ dislikesCount }}</span>
                </button>
                <button class="btn-action" onclick="translatePost()" id="btn-translate">
                    🌐 <span id="translate-label">Traduire en EN</span>
                </button>
                <button class="btn-action {{ hasShared ? 'shared' }}" onclick="repost()" id="btn-repost" {% if hasShared %}disabled{% endif %}>
                    🔁 <span id="shares-count">{{ sharesCount }}</span> <span id="repost-label">{{ hasShared ? 'Reposté' : 'Repost' }}</span>
                </button>
            </div>
        </div>
    </div>

    <div class="comments-section">
        <div class="section-title">
            <span>Commentaires ({{ post.commentaires|length }})</span>
        </div>

        <div id="comments-list">
            {% for comment in post.commentaires %}
                <div class="comment-card" id="comment-{{ comment.id }}">
                    <div class="comment-header">
                        <div>
                            <strong>{{ comment.user.prenom }} {{ comment.user.nom }}</strong>
                            <span style="color: var(--muted); margin-left: 8px;">{{ comment.createdAt|date('d/m/Y H:i') }}</span>
                        </div>
                        {% if app.user and comment.user == app.user %}
                            <div class="comment-mgmt">
                                <button class="btn-small" onclick="startEditComment({{ comment.id }})">Modifier</button>
                                <button class="btn-small btn-delete" onclick="deleteComment({{ comment.id }}, '{{ csrf_token('delete_comment' ~ comment.id) }}')">Supprimer</button>
                            </div>
                        {% endif %}
                    </div>
                    <div class="comment-content" id="comment-body-{{ comment.id }}">
                        {{ comment.contenu|raw }}
                    </div>
                </div>
            {% else %}
                <p id="no-comments-msg" style="color: var(--muted); text-align: center; padding: 20px;">Aucun commentaire pour le moment.</p>
            {% endfor %}
        </div>

        {% if app.user %}
            <div class="add-comment-card" style="background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 24px; margin-top: 30px;">
                <h4 style="margin-bottom: 16px; font-size: 1rem;">Ajouter un commentaire</h4>
                {{ form_start(commentaireForm, {action: path('comment_create', {id: post.id}), attr: {id: 'new-comment-form'}}) }}
                    {{ form_widget(commentaireForm.contenu, {attr: {placeholder: 'Votre message...'}}) }}
                    <button type="submit" class="btn-submit" style="margin-top: 20px; background: var(--accent); color: #fff; padding: 10px 20px; border:none; border-radius: 8px; font-weight: 700; cursor: pointer;">📤 Envoyer</button>
                {{ form_end(commentaireForm, {render_rest: false}) }}
            </div>
        {% endif %}
    </div>

    <div id="toast-container" style="position: fixed; bottom: 24px; right: 24px; z-index: 1000;"></div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.ckeditor.com/4.22.1/full/ckeditor.js"></script>
    <script>
        const POST_ID = {{ post.id }};
        const TRANSLATE_URL = "{{ path('app_posts_ai_translate', {id: post.id}) }}";
        const LIKE_URL = "{{ path('post_like', {id: post.id}) }}";
        const REPOST_URL = "{{ path('post_repost', {id: post.id}) }}";

        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.style.cssText = 'background: rgba(24,27,48,0.9); backdrop-filter: blur(10px); border: 1px solid var(--accent); color: #fff; padding: 12px 24px; border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); margin-top: 10px; display: flex; align-items: center; gap: 10px; animation: slideIn 0.3s ease;';
            toast.innerHTML = (type === 'success' ? '✅ ' : '❌ ') + message;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
        }

        async function vote(type) {
            const body = new URLSearchParams({ type });
            const res = await fetch(LIKE_URL, { method: 'POST', body, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const data = await res.json();
            document.getElementById('likes-count').textContent = data.likes;
            document.getElementById('dislikes-count').textContent = data.dislikes;
            showToast('Vote enregistré !');
        }

        async function repost() {
            const res = await fetch(REPOST_URL, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const data = await res.json();
            document.getElementById('shares-count').textContent = data.shares;
            document.getElementById('repost-label').textContent = 'Reposté';
            document.getElementById('btn-repost').disabled = true;
            showToast('Reposté avec succès !');
        }

        let translationCache = null;
        async function translatePost() {
            const panel = document.getElementById('translation-panel');
            if (panel.classList.contains('visible')) {
                panel.classList.remove('visible');
                document.getElementById('translate-label').textContent = 'Traduire en EN';
                return;
            }
            if (translationCache) {
                panel.classList.add('visible');
                document.getElementById('translate-label').textContent = 'Voir l\'original';
                return;
            }
            const res = await fetch(TRANSLATE_URL, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const data = await res.json();
            if (data.success) {
                translationCache = data;
                document.getElementById('tr-title').textContent = data.title;
                document.getElementById('tr-content').innerHTML = data.content;
                panel.classList.add('visible');
                document.getElementById('translate-label').textContent = 'Voir l\'original';
                showToast('Traduit avec succès');
            }
        }

        function startEditComment(id) {
            const body = document.getElementById('comment-body-' + id);
            const text = body.textContent.trim();
            body.innerHTML = `
                <div class="inline-edit-form" id="edit-form-${id}" style="margin-top: 10px;">
                    <textarea id="temp-edit-${id}" style="width: 100%; background: var(--surface); border: 1px solid var(--accent); border-radius: 8px; color: #fff; padding: 10px; min-height: 80px; outline: none; margin-bottom: 8px;">${text}</textarea>
                    <div class="inline-edit-btns" style="display: flex; gap: 8px;">
                        <button class="btn-save-edit" onclick="saveEditComment(${id})" style="background: var(--accent); color: #fff; border: none; border-radius: 6px; padding: 6px 12px; font-size: 0.75rem; cursor: pointer;">Sauvegarder</button>
                        <button class="btn-cancel-edit" onclick="location.reload()" style="background: rgba(255,255,255,0.1); color: #fff; border: none; border-radius: 6px; padding: 6px 12px; font-size: 0.75rem; cursor: pointer;">Annuler</button>
                    </div>
                </div>
            `;
        }

        async function saveEditComment(id) {
            const content = document.getElementById('temp-edit-' + id).value;
            const body = new URLSearchParams({ contenu: content });
            const res = await fetch(`/comments/${id}/edit`, { method: 'POST', body, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const data = await res.json();
            if (data.success) {
                document.getElementById('comment-body-' + id).innerHTML = data.contenu;
                showToast('Modifié !');
            } else {
                showToast(data.error || 'Erreur lors de la modification', 'error');
            }
        }

        async function deleteComment(id, token) {
            if (!confirm('Supprimer ?')) return;
            const body = new URLSearchParams({ _token: token });
            const res = await fetch(`/comments/${id}/delete`, { method: 'POST', body, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const data = await res.json();
            if (data.success) {
                document.getElementById('comment-' + id).remove();
                showToast('Supprimé !');
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            const commentForm = document.getElementById('new-comment-form');
            if (commentForm) {
                commentForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    // Force update CKEditor if used
                    if (window.CKEDITOR && CKEDITOR.instances[Object.keys(CKEDITOR.instances)[0]]) {
                        CKEDITOR.instances[Object.keys(CKEDITOR.instances)[0]].updateElement();
                    }
                    
                    const formData = new FormData(this);
                    const res = await fetch("{{ path('comment_create', {id: post.id}) }}", {
                        method: 'POST',
                        body: new URLSearchParams(formData),
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    const data = await res.json();
                    
                    if (data.success) {
                        location.reload(); // Simplest way to show new comment with full UI
                    } else {
                        showToast(data.error || 'Erreur', 'error');
                    }
                });
            }

            const textarea = document.querySelector('.add-comment-card textarea');
            if (textarea) {
                CKEDITOR.replace(textarea, {
                    height: 120,
                    toolbar: [{ name: 'basic', items: ['Bold', 'Italic', 'Underline'] }],
                    on: { change: function(e) { e.editor.updateElement(); } }
                });
            }
        });
    </script>
{% endblock %}
