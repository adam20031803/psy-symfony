{% extends 'base.html.twig' %}

{% block title %}Nouveau Post — Atomic You{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); text-decoration: none; font-size: 0.8rem; font-weight: 500; margin-bottom: 20px; transition: color .2s; }
        .back-link:hover { color: var(--accent2); }

        .page-heading { margin-bottom: 28px; }
        .page-heading h1 { font-size: 1.4rem; font-weight: 700; margin-bottom: 4px; }
        .page-heading h1 span { background: linear-gradient(90deg, var(--accent), var(--accent2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .page-heading p { color: var(--muted); font-size: 0.82rem; }

        .form-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 32px 36px; }
        .field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }
        .field label { font-size: 0.78rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
        .field input[type="text"], .field textarea, .field select {
            background: var(--surface); border: 1px solid var(--border);
            color: var(--text); border-radius: 10px; padding: 11px 14px;
            font-family: 'Inter', sans-serif; font-size: 0.85rem;
            outline: none; transition: border-color .2s, box-shadow .2s; width: 100%;
        }
        .field input[type="text"]:focus, .field textarea:focus, .field select:focus {
            border-color: var(--accent); box-shadow: 0 0 0 3px rgba(108,99,255,.15);
        }
        .form-error { color: #ef4444; font-size: 0.75rem; margin-top: 2px; }
        .btn-submit {
            width: 100%; padding: 12px; border: none; border-radius: 11px; cursor: pointer;
            font-family: 'Inter', sans-serif; font-size: 0.88rem; font-weight: 700;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            color: #fff; transition: opacity .2s;
            box-shadow: 0 4px 18px rgba(108,99,255,.3); margin-top: 4px;
        }
        .btn-submit:hover { opacity: .88; }

        .ai-assistant {
            background: linear-gradient(135deg, rgba(108,99,255,.12), rgba(0,210,255,.08));
            border: 1px solid rgba(108,99,255,.2);
            border-radius: var(--radius); padding: 24px; margin-bottom: 28px;
            position: relative; overflow: hidden;
        }
        .ai-header { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
        .ai-header h3 { font-size: 0.95rem; font-weight: 700; color: #fff; }
        .ai-header .badge { font-size: 0.65rem; background: var(--accent); color: #fff; padding: 2px 8px; border-radius: 999px; text-transform: uppercase; }
        .ai-input-group { display: flex; gap: 10px; }
        .ai-input {
            flex: 1; background: rgba(10,12,26,0.6); border: 1px solid rgba(255,255,255,0.1);
            border-radius: 10px; padding: 10px 14px; color: #fff; font-size: 0.85rem; outline: none;
        }
        .btn-ai-gen {
            background: var(--accent); color: #fff; border: none; border-radius: 10px;
            padding: 10px 20px; font-size: 0.85rem; font-weight: 700; cursor: pointer;
            transition: all 0.2s; display: flex; align-items: center; gap: 8px; white-space: nowrap;
        }
        .spinner { width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%; animation: spin 0.8s linear infinite; display: none; }
        .spinning .spinner { display: block; }
        .spinning .icon-gen { display: none; }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
{% endblock %}

{% block body %}
    <a href="{{ path('post_index') }}" class="back-link">← Retour au forum</a>
    <div class="page-heading">
        <h1>🖋️ <span>Nouveau Post</span></h1>
        <p>Partagez quelque chose avec la communauté Atomic You</p>
    </div>

    <div class="form-card">
        <div class="ai-assistant">
            <div class="ai-header">
                <h3>Assistant de rédaction IA</h3>
                <span class="badge">Gemini AI</span>
            </div>
            <div class="ai-input-group">
                <input type="text" id="ai-subject" class="ai-input" placeholder="Sujet du post (ex: Routine matinale)">
                <button type="button" id="btn-ai-gen" class="btn-ai-gen">
                    <span class="spinner"></span>
                    <span class="icon-gen">✨</span>
                    <span>Générer</span>
                </button>
            </div>
        </div>

        {{ form_start(form, {attr: {id: 'post-form', enctype: 'multipart/form-data', novalidate: 'novalidate'}}) }}
            <div class="field">
                {{ form_label(form.titre) }}
                {{ form_widget(form.titre, {attr: {placeholder: 'Titre du post'}}) }}
                {{ form_errors(form.titre) }}
            </div>
            <div class="field">
                {{ form_label(form.contenu) }}
                {{ form_widget(form.contenu) }}
                {{ form_errors(form.contenu) }}
            </div>
            <div class="field">
                {{ form_label(form.categorie) }}
                {{ form_widget(form.categorie) }}
                {{ form_errors(form.categorie) }}
            </div>
            <div class="field">
                <label for="{{ form.imageFile.vars.id }}">Image</label>
                {{ form_widget(form.imageFile) }}
                {{ form_errors(form.imageFile) }}
            </div>
            <div class="field" style="flex-direction: row; align-items: center; gap: 10px;">
                {{ form_widget(form.isAnonymous) }}
                <label for="{{ form.isAnonymous.vars.id }}" style="margin: 0; text-transform: none; letter-spacing: normal;">Poster anonymement</label>
            </div>
            <button type="submit" class="btn-submit">🚀 Publier le post</button>
        {{ form_end(form) }}
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.ckeditor.com/4.22.1/full/ckeditor.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const btnAiGen = document.getElementById('btn-ai-gen');
            const aiSubject = document.getElementById('ai-subject');
            const titleField = document.getElementById('{{ form.titre.vars.id }}');
            const contentField = document.getElementById('{{ form.contenu.vars.id }}');
            const categoryField = document.getElementById('{{ form.categorie.vars.id }}');

            // Init CKEditor if exists
            let editorInstance = null;
            if (contentField) {
                editorInstance = CKEDITOR.replace(contentField.id, {
                    height: 300,
                    skin: 'moono-lisa',
                    contentsCss: ['body { font-family: Inter, sans-serif; font-size: 14px; color: #c8d3e0; background: #111328; padding: 20px; line-height: 1.7; }'],
                    on: {
                        change: function(evt) { evt.editor.updateElement(); }
                    }
                });
            }

            btnAiGen.addEventListener('click', async function() {
                const subject = aiSubject.value.trim();
                if (!subject) return alert('Veuillez saisir un sujet.');

                btnAiGen.classList.add('spinning');
                btnAiGen.disabled = true;

                try {
                    const response = await fetch('{{ path("app_posts_ai_generate") }}', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ subject: subject })
                    });
                    const data = await response.json();

                    if (data.success) {
                        titleField.value = data.title;
                        if (editorInstance) {
                            editorInstance.setData(data.content);
                        } else {
                            contentField.value = data.content;
                        }
                        if (data.category_id) categoryField.value = data.category_id;
                    } else {
                        alert('Erreur: ' + (data.error || 'Échec de la génération.'));
                    }
                } catch (error) {
                    alert('Erreur réseau.');
                } finally {
                    btnAiGen.classList.remove('spinning');
                    btnAiGen.disabled = false;
                }
            });
        });
    </script>
{% endblock %}
