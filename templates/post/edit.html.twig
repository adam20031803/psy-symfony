{% extends 'base.html.twig' %}

{% block title %}Modifier le Post — Atomic You{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); text-decoration: none; font-size: 0.8rem; font-weight: 500; margin-bottom: 20px; transition: color .2s; }
        .back-link:hover { color: var(--accent2); }
        .page-heading { margin-bottom: 28px; }
        .page-heading h1 { font-size: 1.4rem; font-weight: 700; margin-bottom: 4px; }
        .page-heading h1 span { background: linear-gradient(90deg, var(--accent), var(--accent2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .page-heading p { color: var(--muted); font-size: 0.82rem; }
        .form-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 32px 36px; }

        /* ── AI Toolbar ── */
        .ai-toolbar {
            display: flex; gap: 10px; flex-wrap: wrap;
            background: linear-gradient(135deg, rgba(108,99,255,.07), rgba(0,210,255,.04));
            border: 1px solid rgba(108,99,255,.15); border-radius: 12px;
            padding: 14px 16px; margin-bottom: 24px; align-items: center;
        }
        .ai-toolbar-label { font-size: 0.72rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; flex: 1; }
        .ai-topic-input {
            flex: 2; min-width: 180px;
            background: var(--surface); border: 1px solid var(--border);
            color: var(--text); border-radius: 9px; padding: 8px 12px;
            font-family: 'Inter', sans-serif; font-size: 0.82rem; outline: none;
            transition: border-color .2s;
        }
        .ai-topic-input:focus { border-color: var(--accent); }
        .ai-topic-input::placeholder { color: var(--muted); }
        .btn-ai {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 8px 16px; border-radius: 9px; border: none; cursor: pointer;
            font-family: 'Inter', sans-serif; font-size: 0.78rem; font-weight: 600;
            transition: all .2s; white-space: nowrap;
        }
        .btn-ai-generate {
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            color: #fff; box-shadow: 0 3px 12px rgba(108,99,255,.3);
        }
        .btn-ai-generate:hover { opacity: .88; transform: translateY(-1px); }
        .btn-ai-translate {
            background: rgba(0,210,255,.1); color: var(--accent2);
            border: 1px solid rgba(0,210,255,.2);
        }
        .btn-ai-translate:hover { background: rgba(0,210,255,.2); }

        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; color: var(--text); }
        .form-control { width: 100%; background: var(--surface); border: 1px solid var(--border); color: var(--text); border-radius: 10px; padding: 10px 14px; font-family: 'Inter', sans-serif; font-size: 0.88rem; outline: none; transition: border-color .2s; }
        .form-control:focus { border-color: var(--accent); }
        .form-actions { margin-top: 32px; display: flex; gap: 12px; }
        .btn-submit { flex: 1; background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; border: none; border-radius: 10px; padding: 12px; font-size: 0.9rem; font-weight: 700; cursor: pointer; transition: opacity .2s; }
        .btn-submit:hover { opacity: 0.9; }
        .btn-cancel { text-decoration: none; background: var(--surface); color: var(--muted); border: 1px solid var(--border); border-radius: 10px; padding: 12px 24px; font-size: 0.9rem; font-weight: 600; transition: all .2s; }
        .btn-cancel:hover { color: var(--text); border-color: rgba(255,255,255,0.1); }

        /* Current image preview */
        .current-image { margin-bottom: 12px; border-radius: 10px; overflow: hidden; border: 1px solid var(--border); width: 120px; height: 80px; }
        .current-image img { width: 100%; height: 100%; object-fit: cover; }

        /* Custom file input */
        .file-input-wrapper { position: relative; }
        .file-input-wrapper input[type="file"] { position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; cursor: pointer; }
        .file-input-custom { background: var(--surface); border: 1px dashed var(--border); border-radius: 10px; padding: 20px; text-align: center; color: var(--muted); font-size: 0.82rem; transition: all .2s; }
        .file-input-wrapper:hover .file-input-custom { border-color: var(--accent); color: var(--accent); }

        /* Toast feedback */
        .toast { position: fixed; bottom: 28px; right: 28px; z-index: 9999; background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 12px 20px; font-size: 0.82rem; font-weight: 500; color: var(--text); box-shadow: 0 8px 32px rgba(0,0,0,.4); transform: translateY(20px); opacity: 0; transition: all .3s cubic-bezier(.4, 0, .2, 1); pointer-events: none; }
        .toast.show { transform: translateY(0); opacity: 1; }
        .toast.toast-success { border-color: rgba(34,211,165,0.3); color: var(--success); }
        .toast.toast-error { border-color: rgba(239,68,68,0.3); color: #ef4444; }

        .spinner { display: none; width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.3); border-radius: 50%; border-top-color: #fff; animation: spin 0.8s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
{% endblock %}

{% block body %}
    <div class="w-narrow">
        <a href="{{ path('post_show', {id: post.id}) }}" class="back-link">← Retour au post</a>

        <div class="page-heading">
            <h1>Modifier <span>votre Post</span></h1>
            <p>Ajustez votre contenu ou utilisez l'IA pour l'améliorer.</p>
        </div>

        <div class="form-card" style="padding: 0; overflow: hidden;">
            {# ── En-tête AI Intégré ── #}
            <div class="ai-header">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span style="font-size: 1.2rem;">✨</span>
                        <div class="ai-toolbar-label" style="margin:0;">Assistant IA</div>
                    </div>
                    <div style="display: flex; gap: 10px; flex: 1; min-width: 300px;">
                        <input type="text" id="ai-topic" class="ai-topic-input" placeholder="Sujet pour régénérer (optionnel)..." style="flex: 1;">
                        <button type="button" class="btn-ai btn-ai-generate" id="btn-generate" onclick="aiGenerate()">
                            <span class="spinner" id="gen-spinner"></span>
                            🪄 Régénérer
                        </button>
                    </div>
                </div>
            </div>

            <div style="padding: 36px;">
                {{ form_start(form) }}
                    <div class="form-group">
                        {{ form_label(form.titre, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.titre, {'attr': {'class': 'form-control', 'placeholder': 'Titre du post'}}) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.categorie, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.categorie, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.contenu, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.contenu) }}
                    </div>

                    <div class="form-group">
                        <label class="form-label">Image d'illustration</label>
                        <div style="display: flex; gap: 20px; align-items: flex-start; flex-wrap: wrap;">
                            {% if post.image %}
                                <div class="current-image" style="margin-bottom:0;">
                                    <img src="/uploads/posts/{{ post.image }}" alt="Actuelle">
                                    <div style="font-size: 0.65rem; text-align: center; color: var(--muted); padding-top:4px;">Image actuelle</div>
                                </div>
                            {% endif %}
                            <div class="file-input-wrapper" style="flex:1; min-width: 200px;">
                                {{ form_widget(form.imageFile) }}
                                <div class="file-input-custom">
                                    <span>📸 Remplacer l'image</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group" style="display: flex; align-items: center; gap: 12px; margin-top: 24px; padding: 12px; background: rgba(255,255,255,0.02); border-radius: 12px; border: 1px solid var(--border);">
                        {{ form_widget(form.isAnonymous) }}
                        {{ form_label(form.isAnonymous, null, {'label_attr': {'style': 'margin:0; cursor:pointer; font-size: 0.85rem;'}}) }}
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-submit">💾 Enregistrer les modifications</button>
                        <a href="{{ path('post_show', {id: post.id}) }}" class="btn-cancel">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    {# ── Toast de feedback ── #}
    <div class="toast" id="toast"></div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.ckeditor.com/4.22.1/full-all/ckeditor.js"></script>
    <script>
        const GEN_URL = '{{ path('api_post_generate') }}';

        function showToast(msg, type = 'success') {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.className = `toast toast-${type}`;
            void t.offsetWidth;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 2800);
        }

        function setLoading(btnId, spinnerId, isLoading) {
            const btn = document.getElementById(btnId);
            const spinner = document.getElementById(spinnerId);
            if (!btn || !spinner) return;
            if (isLoading) { btn.style.opacity = '0.7'; btn.style.pointerEvents = 'none'; spinner.style.display = 'inline-block'; }
            else { btn.style.opacity = '1'; btn.style.pointerEvents = 'auto'; spinner.style.display = 'none'; }
        }

        async function aiGenerate() {
            const topicInput = document.getElementById('ai-topic');
            const titreField = document.getElementById('post_titre');
            const topic      = topicInput.value.trim() || titreField.value.trim();
            if (!topic) { showToast('⚠️ Entrez au moins un titre ou un sujet.', 'error'); return; }

            setLoading('btn-generate', 'gen-spinner', true);
            try {
                const res  = await fetch(GEN_URL, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ topic }) });
                const data = await res.json();
                if (data.error) { showToast('❌ ' + data.error, 'error'); return; }

                if (titreField) titreField.value = data.titre;
                
                if (typeof CKEDITOR !== 'undefined' && CKEDITOR.instances['post_contenu']) {
                    CKEDITOR.instances['post_contenu'].setData(data.contenu);
                } else {
                    const contenuField = document.getElementById('post_contenu');
                    if (contenuField) contenuField.value = data.contenu;
                }
                showToast('🪄 Post régénéré par l\'IA !');
            } catch (e) { showToast('❌ Erreur réseau.', 'error'); }
            finally { setLoading('btn-generate', 'gen-spinner', false); }
        }

        // Force Dark Mode even if CSS fails to load inside the iframe
        if (typeof CKEDITOR !== 'undefined') {
            CKEDITOR.on('instanceReady', function(ev) {
                const body = ev.editor.document.getBody();
                body.setStyle('background-color', '#181b30');
                body.setStyle('color', '#e2e8f0');
                body.setStyle('font-family', "'Inter', sans-serif");
            });
        }
    </script>
{% endblock %}
