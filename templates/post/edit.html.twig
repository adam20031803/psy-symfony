{# templates/post/edit.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier le post — PsyApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root { --bg: #0a0c1a; --surface: #111328; --card: #181b30; --sidebar: #0e1025; --border: rgba(255,255,255,0.06); --accent: #6c63ff; --accent2: #00d2ff; --success: #22d3a5; --warning: #f59e0b; --pink: #ec4899; --orange: #f97316; --text: #e2e8f0; --muted: #64748b; --radius: 16px; --sidebar-w: 280px; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; display: flex; flex-direction: column; }
        body::before { content: ''; position: fixed; inset: 0; background: radial-gradient(ellipse 60% 40% at 20% 10%, rgba(108,99,255,.10) 0%, transparent 70%), radial-gradient(ellipse 50% 35% at 80% 80%, rgba(0,210,255,.06) 0%, transparent 70%); pointer-events: none; z-index: 0; }
        .top-nav { position: sticky; top: 0; z-index: 100; background: rgba(14,16,37,.92); backdrop-filter: blur(18px); border-bottom: 1px solid var(--border); padding: 0 32px; height: 60px; display: flex; align-items: center; justify-content: space-between; }
        .nav-logo { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.1rem; }
        .nav-logo .icon { width: 34px; height: 34px; background: linear-gradient(135deg, var(--accent), var(--accent2)); border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: 0.95rem; }
        .nav-logo span { color: var(--accent2); } .nav-logo strong { color: var(--text); }
        .nav-actions { display: flex; align-items: center; gap: 14px; }
        .nav-user { display: flex; align-items: center; gap: 10px; background: var(--card); border: 1px solid var(--border); border-radius: 999px; padding: 5px 14px 5px 5px; }
        .nav-avatar { width: 28px; height: 28px; background: linear-gradient(135deg, var(--accent), var(--pink)); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.7rem; }
        .nav-name { font-size: 0.8rem; font-weight: 500; }
        .btn-logout { text-decoration: none; color: var(--muted); font-size: 0.78rem; font-weight: 500; padding: 6px 12px; border-radius: 8px; border: 1px solid var(--border); transition: all .2s; }
        .btn-logout:hover { color: var(--text); border-color: rgba(255,255,255,.15); background: var(--card); }
        .app-layout { display: flex; flex: 1; position: relative; z-index: 1; }
        .sidebar { width: var(--sidebar-w); min-height: calc(100vh - 60px); background: var(--sidebar); border-right: 1px solid var(--border); display: flex; flex-direction: column; padding: 24px 0; position: sticky; top: 60px; height: calc(100vh - 60px); overflow-y: auto; flex-shrink: 0; }
        .sidebar-section-label { font-size: 0.65rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); padding: 0 24px; margin-bottom: 10px; margin-top: 8px; }
        .sidebar-nav { display: flex; flex-direction: column; gap: 2px; padding: 0 12px; }
        .sidebar-link { display: flex; align-items: center; gap: 14px; padding: 12px 16px; border-radius: 12px; text-decoration: none; color: rgba(255,255,255,0.6); font-size: 0.85rem; font-weight: 500; transition: all .25s cubic-bezier(.4,0,.2,1); position: relative; overflow: hidden; }
        .sidebar-link:hover { background: rgba(108,99,255,.08); color: var(--text); transform: translateX(4px); }
        .sidebar-link.active { background: linear-gradient(135deg, rgba(108,99,255,.15), rgba(0,210,255,.08)); color: #fff; font-weight: 600; border: 1px solid rgba(108,99,255,.2); box-shadow: 0 4px 16px rgba(108,99,255,.12); animation: pulse-glow 3s ease-in-out infinite; }
        .sidebar-link.active::before { content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 3px; height: 60%; background: linear-gradient(180deg, var(--accent), var(--accent2)); border-radius: 0 4px 4px 0; }
        .sidebar-icon { width: 38px; height: 38px; border-radius: 11px; display: flex; align-items: center; justify-content: center; font-size: 1.15rem; flex-shrink: 0; transition: transform .25s; }
        .sidebar-link:hover .sidebar-icon { transform: scale(1.1); }
        .si-purple { background: rgba(108,99,255,.12); } .si-teal { background: rgba(0,210,255,.10); } .si-green { background: rgba(34,211,165,.10); } .si-pink { background: rgba(236,72,153,.10); } .si-orange { background: rgba(249,115,22,.10); } .si-blue { background: rgba(59,130,246,.10); } .si-yellow { background: rgba(245,158,11,.10); }
        .sidebar-link-text { display: flex; flex-direction: column; gap: 1px; }
        .sidebar-link-title { font-size: 0.84rem; line-height: 1.3; }
        .sidebar-link-sub { font-size: 0.68rem; color: var(--muted); font-weight: 400; }
        .sidebar-link:hover .sidebar-link-sub, .sidebar-link.active .sidebar-link-sub { color: rgba(255,255,255,.45); }
        .sidebar-badge { margin-left: auto; font-size: 0.65rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; background: rgba(108,99,255,.18); color: var(--accent); }
        .sidebar-divider { height: 1px; background: var(--border); margin: 16px 24px; }
        .sidebar-footer { margin-top: auto; padding: 20px 20px 0; }
        .sidebar-pro-card { background: linear-gradient(135deg, rgba(108,99,255,.12), rgba(0,210,255,.08)); border: 1px solid rgba(108,99,255,.18); border-radius: 14px; padding: 18px; text-align: center; }
        .sidebar-pro-card .pro-emoji { font-size: 2rem; margin-bottom: 8px; display: block; }
        .sidebar-pro-card h4 { font-size: 0.82rem; font-weight: 700; margin-bottom: 4px; background: linear-gradient(90deg, var(--accent), var(--accent2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .sidebar-pro-card p { font-size: 0.7rem; color: var(--muted); line-height: 1.4; }
        .main-content { flex: 1; padding: 36px 40px 80px; max-width: 720px; }
        .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); text-decoration: none; font-size: 0.8rem; font-weight: 500; margin-bottom: 20px; transition: color .2s; }
        .back-link:hover { color: var(--accent2); }
        .page-heading { margin-bottom: 28px; }
        .page-heading h1 { font-size: 1.4rem; font-weight: 700; margin-bottom: 4px; }
        .page-heading h1 span { background: linear-gradient(90deg, var(--warning), var(--orange)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .page-heading p { color: var(--muted); font-size: 0.82rem; }
        .form-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 32px 36px; }
        .field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }
        .field label { font-size: 0.78rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
        .field input[type="text"], .field textarea, .field select { background: var(--surface); border: 1px solid var(--border); color: var(--text); border-radius: 10px; padding: 11px 14px; font-family: 'Inter', sans-serif; font-size: 0.85rem; outline: none; transition: border-color .2s, box-shadow .2s; width: 100%; }
        .field input[type="text"]:focus, .field textarea:focus, .field select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(108,99,255,.15); }
        .field textarea { resize: vertical; min-height: 140px; }
        .field input[type="file"] { background: var(--surface); border: 1px dashed rgba(255,255,255,.12); border-radius: 10px; padding: 11px 14px; color: var(--muted); font-size: 0.8rem; width: 100%; cursor: pointer; }
        .field input[type="file"]:hover { border-color: var(--accent); }
        .field-check { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
        .field-check input[type="checkbox"] { width: 16px; height: 16px; accent-color: var(--accent); cursor: pointer; }
        .field-check label { font-size: 0.84rem; color: var(--text); cursor: pointer; }
        .form-error { color: #ef4444; font-size: 0.75rem; margin-top: 2px; }

        /* Current image preview */
        .current-image-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-bottom: 20px; }
        .current-image-label { font-size: 0.72rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; padding: 10px 14px; background: rgba(255,255,255,.02); border-bottom: 1px solid var(--border); }
        .current-image-card img { width: 100%; max-height: 200px; object-fit: cover; display: block; }

        .btn-submit { width: 100%; padding: 12px; border: none; border-radius: 11px; cursor: pointer; font-family: 'Inter', sans-serif; font-size: 0.88rem; font-weight: 700; background: linear-gradient(135deg, var(--warning), var(--orange)); color: #fff; transition: opacity .2s; box-shadow: 0 4px 18px rgba(245,158,11,.25); margin-top: 4px; }
        .btn-submit:hover { opacity: .88; }
        @media (max-width: 900px) { .sidebar { display: none; } .main-content { padding: 24px 16px 60px; } }
        @keyframes pulse-glow { 0%, 100% { box-shadow: 0 0 0 0 rgba(108,99,255,.15); } 50% { box-shadow: 0 0 18px 4px rgba(108,99,255,.12); } }
    </style>
</head>
<body>

<nav class="top-nav">
    <div class="nav-logo"><div class="icon">🧠</div><div><strong>Psy</strong><span>App</span></div></div>
    <div class="nav-actions">
        {% if app.user %}
        <div class="nav-user">
            <div class="nav-avatar">{{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}</div>
            <span class="nav-name">{{ app.user.prenom }} {{ app.user.nom }}</span>
        </div>
        {% endif %}
        <a href="{{ path('app_logout') }}" class="btn-logout">🚪 Déconnexion</a>
    </div>
</nav>

<div class="app-layout">
    <aside class="sidebar">
        <div class="sidebar-section-label">🏠 Tableau de bord</div>
        <div class="sidebar-nav"><a href="{{ path('app_dashboard') }}" class="sidebar-link"><div class="sidebar-icon si-blue">📊</div><div class="sidebar-link-text"><span class="sidebar-link-title">Dashboard</span><span class="sidebar-link-sub">Vue d'ensemble</span></div></a></div>
        <div class="sidebar-divider"></div>
        <div class="sidebar-section-label">⚙️ Gestion</div>
        <div class="sidebar-nav">
            <a href="{{ path('app_challenge_index') }}" class="sidebar-link"><div class="sidebar-icon si-purple">🔥</div><div class="sidebar-link-text"><span class="sidebar-link-title">Motivation</span><span class="sidebar-link-sub">Challenges & objectifs</span></div><span class="sidebar-badge">PRO</span></a>
            <a href="#" class="sidebar-link"><div class="sidebar-icon si-green">🔄</div><div class="sidebar-link-text"><span class="sidebar-link-title">Habitudes</span><span class="sidebar-link-sub">Suivi quotidien</span></div></a>
            <a href="#" class="sidebar-link"><div class="sidebar-icon si-orange">🏋️</div><div class="sidebar-link-text"><span class="sidebar-link-title">Fitness</span><span class="sidebar-link-sub">Workouts & plans</span></div></a>
            <a href="{{ path('post_index') }}" class="sidebar-link active"><div class="sidebar-icon si-pink">💬</div><div class="sidebar-link-text"><span class="sidebar-link-title">Posts</span><span class="sidebar-link-sub">Communauté & partage</span></div></a>
            <a href="#" class="sidebar-link"><div class="sidebar-icon si-teal">🧠</div><div class="sidebar-link-text"><span class="sidebar-link-title">Mentalité</span><span class="sidebar-link-sub">Journal & bien-être</span></div></a>
        </div>
        <div class="sidebar-divider"></div>
        <div class="sidebar-section-label">📋 Support</div>
        <div class="sidebar-nav"><a href="{{ path('app_reclamation_index') }}" class="sidebar-link"><div class="sidebar-icon si-yellow">📬</div><div class="sidebar-link-text"><span class="sidebar-link-title">Réclamations</span><span class="sidebar-link-sub">Mes demandes</span></div></a></div>
        <div class="sidebar-footer"><div class="sidebar-pro-card"><span class="pro-emoji">🌟</span><h4>PsyApp Pro</h4><p>Votre bien-être mental est notre priorité quotidienne.</p></div></div>
    </aside>

    <div class="main-content">
        <a href="{{ path('post_show', {id: post.id}) }}" class="back-link">← Retour au post</a>

        <div class="page-heading">
            <h1>✏️ <span>Modifier le post</span></h1>
            <p>Apportez vos modifications ci-dessous</p>
        </div>

        <div class="form-card">
            {{ form_start(form, {attr: {enctype: 'multipart/form-data', novalidate: 'novalidate'}}) }}

                <div class="field">
                    <label for="{{ form.titre.vars.id }}">Titre</label>
                    {{ form_widget(form.titre) }}
                    {{ form_errors(form.titre) }}
                </div>

                <div class="field">
                    <label for="{{ form.contenu.vars.id }}">Contenu</label>
                    {{ form_widget(form.contenu) }}
                    {{ form_errors(form.contenu) }}
                </div>

                <div class="field">
                    <label for="{{ form.categorie.vars.id }}">Catégorie</label>
                    {{ form_widget(form.categorie) }}
                    {{ form_errors(form.categorie) }}
                </div>

                {% if post.image %}
                <div class="current-image-card">
                    <div class="current-image-label">📎 Image actuelle</div>
                    <img src="/uploads/posts/{{ post.image }}" alt="Image actuelle">
                </div>
                {% endif %}

                <div class="field">
                    <label for="{{ form.imageFile.vars.id }}">Remplacer l'image (optionnel)</label>
                    {{ form_widget(form.imageFile) }}
                    {{ form_errors(form.imageFile) }}
                </div>

                <div class="field-check">
                    {{ form_widget(form.isAnonymous) }}
                    <label for="{{ form.isAnonymous.vars.id }}">Poster anonymement</label>
                </div>

                <button type="submit" class="btn-submit">💾 Enregistrer les modifications</button>

            {{ form_end(form) }}
        </div>
    </div>
</div>

</body>
</html>
