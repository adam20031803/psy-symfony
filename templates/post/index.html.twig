{% extends 'base.html.twig' %}

{% block title %}Forum & Posts — Atomic You{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .page-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; }
        .page-header h1 { font-size: 1.8rem; font-weight: 800; }
        .page-header h1 span { background: linear-gradient(90deg, var(--accent), var(--accent2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        .btn-primary {
            background: var(--accent); color: #fff; padding: 12px 24px; border-radius: 12px;
            text-decoration: none; font-weight: 700; font-size: 0.85rem; transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(108,99,255,0.3);
        }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(108,99,255,0.4); }

        .filter-bar { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 20px; display: flex; gap: 12px; margin-bottom: 30px; }
        .filter-bar input, .filter-bar select { background: var(--surface); border: 1px solid var(--border); color: #fff; padding: 10px 15px; border-radius: 10px; font-size: 0.85rem; outline: none; }
        .filter-bar input { flex: 1; }
        .btn-filter { background: rgba(255,255,255,0.05); color: #fff; border: 1px solid var(--border); padding: 10px 20px; border-radius: 10px; cursor: pointer; transition: 0.2s; }
        .btn-filter:hover { background: var(--card); border-color: var(--accent); }

        .posts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; }
        .post-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; transition: 0.3s; position: relative; }
        .post-card:hover { transform: translateY(-5px); border-color: rgba(108,99,255,0.3); }
        .post-card-img { width: 100%; height: 180px; object-fit: cover; border-bottom: 1px solid var(--border); }
        .post-card-body { padding: 20px; }
        .post-badge { background: rgba(108,99,255,0.15); color: var(--accent); padding: 4px 12px; border-radius: 99px; font-size: 0.75rem; font-weight: 700; margin-bottom: 12px; display: inline-block; }
        .post-card h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 10px; color: #fff; }
        .post-card p { font-size: 0.85rem; color: var(--muted); line-height: 1.6; margin-bottom: 20px; }
        .post-footer { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding: 15px 20px; font-size: 0.75rem; color: var(--muted); }
        .post-stats { display: flex; gap: 12px; align-items: center; }
        .stat-item { display: flex; align-items: center; gap: 4px; }

        /* Pagination Styling */
        .pagination-custom .pagination { display: flex; list-style: none; gap: 8px; align-items: center; }
        .pagination-custom .page-item { border-radius: 8px; overflow: hidden; border: 1px solid var(--border); background: var(--card); transition: 0.2s; }
        .pagination-custom .page-link { display: block; padding: 8px 14px; color: var(--text); text-decoration: none; font-size: 0.85rem; font-weight: 500; }
        .pagination-custom .active { background: var(--accent); border-color: var(--accent); }
        .pagination-custom .active .page-link { color: #fff; font-weight: 700; }
        .pagination-custom .page-item:not(.active):hover { border-color: var(--accent); background: rgba(108,99,255,0.1); }
        .pagination-custom .disabled .page-link { opacity: 0.5; cursor: not-allowed; }
    </style>
{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>🗨️ <span>Forum</span> Community</h1>
            <p>Échangez, partagez et progressez ensemble</p>
        </div>
        {% if app.user %}
            <a href="{{ path('post_new') }}" class="btn-primary">✨ Nouveau Post</a>
        {% endif %}
    </div>

    <form method="get" action="{{ path('post_index') }}" class="filter-bar">
        <input type="text" name="q" value="{{ search ?? '' }}" placeholder="Rechercher un sujet...">
        <select name="categorie">
            <option value="">Toutes les catégories</option>
            {% for cat in categories %}
                <option value="{{ cat.id }}" {{ selectedCategorie == cat.id ? 'selected' }}>{{ cat.nom }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="btn-filter">Filtrer</button>
    </form>

    {% if posts|length == 0 %}
        <div class="empty-state" style="text-align: center; padding: 60px; background: var(--card); border-radius: var(--radius); border: 1px dashed var(--border);">
            <p>Aucun post trouvé. Soyez le premier à contribuer !</p>
        </div>
    {% else %}
        <div class="posts-grid">
            {% for post in posts %}
                <div class="post-card">
                    {% if post.image %}
                        <img src="/uploads/posts/{{ post.image }}" class="post-card-img" alt="{{ post.titre }}">
                    {% endif %}
                    <div class="post-card-body">
                        {% if post.categorie %}
                            <span class="post-badge">{{ post.categorie.nom }}</span>
                        {% endif %}
                        <h3>{{ post.titre }}</h3>
                        <p>{{ post.contenu|striptags|slice(0, 150) }}...</p>
                    </div>
                    <div class="post-footer">
                        <div class="post-author">
                            Par <strong>{{ post.isAnonymous ? 'Anonyme' : (post.user ? post.user.prenom ~ ' ' ~ post.user.nom : 'Utilisateur') }}</strong>
                        </div>
                        <div class="post-stats">
                            <span class="stat-item">👍 {{ post.countLikes }}</span>
                            <span class="stat-item">💬 {{ post.commentaires|length }}</span>
                            <a href="{{ path('post_show', {id: post.id}) }}" style="color: var(--accent); font-weight: 700; text-decoration: none;">Voir plus</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="pagination-wrapper" style="margin-top: 40px; display: flex; justify-content: center; gap: 10px;">
            {% if currentPage > 1 %}
                <a href="{{ path('post_index', app.request.query.all|merge({'page': currentPage - 1})) }}" class="btn-filter">Précédent</a>
            {% endif %}

            {% for p in 1..totalPages %}
                {% if p == currentPage %}
                    <span class="btn-filter active" style="background: var(--accent); border-color: var(--accent);">{{ p }}</span>
                {% else %}
                    <a href="{{ path('post_index', app.request.query.all|merge({'page': p})) }}" class="btn-filter">{{ p }}</a>
                {% endif %}
            {% endfor %}

            {% if currentPage < totalPages %}
                <a href="{{ path('post_index', app.request.query.all|merge({'page': currentPage + 1})) }}" class="btn-filter">Suivant</a>
            {% endif %}
        </div>
    {% endif %}

    <div id="toast-container" style="position: fixed; bottom: 24px; right: 24px; z-index: 1000;"></div>
{% endblock %}

{% block javascripts %}
    <script>
        function showToast(message) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.style.cssText = 'background: rgba(24,27,48,0.9); backdrop-filter: blur(10px); border: 1px solid var(--accent); color: #fff; padding: 12px 24px; border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); margin-top: 10px; animation: slideIn 0.3s ease;';
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
        }
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                showToast("{{ message|e('js') }}");
            {% endfor %}
        {% endfor %}
    </script>
{% endblock %}
