{# templates/post/index.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forum & Posts — PsyApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg:       #0a0c1a;
            --surface:  #111328;
            --card:     #181b30;
            --sidebar:  #0e1025;
            --border:   rgba(255,255,255,0.06);
            --accent:   #6c63ff;
            --accent2:  #00d2ff;
            --success:  #22d3a5;
            --warning:  #f59e0b;
            --pink:     #ec4899;
            --orange:   #f97316;
            --text:     #e2e8f0;
            --muted:    #64748b;
            --radius:   16px;
            --sidebar-w: 280px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse 60% 40% at 20% 10%, rgba(108,99,255,.10) 0%, transparent 70%),
                radial-gradient(ellipse 50% 35% at 80% 80%, rgba(0,210,255,.06) 0%, transparent 70%);
            pointer-events: none;
            z-index: 0;
        }

        /* ── Navbar ── */
        .top-nav {
            position: sticky; top: 0; z-index: 100;
            background: rgba(14,16,37,.92);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid var(--border);
            padding: 0 32px; height: 60px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .nav-logo { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.1rem; }
        .nav-logo .icon {
            width: 34px; height: 34px;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: 0.95rem;
        }
        .nav-logo span { color: var(--accent2); }
        .nav-logo strong { color: var(--text); }
        .nav-actions { display: flex; align-items: center; gap: 14px; }
        .nav-user {
            display: flex; align-items: center; gap: 10px;
            background: var(--card); border: 1px solid var(--border);
            border-radius: 999px; padding: 5px 14px 5px 5px;
        }
        .nav-avatar {
            width: 28px; height: 28px;
            background: linear-gradient(135deg, var(--accent), var(--pink));
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 0.7rem;
        }
        .nav-name { font-size: 0.8rem; font-weight: 500; }
        .btn-logout {
            text-decoration: none; color: var(--muted); font-size: 0.78rem; font-weight: 500;
            padding: 6px 12px; border-radius: 8px; border: 1px solid var(--border); transition: all .2s;
        }
        .btn-logout:hover { color: var(--text); border-color: rgba(255,255,255,.15); background: var(--card); }

        /* ── Layout ── */
        .app-layout { display: flex; flex: 1; position: relative; z-index: 1; }

        /* ── Sidebar ── */
        .sidebar {
            width: var(--sidebar-w); min-height: calc(100vh - 60px);
            background: var(--sidebar); border-right: 1px solid var(--border);
            display: flex; flex-direction: column; padding: 24px 0;
            position: sticky; top: 60px; height: calc(100vh - 60px);
            overflow-y: auto; flex-shrink: 0;
        }
        .sidebar-section-label {
            font-size: 0.65rem; font-weight: 700; letter-spacing: .12em;
            text-transform: uppercase; color: var(--muted);
            padding: 0 24px; margin-bottom: 10px; margin-top: 8px;
        }
        .sidebar-nav { display: flex; flex-direction: column; gap: 2px; padding: 0 12px; }
        .sidebar-link {
            display: flex; align-items: center; gap: 14px; padding: 12px 16px;
            border-radius: 12px; text-decoration: none; color: rgba(255,255,255,0.6);
            font-size: 0.85rem; font-weight: 500;
            transition: all .25s cubic-bezier(.4,0,.2,1);
            position: relative; overflow: hidden;
        }
        .sidebar-link:hover { background: rgba(108,99,255,.08); color: var(--text); transform: translateX(4px); }
        .sidebar-link.active {
            background: linear-gradient(135deg, rgba(108,99,255,.15), rgba(0,210,255,.08));
            color: #fff; font-weight: 600;
            border: 1px solid rgba(108,99,255,.2);
            box-shadow: 0 4px 16px rgba(108,99,255,.12);
            animation: pulse-glow 3s ease-in-out infinite;
        }
        .sidebar-link.active::before {
            content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
            width: 3px; height: 60%;
            background: linear-gradient(180deg, var(--accent), var(--accent2));
            border-radius: 0 4px 4px 0;
        }
        .sidebar-icon {
            width: 38px; height: 38px; border-radius: 11px; display: flex;
            align-items: center; justify-content: center; font-size: 1.15rem;
            flex-shrink: 0; transition: transform .25s;
        }
        .sidebar-link:hover .sidebar-icon { transform: scale(1.1); }
        .si-purple { background: rgba(108,99,255,.12); }
        .si-teal   { background: rgba(0,210,255,.10); }
        .si-green  { background: rgba(34,211,165,.10); }
        .si-pink   { background: rgba(236,72,153,.10); }
        .si-orange { background: rgba(249,115,22,.10); }
        .si-blue   { background: rgba(59,130,246,.10); }
        .si-yellow { background: rgba(245,158,11,.10); }
        .sidebar-link-text { display: flex; flex-direction: column; gap: 1px; }
        .sidebar-link-title { font-size: 0.84rem; line-height: 1.3; }
        .sidebar-link-sub { font-size: 0.68rem; color: var(--muted); font-weight: 400; }
        .sidebar-link:hover .sidebar-link-sub,
        .sidebar-link.active .sidebar-link-sub { color: rgba(255,255,255,.45); }
        .sidebar-badge {
            margin-left: auto; font-size: 0.65rem; font-weight: 700;
            padding: 2px 8px; border-radius: 999px;
            background: rgba(108,99,255,.18); color: var(--accent); letter-spacing: .02em;
        }
        .sidebar-divider { height: 1px; background: var(--border); margin: 16px 24px; }
        .sidebar-footer { margin-top: auto; padding: 20px 20px 0; }
        .sidebar-pro-card {
            background: linear-gradient(135deg, rgba(108,99,255,.12), rgba(0,210,255,.08));
            border: 1px solid rgba(108,99,255,.18); border-radius: 14px;
            padding: 18px; text-align: center;
        }
        .sidebar-pro-card .pro-emoji { font-size: 2rem; margin-bottom: 8px; display: block; }
        .sidebar-pro-card h4 {
            font-size: 0.82rem; font-weight: 700; margin-bottom: 4px;
            background: linear-gradient(90deg, var(--accent), var(--accent2));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .sidebar-pro-card p { font-size: 0.7rem; color: var(--muted); line-height: 1.4; }

        /* ── Main ── */
        .main-content { flex: 1; padding: 36px 40px 80px; max-width: 1100px; }

        /* ── Page header ── */
        .page-header {
            background: linear-gradient(135deg, rgba(108,99,255,.12), rgba(0,210,255,.06));
            border: 1px solid rgba(108,99,255,.18);
            border-radius: var(--radius); padding: 28px 32px;
            margin-bottom: 28px;
            display: flex; align-items: center; justify-content: space-between; gap: 20px;
        }
        .page-header-text h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 4px; }
        .page-header-text h1 span {
            background: linear-gradient(90deg, var(--accent), var(--accent2));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .page-header-text p { color: var(--muted); font-size: 0.82rem; }
        .btn-primary {
            display: inline-flex; align-items: center; gap: 8px;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            color: #fff; font-size: 0.82rem; font-weight: 600;
            padding: 9px 18px; border-radius: 10px; border: none;
            text-decoration: none; cursor: pointer; transition: opacity .2s;
            box-shadow: 0 3px 14px rgba(108,99,255,.3); white-space: nowrap;
        }
        .btn-primary:hover { opacity: .88; }

        /* ── Filter bar ── */
        .filter-bar {
            background: var(--card); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 16px 20px;
            display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
            margin-bottom: 24px;
        }
        .filter-bar input, .filter-bar select {
            background: var(--surface); border: 1px solid var(--border);
            color: var(--text); border-radius: 10px; padding: 9px 14px;
            font-family: 'Inter', sans-serif; font-size: 0.82rem;
            outline: none; transition: border-color .2s;
        }
        .filter-bar input { flex: 1; min-width: 180px; }
        .filter-bar input::placeholder { color: var(--muted); }
        .filter-bar input:focus, .filter-bar select:focus { border-color: var(--accent); }
        .filter-bar select { min-width: 180px; }
        .btn-filter {
            background: var(--surface); border: 1px solid var(--border);
            color: var(--text); font-size: 0.82rem; font-weight: 600;
            padding: 9px 18px; border-radius: 10px; cursor: pointer;
            font-family: 'Inter', sans-serif; transition: all .2s;
        }
        .btn-filter:hover { border-color: var(--accent); color: var(--accent); }

        /* ── Flash messages ── */
        .flash { padding: 12px 18px; border-radius: 10px; font-size: 0.82rem; font-weight: 500; margin-bottom: 16px; }
        .flash-success { background: rgba(34,211,165,.12); border: 1px solid rgba(34,211,165,.3); color: var(--success); }
        .flash-error   { background: rgba(231,76,60,.12);  border: 1px solid rgba(231,76,60,.3);  color: #ef4444; }

        /* ── Posts grid ── */
        .posts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 18px;
        }

        /* ── Post card ── */
        .post-card {
            background: var(--card); border: 1px solid var(--border);
            border-radius: var(--radius); overflow: hidden;
            display: flex; flex-direction: column;
            transition: transform .2s, box-shadow .2s, border-color .2s;
        }
        .post-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(0,0,0,.35);
            border-color: rgba(108,99,255,.25);
        }
        .post-card-img { width: 100%; height: 160px; object-fit: cover; }
        .post-card-img-placeholder {
            width: 100%; height: 160px;
            background: var(--surface); display: flex; align-items: center;
            justify-content: center; font-size: 2.5rem; color: var(--muted);
        }
        .post-card-body { padding: 18px; flex: 1; display: flex; flex-direction: column; gap: 10px; }
        .post-badge {
            display: inline-flex; align-items: center; gap: 5px;
            background: rgba(108,99,255,.12); color: var(--accent);
            border: 1px solid rgba(108,99,255,.2); font-size: 0.68rem;
            font-weight: 600; padding: 3px 10px; border-radius: 999px;
            align-self: flex-start;
        }
        .post-card h3 { font-size: 0.92rem; font-weight: 600; line-height: 1.4; }
        .post-card p  { font-size: 0.78rem; color: var(--muted); line-height: 1.55; flex: 1; }
        .post-meta {
            display: flex; align-items: center; justify-content: space-between;
            font-size: 0.7rem; color: var(--muted);
            padding-top: 10px; border-top: 1px solid var(--border);
            margin-bottom: 4px;
        }
        .post-stats {
            display: flex; align-items: center; gap: 12px;
            font-size: 0.72rem; color: var(--muted);
            margin-top: 2px;
        }
        .post-stats span { display: flex; align-items: center; gap: 4px; }
        .post-stats .stat-icon { font-size: 0.85rem; }
        .post-card-actions { display: flex; gap: 8px; flex-wrap: wrap; padding: 0 18px 18px; }

        /* ── Card buttons ── */
        .btn-see {
            flex: 1; display: inline-flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            color: #fff; font-size: 0.75rem; font-weight: 600;
            padding: 7px 14px; border-radius: 8px; text-decoration: none;
            transition: opacity .2s;
        }
        .btn-see:hover { opacity: .85; }
        .btn-edit {
            display: inline-flex; align-items: center; gap: 4px;
            background: rgba(245,158,11,.12); color: var(--warning);
            border: 1px solid rgba(245,158,11,.25); font-size: 0.75rem; font-weight: 600;
            padding: 7px 12px; border-radius: 8px; text-decoration: none; transition: all .2s;
        }
        .btn-edit:hover { background: rgba(245,158,11,.22); }
        .btn-delete {
            display: inline-flex; align-items: center; gap: 4px;
            background: rgba(239,68,68,.1); color: #ef4444;
            border: 1px solid rgba(239,68,68,.25); font-size: 0.75rem; font-weight: 600;
            padding: 7px 12px; border-radius: 8px; cursor: pointer;
            font-family: 'Inter', sans-serif; transition: all .2s;
        }
        .btn-delete:hover { background: rgba(239,68,68,.2); }

        /* ── Empty state ── */
        .empty-state {
            text-align: center; padding: 60px 24px;
            background: var(--card); border: 1px solid var(--border);
            border-radius: var(--radius);
        }
        .empty-state .icon { font-size: 3rem; margin-bottom: 14px; display: block; }
        .empty-state p { color: var(--muted); font-size: 0.88rem; }

        /* ── Responsive ── */
        @media (max-width: 900px) {
            .sidebar { display: none; }
            .main-content { padding: 24px 16px 60px; }
        }

        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(108,99,255,.15); }
            50% { box-shadow: 0 0 18px 4px rgba(108,99,255,.12); }
        }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="top-nav">
    <div class="nav-logo">
        <div class="icon">🧠</div>
        <div><strong>Psy</strong><span>App</span></div>
    </div>
    <div class="nav-actions">
        {% if app.user %}
        <div class="nav-user">
            <div class="nav-avatar">{{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}</div>
            <span class="nav-name">{{ app.user.prenom }} {{ app.user.nom }}</span>
        </div>
        {% endif %}
        <a href="{{ path('app_logout') }}" class="btn-logout">🚪 Déconnexion</a>
    </div>
</nav>

<div class="app-layout">

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-section-label">🏠 Tableau de bord</div>
        <div class="sidebar-nav">
            <a href="{{ path('app_dashboard') }}" class="sidebar-link">
                <div class="sidebar-icon si-blue">📊</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Dashboard</span>
                    <span class="sidebar-link-sub">Vue d'ensemble</span>
                </div>
            </a>
        </div>

        <div class="sidebar-divider"></div>

        <div class="sidebar-section-label">⚙️ Gestion</div>
        <div class="sidebar-nav">
            <a href="{{ path('app_challenge_index') }}" class="sidebar-link">
                <div class="sidebar-icon si-purple">🔥</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Motivation</span>
                    <span class="sidebar-link-sub">Challenges & objectifs</span>
                </div>
                <span class="sidebar-badge">PRO</span>
            </a>

            <a href="#" class="sidebar-link">
                <div class="sidebar-icon si-green">🔄</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Habitudes</span>
                    <span class="sidebar-link-sub">Suivi quotidien</span>
                </div>
            </a>

            <a href="#" class="sidebar-link">
                <div class="sidebar-icon si-orange">🏋️</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Fitness</span>
                    <span class="sidebar-link-sub">Workouts & plans</span>
                </div>
            </a>

            <a href="{{ path('post_index') }}" class="sidebar-link active">
                <div class="sidebar-icon si-pink">💬</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Posts</span>
                    <span class="sidebar-link-sub">Communauté & partage</span>
                </div>
            </a>

            <a href="#" class="sidebar-link">
                <div class="sidebar-icon si-teal">🧠</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Mentalité</span>
                    <span class="sidebar-link-sub">Journal & bien-être</span>
                </div>
            </a>
        </div>

        <div class="sidebar-divider"></div>

        <div class="sidebar-section-label">📋 Support</div>
        <div class="sidebar-nav">
            <a href="{{ path('app_reclamation_index') }}" class="sidebar-link">
                <div class="sidebar-icon si-yellow">📬</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Réclamations</span>
                    <span class="sidebar-link-sub">Mes demandes</span>
                </div>
            </a>
        </div>

        <div class="sidebar-footer">
            <div class="sidebar-pro-card">
                <span class="pro-emoji">🌟</span>
                <h4>PsyApp Pro</h4>
                <p>Votre bien-être mental est notre priorité quotidienne.</p>
            </div>
        </div>
    </aside>

    <!-- Main content -->
    <div class="main-content">

        <!-- Flash messages -->
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash flash-{{ type }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <!-- Page header -->
        <div class="page-header">
            <div class="page-header-text">
                <h1>💬 Forum & <span>Posts</span></h1>
                <p>Partagez vos idées et échangez avec la communauté PsyApp</p>
            </div>
            {% if app.user %}
                <a href="{{ path('post_new') }}" class="btn-primary">✏️ Nouveau Post</a>
            {% endif %}
        </div>

        <!-- Filter bar -->
        <form method="get" action="{{ path('post_index') }}" class="filter-bar">
            <input type="text" name="q" value="{{ search ?? '' }}" placeholder="🔍 Rechercher un post…">
            <select name="categorie">
                <option value="">Toutes les catégories</option>
                {% for cat in categories %}
                    <option value="{{ cat.id }}" {{ selectedCategorie == cat.id ? 'selected' }}>
                        {{ cat.icon ? cat.icon ~ ' ' }}{{ cat.nom }}
                    </option>
                {% endfor %}
            </select>
            <button type="submit" class="btn-filter">Filtrer</button>
        </form>

        <!-- Posts grid -->
        {% if posts is empty %}
            <div class="empty-state">
                <span class="icon">🗒️</span>
                <p>Aucun post trouvé. Soyez le premier à publier !</p>
            </div>
        {% else %}
            <div class="posts-grid">
                {% for post in posts %}
                <div class="post-card">
                    {% if post.image %}
                        <img src="/uploads/posts/{{ post.image }}" alt="{{ post.titre }}" class="post-card-img">
                    {% else %}
                        <div class="post-card-img-placeholder">🖼️</div>
                    {% endif %}

                    <div class="post-card-body">
                        {% if post.categorie %}
                            <span class="post-badge">{{ post.categorie.icon ? post.categorie.icon ~ ' ' }}{{ post.categorie.nom }}</span>
                        {% endif %}

                        <h3>{{ post.titre|slice(0, 65) }}{% if post.titre|length > 65 %}…{% endif %}</h3>
                        <p>{{ post.contenu|striptags|slice(0, 120) }}{% if post.contenu|length > 120 %}…{% endif %}</p>

                        <div class="post-meta">
                            <span>👤
                                {% if post.isAnonymous %}<em>Anonyme</em>
                                {% else %}{{ post.user.prenom }} {{ post.user.nom }}
                                {% endif %}
                            </span>
                            <span>{{ post.createdAt|date('d/m/Y') }}</span>
                        </div>

                        <div class="post-stats">
                            <span><span class="stat-icon">👍</span> {{ post.countLikes }}</span>
                            <span><span class="stat-icon">👎</span> {{ post.countDislikes }}</span>
                            <span><span class="stat-icon">🔁</span> {{ post.countShares }}</span>
                            <span><span class="stat-icon">💬</span> {{ post.commentaires|length }}</span>
                        </div>
                    </div>

                    <div class="post-card-actions">
                        <a href="{{ path('post_show', {id: post.id}) }}" class="btn-see">👁 Voir</a>

                        {% if app.user and app.user == post.user %}
                            <a href="{{ path('post_edit', {id: post.id}) }}" class="btn-edit">✏️ Modifier</a>
                            <form method="post" action="{{ path('post_delete', {id: post.id}) }}"
                                  onsubmit="return confirm('Supprimer ce post ?')" style="display:contents">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete'~post.id) }}">
                                <button type="submit" class="btn-delete">🗑️</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</div>

</body>
</html>
