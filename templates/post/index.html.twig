{% extends 'base.html.twig' %}

{% block title %}Forum & Posts — Atomic You{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* ── Page header ── */
        .page-header {
            background: linear-gradient(135deg, rgba(108,99,255,.12), rgba(0,210,255,.06));
            border: 1px solid rgba(108,99,255,.18);
            border-radius: var(--radius); padding: 28px 32px;
            margin-bottom: 28px;
            display: flex; align-items: center; justify-content: space-between; gap: 20px;
        }
        .page-header-text h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 4px; }
        .page-header-text h1 span {
            background: linear-gradient(90deg, var(--accent), var(--accent2));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .page-header-text p { color: var(--muted); font-size: 0.82rem; }
        .btn-primary {
            display: inline-flex; align-items: center; gap: 8px;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            color: #fff; font-size: 0.82rem; font-weight: 600;
            padding: 9px 18px; border-radius: 10px; border: none;
            text-decoration: none; cursor: pointer; transition: opacity .2s;
            box-shadow: 0 3px 14px rgba(108,99,255,.3); white-space: nowrap;
        }
        .btn-primary:hover { opacity: .88; }

        /* ── Filter bar ── */
        .filter-bar {
            background: var(--card); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 16px 20px;
            display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
            margin-bottom: 24px;
        }
        .filter-bar input, .filter-bar select {
            background: var(--surface); border: 1px solid var(--border);
            color: var(--text); border-radius: 10px; padding: 9px 14px;
            font-family: 'Inter', sans-serif; font-size: 0.82rem;
            outline: none; transition: border-color .2s;
        }
        .filter-bar input { flex: 1; min-width: 180px; }
        .filter-bar input::placeholder { color: var(--muted); }
        .filter-bar input:focus, .filter-bar select:focus { border-color: var(--accent); }
        .filter-bar select { min-width: 180px; }
        .btn-filter {
            background: var(--surface); border: 1px solid var(--border);
            color: var(--text); font-size: 0.82rem; font-weight: 600;
            padding: 9px 18px; border-radius: 10px; cursor: pointer;
            font-family: 'Inter', sans-serif; transition: all .2s;
        }
        .btn-filter:hover { border-color: var(--accent); color: var(--accent); }

        /* ── Flash messages ── */
        .flash { padding: 12px 18px; border-radius: 10px; font-size: 0.82rem; font-weight: 500; margin-bottom: 16px; }
        .flash-success { background: rgba(34,211,165,.12); border: 1px solid rgba(34,211,165,.3); color: var(--success); }
        .flash-error   { background: rgba(231,76,60,.12);  border: 1px solid rgba(231,76,60,.3);  color: #ef4444; }

        /* ── Posts grid ── */
        .posts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 18px;
        }

        /* ── Post card ── */
        .post-card {
            background: var(--card); border: 1px solid var(--border);
            border-radius: var(--radius); overflow: hidden;
            display: flex; flex-direction: column;
            transition: transform .2s, box-shadow .2s, border-color .2s;
        }
        .post-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(0,0,0,.35);
            border-color: rgba(108,99,255,.25);
        }
        .post-card-img { width: 100%; height: 160px; object-fit: cover; }
        .post-card-img-placeholder {
            width: 100%; height: 160px;
            background: var(--surface); display: flex; align-items: center;
            justify-content: center; font-size: 2.5rem; color: var(--muted);
        }
        .post-card-body { padding: 18px; flex: 1; display: flex; flex-direction: column; gap: 10px; }
        .post-badge {
            display: inline-flex; align-items: center; gap: 5px;
            background: rgba(108,99,255,.12); color: var(--accent);
            border: 1px solid rgba(108,99,255,.2); font-size: 0.68rem;
            font-weight: 600; padding: 3px 10px; border-radius: 999px;
            align-self: flex-start;
        }
        .post-card h3 { font-size: 0.92rem; font-weight: 600; line-height: 1.4; }
        .post-card p  { font-size: 0.78rem; color: var(--muted); line-height: 1.55; flex: 1; }
        .post-meta {
            display: flex; align-items: center; justify-content: space-between;
            font-size: 0.7rem; color: var(--muted);
            padding-top: 10px; border-top: 1px solid var(--border);
            margin-bottom: 4px;
        }
        .post-stats {
            display: flex; align-items: center; gap: 12px;
            font-size: 0.72rem; color: var(--muted);
            margin-top: 2px;
        }
        .post-stats span { display: flex; align-items: center; gap: 4px; }
        .post-stats .stat-icon { font-size: 0.85rem; }
        .post-card-actions { display: flex; gap: 8px; flex-wrap: wrap; padding: 0 18px 18px; }

        /* ── Card buttons ── */
        .btn-see {
            flex: 1; display: inline-flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            color: #fff; font-size: 0.75rem; font-weight: 600;
            padding: 7px 14px; border-radius: 8px; text-decoration: none;
            transition: opacity .2s;
        }
        .btn-see:hover { opacity: .85; }
        .btn-edit {
            display: inline-flex; align-items: center; gap: 4px;
            background: rgba(245,158,11,.12); color: var(--warning);
            border: 1px solid rgba(245,158,11,.25); font-size: 0.75rem; font-weight: 600;
            padding: 7px 12px; border-radius: 8px; text-decoration: none; transition: all .2s;
        }
        .btn-edit:hover { background: rgba(245,158,11,.22); }
        .btn-delete {
            display: inline-flex; align-items: center; gap: 4px;
            background: rgba(239,68,68,.1); color: #ef4444;
            border: 1px solid rgba(239,68,68,.25); font-size: 0.75rem; font-weight: 600;
            padding: 7px 12px; border-radius: 8px; cursor: pointer;
            font-family: 'Inter', sans-serif; transition: all .2s;
        }
        .btn-delete:hover { background: rgba(239,68,68,.2); }

        /* ── Empty state ── */
        .empty-state {
            text-align: center; padding: 60px 24px;
            background: var(--card); border: 1px solid var(--border);
            border-radius: var(--radius);
        }
        .empty-state .icon { font-size: 3rem; margin-bottom: 14px; display: block; }
        .empty-state p { color: var(--muted); font-size: 0.88rem; }

    </style>
{% endblock %}

{% block body %}
    <div class="w-wide">
        <!-- Flash messages -->
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash flash-{{ type }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <!-- Page header -->
        <div class="page-header">
            <div class="page-header-text">
                <h1>💬 Forum & <span>Posts</span></h1>
                <p>Partagez vos idées et échangez avec la communauté Atomic You</p>
            </div>
            {% if app.user %}
                <a href="{{ path('post_new') }}" class="btn-primary">✏️ Nouveau Post</a>
            {% endif %}
        </div>

        <!-- Filter bar -->
        <form method="get" action="{{ path('post_index') }}" class="filter-bar">
            <input type="text" name="q" value="{{ search ?? '' }}" placeholder="🔍 Rechercher un post…">
            <select name="categorie">
                <option value="">Toutes les catégories</option>
                {% for cat in categories %}
                    <option value="{{ cat.id }}" {{ selectedCategorie == cat.id ? 'selected' }}>
                        {{ cat.icon ? cat.icon ~ ' ' }}{{ cat.nom }}
                    </option>
                {% endfor %}
            </select>
            <button type="submit" class="btn-filter">Filtrer</button>
        </form>

        <!-- Posts grid -->
        {% if posts is empty %}
            <div class="empty-state">
                <span class="icon">🗒️</span>
                <p>Aucun post trouvé. Soyez le premier à publier !</p>
            </div>
        {% else %}
            <div class="posts-grid" id="posts-list">
                {% for post in posts %}
                <div class="post-card">
                    {% if post.image %}
                        <img src="/uploads/posts/{{ post.image }}" alt="{{ post.titre }}" class="post-card-img">
                    {% else %}
                        <div class="post-card-img-placeholder">🖼️</div>
                    {% endif %}

                    <div class="post-card-body">
                        {% if post.categorie %}
                            <span class="post-badge">{{ post.categorie.icon ? post.categorie.icon ~ ' ' }}{{ post.categorie.nom }}</span>
                        {% endif %}

                        <h3>{{ post.titre|slice(0, 65) }}{% if post.titre|length > 65 %}…{% endif %}</h3>
                        <p>{{ post.contenu|striptags|slice(0, 120) }}{% if post.contenu|length > 120 %}…{% endif %}</p>

                        <div class="post-meta">
                            <span>👤
                                {% if post.isAnonymous %}<em>Anonyme</em>
                                {% else %}{{ post.user.prenom }} {{ post.user.nom }}
                                {% endif %}
                            </span>
                            <span>{{ post.createdAt|date('d/m/Y') }}</span>
                        </div>

                        <div class="post-stats">
                            <span><span class="stat-icon">👍</span> {{ post.countLikes }}</span>
                            <span><span class="stat-icon">👎</span> {{ post.countDislikes }}</span>
                            <span><span class="stat-icon">🔁</span> {{ post.countShares }}</span>
                            <span><span class="stat-icon">💬</span> {{ post.commentaires|length }}</span>
                        </div>
                    </div>

                    <div class="post-card-actions">
                        <a href="{{ path('post_show', {id: post.id}) }}" class="btn-see">👁 Voir</a>

                        {% if app.user and app.user == post.user %}
                            <a href="{{ path('post_edit', {id: post.id}) }}" class="btn-edit">✏️ Modifier</a>
                            <form method="post" action="{{ path('post_delete', {id: post.id}) }}"
                                  onsubmit="return confirm('Supprimer ce post ?')" style="display:contents">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete'~post.id) }}">
                                <button type="submit" class="btn-delete">🗑️</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>

            {# ── Pagination ── #}
            <div class="pagination-bar">
                {{ knp_pagination_render(posts) }}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Smooth scroll back to list on page change if page > 1
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('page') && parseInt(urlParams.get('page')) > 1) {
                const list = document.getElementById('posts-list');
                if (list) {
                    list.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }
        });
    </script>
{% endblock %}
