{% extends 'base.html.twig' %}

{% block title %}Rewards Manager Pro{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/manager.css') }}">
    <link rel="stylesheet" href="{{ asset('css/premium.css') }}">
{% endblock %}

{% block body_class %}manager-body bg-recompense{% endblock %}

{% block body %}
    {% for type, messages in app.flashes %}
        <div class="flash flash-{{ type }}" style="position:fixed;top:20px;right:20px;z-index:9999;padding:15px 25px;border-radius:10px;background:{% if type=='success' %}rgba(46,204,113,0.9){% else %}rgba(52,152,219,0.9){% endif %};color:white;font-weight:bold;box-shadow:0 5px 20px rgba(0,0,0,0.3);animation:slideIn 0.4s ease;">
            {% for msg in messages %}{{ msg }}{% endfor %}
        </div>
    {% endfor %}

    <header class="d-flex flex-column gap-0">
        <div class="top-header justify-between d-flex align-center">
            <div class="d-flex align-center gap-15">
                <div class="header-circle recompense-circle animate-pulse"></div>
                <div>
                    <h1 class="brand-title text-glow">REWARDS MANAGER PRO</h1>
                    <p class="brand-subtitle" style="color:#ffb199;">Catalogue des Trophées</p>
                </div>
            </div>
            <form method="GET" action="{{ path('app_recompense_index') }}" class="d-flex align-center gap-15 card-glass" style="padding:12px 20px; border-radius:12px;">
                <div class="d-flex align-center gap-10 flex-grow-1">
                    <span style="font-size:18px;">🔍</span>
                    <input type="text" name="search" value="{{ filters.search ?? '' }}" class="search-input" placeholder="Rechercher une récompense..." style="background:transparent; border:none; color:white; width:100%; outline:none; font-size:14px;">
                </div>
                
                <div class="vr" style="width:1px; background:rgba(255,255,255,0.1); height:24px;"></div>
                
                <div class="d-flex align-center gap-10">
                    <span style="font-size:14px; color:rgba(255,255,255,0.6);">TRIER:</span>
                    <select name="sort" class="filter-select" style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:8px; padding:6px 12px; color:white; cursor:pointer; font-size:13px; outline:none;">
                        <option value="nom_asc" {% if filters.sort == 'nom_asc' %}selected{% endif %}>Nom (A-Z)</option>
                        <option value="points_desc" {% if filters.sort == 'points_desc' %}selected{% endif %}>Points (Décroissant)</option>
                        <option value="points_asc" {% if filters.sort == 'points_asc' %}selected{% endif %}>Points (Croissant)</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-pink" style="border-radius:8px; padding:8px 16px;">FILTRER</button>
                <a href="{{ path('app_recompense_index') }}" class="btn btn-grey" style="padding:8px; border-radius:8px;">✕</a>
            </form>
        </div>
        <div class="action-bar gap-20 card-glass" style="margin:10px 20px;padding:15px; border-radius:12px;">
            <a href="{{ path('app_challenge_index') }}" class="btn btn-blue-purple">🏆 CHALLENGE MANAGER</a>
            <a href="{{ path('app_coach_index') }}" class="btn btn-purple">👨‍🏫 COACHES</a>
        </div>
    </header>

    <main class="main-content">
        <!-- COLONNE GAUCHE - Liste -->
        <div class="d-flex flex-column gap-20">
            <div class="stats-grid">
                <div class="stat-card border-pink card-glass">
                    <div class="stat-icon text-pink">🏆</div>
                    <div class="stat-title">TOTAL</div>
                    <div class="stat-value text-white text-glow">{{ stats.total }}</div>
                    <div class="stat-subtitle">Récompenses</div>
                </div>
                <div class="stat-card border-yellow card-glass">
                    <div class="stat-icon text-yellow">⭐</div>
                    <div class="stat-title">POINTS MOY.</div>
                    <div class="stat-value text-yellow text-glow">
                        {% if stats.total > 0 %}
                            {% set totalPts = 0 %}
                            {% for r in recompenses %}{% set totalPts = totalPts + r.points %}{% endfor %}
                            {{ (totalPts / stats.total)|round }}
                        {% else %}0{% endif %}
                    </div>
                    <div class="stat-subtitle">Points</div>
                </div>
            </div>

            <div class="list-wrapper card-glass" style="padding:0;overflow:hidden;display:flex;flex-direction:column;">
                <div class="list-header-box bg-header-recompense d-flex align-center justify-center p-15">
                    <span style="font-size:22px;">🎁</span>
                    <h3 class="form-card-title text-white m-0 text-glow" style="margin-left:10px;">CATALOGUE DES RÉCOMPENSES</h3>
                </div>
                <div style="overflow-y:auto;max-height:500px;padding:15px;">
                    {% if recompenses is empty %}
                    <div class="list-placeholder d-flex flex-column align-center gap-15" style="padding:40px;">
                        <span style="font-size:48px;">📭</span>
                        <span style="color:white;font-weight:bold;">Aucune récompense trouvée</span>
                        <span style="color:rgba(255,255,255,0.6);font-size:13px;">Créez votre première récompense →</span>
                    </div>
                    {% else %}
                    <div class="d-flex flex-column gap-12">
                        {% for rec in recompenses %}
                        <div class="recompense-row card-glass p-15"
                             style="cursor:pointer;transition:all 0.3s ease;"
                             data-id="{{ rec.id }}"
                             data-nom="{{ rec.nom|e('html_attr') }}"
                             data-desc="{{ rec.description|e('html_attr') }}"
                             data-points="{{ rec.points }}"
                             data-image="{{ rec.image ?? '' }}"
                             data-token="{{ csrf_token('delete' ~ rec.id) }}">

                            <div class="d-flex justify-between align-center" style="margin-bottom:8px;">
                                <div class="d-flex align-center gap-10">
                                    <div style="width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#ff0844,#ffb199);display:flex;align-items:center;justify-content:center;font-size:22px;">
                                        {% if rec.image and 'badge' in rec.image %}🎖️
                                        {% elseif rec.image and 'medal' in rec.image %}🥇
                                        {% elseif rec.image and 'cert' in rec.image %}📜
                                        {% else %}🏆{% endif %}
                                    </div>
                                    <div>
                                        <h4 class="text-white m-0 text-glow" style="font-size:15px;">{{ rec.nom }}</h4>
                                        {% if rec.image %}
                                        <small style="color:#ffb199;">🖼️ {{ rec.image }}</small>
                                        {% endif %}
                                    </div>
                                </div>
                                <div style="text-align:right;">
                                    <div style="padding:6px 14px;border-radius:20px;background:rgba(255,226,89,0.15);color:#ffe259;border:1px solid rgba(255,226,89,0.4);font-weight:bold;font-size:13px;">
                                        ⭐ {{ rec.points }} pts
                                    </div>
                                </div>
                            </div>

                            <p style="color:rgba(255,255,255,0.7);font-size:13px;margin:0;line-height:1.5;">
                                {{ rec.description|length > 90 ? rec.description|slice(0,90) ~ '...' : rec.description }}
                            </p>
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
                <div class="list-footer" style="padding:10px;text-align:center;color:rgba(255,255,255,0.5);font-size:12px;">
                    👆 Cliquez sur une récompense pour remplir le formulaire
                </div>
            </div>
        </div>

        <!-- COLONNE DROITE - Formulaire -->
        <div class="d-flex flex-column gap-20">
            <div class="form-card d-flex flex-column gap-15 card-glass" style="padding:25px;">
                <div class="d-flex align-center gap-12 mb-5">
                    <div class="form-header-circle bg-form-recompense"></div>
                    <h3 class="form-card-title text-glow m-0">ÉDITION RÉCOMPENSE</h3>
                </div>
                <p style="color:rgba(255,255,255,0.5);font-size:12px;margin:0;">Champs: nom, description, points, image</p>

                <form id="recForm" method="POST" action="{{ path('app_recompense_new') }}" class="d-flex flex-column gap-12">
                    <input type="hidden" name="id" id="recId" value="">

                    <!-- Nom -->
                    <div class="form-group d-flex flex-column gap-5">
                        <label class="form-group-title" style="color:#ffb199;">🏆 NOM DE LA RÉCOMPENSE *</label>
                        <input type="text" name="nom" id="nomField" class="form-control p-10" placeholder="Ex: Médaille d'Or, Badge Expert..." required>
                    </div>

                    <!-- Description -->
                    <div class="form-group d-flex flex-column gap-5">
                        <label class="form-group-title" style="color:#ffb199;">📝 DESCRIPTION</label>
                        <textarea name="description" id="descField" class="form-control p-10" rows="3" placeholder="Décrivez cette récompense..."></textarea>
                    </div>

                    <!-- Points & Image -->
                    <div class="grid-2 gap-12">
                        <div class="form-group d-flex flex-column gap-5">
                            <label class="form-group-title" style="color:#ffb199;">⭐ VALEUR EN POINTS</label>
                            <input type="number" name="points" id="pointsField" class="form-control p-10" value="100" min="0" max="10000">
                        </div>
                        <div class="form-group d-flex flex-column gap-5">
                            <label class="form-group-title" style="color:#ffb199;">🖼️ IMAGE / ICÔNE</label>
                            <select name="image" id="imageField" class="form-control p-10">
                                <option value="">-- Aucune --</option>
                                <option value="badge.png">🎖️ Badge</option>
                                <option value="medal.png">🥇 Médaille</option>
                                <option value="cert.png">📜 Certificat</option>
                                <option value="trophy.png">🏆 Trophée</option>
                                <option value="crown.png">👑 Couronne</option>
                                <option value="gift.png">🎁 Cadeau</option>
                                <option value="star.png">⭐ Étoile</option>
                            </select>
                        </div>
                    </div>

                    <!-- Aperçu valeur -->
                    <div class="status-box d-flex align-center gap-10 card-glass p-10">
                        <span style="font-size:24px;">🎯</span>
                        <div class="d-flex flex-column flex-grow-1">
                            <span class="text-white" style="font-weight:bold;">Niveau automatique</span>
                            <span id="niveauLabel" style="color:#ffe259;font-size:12px;">Bronze (0–99 pts)</span>
                        </div>
                    </div>

                    <div class="grid-2 gap-12" style="margin-top:5px;">
                        <button type="submit" id="btnAdd" class="btn btn-pink p-12" style="border-radius:8px;">➕ AJOUTER</button>
                        <button type="button" id="btnEdit" class="btn btn-purple p-12" style="border-radius:8px;">✏️ MODIFIER</button>
                        <button type="button" id="btnDelete" class="btn btn-orange-red p-12" style="border-radius:8px;">🗑️ SUPPRIMER</button>
                        <button type="button" id="btnReset" class="btn p-12" style="background:rgba(255,255,255,0.1);color:white;border-radius:8px;">🔄 VIDER</button>
                    </div>
                </form>
            </div>

            <div class="advice-card advice-recompense card-glass d-flex flex-column gap-10" style="padding:20px;">
                <div class="d-flex align-center gap-10">
                    <span style="font-size:22px;">💡</span>
                    <span class="advice-title text-glow">CONSEIL PRO</span>
                </div>
                <p class="advice-subtitle">Les récompenses bien définies augmentent la motivation de 75%. Associez des points élevés aux défis les plus difficiles pour maximiser l'engagement!</p>
            </div>
        </div>
    </main>

    <footer class="main-footer text-white">
        © 2024 Rewards Manager Pro — Symfony Edition | Système de Trophées
    </footer>

    <style>
        @keyframes slideIn { from { transform:translateX(120%);opacity:0; } to { transform:translateX(0);opacity:1; } }
        .p-10{padding:10px;} .p-12{padding:12px;} .gap-12{gap:12px;} .m-0{margin:0;} .mb-5{margin-bottom:5px;}
    </style>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('recForm');
        const idField = document.getElementById('recId');
        const pointsField = document.getElementById('pointsField');
        const niveauLabel = document.getElementById('niveauLabel');

        // Update niveau label based on points
        function updateNiveau(pts) {
            pts = parseInt(pts) || 0;
            if (pts < 100) niveauLabel.textContent = '🥉 Bronze (0–99 pts)';
            else if (pts < 500) niveauLabel.textContent = '🥈 Argent (100–499 pts)';
            else if (pts < 1000) niveauLabel.textContent = '🥇 Or (500–999 pts)';
            else niveauLabel.textContent = '💎 Diamant (1000+ pts)';
        }

        pointsField.addEventListener('input', () => updateNiveau(pointsField.value));
        updateNiveau(pointsField.value);

        // Click row → fill form
        document.querySelectorAll('.recompense-row').forEach(row => {
            row.addEventListener('click', () => {
                idField.value = row.dataset.id;
                document.getElementById('nomField').value    = row.dataset.nom;
                document.getElementById('descField').value   = row.dataset.desc;
                document.getElementById('pointsField').value = row.dataset.points;
                document.getElementById('imageField').value  = row.dataset.image;
                updateNiveau(row.dataset.points);
                document.querySelectorAll('.recompense-row').forEach(r => r.style.borderColor = 'rgba(255,255,255,0.08)');
                row.style.borderColor = '#ff0844';
            });
        });

        document.getElementById('btnEdit').addEventListener('click', () => {
            if (!idField.value) { alert('Sélectionnez une récompense dans la liste.'); return; }
            form.action = '/recompense/' + idField.value + '/edit';
            form.submit();
        });

        document.getElementById('btnDelete').addEventListener('click', () => {
            if (!idField.value) { alert('Sélectionnez une récompense dans la liste.'); return; }
            if (!confirm('Supprimer cette récompense ?')) return;
            form.action = '/recompense/' + idField.value + '/delete';
            const csrf = document.createElement('input');
            csrf.type = 'hidden'; csrf.name = '_token';
            const row = document.querySelector(`.recompense-row[data-id="${idField.value}"]`);
            if (row) csrf.value = row.dataset.token;
            form.appendChild(csrf);
            form.submit();
        });

        document.getElementById('btnReset').addEventListener('click', () => {
            form.reset(); idField.value = '';
            form.action = '{{ path("app_recompense_new") }}';
            updateNiveau(100);
            document.querySelectorAll('.recompense-row').forEach(r => r.style.borderColor = 'rgba(255,255,255,0.08)');
        });

        setTimeout(() => document.querySelectorAll('.flash').forEach(f => f.style.opacity = '0'), 4000);
    });
    </script>
{% endblock %}
