<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Back-Office — PsyApp Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg:        #0d0f1a;
            --surface:   #141627;
            --card:      #1a1d30;
            --border:    rgba(255,255,255,0.07);
            --accent:    #6c63ff;
            --accent2:   #00d2ff;
            --danger:    #ff4d6d;
            --success:   #22d3a5;
            --warning:   #f59e0b;
            --text:      #e2e8f0;
            --muted:     #64748b;
            --radius:    14px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
        }

        /* ── Sidebar ── */
        .sidebar {
            width: 240px;
            min-height: 100vh;
            background: var(--surface);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            padding: 28px 0;
            position: sticky;
            top: 0;
        }
        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 24px 32px;
            font-size: 1.25rem;
            font-weight: 700;
        }
        .sidebar-logo .icon {
            width: 38px; height: 38px;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem;
        }
        .sidebar-logo span { color: var(--accent2); }
        .sidebar-logo strong { color: var(--text); }

        .nav-label {
            font-size: 0.65rem;
            font-weight: 600;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--muted);
            padding: 0 24px 8px;
        }
        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 24px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: all .2s;
        }
        .nav-item:hover, .nav-item.active {
            color: var(--text);
            background: rgba(108,99,255,.08);
            border-left-color: var(--accent);
        }
        .nav-item.danger:hover { color: var(--danger); border-left-color: var(--danger); background: rgba(255,77,109,.06); }
        .nav-icon { font-size: 1rem; width: 18px; text-align: center; }
        .sidebar-spacer { flex: 1; }

        /* ── Main ── */
        .main { flex: 1; padding: 32px 36px; overflow-x: auto; }

        /* ── Header ── */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
        }
        .page-header h1 { font-size: 1.5rem; font-weight: 700; }
        .page-header p { color: var(--muted); font-size: 0.85rem; margin-top: 3px; }
        .admin-badge {
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            padding: 6px 14px;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        /* ── Flash messages ── */
        .flash { padding: 12px 18px; border-radius: var(--radius); margin-bottom: 20px; font-size: 0.85rem; }
        .flash-success { background: rgba(34,211,165,.12); border: 1px solid rgba(34,211,165,.3); color: var(--success); }
        .flash-danger  { background: rgba(255,77,109,.12);  border: 1px solid rgba(255,77,109,.3);  color: var(--danger);  }

        /* ── Stats ── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-bottom: 32px;
        }
        .stat-icon.orange { background: rgba(245,158,11,.15); }
        .stat-icon.red    { background: rgba(255,77,109,.15); }

        /* ── Section title ── */
        .section-header {
            display: flex; align-items: center; justify-content: space-between;
            margin: 36px 0 16px;
        }
        .section-header h2 { font-size: 1.1rem; font-weight: 700; }
        .section-header p  { font-size: 0.8rem; color: var(--muted); margin-top: 2px; }

        /* Reclamation specific badges */
        .badge-ouvert   { background: rgba(245,158,11,.15);  color: var(--warning); }
        .badge-en_cours { background: rgba(0,210,255,.12);   color: #00d2ff; }
        .badge-resolu   { background: rgba(34,211,165,.12);  color: var(--success); }
        .badge-ferme    { background: rgba(100,116,139,.12); color: var(--muted); }

        select.statut-select {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 7px;
            color: var(--text);
            font-family: inherit;
            font-size: 0.75rem;
            padding: 4px 8px;
            cursor: pointer;
            outline: none;
        }
        .desc-cell {
            max-width: 280px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: var(--muted);
            font-size: 0.8rem;
        }
        .stat-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 22px 24px;
            display: flex;
            align-items: center;
            gap: 18px;
            transition: transform .2s, box-shadow .2s;
        }
        .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.3); }
        .stat-icon {
            width: 48px; height: 48px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem;
        }
        .stat-icon.purple { background: rgba(108,99,255,.15); }
        .stat-icon.teal   { background: rgba(0,210,255,.15); }
        .stat-icon.green  { background: rgba(34,211,165,.15); }
        .stat-label { font-size: 0.78rem; color: var(--muted); margin-bottom: 4px; }
        .stat-value { font-size: 1.8rem; font-weight: 700; }

        /* ── Table ── */
        .table-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
        }
        .table-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .table-header h2 { font-size: 1rem; font-weight: 600; }
        .search-box {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 7px 14px;
            color: var(--text);
            font-size: 0.83rem;
            font-family: inherit;
            width: 200px;
            outline: none;
            transition: border-color .2s;
        }
        .search-box:focus { border-color: var(--accent); }

        table { width: 100%; border-collapse: collapse; }
        thead th {
            padding: 12px 20px;
            text-align: left;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--muted);
            border-bottom: 1px solid var(--border);
        }
        tbody tr { border-bottom: 1px solid var(--border); transition: background .15s; }
        tbody tr:last-child { border-bottom: none; }
        tbody tr:hover { background: rgba(255,255,255,.02); }
        tbody td { padding: 14px 20px; font-size: 0.85rem; vertical-align: middle; }

        .avatar {
            width: 36px; height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 0.8rem;
            flex-shrink: 0;
        }
        .user-cell { display: flex; align-items: center; gap: 12px; }
        .user-name { font-weight: 500; }
        .user-email { font-size: 0.75rem; color: var(--muted); }

        /* Badges */
        .badge {
            display: inline-flex;
            align-items: center;
            padding: 3px 10px;
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 600;
        }
        .badge-admin   { background: rgba(108,99,255,.2); color: #a29bfe; }
        .badge-coach   { background: rgba(245,158,11,.2); color: var(--warning); }
        .badge-user    { background: rgba(100,116,139,.15); color: var(--muted); }
        .badge-active  { background: rgba(34,211,165,.15); color: var(--success); }
        .badge-inactive{ background: rgba(255,77,109,.12); color: var(--danger); }

        /* Actions */
        .actions { display: flex; gap: 6px; align-items: center; }
        .btn {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 5px 12px;
            border-radius: 7px;
            font-size: 0.75rem;
            font-weight: 600;
            border: none;
            cursor: pointer;
            font-family: inherit;
            text-decoration: none;
            transition: opacity .2s, transform .15s;
        }
        .btn:hover { opacity: .85; transform: translateY(-1px); }
        .btn-toggle  { background: rgba(245,158,11,.15); color: var(--warning); }
        .btn-delete  { background: rgba(255,77,109,.15); color: var(--danger); }

        select.role-select {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 7px;
            color: var(--text);
            font-family: inherit;
            font-size: 0.75rem;
            padding: 4px 8px;
            cursor: pointer;
            outline: none;
        }
        .role-form { display: flex; align-items: center; gap: 6px; }
        .btn-save { background: rgba(108,99,255,.2); color: var(--accent); }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,.1); border-radius: 3px; }
    </style>
</head>
<body>

<!-- ── Sidebar ── -->
<aside class="sidebar">
    <div class="sidebar-logo">
        <div class="icon">🧠</div>
        <div><strong>Psy</strong><span>App</span></div>
    </div>

    <div class="nav-label">Principal</div>
    <a href="{{ path('app_admin') }}" class="nav-item active">
        <span class="nav-icon">👥</span> Utilisateurs
    </a>
    <a href="{{ path('app_admin') }}#section-reclamations" class="nav-item">
        <span class="nav-icon">📬</span> Réclamations
        {% if stats.rec_ouvert is defined and stats.rec_ouvert > 0 %}
            <span style="margin-left:auto;background:rgba(245,158,11,.2);color:var(--warning);font-size:0.7rem;font-weight:700;padding:2px 7px;border-radius:999px;">{{ stats.rec_ouvert }}</span>
        {% endif %}
    </a>
    <a href="{{ path('app_admin_motivation') }}" class="nav-item">
        <span class="nav-icon">🚀</span> Motivation
    </a>

    <div class="sidebar-spacer"></div>

    <div class="nav-label">Compte</div>
    <a href="{{ path('app_logout') }}" class="nav-item danger">
        <span class="nav-icon">🚪</span> Déconnexion
    </a>
</aside>

<!-- ── Main ── -->
<main class="main">

    <!-- Header -->
    <div class="page-header">
        <div>
            <h1>Gestion des Utilisateurs</h1>
            <p>Bienvenue, {{ app.user.prenom }} — espace administrateur</p>
        </div>
        <span class="admin-badge">⚡ ADMIN</span>
    </div>

    <!-- Flash messages -->
    {% for msg in app.flashes('success') %}
        <div class="flash flash-success">✅ {{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('danger') %}
        <div class="flash flash-danger">❌ {{ msg }}</div>
    {% endfor %}

    <!-- Stats utilisateurs -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon purple">👥</div>
            <div>
                <div class="stat-label">Total utilisateurs</div>
                <div class="stat-value">{{ stats.total }}</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon teal">🛡️</div>
            <div>
                <div class="stat-label">Administrateurs</div>
                <div class="stat-value">{{ stats.admins }}</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green">✅</div>
            <div>
                <div class="stat-label">Comptes actifs</div>
                <div class="stat-value">{{ stats.active }}</div>
            </div>
        </div>
    </div>

    <!-- Stats réclamations -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon orange">📬</div>
            <div>
                <div class="stat-label">Total réclamations</div>
                <div class="stat-value">{{ stats.rec_total }}</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon red">⏳</div>
            <div>
                <div class="stat-label">En attente</div>
                <div class="stat-value">{{ stats.rec_ouvert }}</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green">✅</div>
            <div>
                <div class="stat-label">Résolues</div>
                <div class="stat-value">{{ stats.rec_resolu }}</div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="table-card">
        <div class="table-header">
            <h2>Liste des utilisateurs</h2>
            <input class="search-box" type="text" id="searchInput" placeholder="🔍 Rechercher…" onkeyup="filterTable()">
        </div>
        <table id="usersTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Utilisateur</th>
                    <th>Email</th>
                    <th>Rôle</th>
                    <th>Statut</th>
                    <th>Inscrit le</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td style="color:var(--muted)">{{ user.id }}</td>

                    <td>
                        <div class="user-cell">
                            <div class="avatar">{{ user.prenom|slice(0,1)|upper }}{{ user.nom|slice(0,1)|upper }}</div>
                            <div>
                                <div class="user-name">{{ user.prenom }} {{ user.nom }}</div>
                                {% if user.age %}<div class="user-email">{{ user.age }} ans</div>{% endif %}
                            </div>
                        </div>
                    </td>

                    <td style="color:var(--muted)">{{ user.email }}</td>

                    <td>
                        <form class="role-form" method="post" action="{{ path('app_admin_change_role', {id: user.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('change_role'~user.id) }}">
                            <select name="role" class="role-select" onchange="this.form.submit()">
                                <option value="user"  {% if user.role == 'user'  %}selected{% endif %}>User</option>
                                <option value="coach" {% if user.role == 'coach' %}selected{% endif %}>Coach</option>
                                <option value="admin" {% if user.role == 'admin' %}selected{% endif %}>Admin</option>
                            </select>
                        </form>
                    </td>

                    <td>
                        <span class="badge {{ user.isActive ? 'badge-active' : 'badge-inactive' }}">
                            {{ user.isActive ? '● Actif' : '○ Inactif' }}
                        </span>
                    </td>

                    <td style="color:var(--muted)">{{ user.createdAt ? user.createdAt|date('d/m/Y') : '—' }}</td>

                    <td>
                        <div class="actions">
                            <form method="post" action="{{ path('app_admin_toggle_user', {id: user.id}) }}">
                                <button class="btn btn-toggle" type="submit">
                                    {{ user.isActive ? '🔕 Désactiver' : '🔔 Activer' }}
                                </button>
                            </form>
                            <form method="post" action="{{ path('app_admin_delete_user', {id: user.id}) }}"
                                  onsubmit="return confirm('Supprimer cet utilisateur ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete'~user.id) }}">
                                <button class="btn btn-delete" type="submit">🗑️</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" style="text-align:center;color:var(--muted);padding:40px">
                        Aucun utilisateur trouvé.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- ── Section Réclamations ── -->
    <div class="section-header" id="section-reclamations">
        <div>
            <h2>📬 Gestion des Réclamations</h2>
            <p>Toutes les réclamations soumises par les utilisateurs</p>
        </div>
    </div>

    <div class="table-card">
        <div class="table-header">
            <h2>Liste des réclamations</h2>
            <input class="search-box" type="text" id="searchRec" placeholder="🔍 Rechercher…" onkeyup="filterRec()">
        </div>
        <table id="recTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Utilisateur</th>
                    <th>Sujet</th>
                    <th>Description</th>
                    <th>Statut</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for rec in reclamations %}
                <tr>
                    <td style="color:var(--muted)">{{ rec.id }}</td>

                    <td>
                        <div class="user-cell">
                            <div class="avatar" style="background:linear-gradient(135deg,#f59e0b,#ef4444)">
                                {{ rec.user.prenom|slice(0,1)|upper }}{{ rec.user.nom|slice(0,1)|upper }}
                            </div>
                            <div>
                                <div class="user-name">{{ rec.user.prenom }} {{ rec.user.nom }}</div>
                                <div class="user-email">{{ rec.user.email }}</div>
                            </div>
                        </div>
                    </td>

                    <td style="font-weight:500;max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                        {{ rec.sujet }}
                    </td>

                    <td class="desc-cell">{{ rec.description }}</td>

                    <td>
                        <form method="post" action="{{ path('app_admin_reclamation_statut', {id: rec.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('statut_rec'~rec.id) }}">
                            <select name="statut" class="statut-select" onchange="this.form.submit()">
                                <option value="ouvert"   {% if rec.statut == 'ouvert'   %}selected{% endif %}>⏳ Ouvert</option>
                                <option value="en_cours" {% if rec.statut == 'en_cours' %}selected{% endif %}>🔄 En cours</option>
                                <option value="resolu"   {% if rec.statut == 'resolu'   %}selected{% endif %}>✅ Résolu</option>
                                <option value="ferme"    {% if rec.statut == 'ferme'    %}selected{% endif %}>🔒 Fermé</option>
                            </select>
                        </form>
                    </td>

                    <td style="color:var(--muted)">{{ rec.createdAt|date('d/m/Y') }}</td>

                    <td>
                        <div class="actions">
                            <form method="post" action="{{ path('app_admin_reclamation_delete', {id: rec.id}) }}"
                                  onsubmit="return confirm('Supprimer cette réclamation ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_rec'~rec.id) }}">
                                <button class="btn btn-delete" type="submit">🗑️ Supprimer</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" style="text-align:center;color:var(--muted);padding:40px">
                        Aucune réclamation trouvée.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

</main>

<script>
function filterTable() {
    const q = document.getElementById('searchInput').value.toLowerCase();
    document.querySelectorAll('#usersTable tbody tr').forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
}
function filterRec() {
    const q = document.getElementById('searchRec').value.toLowerCase();
    document.querySelectorAll('#recTable tbody tr').forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
}
</script>
</body>
</html>
