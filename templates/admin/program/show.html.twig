{% extends 'admin/base.html.twig' %}

{% block title %}{{ program.title }} — Admin{% endblock %}
{% block topbar_title %}Détail du programme{% endblock %}

{% block stylesheets %}
<style>
    /* ── Page Layout ── */
    .prog-show-page { max-width: 1200px; margin: 0 auto; }

    /* ── Page Header ── */
    .prog-show-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
        gap: 16px;
    }
    .prog-show-header-left { display: flex; flex-direction: column; gap: 4px; }
    .prog-show-header h1 {
        font-size: 1.8rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .prog-show-header h1 .icon-circle {
        width: 48px; height: 48px;
        background: linear-gradient(135deg, #3b82f6, #60a5fa);
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
        box-shadow: 0 4px 15px rgba(59,130,246,0.3);
    }
    .prog-show-header .subtitle {
        color: #64748b;
        font-size: 0.88rem;
        margin-left: 60px;
    }
    .prog-show-actions { display: flex; gap: 10px; flex-shrink: 0; }
    .btn-edit-prog {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 10px 20px;
        background: linear-gradient(135deg, #f59e0b, #f97316);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
        box-shadow: 0 4px 12px rgba(245,158,11,0.25);
    }
    .btn-edit-prog:hover { opacity: 0.9; transform: translateY(-1px); }
    .btn-back-prog {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 10px 20px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: #94a3b8;
        border-radius: 10px;
        font-size: 0.88rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s;
    }
    .btn-back-prog:hover { background: rgba(255,255,255,0.1); color: #e2e8f0; border-color: rgba(255,255,255,0.2); }

    /* ── Cards ── */
    .prog-detail-card {
        background: #1a1d30;
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0,0,0,0.4);
        margin-bottom: 20px;
    }
    .prog-detail-card-header {
        padding: 20px 28px;
        border-bottom: 1px solid rgba(255,255,255,0.07);
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .prog-detail-card-header .header-icon {
        width: 32px; height: 32px;
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem;
    }
    .prog-detail-card-header span {
        font-size: 0.95rem;
        font-weight: 600;
        color: #e2e8f0;
    }
    .prog-detail-card-body { padding: 28px; }

    /* Info Grid */
    .prog-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }
    .prog-info-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .prog-info-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .prog-info-value {
        font-size: 1rem;
        color: #e2e8f0;
        font-weight: 500;
    }

    /* Level Badge */
    .level-badge-show {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 700;
        border: 1px solid;
    }
    .level-badge-show.deb {
        background: rgba(34,211,165,0.1);
        color: #22d3a5;
        border-color: rgba(34,211,165,0.25);
    }
    .level-badge-show.int {
        background: rgba(59,130,246,0.1);
        color: #3b82f6;
        border-color: rgba(59,130,246,0.25);
    }
    .level-badge-show.adv {
        background: rgba(255,77,109,0.1);
        color: #ff4d6d;
        border-color: rgba(255,77,109,0.25);
    }

    /* Status Badge */
    .status-badge-show {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 700;
        border: 1px solid;
    }
    .status-badge-show.published {
        background: rgba(34,211,165,0.1);
        color: #22d3a5;
        border-color: rgba(34,211,165,0.25);
    }
    .status-badge-show.draft {
        background: rgba(100,116,139,0.1);
        color: #64748b;
        border-color: rgba(100,116,139,0.2);
    }

    /* Stats Pills */
    .assign-stats-show {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 24px;
    }
    @media (max-width: 900px) { .assign-stats-show { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .assign-stats-show { grid-template-columns: 1fr; } }
    .assign-stat-box {
        background: rgba(13,15,26,0.5);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
    }
    .assign-stat-box:hover { transform: translateY(-2px); border-color: rgba(59,130,246,0.3); }
    .assign-stat-icon {
        width: 40px; height: 40px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem;
    }
    .assign-stat-icon.total { background: rgba(100,116,139,0.12); color: #94a3b8; }
    .assign-stat-icon.accepted { background: rgba(34,211,165,0.12); color: #22d3a5; }
    .assign-stat-icon.pending { background: rgba(245,158,11,0.12); color: #f59e0b; }
    .assign-stat-icon.declined { background: rgba(255,77,109,0.12); color: #ff4d6d; }
    .assign-stat-value { font-size: 1.5rem; font-weight: 700; color: #e2e8f0; line-height: 1; }
    .assign-stat-label { font-size: 0.72rem; color: #64748b; text-align: center; }

    /* User List */
    .assigned-user-list { display: flex; flex-direction: column; gap: 10px; }
    .assigned-user-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        background: rgba(13,15,26,0.5);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 12px;
        transition: all 0.2s;
    }
    .assigned-user-row:hover { border-color: rgba(59,130,246,0.3); background: rgba(59,130,246,0.04); }
    .user-avatar-show {
        width: 42px; height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6, #60a5fa);
        display: flex; align-items: center; justify-content: center;
        font-size: 0.85rem;
        font-weight: 700;
        color: #fff;
        flex-shrink: 0;
    }
    .user-info-show { flex: 1; min-width: 0; }
    .user-name-show {
        font-size: 0.92rem;
        font-weight: 600;
        color: #e2e8f0;
        margin-bottom: 2px;
    }
    .user-email-show {
        font-size: 0.78rem;
        color: #64748b;
    }
    .user-meta-show {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        flex-shrink: 0;
    }
    .user-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        border: 1px solid;
    }
    .user-status-badge.pending {
        background: rgba(245,158,11,0.1);
        color: #f59e0b;
        border-color: rgba(245,158,11,0.3);
    }
    .user-status-badge.accepted {
        background: rgba(34,211,165,0.1);
        color: #22d3a5;
        border-color: rgba(34,211,165,0.3);
    }
    .user-status-badge.declined {
        background: rgba(255,77,109,0.1);
        color: #ff4d6d;
        border-color: rgba(255,77,109,0.3);
    }
    .user-date-show {
        font-size: 0.72rem;
        color: #475569;
    }
    .no-users-show {
        text-align: center;
        padding: 48px 20px;
        color: #475569;
    }
    .no-users-show i {
        font-size: 3rem;
        display: block;
        margin-bottom: 16px;
        opacity: 0.5;
    }

    /* Exercise Table */
    .exercise-table-show {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }
    .exercise-table-show thead th {
        background: rgba(13,15,26,0.7);
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 14px 18px;
        border-bottom: 1px solid rgba(255,255,255,0.07);
    }
    .exercise-table-show thead th:first-child { border-radius: 10px 0 0 0; }
    .exercise-table-show thead th:last-child { border-radius: 0 10px 0 0; }
    .exercise-table-show tbody tr {
        transition: all 0.2s;
    }
    .exercise-table-show tbody tr:hover {
        background: rgba(59,130,246,0.04);
    }
    .exercise-table-show tbody td {
        padding: 14px 18px;
        color: #e2e8f0;
        font-size: 0.88rem;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .exercise-link {
        color: #60a5fa !important;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s;
    }
    .exercise-link:hover { color: #3b82f6 !important; text-decoration: underline; }
    .category-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        background: rgba(59,130,246,0.1);
        color: #60a5fa;
        border: 1px solid rgba(59,130,246,0.25);
    }
    .difficulty-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        border: 1px solid;
    }
    .difficulty-badge.deb {
        background: rgba(34,211,165,0.1);
        color: #22d3a5;
        border-color: rgba(34,211,165,0.25);
    }
    .difficulty-badge.int {
        background: rgba(245,158,11,0.1);
        color: #f59e0b;
        border-color: rgba(245,158,11,0.25);
    }
    .difficulty-badge.adv {
        background: rgba(255,77,109,0.1);
        color: #ff4d6d;
        border-color: rgba(255,77,109,0.25);
    }

    /* Action Buttons */
    .action-buttons-show {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }
    .btn-publish-show {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 20px;
        border: none;
        border-radius: 10px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-publish-show.publish {
        background: linear-gradient(135deg, #22d3a5, #3b82f6);
        color: #fff;
        box-shadow: 0 4px 12px rgba(34,211,165,0.25);
    }
    .btn-publish-show.unpublish {
        background: rgba(245,158,11,0.1);
        color: #f59e0b;
        border: 1px solid rgba(245,158,11,0.3);
    }
    .btn-publish-show:hover { opacity: 0.9; transform: translateY(-1px); }
    .btn-delete-show {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 12px 20px;
        background: rgba(255,77,109,0.1);
        color: #ff4d6d;
        border: 1px solid rgba(255,77,109,0.3);
        border-radius: 10px;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-delete-show:hover { background: rgba(255,77,109,0.15); }

    /* Responsive */
    @media (max-width: 768px) {
        .prog-show-header { flex-direction: column; align-items: flex-start; }
        .prog-show-actions { width: 100%; }
        .prog-info-grid { grid-template-columns: 1fr; }
    }
</style>
{% endblock %}

{% block content %}
<div class="prog-show-page">

    {# ── Page Header ── #}
    <div class="prog-show-header">
        <div class="prog-show-header-left">
            <h1>
                <span class="icon-circle"><i class="bi bi-journal-bookmark-fill"></i></span>
                {{ program.title }}
            </h1>
            <div class="subtitle">{{ program.goal }}</div>
        </div>
        <div class="prog-show-actions">
            <a href="{{ path('admin_program_edit', {id: program.id}) }}" class="btn-edit-prog">
                <i class="bi bi-pencil"></i> Modifier
            </a>
            <a href="{{ path('admin_program_index') }}" class="btn-back-prog">
                <i class="bi bi-arrow-left"></i> Retour
            </a>
        </div>
    </div>

    <div class="row g-4">
        {# Left: Program Details #}
        <div class="col-lg-4">
            <div class="prog-detail-card">
                <div class="prog-detail-card-header" style="background: rgba(59,130,246,0.05);">
                    <div class="header-icon" style="background: rgba(59,130,246,0.12); color: #3b82f6;">
                        <i class="bi bi-info-circle-fill"></i>
                    </div>
                    <span>Informations du programme</span>
                </div>
                <div class="prog-detail-card-body">
                    <div class="prog-info-grid">
                        <div class="prog-info-item">
                            <div class="prog-info-label">
                                <i class="bi bi-speedometer2" style="color:#3b82f6;"></i> Niveau
                            </div>
                            <div class="prog-info-value">
                                {% if program.level == 'Débutant' %}
                                    <span class="level-badge-show deb"><i class="bi bi-bar-chart"></i>{{ program.level }}</span>
                                {% elseif program.level == 'Intermédiaire' %}
                                    <span class="level-badge-show int"><i class="bi bi-bar-chart"></i>{{ program.level }}</span>
                                {% else %}
                                    <span class="level-badge-show adv"><i class="bi bi-bar-chart"></i>{{ program.level }}</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="prog-info-item">
                            <div class="prog-info-label">
                                <i class="bi bi-calendar3" style="color:#3b82f6;"></i> Durée
                            </div>
                            <div class="prog-info-value">{{ program.durationWeeks }} semaines</div>
                        </div>
                        <div class="prog-info-item">
                            <div class="prog-info-label">
                                <i class="bi bi-activity" style="color:#3b82f6;"></i> Exercices
                            </div>
                            <div class="prog-info-value">{{ program.exercises|length }} exercices</div>
                        </div>
                        <div class="prog-info-item">
                            <div class="prog-info-label">
                                <i class="bi bi-eye" style="color:#3b82f6;"></i> Statut
                            </div>
                            <div class="prog-info-value">
                                {% if program.isPublished %}
                                    <span class="status-badge-show published"><i class="bi bi-check-circle-fill"></i> Publié</span>
                                {% else %}
                                    <span class="status-badge-show draft"><i class="bi bi-drafting-compass"></i> Brouillon</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="prog-info-item">
                            <div class="prog-info-label">
                                <i class="bi bi-calendar" style="color:#3b82f6;"></i> Créé le
                            </div>
                            <div class="prog-info-value">{{ program.createdAt|date('d/m/Y') }}</div>
                        </div>
                    </div>

                    <div class="action-buttons-show">
                        <form method="post" action="{{ path('admin_program_publish', {id: program.id}) }}" style="flex:1;">
                            <input type="hidden" name="_token" value="{{ csrf_token('publish_program_' ~ program.id) }}">
                            <button class="btn-publish-show {{ program.isPublished ? 'unpublish' : 'publish' }}">
                                <i class="bi bi-{{ program.isPublished ? 'eye-slash' : 'eye' }}"></i>
                                {{ program.isPublished ? 'Dépublier' : 'Publier' }}
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        {# Right: Exercises & Assignments #}
        <div class="col-lg-8">
            {# Exercises Card #}
            <div class="prog-detail-card">
                <div class="prog-detail-card-header" style="background: rgba(34,211,165,0.05);">
                    <div class="header-icon" style="background: rgba(34,211,165,0.12); color: #22d3a5;">
                        <i class="bi bi-collection-fill"></i>
                    </div>
                    <span>Exercices associés ({{ program.exercises|length }})</span>
                </div>
                <div class="prog-detail-card-body" style="padding: 0;">
                    {% if program.exercises|length > 0 %}
                        <table class="exercise-table-show">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">#</th>
                                    <th>Nom</th>
                                    <th>Catégorie</th>
                                    <th>Difficulté</th>
                                    <th>Durée</th>
                                    <th>Calories</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for ex in program.exercises %}
                                    <tr>
                                        <td style="color:#64748b;">{{ loop.index }}</td>
                                        <td>
                                            <a href="{{ path('admin_exercise_show', {id: ex.id}) }}" class="exercise-link">{{ ex.name }}</a>
                                        </td>
                                        <td><span class="category-badge"><i class="bi bi-tag"></i>{{ ex.category }}</span></td>
                                        <td>
                                            {% if ex.difficulty == 'Débutant' %}
                                                <span class="difficulty-badge deb"><i class="bi bi-circle"></i>{{ ex.difficulty }}</span>
                                            {% elseif ex.difficulty == 'Intermédiaire' %}
                                                <span class="difficulty-badge int"><i class="bi bi-circle-half"></i>{{ ex.difficulty }}</span>
                                            {% else %}
                                                <span class="difficulty-badge adv"><i class="bi bi-circle-fill"></i>{{ ex.difficulty }}</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ ex.duration }} min</td>
                                        <td>{{ ex.calories }} kcal</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <div class="no-users-show">
                            <i class="bi bi-activity"></i>
                            <div>Aucun exercice associé à ce programme</div>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Assignments Card #}
            <div class="prog-detail-card">
                <div class="prog-detail-card-header" style="background: rgba(245,158,11,0.05);">
                    <div class="header-icon" style="background: rgba(245,158,11,0.12); color: #f59e0b;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <span>Assignations utilisateurs</span>
                </div>
                <div class="prog-detail-card-body">
                    {# Stats #}
                    <div class="assign-stats-show">
                        <div class="assign-stat-box">
                            <div class="assign-stat-icon total"><i class="bi bi-send-fill"></i></div>
                            <div class="assign-stat-value">{{ stats.total }}</div>
                            <div class="assign-stat-label">Total envoyés</div>
                        </div>
                        <div class="assign-stat-box">
                            <div class="assign-stat-icon accepted"><i class="bi bi-check-circle-fill"></i></div>
                            <div class="assign-stat-value" style="color:#22d3a5;">{{ stats.accepted }}</div>
                            <div class="assign-stat-label">Acceptés</div>
                        </div>
                        <div class="assign-stat-box">
                            <div class="assign-stat-icon pending"><i class="bi bi-hourglass-split"></i></div>
                            <div class="assign-stat-value" style="color:#f59e0b;">{{ stats.pending }}</div>
                            <div class="assign-stat-label">En attente</div>
                        </div>
                        <div class="assign-stat-box">
                            <div class="assign-stat-icon declined"><i class="bi bi-x-circle-fill"></i></div>
                            <div class="assign-stat-value" style="color:#ff4d6d;">{{ stats.declined }}</div>
                            <div class="assign-stat-label">Déclinés</div>
                        </div>
                    </div>

                    {# User List #}
                    {% if assignments|length > 0 %}
                        <div class="assigned-user-list">
                            {% for assignment in assignments %}
                                <div class="assigned-user-row">
                                    <div class="user-avatar-show">
                                        {{ assignment.user.prenom|first|upper }}{{ assignment.user.nom|first|upper }}
                                    </div>
                                    <div class="user-info-show">
                                        <div class="user-name-show">{{ assignment.user.prenom }} {{ assignment.user.nom }}</div>
                                        <div class="user-email-show">{{ assignment.user.email }}</div>
                                    </div>
                                    <div class="user-meta-show">
                                        {% if assignment.isPending() %}
                                            <span class="user-status-badge pending">
                                                <i class="bi bi-hourglass-split"></i> En attente
                                            </span>
                                        {% elseif assignment.isAccepted() %}
                                            <span class="user-status-badge accepted">
                                                <i class="bi bi-check-circle-fill"></i> Accepté
                                            </span>
                                        {% else %}
                                            <span class="user-status-badge declined">
                                                <i class="bi bi-x-circle-fill"></i> Décliné
                                            </span>
                                        {% endif %}
                                        <div class="user-date-show">
                                            {{ assignment.sentAt|date('d/m/Y') }}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="no-users-show">
                            <i class="bi bi-inbox"></i>
                            <div>Aucun utilisateur assigné à ce programme</div>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Delete Button #}
            <div class="action-buttons-show">
                <form method="post" action="{{ path('admin_program_delete', {id: program.id}) }}"
                      onsubmit="return confirm('Supprimer définitivement ce programme ?');" style="width: 100%;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_program_' ~ program.id) }}">
                    <button class="btn-delete-show" style="width: 100%; justify-content: center;">
                        <i class="bi bi-trash"></i> Supprimer ce programme
                    </button>
                </form>
            </div>
        </div>
    </div>

</div>
{% endblock %}
