{% extends 'admin/base.html.twig' %}

{% block title %}{{ program.title }} — Admin{% endblock %}
{% block topbar_title %}Détail du programme{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1>{{ program.title }}</h1>
        <div class="page-sub">Fiche détaillée du programme</div>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_program_edit', {id: program.id}) }}" class="btn btn-warning text-dark">
            <i class="bi bi-pencil me-1"></i>Modifier
        </a>
        <a href="{{ path('admin_program_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Retour
        </a>
    </div>
</div>

<div class="row g-4">
    {# Left: quick info card #}
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-1">{{ program.title }}</h5>
                <p class="text-muted" style="font-size:0.875rem;">{{ program.goal }}</p>

                <hr>

                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted" style="font-size:0.82rem;"><i class="bi bi-bar-chart me-2"></i>Niveau</span>
                        {% if program.level == 'Débutant' %}
                            <span class="badge bg-success">{{ program.level }}</span>
                        {% elseif program.level == 'Intermédiaire' %}
                            <span class="badge bg-warning text-dark">{{ program.level }}</span>
                        {% else %}
                            <span class="badge bg-danger">{{ program.level }}</span>
                        {% endif %}
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted" style="font-size:0.82rem;"><i class="bi bi-calendar-week me-2"></i>Durée</span>
                        <strong>{{ program.durationWeeks }} semaines</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted" style="font-size:0.82rem;"><i class="bi bi-activity me-2"></i>Exercices</span>
                        <strong>{{ program.exercises|length }}</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted" style="font-size:0.82rem;"><i class="bi bi-eye me-2"></i>Statut</span>
                        {% if program.isPublished %}
                            <span class="badge" style="background:#dcfce7;color:#15803d;">Publié</span>
                        {% else %}
                            <span class="badge" style="background:#f1f5f9;color:#64748b;">Brouillon</span>
                        {% endif %}
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted" style="font-size:0.82rem;"><i class="bi bi-calendar me-2"></i>Créé le</span>
                        <span>{{ program.createdAt|date('d/m/Y') }}</span>
                    </div>
                </div>

                <hr>

                {# Publish toggle #}
                <form method="post" action="{{ path('admin_program_publish', {id: program.id}) }}">
                    <input type="hidden" name="_token"
                           value="{{ csrf_token('publish_program_' ~ program.id) }}">
                    <button class="btn w-100 {{ program.isPublished ? 'btn-outline-warning' : 'btn-outline-success' }}">
                        <i class="bi bi-{{ program.isPublished ? 'eye-slash' : 'eye' }} me-2"></i>
                        {{ program.isPublished ? 'Dépublier' : 'Publier' }}
                    </button>
                </form>
            </div>
        </div>
    </div>

    {# Right: exercises list #}
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header py-3">
                <i class="bi bi-list-check me-2 text-primary"></i>
                Exercices associés ({{ program.exercises|length }})
            </div>
            <div class="card-body p-0">
                {% if program.exercises|length > 0 %}
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">#</th>
                                <th>Nom</th>
                                <th>Catégorie</th>
                                <th>Difficulté</th>
                                <th>Durée</th>
                                <th>Calories</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ex in program.exercises %}
                                <tr>
                                    <td class="ps-4 text-muted">{{ loop.index }}</td>
                                    <td>
                                        <a href="{{ path('admin_exercise_show', {id: ex.id}) }}"
                                           class="text-decoration-none fw-semibold">{{ ex.name }}</a>
                                    </td>
                                    <td><span class="badge bg-primary bg-opacity-10 text-primary">{{ ex.category }}</span></td>
                                    <td>
                                        {% if ex.difficulty == 'Débutant' %}
                                            <span class="badge bg-success bg-opacity-15 text-success">{{ ex.difficulty }}</span>
                                        {% elseif ex.difficulty == 'Intermédiaire' %}
                                            <span class="badge bg-warning bg-opacity-15 text-warning">{{ ex.difficulty }}</span>
                                        {% else %}
                                            <span class="badge bg-danger bg-opacity-15 text-danger">{{ ex.difficulty }}</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ ex.duration }} min</td>
                                    <td>{{ ex.calories }} kcal</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-activity display-6 d-block mb-2"></i>
                        Aucun exercice associé à ce programme.
                    </div>
                {% endif %}
            </div>
        </div>

        {# Delete zone #}
        <div class="card mt-3 border-danger border-opacity-25">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold text-danger" style="font-size:0.875rem;">Zone de danger</div>
                    <div class="text-muted" style="font-size:0.78rem;">La suppression est irréversible.</div>
                </div>
                <form method="post" action="{{ path('admin_program_delete', {id: program.id}) }}"
                      onsubmit="return confirm('Supprimer définitivement ce programme ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_program_' ~ program.id) }}">
                    <button class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash me-1"></i>Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
