{% extends 'admin/base.html.twig' %}

{% block title %}Programmes — Admin{% endblock %}
{% block topbar_title %}Gestion des Programmes{% endblock %}

{% block stylesheets %}
<style>
    /* Stats bar at top */
    .prog-stats-bar {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 28px;
    }
    .prog-stat-box {
        background: var(--card);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 14px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: transform .15s;
    }
    .prog-stat-box:hover { transform: translateY(-2px); }
    .prog-stat-icon {
        width: 42px; height: 42px;
        border-radius: 11px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }
    .psi-green  { background: rgba(34,211,165,.12); }
    .psi-blue   { background: rgba(59,130,246,.12); }
    .psi-yellow { background: rgba(245,158,11,.12); }
    .psi-pink   { background: rgba(236,72,153,.12); }
    .prog-stat-label { font-size: 0.72rem; color: var(--muted); margin-bottom: 2px; }
    .prog-stat-value { font-size: 1.6rem; font-weight: 700; color: #fff; line-height: 1; }

    /* Assignment mini-stats inside table */
    .assign-stats {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }
    .assign-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 600;
        border: 1px solid;
    }
    .ab-accepted { background: rgba(34,211,165,.10); color: #22d3a5; border-color: rgba(34,211,165,.25); }
    .ab-declined { background: rgba(255,77,109,.10); color: #ff4d6d; border-color: rgba(255,77,109,.25); }
    .ab-pending  { background: rgba(245,158,11,.10); color: #f59e0b; border-color: rgba(245,158,11,.25); }
    .ab-total    { background: rgba(100,116,139,.10); color: #94a3b8; border-color: rgba(100,116,139,.2); }

    @media (max-width: 900px) {
        .prog-stats-bar { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 500px) {
        .prog-stats-bar { grid-template-columns: 1fr; }
    }
</style>
{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1><i class="bi bi-journal-bookmark-fill me-2" style="color:var(--success);"></i>Programmes</h1>
        <div class="page-sub">{{ programs|length }} programme(s) enregistré(s)</div>
    </div>
    <a href="{{ path('admin_program_new') }}" class="btn btn-primary" style="background:var(--success); border-color:var(--success);">
        <i class="bi bi-plus-lg me-1"></i>Ajouter un programme
    </a>
</div>

{# ── Global Acceptance Stats ── #}
{% set totalSent     = 0 %}
{% set totalAccepted = 0 %}
{% set totalDeclined = 0 %}
{% set totalPending  = 0 %}
{% for s in stats %}
    {% set totalSent     = totalSent     + s.total %}
    {% set totalAccepted = totalAccepted + s.accepted %}
    {% set totalDeclined = totalDeclined + s.declined %}
    {% set totalPending  = totalPending  + s.pending %}
{% endfor %}

<div class="prog-stats-bar">
    <div class="prog-stat-box">
        <div class="prog-stat-icon psi-green"><i class="bi bi-journal-bookmark-fill" style="color:var(--success);"></i></div>
        <div>
            <div class="prog-stat-label">Total programmes</div>
            <div class="prog-stat-value">{{ programs|length }}</div>
        </div>
    </div>
    <div class="prog-stat-box">
        <div class="prog-stat-icon psi-blue"><i class="bi bi-send-fill" style="color:#60a5fa;"></i></div>
        <div>
            <div class="prog-stat-label">Assignations envoyées</div>
            <div class="prog-stat-value">{{ totalSent }}</div>
        </div>
    </div>
    <div class="prog-stat-box">
        <div class="prog-stat-icon psi-yellow"><i class="bi bi-check-circle-fill" style="color:var(--success);"></i></div>
        <div>
            <div class="prog-stat-label">Acceptés</div>
            <div class="prog-stat-value" style="color:var(--success);">{{ totalAccepted }}</div>
        </div>
    </div>
    <div class="prog-stat-box">
        <div class="prog-stat-icon psi-pink"><i class="bi bi-clock-fill" style="color:#f59e0b;"></i></div>
        <div>
            <div class="prog-stat-label">En attente</div>
            <div class="prog-stat-value" style="color:#f59e0b;">{{ totalPending }}</div>
        </div>
    </div>
</div>

<div class="table-card">
    <div class="table-header py-3 d-flex justify-content-between align-items-center">
        <span style="font-weight: 600; font-size: 1rem;"><i class="bi bi-list me-2" style="color:var(--success);"></i>Liste des programmes</span>
        
        {# Search Bar #}
        <form method="get" action="{{ path('admin_program_index') }}" class="d-flex gap-2" style="max-width: 350px;">
            <div class="input-group" style="border-radius: 10px; overflow: hidden;">
                <span class="input-group-text" style="background: rgba(34,211,165,0.1); border-color: rgba(34,211,165,0.2); color: var(--success);">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="q" class="form-control" placeholder="Rechercher par titre ou objectif…" 
                       value="{{ searchQuery }}" 
                       style="background: rgba(13,15,26,0.7); border-color: rgba(34,211,165,0.2); color: #e2e8f0;"
                       autocomplete="off">
                {% if searchQuery %}
                    <a href="{{ path('admin_program_index') }}" class="btn" style="background: rgba(255,77,109,0.1); border-color: rgba(255,77,109,0.2); color: var(--danger);" title="Effacer la recherche">
                        <i class="bi bi-x-lg"></i>
                    </a>
                {% endif %}
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th class="ps-4" style="width:25%;">Titre</th>
                    <th>Objectif</th>
                    <th>Niveau</th>
                    <th>Durée</th>
                    <th>Exercices</th>
                    <th>Acceptations</th>
                    <th>Statut</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for program in programs %}
                    {% set s = stats[program.id] ?? {total:0,accepted:0,declined:0,pending:0} %}
                    <tr>
                        <td class="ps-4">
                            <div class="fw-semibold" style="color: #fff;">
                                {{ program.title|length > 35 ? program.title|slice(0,35) ~ '…' : program.title }}
                            </div>
                            <div style="font-size:0.75rem;color:var(--muted);">
                                Créé le {{ program.createdAt|date('d/m/Y') }}
                            </div>
                        </td>
                        <td style="font-size:0.85rem; color: var(--text);">
                            {{ program.goal|length > 30 ? program.goal|slice(0,30) ~ '…' : program.goal }}
                        </td>
                        <td>
                            {% if program.level == 'Débutant' %}
                                <span class="badge" style="background: rgba(34,211,165,.15); color: var(--success); border: 1px solid rgba(34,211,165,.25);">{{ program.level }}</span>
                            {% elseif program.level == 'Intermédiaire' %}
                                <span class="badge" style="background: rgba(245,158,11,.15); color: var(--warning); border: 1px solid rgba(245,158,11,.25);">{{ program.level }}</span>
                            {% else %}
                                <span class="badge" style="background: rgba(255,77,109,.15); color: var(--danger); border: 1px solid rgba(255,77,109,.25);">{{ program.level }}</span>
                            {% endif %}
                        </td>
                        <td style="color:var(--muted);">{{ program.durationWeeks }} sem.</td>
                        <td>
                            <span class="badge" style="background: rgba(59,130,246,.15); color: #60a5fa; border: 1px solid rgba(59,130,246,.25);">
                                <i class="bi bi-activity me-1"></i>{{ program.exercises|length }}
                            </span>
                        </td>
                        <td>
                            {% if s.total == 0 %}
                                <span style="color:var(--muted);font-size:0.78rem;">—</span>
                            {% else %}
                                <div class="assign-stats">
                                    <span class="assign-badge ab-total" title="Total envoyés">
                                        <i class="bi bi-send"></i>{{ s.total }}
                                    </span>
                                    {% if s.accepted > 0 %}
                                        <span class="assign-badge ab-accepted" title="Acceptés">
                                            <i class="bi bi-check"></i>{{ s.accepted }}
                                        </span>
                                    {% endif %}
                                    {% if s.pending > 0 %}
                                        <span class="assign-badge ab-pending" title="En attente">
                                            <i class="bi bi-hourglass-split"></i>{{ s.pending }}
                                        </span>
                                    {% endif %}
                                    {% if s.declined > 0 %}
                                        <span class="assign-badge ab-declined" title="Déclinés">
                                            <i class="bi bi-x"></i>{{ s.declined }}
                                        </span>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </td>
                        <td>
                            {% if program.isPublished %}
                                <span class="badge" style="background: rgba(34,211,165,.15); color: var(--success); border: 1px solid rgba(34,211,165,.25);">
                                    <i class="bi bi-eye-fill me-1"></i>Publié
                                </span>
                            {% else %}
                                <span class="badge" style="background: rgba(100,116,139,.15); color: var(--muted); border: 1px solid rgba(100,116,139,.25);">
                                    <i class="bi bi-eye-slash me-1"></i>Brouillon
                                </span>
                            {% endif %}
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex gap-1 justify-content-end flex-wrap">
                                {# Publish toggle #}
                                <form method="post" action="{{ path('admin_program_publish', {id: program.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('publish_program_' ~ program.id) }}">
                                    <button class="btn btn-sm" style="background: {{ program.isPublished ? 'rgba(245,158,11,.15)' : 'rgba(34,211,165,.15)' }}; color: {{ program.isPublished ? 'var(--warning)' : 'var(--success)' }};"
                                            title="{{ program.isPublished ? 'Dépublier' : 'Publier' }}">
                                        <i class="bi bi-{{ program.isPublished ? 'eye-slash' : 'eye' }}"></i>
                                    </button>
                                </form>
                                <a href="{{ path('admin_program_show', {id: program.id}) }}"
                                   class="btn btn-sm" style="background: rgba(59,130,246,.15); color: #60a5fa;" title="Voir / Assignations">
                                    <i class="bi bi-people"></i>
                                </a>
                                <a href="{{ path('admin_program_edit', {id: program.id}) }}"
                                   class="btn btn-sm" style="background: rgba(245,158,11,.15); color: var(--warning);" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post"
                                      action="{{ path('admin_program_delete', {id: program.id}) }}"
                                      onsubmit="return confirm('Supprimer ce programme ?');" style="display:inline-block;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_program_' ~ program.id) }}">
                                    <button class="btn btn-sm" style="background: rgba(255,77,109,.15); color: var(--danger);" title="Supprimer">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox display-6 d-block mb-2"></i>
                            {% if searchQuery %}
                                Aucun programme trouvé pour "<strong>{{ searchQuery }}</strong>". <a href="{{ path('admin_program_index') }}" style="color:var(--success);">Voir tous les programmes</a>
                            {% else %}
                                Aucun programme trouvé. <a href="{{ path('admin_program_new') }}" style="color:var(--success);">Créer le premier</a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
