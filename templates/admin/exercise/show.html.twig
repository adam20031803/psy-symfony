{% extends 'admin/base.html.twig' %}

{% block title %}{{ exercise.name }} — Admin{% endblock %}
{% block topbar_title %}Détail de l'exercice{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1>{{ exercise.name }}</h1>
        <div class="page-sub">Fiche détaillée</div>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_exercise_edit', {id: exercise.id}) }}" class="btn btn-warning text-dark">
            <i class="bi bi-pencil me-1"></i>Modifier
        </a>
        <a href="{{ path('admin_exercise_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Retour
        </a>
    </div>
</div>

<div class="row g-4">
    {# Left: image + quick stats #}
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                {% if exercise.imageUrl %}
                    <img src="{{ exercise.imageUrl }}" alt="{{ exercise.name }}"
                         class="img-fluid rounded-3 mb-3" style="max-height:220px;object-fit:cover;width:100%;">
                {% else %}
                    <div class="rounded-3 mb-3 d-flex align-items-center justify-content-center"
                         style="height:180px;background:linear-gradient(135deg,#dbeafe,#ede9fe);">
                        <i class="bi bi-image text-primary" style="font-size:3rem;opacity:0.5;"></i>
                    </div>
                {% endif %}

                <h4 class="fw-bold mb-1">{{ exercise.name }}</h4>

                {# Difficulty badge #}
                {% if exercise.difficulty == 'Débutant' %}
                    <span class="badge bg-success fs-6 mb-3">{{ exercise.difficulty }}</span>
                {% elseif exercise.difficulty == 'Intermédiaire' %}
                    <span class="badge bg-warning text-dark fs-6 mb-3">{{ exercise.difficulty }}</span>
                {% else %}
                    <span class="badge bg-danger fs-6 mb-3">{{ exercise.difficulty }}</span>
                {% endif %}

                <div class="row g-2 mt-2">
                    <div class="col-6">
                        <div class="stat-card flex-column text-center justify-content-center" style="gap:4px;">
                            <div style="font-size:1.3rem;font-weight:700;color:#2563eb;">{{ exercise.duration }}</div>
                            <div style="font-size:0.7rem;color:#94a3b8;text-transform:uppercase;">Minutes</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-card flex-column text-center justify-content-center" style="gap:4px;">
                            <div style="font-size:1.3rem;font-weight:700;color:#ef4444;">{{ exercise.calories }}</div>
                            <div style="font-size:0.7rem;color:#94a3b8;text-transform:uppercase;">Calories</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Right: full details #}
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header py-3">
                <i class="bi bi-info-circle me-2 text-primary"></i>Informations complètes
            </div>
            <div class="card-body p-4">
                <table class="table table-borderless mb-0">
                    <tbody>
                        <tr>
                            <td class="fw-semibold text-muted" style="width:35%;font-size:0.85rem;">Catégorie</td>
                            <td><span class="badge bg-primary bg-opacity-10 text-primary fs-6">{{ exercise.category }}</span></td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted" style="font-size:0.85rem;">Difficulté</td>
                            <td>{{ exercise.difficulty }}</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted" style="font-size:0.85rem;">Durée</td>
                            <td><i class="bi bi-clock me-1 text-muted"></i>{{ exercise.duration }} minutes</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted" style="font-size:0.85rem;">Calories</td>
                            <td><i class="bi bi-fire me-1 text-danger"></i>{{ exercise.calories }} kcal</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted" style="font-size:0.85rem;">Créé le</td>
                            <td>{{ exercise.createdAt|date('d/m/Y à H:i') }}</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted" style="font-size:0.85rem;">Mis à jour le</td>
                            <td>{{ exercise.updatedAt|date('d/m/Y à H:i') }}</td>
                        </tr>
                        {% if exercise.imageUrl %}
                            <tr>
                                <td class="fw-semibold text-muted" style="font-size:0.85rem;">Image URL</td>
                                <td><a href="{{ exercise.imageUrl }}" target="_blank" class="text-truncate d-block" style="max-width:300px;">{{ exercise.imageUrl }}</a></td>
                            </tr>
                        {% endif %}
                        <tr>
                            <td class="fw-semibold text-muted align-top" style="font-size:0.85rem;padding-top:12px;">Description</td>
                            <td style="padding-top:10px;line-height:1.7;color:#374151;">{{ exercise.description }}</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted" style="font-size:0.85rem;">Programmes liés</td>
                            <td>
                                {% if exercise.programs|length > 0 %}
                                    {% for prog in exercise.programs %}
                                        <span class="badge bg-info bg-opacity-10 text-info me-1">{{ prog.title }}</span>
                                    {% endfor %}
                                {% else %}
                                    <span class="text-muted fst-italic">Aucun programme lié</span>
                                {% endif %}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        {# Delete zone #}
        <div class="card mt-3 border-danger border-opacity-25">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold text-danger" style="font-size:0.875rem;">Zone de danger</div>
                    <div class="text-muted" style="font-size:0.78rem;">La suppression est irréversible.</div>
                </div>
                <form method="post" action="{{ path('admin_exercise_delete', {id: exercise.id}) }}"
                      onsubmit="return confirm('Supprimer définitivement cet exercice ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_exercise_' ~ exercise.id) }}">
                    <button class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash me-1"></i>Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
