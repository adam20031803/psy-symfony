{% extends 'admin/base.html.twig' %}

{% block title %}Modifier — {{ exercise.name }} — Admin{% endblock %}
{% block topbar_title %}Modifier l'exercice{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1><i class="bi bi-pencil-square me-2 text-warning"></i>Modifier l'exercice</h1>
        <div class="page-sub">{{ exercise.name }}</div>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_exercise_show', {id: exercise.id}) }}" class="btn btn-outline-secondary">
            <i class="bi bi-eye me-1"></i>Voir
        </a>
        <a href="{{ path('admin_exercise_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Liste
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header py-3">
                <i class="bi bi-activity me-2 text-warning"></i>Modifier les informations
            </div>
            <div class="card-body p-4">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                <div class="row g-3">
                    <div class="col-12">
                        {{ form_label(form.name) }}
                        {{ form_widget(form.name) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.name) }}</div>
                    </div>
                    <div class="col-12">
                        {{ form_label(form.description) }}
                        {{ form_widget(form.description) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.description) }}</div>
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.category) }}
                        {{ form_widget(form.category) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.category) }}</div>
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.difficulty) }}
                        {{ form_widget(form.difficulty) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.difficulty) }}</div>
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.duration) }}
                        <div class="input-group">
                            {{ form_widget(form.duration) }}
                            <span class="input-group-text">min</span>
                        </div>
                        <div class="text-danger small mt-1">{{ form_errors(form.duration) }}</div>
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.calories) }}
                        <div class="input-group">
                            {{ form_widget(form.calories) }}
                            <span class="input-group-text">kcal</span>
                        </div>
                        <div class="text-danger small mt-1">{{ form_errors(form.calories) }}</div>
                    </div>
                    <div class="col-12">
                        {{ form_label(form.imageUrl) }}
                        {{ form_widget(form.imageUrl) }}
                        <div class="form-text">Optionnel — URL d'une image</div>
                        <div class="text-danger small mt-1">{{ form_errors(form.imageUrl) }}</div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4 pt-3" style="border-top:1px solid #e2e8f0;">
                    <button type="submit" class="btn btn-warning px-4 text-dark fw-semibold">
                        <i class="bi bi-check-lg me-1"></i>Enregistrer les modifications
                    </button>
                    <a href="{{ path('admin_exercise_index') }}" class="btn btn-outline-secondary">Annuler</a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
