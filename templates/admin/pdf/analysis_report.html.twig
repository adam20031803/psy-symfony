<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Rapport d'Intelligence Fitness — Atomic You</title>
    <style>
        body {
            font-family: 'Helvetica', 'Arial', sans-serif;
            color: #1a1a1a;
            line-height: 1.5;
            margin: 0;
            padding: 0;
        }
        .header {
            border-bottom: 2px solid #6366f1;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #6366f1;
        }
        .date {
            float: right;
            font-size: 12px;
            color: #666;
            margin-top: 10px;
        }
        h1 {
            font-size: 20px;
            margin: 0;
            color: #111;
        }
        .kpi-container {
            margin-bottom: 30px;
        }
        .kpi-row {
            width: 100%;
            margin-bottom: 15px;
        }
        .kpi-card {
            display: inline-block;
            width: 30%;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 15px;
            border-radius: 8px;
            margin-right: 2%;
            text-align: center;
        }
        .kpi-label {
            font-size: 11px;
            color: #64748b;
            text-transform: uppercase;
            margin-bottom: 5px;
        }
        .kpi-value {
            font-size: 18px;
            font-weight: bold;
            color: #1e293b;
        }
        .section {
            margin-bottom: 30px;
        }
        .section-title {
            font-size: 14px;
            font-weight: bold;
            text-transform: uppercase;
            color: #475569;
            border-left: 4px solid #6366f1;
            padding-left: 10px;
            margin-bottom: 15px;
        }
        .content-box {
            background: #ffffff;
            border: 1px solid #f1f5f9;
            padding: 15px;
            font-size: 13px;
        }
        /* Progress Bars for Charts */
        .bar-container {
            margin-bottom: 10px;
        }
        .bar-label {
            font-size: 12px;
            margin-bottom: 4px;
        }
        .bar-track {
            height: 12px;
            background: #e2e8f0;
            border-radius: 6px;
            width: 100%;
        }
        .bar-fill {
            height: 12px;
            background: #6366f1;
            border-radius: 6px;
        }
        .footer {
            position: fixed;
            bottom: 30px;
            left: 0;
            right: 0;
            font-size: 10px;
            color: #94a3b8;
            text-align: center;
            border-top: 1px solid #f1f5f9;
            padding-top: 10px;
        }
    </style>
</head>
<body>
    <div class="header">
        <span class="date">Généré le {{ exported_at|date('d/m/Y H:i') }}</span>
        <div class="logo">ATOMIC YOU</div>
        <h1>Rapport d'Intelligence Fitness</h1>
    </div>

    {# KPI Section #}
    <div class="section">
        <div class="section-title">Indicateurs de Performance</div>
        <div class="kpi-container">
            {% for kpi in kpis %}
                <div class="kpi-card">
                    <div class="kpi-label">{{ kpi.label }}</div>
                    <div class="kpi-value">{{ kpi.value }} {{ kpi.unit }}</div>
                </div>
            {% endfor %}
        </div>
    </div>

    {# Executive Summary #}
    <div class="section">
        <div class="section-title">Résumé Exécutif</div>
        <div class="content-box">
            {{ summary|nl2br }}
        </div>
    </div>

    {# Data Visualization (Chart replacement) #}
    {% if chartData and chartData.labels %}
    <div class="section">
        <div class="section-title">Équilibre du Catalogue</div>
        <div class="content-box">
            {% set maxVal = 1 %}
            {% for val in chartData.values %}
                {% if val > maxVal %}{% set maxVal = val %}{% endif %}
            {% endfor %}

            {% for i, label in chartData.labels %}
                {% set percent = (chartData.values[i] / maxVal * 100)|round %}
                <div class="bar-container">
                    <div class="bar-label">{{ label }} ({{ chartData.values[i] }})</div>
                    <div class="bar-track">
                        <div class="bar-fill" style="width: {{ percent }}%;"></div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# Detailed Advice #}
    <div class="section">
        <div class="section-title">Recommandations du Coach Expert</div>
        <div class="content-box" style="white-space: pre-wrap;">{{ advice }}</div>
    </div>

    <div class="footer">
        Document confidentiel — Atomic You Fitness AI Service — &copy; {{ "now"|date("Y") }}
    </div>
</body>
</html>
