{% extends 'admin/base.html.twig' %}

{% block title %}Utilisateurs — Atomic You Admin{% endblock %}

{% block stylesheets %}
<style>
    .badge-active   { background: rgba(34,211,165,.15); color: var(--success); }
    .badge-inactive { background: rgba(255,77,109,.12); color: var(--danger); }
    .badge-admin    { background: rgba(108,99,255,.2); color: #a29bfe; }
    .badge-coach    { background: rgba(245,158,11,.2); color: var(--warning); }
    .badge-user     { background: rgba(100,116,139,.15); color: var(--muted); }

    .user-cell { display: flex; align-items: center; gap: 12px; }
    .avatar {
        width: 36px; height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6c63ff, #00d2ff);
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 0.8rem;
        flex-shrink: 0;
        color: #fff;
    }
    .user-name { font-weight: 500; color: var(--text); }
    .user-email { font-size: 0.75rem; color: var(--muted); }

    .role-select {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 7px;
        color: var(--text);
        font-family: inherit;
        font-size: 0.75rem;
        padding: 4px 8px;
        cursor: pointer;
        outline: none;
    }
    .actions { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }

    .btn-activate   { background: rgba(34,211,165,.15); color: #22d3a5; border: 1px solid rgba(34,211,165,.3); }
    .btn-activate:hover { background: rgba(34,211,165,.28); }
    .btn-deactivate { background: rgba(239,68,68,.12); color: #ef4444; border: 1px solid rgba(239,68,68,.3); }
    .btn-deactivate:hover { background: rgba(239,68,68,.25); }
    .btn-magic      { background: rgba(139,92,246,.15); color: #a78bfa; border: 1px solid rgba(139,92,246,.3); font-size: 0.72rem; }
    .btn-magic:hover { background: rgba(139,92,246,.28); }

    .search-box {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 7px 14px;
        color: var(--text);
        font-size: 0.83rem;
        font-family: inherit;
        width: 200px;
        outline: none;
        transition: border-color .2s;
    }
    .search-box:focus { border-color: var(--accent); }
</style>
{% endblock %}

{% block content %}
    <div class="page-header">
        <div>
            <h1>Gestion des Utilisateurs</h1>
            <p>Liste complète des membres enregistrés sur la plateforme</p>
        </div>
        <span class="admin-badge">⚡ {{ stats.total }} MEMBRES</span>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon purple">👥</div>
            <div>
                <div class="stat-label">Total utilisateurs</div>
                <div class="stat-value">{{ stats.total }}</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon blue">🛡️</div>
            <div>
                <div class="stat-label">Admin & Coachs</div>
                <div class="stat-value">{{ stats.admins }}</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green">✅</div>
            <div>
                <div class="stat-label">Comptes actifs</div>
                <div class="stat-value">{{ stats.active }}</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon orange">⏳</div>
            <div>
                <div class="stat-label">Comptes inactifs</div>
                <div class="stat-value">{{ stats.total - stats.active }}</div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="table-card">
        <div class="table-header">
            <h2>Liste des utilisateurs</h2>
            <input class="search-box" type="text" id="searchInput" placeholder="🔍 Rechercher…" onkeyup="filterTable()">
        </div>
        <table id="usersTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Utilisateur</th>
                    <th>Email</th>
                    <th>Rôle</th>
                    <th>Statut</th>
                    <th>Inscrit le</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td style="color:var(--muted)">{{ user.id }}</td>

                    <td>
                        <div class="user-cell">
                            <div class="avatar">{{ user.prenom|slice(0,1)|upper }}{{ user.nom|slice(0,1)|upper }}</div>
                            <div>
                                <div class="user-name">{{ user.prenom }} {{ user.nom }}</div>
                                {% if user.age %}<div class="user-email">{{ user.age }} ans</div>{% endif %}
                            </div>
                        </div>
                    </td>

                    <td style="color:var(--muted)">{{ user.email }}</td>

                    <td>
                        <form method="post" action="{{ path('app_admin_change_role', {id: user.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('change_role'~user.id) }}">
                            <select name="role" class="role-select" onchange="this.form.submit()">
                                <option value="user"  {% if user.role == 'user'  %}selected{% endif %}>User</option>
                                <option value="coach" {% if user.role == 'coach' %}selected{% endif %}>Coach</option>
                                <option value="admin" {% if user.role == 'admin' %}selected{% endif %}>Admin</option>
                            </select>
                        </form>
                    </td>

                    <td>
                        <span class="badge {{ user.isActive ? 'badge-active' : 'badge-inactive' }}">
                            {{ user.isActive ? '● Actif' : '○ Inactif' }}
                        </span>
                    </td>

                    <td style="color:var(--muted)">{{ user.createdAt ? user.createdAt|date('d/m/Y') : '—' }}</td>

                    <td>
                        <div class="actions">
                            {# Edit button #}
                            <a href="{{ path('app_admin_user_edit', {id: user.id}) }}"
                               class="btn" style="background: rgba(108,99,255,.15); color: var(--accent); padding: 5px 10px;">
                                ✏️ Éditer
                            </a>

                            {# Activate button — only shown when inactive #}
                            {% if not user.isActive %}
                            <form method="post" action="{{ path('app_admin_activate_user', {id: user.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('activate'~user.id) }}">
                                <button class="btn btn-activate" type="submit" title="Activer ce compte">
                                    ✅ Activer
                                </button>
                            </form>
                            {% endif %}

                            {# Deactivate button — only shown when active #}
                            {% if user.isActive %}
                            <form method="post" action="{{ path('app_admin_deactivate_user', {id: user.id}) }}"
                                  onsubmit="return confirm('Désactiver le compte de {{ user.prenom }} {{ user.nom }} ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('deactivate'~user.id) }}">
                                <button class="btn btn-deactivate" type="submit" title="Désactiver ce compte">
                                    🔕 Désactiver
                                </button>
                            </form>
                            {% endif %}

                            {# Magic Login Link — only available if account is active #}
                            {% if user.isActive %}
                            <form method="post" action="{{ path('app_admin_send_magic_link', {id: user.id}) }}"
                                  onsubmit="return confirm('Envoyer un lien de connexion magique à {{ user.email }} ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('magic_link'~user.id) }}">
                                <button class="btn btn-magic" type="submit" title="Envoyer un lien de connexion sans mot de passe">
                                    🔗 Magic Link
                                </button>
                            </form>
                            {% endif %}

                            {# Delete button #}
                            <form method="post" action="{{ path('app_admin_delete_user', {id: user.id}) }}"
                                  onsubmit="return confirm('Supprimer cet utilisateur ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete'~user.id) }}">
                                <button class="btn btn-danger" type="submit" style="padding: 5px 10px;" title="Supprimer l'utilisateur">🗑️</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" style="text-align:center;color:var(--muted);padding:40px">
                        Aucun utilisateur trouvé.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% block javascripts %}
<script>
function filterTable() {
    const q = document.getElementById('searchInput').value.toLowerCase();
    document.querySelectorAll('#usersTable tbody tr').forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
}
</script>
{% endblock %}

