<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des Habitudes — Atomic You Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg:        #0d0f1a;
            --surface:   #141627;
            --card:      #1a1d30;
            --border:    rgba(255,255,255,0.07);
            --accent:    #22d3a5; /* Green/teal for habits */
            --accent2:   #6c63ff;
            --danger:    #ff4d6d;
            --success:   #22d3a5;
            --warning:   #f59e0b;
            --orange:    #f97316;
            --text:      #e2e8f0;
            --muted:     #64748b;
            --radius:    14px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
        }

        /* ── Sidebar ── */
        .sidebar {
            width: 240px;
            min-height: 100vh;
            background: var(--surface);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            padding: 28px 0;
            position: sticky;
            top: 0;
        }
        .sidebar-logo {
            display: flex; align-items: center; gap: 10px;
            padding: 0 24px 32px;
            font-size: 1.25rem; font-weight: 700;
        }
        .sidebar-logo .icon {
            width: 38px; height: 38px;
            background: linear-gradient(135deg, #6c63ff, #00d2ff);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem;
        }
        .sidebar-logo span { color: #00d2ff; }
        .sidebar-logo strong { color: var(--text); }

        .nav-label {
            font-size: 0.65rem; font-weight: 600; letter-spacing: .1em;
            text-transform: uppercase; color: var(--muted);
            padding: 0 24px 8px; margin-top: 10px;
        }
        .nav-item {
            display: flex; align-items: center; gap: 12px;
            padding: 11px 24px; color: var(--muted);
            text-decoration: none; font-size: 0.88rem; font-weight: 500;
            border-left: 3px solid transparent; transition: all .2s;
        }
        .nav-item:hover, .nav-item.active {
            color: var(--text);
            background: rgba(34,211,165,.08);
            border-left-color: var(--accent);
        }
        .nav-item.danger:hover { color: var(--danger); border-left-color: var(--danger); background: rgba(255,77,109,.06); }
        .nav-icon { font-size: 1rem; width: 18px; text-align: center; }
        .nav-icon-sub { padding-left: 14px; font-size: 0.9rem; }
        .sidebar-spacer { flex: 1; }

        /* ── Main ── */
        .main { flex: 1; padding: 32px 36px; overflow-x: auto; }

        /* ── Header ── */
        .page-header {
            display: flex; justify-content: space-between;
            align-items: center; margin-bottom: 32px;
        }
        .page-header h1 { font-size: 1.5rem; font-weight: 700; color: #fff; }
        .page-header p { color: var(--muted); font-size: 0.85rem; margin-top: 3px; }
        .admin-badge {
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            padding: 6px 14px; border-radius: 999px;
            font-size: 0.75rem; font-weight: 600; color: #fff;
        }

        /* ── Flash ── */
        .flash { padding: 12px 18px; border-radius: var(--radius); margin-bottom: 20px; font-size: 0.85rem; }
        .flash-success { background: rgba(34,211,165,.12); border: 1px solid rgba(34,211,165,.3); color: var(--success); }
        .flash-danger  { background: rgba(255,77,109,.12); border: 1px solid rgba(255,77,109,.3); color: var(--danger); }

        /* ── Stats ── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-bottom: 32px;
        }
        .stat-card {
            background: var(--card); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 22px 24px;
            display: flex; align-items: center; gap: 18px;
            transition: transform .2s, box-shadow .2s;
        }
        .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.3); }
        .stat-icon {
            width: 48px; height: 48px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center; font-size: 1.4rem;
        }
        .stat-icon.green  { background: rgba(34,211,165,.15); }
        .stat-icon.purple { background: rgba(108,99,255,.15); }
        .stat-icon.orange { background: rgba(249,115,22,.15); }
        .stat-label { font-size: 0.78rem; color: var(--muted); margin-bottom: 4px; }
        .stat-value { font-size: 1.8rem; font-weight: 700; }

        /* ── Category breakdown ── */
        .breakdown-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 12px;
            margin-bottom: 32px;
        }
        .breakdown-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 16px;
            text-align: center;
        }
        .breakdown-card .bc-emoji { font-size: 1.6rem; display: block; margin-bottom: 6px; }
        .breakdown-card .bc-label { font-size: 0.72rem; color: var(--muted); text-transform: uppercase; font-weight: 600; }
        .breakdown-card .bc-count { font-size: 1.4rem; font-weight: 700; color: var(--accent); }

        /* ── Table ── */
        .table-card {
            background: var(--card); border: 1px solid var(--border);
            border-radius: var(--radius); overflow: hidden; margin-bottom: 32px;
        }
        .table-header {
            padding: 20px 24px; border-bottom: 1px solid var(--border);
            display: flex; align-items: center; justify-content: space-between;
        }
        .table-header h2 { font-size: 1rem; font-weight: 600; color: #fff; }
        .search-box {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: 8px; padding: 7px 14px; color: var(--text);
            font-size: 0.83rem; font-family: inherit; width: 220px;
            outline: none; transition: border-color .2s;
        }
        .search-box:focus { border-color: var(--accent); }

        table { width: 100%; border-collapse: collapse; }
        thead th {
            padding: 12px 20px; text-align: left; font-size: 0.72rem;
            font-weight: 600; letter-spacing: .06em; text-transform: uppercase;
            color: var(--muted); border-bottom: 1px solid var(--border);
        }
        tbody tr { border-bottom: 1px solid var(--border); transition: background .15s; }
        tbody tr:last-child { border-bottom: none; }
        tbody tr:hover { background: rgba(255,255,255,.02); }
        tbody td { padding: 14px 20px; font-size: 0.85rem; vertical-align: middle; }

        .user-cell { display: flex; align-items: center; gap: 10px; }
        .avatar {
            width: 32px; height: 32px; border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 0.7rem; flex-shrink: 0; color: #fff;
        }
        .user-name { font-weight: 500; font-size: 0.8rem; }
        .user-email { font-size: 0.7rem; color: var(--muted); }

        /* Badges */
        .badge {
            display: inline-flex; align-items: center;
            padding: 3px 10px; border-radius: 999px;
            font-size: 0.72rem; font-weight: 600;
        }
        .badge-active   { background: rgba(34,211,165,.12); color: var(--success); border: 1px solid rgba(34,211,165,.25); }
        .badge-inactive { background: rgba(100,116,139,.12); color: var(--muted); border: 1px solid rgba(100,116,139,.25); }
        .badge-cat      { background: rgba(108,99,255,.12); color: #a78bfa; border: 1px solid rgba(108,99,255,.2); }

        /* Streaks */
        .streak-cell { display: flex; gap: 12px; }
        .streak-item { display: flex; flex-direction: column; align-items: center; }
        .streak-num { font-size: 1rem; font-weight: 700; color: var(--orange); }
        .streak-lbl { font-size: 0.6rem; color: var(--muted); text-transform: uppercase; }

        /* Actions */
        .actions { display: flex; gap: 6px; align-items: center; }
        .btn {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 5px 12px; border-radius: 7px; font-size: 0.75rem;
            font-weight: 600; border: none; cursor: pointer;
            font-family: inherit; text-decoration: none; transition: opacity .2s, transform .15s;
        }
        .btn:hover { opacity: .85; transform: translateY(-1px); }
        .btn-see    { background: rgba(59,130,246,.15); color: #60a5fa; }
        .btn-delete { background: rgba(255,77,109,.15); color: var(--danger); }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,.1); border-radius: 3px; }
    </style>
</head>
<body>

<!-- ── Sidebar ── -->
{% include 'components/admin_sidebar.html.twig' %}

<!-- ── Main ── -->
<main class="main">

    <!-- Header -->
    <div class="page-header">
        <div>
            <h1>🎯 Gestion des Habitudes</h1>
            <p>Supervisez et modérez toutes les habitudes des utilisateurs</p>
        </div>
        <span class="admin-badge">⚡ ADMIN</span>
    </div>

    <!-- Flash messages -->
    {% for msg in app.flashes('success') %}
        <div class="flash flash-success">✅ {{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('danger') %}
        <div class="flash flash-danger">❌ {{ msg }}</div>
    {% endfor %}

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon green">🎯</div>
            <div>
                <div class="stat-label">Total Habitudes</div>
                <div class="stat-value">{{ stats.total }}</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon purple">✨</div>
            <div>
                <div class="stat-label">Habitudes Actives</div>
                <div class="stat-value">{{ stats.active }}</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon orange">💤</div>
            <div>
                <div class="stat-label">Habitudes Inactives</div>
                <div class="stat-value">{{ stats.completed }}</div>
            </div>
        </div>
    </div>

    <!-- Category Breakdown -->
    {% set categories = {} %}
    {% for h in habitudes %}
        {% set cat = h.category %}
        {% if cat %}
            {% set categories = categories|merge({(cat): (categories[cat] is defined ? categories[cat] + 1 : 1)}) %}
        {% endif %}
    {% endfor %}

    {% if categories|length > 0 %}
    <div style="margin-bottom: 14px; font-size: 0.72rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--muted);">
        Répartition par catégorie
    </div>
    <div class="breakdown-grid">
        {% set catEmojis = {
            'sport': '🏋️', 'health': '❤️', 'meditation': '🧘', 'nutrition': '🥗',
            'sleep': '😴', 'learning': '📚', 'productivity': '⚡', 'mindfulness': '🌿',
            'social': '👥', 'creativity': '🎨', 'finance': '💰', 'other': '✨'
        } %}
        {% for catName, count in categories %}
            <div class="breakdown-card">
                <span class="bc-emoji">{{ catEmojis[catName]|default('🎯') }}</span>
                <div class="bc-label">{{ catName }}</div>
                <div class="bc-count">{{ count }}</div>
            </div>
        {% endfor %}
    </div>
    {% endif %}

    <!-- Table -->
    <div class="table-card">
        <div class="table-header">
            <h2>Liste de toutes les habitudes</h2>
            <input class="search-box" type="text" id="searchInput" placeholder="🔍 Rechercher une habitude…" onkeyup="filterTable()">
        </div>
        <table id="habitudesTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Utilisateur</th>
                    <th>Titre</th>
                    <th>Catégorie</th>
                    <th>Fréquence</th>
                    <th>Séries</th>
                    <th>Complétions</th>
                    <th>Période</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for h in habitudes %}
                <tr>
                    <td style="color:var(--muted)">{{ h.id }}</td>

                    <td>
                        <div class="user-cell">
                            <div class="avatar">
                                {% if h.user %}
                                    {{ h.user.prenom|slice(0,1)|upper }}{{ h.user.nom|slice(0,1)|upper }}
                                {% else %}?{% endif %}
                            </div>
                            <div>
                                <div class="user-name">
                                    {% if h.user %}{{ h.user.prenom }} {{ h.user.nom }}{% else %}<em style="color:var(--muted)">Anonyme</em>{% endif %}
                                </div>
                                {% if h.user %}
                                    <div class="user-email">{{ h.user.email }}</div>
                                {% endif %}
                            </div>
                        </div>
                    </td>

                    <td>
                        <div style="font-weight: 600;">{{ h.title }}</div>
                        {% if h.description %}
                            <div style="font-size:0.75rem; color:var(--muted); margin-top:2px;">{{ h.description|slice(0,55) }}{% if h.description|length > 55 %}…{% endif %}</div>
                        {% endif %}
                    </td>

                    <td>
                        <span class="badge badge-cat">{{ h.category }}</span>
                    </td>

                    <td style="color:var(--muted); font-size:0.78rem;">
                        {% if h.frequencyType == 1 %}📅 Quotidien
                        {% elseif h.frequencyType == 7 %}📆 Hebdomadaire
                        {% elseif h.frequencyType == 30 %}🗓️ Mensuel
                        {% else %}🔁 {{ h.frequencyType }}x
                        {% endif %}
                    </td>

                    <td>
                        <div class="streak-cell">
                            <div class="streak-item">
                                <span class="streak-num">{{ h.currentStreak }}</span>
                                <span class="streak-lbl">actuelle</span>
                            </div>
                            <div class="streak-item">
                                <span class="streak-num" style="color: var(--accent2);">{{ h.longestStreak }}</span>
                                <span class="streak-lbl">record</span>
                            </div>
                        </div>
                    </td>

                    <td>
                        <div style="font-size:1rem; font-weight:700; color:var(--accent);">{{ h.totalCompletions }}</div>
                        <div style="font-size:0.65rem; color:var(--muted);">fois complétée</div>
                    </td>

                    <td style="font-size:0.75rem; color:var(--muted);">
                        <div>📅 {{ h.startDate|date('d/m/Y') }}</div>
                        {% if h.endDate %}
                            <div>🏁 {{ h.endDate|date('d/m/Y') }}</div>
                        {% endif %}
                    </td>

                    <td>
                        {% if h.isActive %}
                            <span class="badge badge-active">✅ Active</span>
                        {% else %}
                            <span class="badge badge-inactive">💤 Inactive</span>
                        {% endif %}
                    </td>

                    <td>
                        <div class="actions">
                            <a href="{{ path('app_habitude_show', {id: h.id}) }}" target="_blank" class="btn btn-see">👁️ Voir</a>
                            <form method="post" action="{{ path('app_admin_habitude_delete', {id: h.id}) }}"
                                  onsubmit="return confirm('Supprimer cette habitude et toutes ses données ? Cette action est irréversible.')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_admin_habitude'~h.id) }}">
                                <button class="btn btn-delete" type="submit">🗑️</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="10" style="text-align:center; color:var(--muted); padding:40px;">
                        <span style="font-size:2rem; display:block; margin-bottom:8px;">🎯</span>
                        Aucune habitude enregistrée pour le moment.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

</main>

<script>
function filterTable() {
    const q = document.getElementById('searchInput').value.toLowerCase();
    document.querySelectorAll('#habitudesTable tbody tr').forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
}
</script>
</body>
</html>
