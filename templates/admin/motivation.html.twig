<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Motivation Hub — PsyApp Admin Pro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg: #080a12; --surface: #0e111f; --card: rgba(255, 255, 255, 0.03); 
            --border: rgba(255, 255, 255, 0.08);
            --p-accent: #8b5cf6; --p-accent-glow: rgba(139, 92, 246, 0.3);
            --s-accent: #06b6d4; --s-accent-glow: rgba(6, 182, 212, 0.3);
            --danger: #ef4444; --success: #10b981; --warning: #f59e0b;
            --text: #f8fafc; --muted: #94a3b8; --radius: 20px;
        }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; display: flex; overflow-x: hidden; }

        /* ── Sidebar (Premium Dark) ── */
        .sidebar { width: 260px; min-height: 100vh; background: var(--surface); border-right: 1px solid var(--border); display: flex; flex-direction: column; padding: 32px 0; position: sticky; top: 0; z-index: 100; }
        .sidebar-logo { display: flex; align-items: center; gap: 12px; padding: 0 28px 40px; font-size: 1.4rem; font-weight: 700; letter-spacing: -0.5px; }
        .sidebar-logo .icon { width: 42px; height: 42px; background: linear-gradient(135deg, var(--p-accent), var(--s-accent)); border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 16px rgba(0,0,0,0.4); }
        .sidebar-logo span { color: var(--s-accent); }
        .nav-label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--muted); padding: 0 28px 12px; opacity: 0.6; }
        .nav-item { display: flex; align-items: center; gap: 14px; padding: 14px 28px; color: var(--muted); text-decoration: none; font-size: 0.95rem; font-weight: 500; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); margin: 2px 12px; border-radius: 12px; }
        .nav-item:hover, .nav-item.active { color: #fff; background: rgba(255,255,255,0.05); }
        .nav-item.active { background: linear-gradient(90deg, rgba(139, 92, 246, 0.15) 0%, rgba(255, 255, 255, 0) 100%); color: var(--p-accent); position: relative; }
        .nav-item.active::after { content: ''; position: absolute; left: 4px; top: 12px; bottom: 12px; width: 4px; background: var(--p-accent); border-radius: 10px; box-shadow: 0 0 10px var(--p-accent); }
        .nav-icon { font-size: 1.1rem; }

        /* ── Main Layout ── */
        .main { flex: 1; padding: 40px 48px; max-width: 1600px; margin: 0 auto; position: relative; }
        .bg-glow { position: absolute; top: -100px; right: -100px; width: 400px; height: 400px; background: radial-gradient(circle, var(--p-accent-glow) 0%, transparent 70%); z-index: -1; pointer-events: none; }

        .header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 48px; }
        .header h1 { font-family: 'Outfit', sans-serif; font-size: 2.2rem; font-weight: 700; letter-spacing: -1px; }
        .header p { color: var(--muted); font-size: 1rem; margin-top: 6px; }

        /* ── Stats Grid (Floating Effect) ── */
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 48px; }
        .stat-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 28px; position: relative; overflow: hidden; backdrop-filter: blur(10px); transition: all 0.3s ease; }
        .stat-card:hover { border-color: rgba(255,255,255,0.2); transform: translateY(-5px); box-shadow: 0 20px 40px rgba(0,0,0,0.4); }
        .stat-icon { position: absolute; top: -10px; right: -10px; font-size: 5rem; opacity: 0.05; transform: rotate(15deg); }
        .stat-value { font-size: 2rem; font-weight: 700; margin-bottom: 4px; font-family: 'Outfit', sans-serif; }
        .stat-label { font-size: 0.85rem; color: var(--muted); font-weight: 600; display: flex; align-items: center; gap: 8px; }
        .stat-label::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--dot-color, var(--p-accent)); }

        /* ── Main Content Grid ── */
        .content-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 32px; }
        .card-panel { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 32px; backdrop-filter: blur(10px); }
        .panel-title { font-size: 1.25rem; font-weight: 700; margin-bottom: 28px; display: flex; align-items: center; justify-content: space-between; }

        /* ── Entities Hub (The Wow Factor) ── */
        .entity-hubs { display: grid; grid-template-columns: 1fr; gap: 24px; }
        .hub-item { background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 18px; padding: 24px; display: flex; align-items: center; gap: 20px; text-decoration: none; color: inherit; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
        .hub-item:hover { background: rgba(255,255,255,0.06); border-color: var(--h-color); transform: scale(1.02) translateX(10px); }
        .hub-icon { width: 64px; height: 64px; border-radius: 16px; background: var(--h-bg); display: flex; align-items: center; justify-content: center; font-size: 1.8rem; box-shadow: 0 10px 20px var(--h-glow); }
        .hub-info { flex: 1; }
        .hub-info h4 { font-size: 1.1rem; font-weight: 700; margin-bottom: 4px; }
        .hub-info p { font-size: 0.85rem; color: var(--muted); }
        .hub-arrow { font-size: 1.2rem; opacity: 0; transition: 0.3s; color: var(--h-color); }
        .hub-item:hover .hub-arrow { opacity: 1; transform: translateX(5px); }

        /* ── Charts Card ── */
        .chart-section { display: grid; grid-template-columns: 1fr; gap: 32px; }
        .chart-wrapper { position: relative; height: 260px; }

        /* ── Floating Actions ── */
        .btn-premium { background: linear-gradient(135deg, var(--p-accent), var(--s-accent)); color: white; border: none; padding: 12px 24px; border-radius: 12px; font-weight: 700; font-size: 0.9rem; cursor: pointer; transition: 0.3s; display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
        .btn-premium:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(139, 92, 246, 0.4); }

        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
    </style>
</head>
<body>

<aside class="sidebar">
    <div class="sidebar-logo">
        <div class="icon">🧠</div>
        <div><strong>Psy</strong><span>App</span> <small style="font-size: 0.6rem; opacity: 0.5; display: block; margin-top: -5px; font-weight: 500;">ADMIN PRO</small></div>
    </div>
    
    <div class="nav-label">Principal</div>
    <a href="{{ path('app_admin') }}" class="nav-item">
        <span class="nav-icon">👤</span> Utilisateurs
    </a>
    <a href="{{ path('app_admin') }}#section-reclamations" class="nav-item">
        <span class="nav-icon">📬</span> Réclamations
    </a>
    <a href="{{ path('app_admin_motivation') }}" class="nav-item active">
        <span class="nav-icon">🚀</span> Motivation Hub
    </a>
    <a href="{{ path('app_admin_posts') }}" class="nav-item">
        <span class="nav-icon">💬</span> Posts Forum
    </a>

    <div class="sidebar-spacer" style="flex:1;"></div>
    <div class="nav-label">Système</div>
    <a href="{{ path('post_index') }}" class="nav-item">
        <span class="nav-icon">🏠</span> Retour au Site
    </a>
    <a href="{{ path('app_logout') }}" class="nav-item danger" style="color: var(--danger);">
        <span class="nav-icon">🚪</span> Déconnexion
    </a>
</aside>

<main class="main">
    <div class="bg-glow"></div>
    
    <div class="header">
        <div>
            <h1>Motivation Hub</h1>
            <p>Intelligence motivationnelle et gestion des succès</p>
        </div>
        <div style="display:flex; gap:12px;">
            <a href="{{ path('app_challenge_new') }}" class="btn-premium"><span>+</span> Nouveau Challenge</a>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="stats-grid">
        <div class="stat-card" style="--dot-color: var(--p-accent);">
            <div class="stat-icon">🏆</div>
            <div class="stat-label">Challenges</div>
            <div class="stat-value">{{ stats.ch_total }}</div>
            <div style="font-size: 0.75rem; color: var(--success);">{{ stats.ch_active }} actifs maintenant</div>
        </div>
        <div class="stat-card" style="--dot-color: var(--s-accent);">
            <div class="stat-icon">👨‍🏫</div>
            <div class="stat-label">Experts Coaches</div>
            <div class="stat-value">{{ stats.co_total }}</div>
            <div style="font-size: 0.75rem; color: var(--muted);">{{ stats.co_active }} en ligne</div>
        </div>
        <div class="stat-card" style="--dot-color: var(--warning);">
            <div class="stat-icon">🎁</div>
            <div class="stat-label">Récompenses</div>
            <div class="stat-value">{{ stats.rec_total }}</div>
            <div style="font-size: 0.75rem; color: var(--muted);">Catalogue de prix</div>
        </div>
        <div class="stat-card" style="--dot-color: var(--danger);">
            <div class="stat-icon">📈</div>
            <div class="stat-label">Points Distribués</div>
            <div class="stat-value">{{ stats.rec_points }}</div>
            <div style="font-size: 0.75rem; color: var(--success);">+14% cette semaine</div>
        </div>
    </div>

    <div class="content-grid">
        <!-- Visualization -->
        <div class="card-panel">
            <div class="panel-title">
                Analyses de Performance
                <span style="font-size: 0.75rem; color: var(--muted); font-weight: normal;">Live Data Updates</span>
            </div>
            
            <div class="chart-section">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px;">
                    <div class="chart-wrapper">
                        <canvas id="mainChart"></canvas>
                    </div>
                    <div class="chart-wrapper">
                        <canvas id="coachChart"></canvas>
                    </div>
                </div>
            </div>

            <div style="margin-top: 40px; padding-top: 32px; border-top: 1px solid var(--border);">
                <h4 style="margin-bottom: 20px;">Dernières Activités Motivation</h4>
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    {% for challenge in challenges|slice(0, 3) %}
                    <div style="background: rgba(255,255,255,0.02); padding: 12px 16px; border-radius: 12px; display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 8px; height: 8px; border-radius: 50%; background: var(--p-accent);"></div>
                            <span style="font-weight: 600;">{{ challenge.titre }}</span>
                        </div>
                        <span style="font-size: 0.8rem; color: var(--muted);">Démarré le {{ challenge.dateDebut|date('d M') }}</span>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Entity Hubs -->
        <div style="display: flex; flex-direction: column; gap: 32px;">
            <div class="card-panel">
                <div class="panel-title">Gestion des Entités</div>
                <div class="entity-hubs">
                    <a href="{{ path('app_challenge_index') }}" class="hub-item" style="--h-color: var(--p-accent); --h-bg: rgba(139, 92, 246, 0.1); --h-glow: rgba(139, 92, 246, 0.2);">
                        <div class="hub-icon">🏆</div>
                        <div class="hub-info">
                            <h4>Challenges</h4>
                            <p>Objectifs, gamification et suivi</p>
                        </div>
                        <div class="hub-arrow">→</div>
                    </a>
                    
                    <a href="{{ path('app_coach_index') }}" class="hub-item" style="--h-color: var(--s-accent); --h-bg: rgba(6, 182, 212, 0.1); --h-glow: rgba(6, 182, 212, 0.2);">
                        <div class="hub-icon">👨‍🏫</div>
                        <div class="hub-info">
                            <h4>Coaches</h4>
                            <p>Experts, sessions et annuaire</p>
                        </div>
                        <div class="hub-arrow">→</div>
                    </a>

                    <a href="{{ path('app_recompense_index') }}" class="hub-item" style="--h-color: var(--warning); --h-bg: rgba(245, 158, 11, 0.1); --h-glow: rgba(245, 158, 11, 0.2);">
                        <div class="hub-icon">🎁</div>
                        <div class="hub-info">
                            <h4>Récompenses</h4>
                            <p>Catalogue, points et trophées</p>
                        </div>
                        <div class="hub-arrow">→</div>
                    </a>
                </div>
            </div>

            <div class="card-panel" style="background: linear-gradient(135deg, rgba(139, 92, 246, 0.1) 0%, rgba(6, 182, 212, 0.1) 100%); border-color: rgba(139, 92, 246, 0.2);">
                <div style="text-align: center; padding: 10px 0;">
                    <div style="font-size: 2.5rem; margin-bottom: 15px;">📊</div>
                    <h4 style="margin-bottom: 8px;">Audit Automatique</h4>
                    <p style="font-size: 0.8rem; color: var(--muted); margin-bottom: 20px;">L'IA analyse le taux de réussite de vos challenges actuels.</p>
                    <button class="btn-premium" style="width: 100%; justify-content: center;">Lancer l'Analyse</button>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    // Style Charts Global
    Chart.defaults.color = '#94a3b8';
    Chart.defaults.font.family = 'Plus Jakarta Sans';

    // Chart 1: Challenge Success Distribution
    new Chart(document.getElementById('mainChart'), {
        type: 'doughnut',
        data: {
            labels: ['En cours', 'Terminés', 'Programmés'],
            datasets: [{
                data: [{{ stats.ch_active }}, {{ stats.ch_done }}, {{ stats.ch_total - stats.ch_active - stats.ch_done }}],
                backgroundColor: ['#8b5cf6', '#06b6d4', '#1e293b'],
                borderWidth: 0,
                hoverOffset: 20
            }]
        },
        options: {
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20 } }
            },
            cutout: '75%'
        }
    });

    // Chart 2: Coach Activity Bar
    new Chart(document.getElementById('coachChart'), {
        type: 'bar',
        data: {
            labels: ['Jan', 'Féb', 'Mar', 'Avr'],
            datasets: [{
                label: 'Sessions Coaches',
                data: [12, 19, 15, {{ stats.co_active * 2 }}],
                backgroundColor: '#06b6d4',
                borderRadius: 8,
                barThickness: 15
            }]
        },
        options: {
            maintainAspectRatio: false,
            scales: {
                y: { display: false },
                x: { grid: { display: false }, border: { display: false } }
            },
            plugins: { legend: { display: false } }
        }
    });
</script>

</body>
</html>
