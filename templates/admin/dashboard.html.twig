{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard — Admin Fitness{% endblock %}
{% block topbar_title %}Dashboard{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1>Dashboard</h1>
        <div class="page-sub">Vue d'ensemble du module fitness</div>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_exercise_new') }}" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Nouvel exercice
        </a>
        <a href="{{ path('admin_program_new') }}" class="btn btn-sm btn-secondary">
            <i class="bi bi-plus-lg me-1"></i> Nouveau programme
        </a>
    </div>
</div>

{# ---- KPI Cards ---- #}
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon blue">
            <i class="bi bi-activity"></i>
        </div>
        <div>
            <div class="stat-label">Exercices au total</div>
            <div class="stat-value">{{ totalExercises }}</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green">
            <i class="bi bi-journal-bookmark-fill"></i>
        </div>
        <div>
            <div class="stat-label">Programmes au total</div>
            <div class="stat-value">{{ totalPrograms }}</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon orange">
            <i class="bi bi-eye-fill"></i>
        </div>
        <div>
            <div class="stat-label">Programmes publiés</div>
            <div class="stat-value">{{ publishedCount }}</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon pink">
            <i class="bi bi-eye-slash-fill"></i>
        </div>
        <div>
            <div class="stat-label">Brouillons</div>
            <div class="stat-value">{{ draftCount }}</div>
        </div>
    </div>
</div>

{# ---- Latest Entries ---- #}
<div class="row g-3">
    {# Latest Exercises #}
    <div class="col-lg-6">
        <div class="table-card h-100 mb-0">
            <div class="table-header py-3 d-flex justify-content-between align-items-center">
                <span style="font-weight: 600; font-size: 1rem;"><i class="bi bi-activity me-2" style="color:var(--accent);"></i>Derniers exercices</span>
                <a href="{{ path('admin_exercise_index') }}" class="btn btn-sm btn-secondary">Voir tout</a>
            </div>
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Nom</th>
                        <th>Catégorie</th>
                        <th>Niveau</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ex in latestExercises %}
                        <tr>
                            <td class="ps-4" style="color: #fff; font-weight: 500;">
                                <a href="{{ path('admin_exercise_show', {id: ex.id}) }}" style="color: inherit; text-decoration: none;">
                                    {{ ex.name }}
                                </a>
                            </td>
                            <td><span class="badge" style="background: rgba(59,130,246,.15); color: #60a5fa; border: 1px solid rgba(59,130,246,.25);">{{ ex.category }}</span></td>
                            <td>
                                {% if ex.difficulty == 'Débutant' %}
                                    <span class="badge" style="background: rgba(34,211,165,.15); color: var(--success); border: 1px solid rgba(34,211,165,.25);">{{ ex.difficulty }}</span>
                                {% elseif ex.difficulty == 'Intermédiaire' %}
                                    <span class="badge" style="background: rgba(245,158,11,.15); color: var(--warning); border: 1px solid rgba(245,158,11,.25);">{{ ex.difficulty }}</span>
                                {% else %}
                                    <span class="badge" style="background: rgba(255,77,109,.15); color: var(--danger); border: 1px solid rgba(255,77,109,.25);">{{ ex.difficulty }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3" class="text-center text-muted py-4 fst-italic">Aucun exercice.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Latest Programs #}
    <div class="col-lg-6">
        <div class="table-card h-100 mb-0">
            <div class="table-header py-3 d-flex justify-content-between align-items-center">
                <span style="font-weight: 600; font-size: 1rem;"><i class="bi bi-journal-bookmark-fill me-2" style="color:var(--success);"></i>Derniers programmes</span>
                <a href="{{ path('admin_program_index') }}" class="btn btn-sm btn-secondary">Voir tout</a>
            </div>
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Titre</th>
                        <th>Durée</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for prog in latestPrograms %}
                        <tr>
                            <td class="ps-4" style="color: #fff; font-weight: 500;">
                                <a href="{{ path('admin_program_show', {id: prog.id}) }}" style="color: inherit; text-decoration: none;">
                                    {{ prog.title|length > 30 ? prog.title|slice(0,30) ~ '…' : prog.title }}
                                </a>
                            </td>
                            <td>{{ prog.durationWeeks }} sem.</td>
                            <td>
                                {% if prog.isPublished %}
                                    <span class="badge" style="background: rgba(34,211,165,.15); color: var(--success); border: 1px solid rgba(34,211,165,.25);"><i class="bi bi-eye me-1"></i>Publié</span>
                                {% else %}
                                    <span class="badge" style="background: rgba(100,116,139,.15); color: var(--muted); border: 1px solid rgba(100,116,139,.25);"><i class="bi bi-eye-slash me-1"></i>Brouillon</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3" class="text-center text-muted py-4 fst-italic">Aucun programme.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
