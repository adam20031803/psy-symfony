{% extends 'base.html.twig' %}

{% block title %}Mes Habitudes — Atomic You{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {# Styles centralisés dans premium.css #}
{% endblock %}

{% block body %}
<div class="w-wide">
    <div class="page-header">
        <h1 class="page-title">
            <span style="font-size: 2.2rem;">🔄</span> 
            Mes Habitudes
        </h1>
        <div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;">
            <a href="{{ path('app_dashboard') }}" class="btn btn-blue-purple btn-small">🔙 Dashboard</a>
            <a href="{{ path('app_daily_checkin_index') }}" class="btn btn-purple btn-small">🧠 Check-in quotidien</a>
            <a href="{{ path('app_youtube_index') }}" class="btn btn-pink btn-small">🎬 Motivation</a>
            <a href="{{ path('app_habitude_insights') }}" class="btn btn-blue-purple btn-small" style="background:rgba(34,197,94,.12) !important;border:1px solid rgba(34,197,94,.3) !important;color:#86efac !important;">🌿 Insights</a>
            <a href="{{ path('app_habitude_new') }}" class="btn btn-purple btn-small">➕ Nouvelle Habitude</a>
        </div>
    </div>

    <!-- Global Statistics Dashboard -->
    <div class="stats-dashboard">
        <div class="stat-card">
            <div class="stat-icon">📊</div>
            <div class="stat-value">{{ globalStats.total }}</div>
            <div class="stat-label">Total Habits</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">✅</div>
            <div class="stat-value" id="completed-today">{{ completedToday|default(0) }}</div>
            <div class="stat-label">Completed Today</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">🔥</div>
            <div class="stat-value">{{ globalStats.globalStreak }}</div>
            <div class="stat-label">Global Streak</div>
        </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="filter-bar">
        <input type="text" id="search-input" class="search-input" placeholder="🔍 Rechercher par titre ou description...">
        <div class="category-filters">
            <button class="category-btn active" data-category="Toutes">Toutes</button>
            <button class="category-btn" data-category="Santé">Santé</button>
            <button class="category-btn" data-category="Mental">Mental</button>
            <button class="category-btn" data-category="Productivité">Productivité</button>
            <button class="category-btn" data-category="Finance">Finance</button>
            <button class="category-btn" data-category="Social">Social</button>
            <button class="category-btn" data-category="Créativité">Créativité</button>
            <button class="category-btn" data-category="Carrière">Carrière</button>
            <button class="category-btn" data-category="Spiritualité">Spiritualité</button>
        </div>
    </div>

    <div class="habitudes-grid" id="habitudes-grid">
        {% for habitude in habitudes %}
            {% set isCompletedToday = habitude.id in completedTodayIds %}
            <div class="hab-card {{ isCompletedToday ? 'completed-today' : '' }}" data-id="{{ habitude.id }}" data-category="{{ habitude.category }}" data-delete-token="{{ csrf_token('delete' ~ habitude.id) }}">
                <div class="hab-status {{ habitude.active ? 'active' : '' }}"></div>
                
                <button class="context-menu-trigger" onclick="event.stopPropagation(); toggleContextMenu({{ habitude.id }})">⋮</button>
                <div class="context-menu" id="context-menu-{{ habitude.id }}">
                    <div class="context-menu-item" onclick="event.stopPropagation(); confirmComplete({{ habitude.id }})">✅ Marquer comme fait</div>
                    <div class="context-menu-item" onclick="event.stopPropagation(); toggleActive({{ habitude.id }})">{{ habitude.active ? '⏸️ Désactiver' : '▶️ Activer' }}</div>
                    <div class="context-menu-item" onclick="event.stopPropagation(); showDetail({{ habitude.id }})">👁️ Voir détails</div>
                    <div class="context-menu-item" onclick="event.stopPropagation(); window.location.href='{{ path('app_habitude_edit', {'id': habitude.id}) }}'">✏️ Éditer</div>
                    <div class="context-menu-item danger" onclick="event.stopPropagation(); deleteHabitude({{ habitude.id }})">🗑️ Supprimer</div>
                </div>
                
                <div class="hab-header">
                    <div>
                        <div class="hab-category">{{ habitude.category }}</div>
                        <h2 class="hab-title">{{ habitude.title }}</h2>
                    </div>
                </div>

                <p class="hab-desc">
                    {{ habitude.description ? (habitude.description|length > 80 ? habitude.description|slice(0, 80) ~ '...' : habitude.description) : 'Aucune description fournie.' }}
                </p>

                <div class="hab-stats">
                    <div class="hab-stat-item">
                        <span class="hab-stat-label">Série actuelle</span>
                        <span class="hab-stat-value">🔥 {{ habitude.currentStreak }}</span>
                    </div>
                    <div class="hab-stat-item">
                        <span class="hab-stat-label">Record</span>
                        <span class="hab-stat-value">🏆 {{ habitude.longestStreak }}</span>
                    </div>
                    <div class="hab-stat-item">
                        <span class="hab-stat-label">Total</span>
                        <span class="hab-stat-value">✅ {{ habitude.totalCompletions }}</span>
                    </div>
                </div>

                <div class="hab-actions">
                    <button type="button" class="btn btn-blue-purple btn-small" onclick="event.stopPropagation(); confirmComplete({{ habitude.id }})">✅ Compléter</button>
                    <a href="{{ path('app_habitude_show', {'id': habitude.id}) }}" class="btn btn-pink btn-small">👁️ Détails</a>
                    <a href="{{ path('app_habitude_edit', {'id': habitude.id}) }}" class="btn btn-purple btn-small" style="background: rgba(108,99,255,0.2) !important; color: #b1aeff !important;">✏️ Editer</a>
                </div>
            </div>
        {% else %}
            <div class="empty-state">
                <div style="font-size: 4rem; margin-bottom: 20px; line-height: 1;">🌱</div>
                <h3>Aucune habitude pour le moment</h3>
                <p>Commencez à structurer votre routine en ajoutant votre première bonne habitude.</p>
                <a href="{{ path('app_habitude_new') }}" class="btn-primary" style="padding: 12px 24px; font-size: 1rem;">
                    Créer ma première habitude
                </a>
            </div>
        {% endfor %}
    </div>
</div>

<!-- Detail Panel Modal -->
<div class="modal-overlay" id="detail-modal">
    <div class="modal-content">
        <div class="modal-header">
            <div>
                <div class="hab-category" id="modal-category"></div>
                <h2 id="modal-title" style="font-size: 1.8rem; margin-top: 10px;"></h2>
            </div>
            <button class="modal-close" onclick="closeModal()">&times;</button>
        </div>

        <p id="modal-description" style="color: var(--muted); margin-bottom: 25px; line-height: 1.6;"></p>

        <div class="stats-dashboard" style="margin-bottom: 25px;">
            <div class="stat-card">
                <div class="stat-icon">🔥</div>
                <div class="stat-value" id="modal-streak">0</div>
                <div class="stat-label">Série Actuelle</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">🏆</div>
                <div class="stat-value" id="modal-record">0</div>
                <div class="stat-label">Record</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">📈</div>
                <div class="stat-value" id="modal-monthly">0%</div>
                <div class="stat-label">Ce Mois</div>
            </div>
        </div>

        <h3 style="margin-bottom: 15px;">📅 Cette Semaine</h3>
        <div class="weekly-tracker" id="weekly-tracker"></div>

        <h3 style="margin: 25px 0 15px;">📊 Historique (4 Semaines)</h3>
        <div class="week-history" id="week-history"></div>

        <div style="display: flex; gap: 10px; margin-top: 25px;">
            <button class="btn-primary" onclick="markCompleteFromModal()" style="flex: 1;">✅ Confirmer : je l'ai faite</button>
            <button class="btn-secondary" onclick="editFromModal()" style="flex: 1;">✏️ Éditer</button>
            <button class="btn-secondary" onclick="deleteFromModal()" style="flex: 1; color: var(--danger);">🗑️ Supprimer</button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    let currentHabitudeId = null;
    let searchTimeout = null;
    let activeCategory = 'Toutes';

    function normalizeText(value) {
        return (value || '')
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '');
    }

    // Search with debounce
    document.getElementById('search-input').addEventListener('input', function(e) {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
            filterHabitudes();
        }, 300);
    });

    // Category filter buttons
    document.querySelectorAll('.category-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.category-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            activeCategory = this.dataset.category;
            filterHabitudes();
        });
    });

    // Filter habits based on search and category
    function filterHabitudes() {
        const searchText = normalizeText(document.getElementById('search-input').value);
        const cards = document.querySelectorAll('.hab-card');
        let visibleCount = 0;

        cards.forEach(card => {
            const title = normalizeText(card.querySelector('.hab-title').textContent);
            const desc = normalizeText(card.querySelector('.hab-desc').textContent);
            const category = normalizeText(card.dataset.category);
            const selectedCategory = normalizeText(activeCategory);

            const matchesSearch = !searchText || title.includes(searchText) || desc.includes(searchText);
            const matchesCategory = selectedCategory === normalizeText('Toutes') || category === selectedCategory;

            if (matchesSearch && matchesCategory) {
                card.style.display = 'block';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        // Show empty state if no results
        const grid = document.getElementById('habitudes-grid');
        const emptyState = grid.querySelector('.empty-state');
        if (visibleCount === 0 && !emptyState) {
            const emptyDiv = document.createElement('div');
            emptyDiv.className = 'empty-state';
            emptyDiv.innerHTML = `
                <div style="font-size: 4rem; margin-bottom: 20px; line-height: 1;">🔍</div>
                <h3>Aucun résultat</h3>
                <p>Essayez de modifier vos filtres ou votre recherche.</p>
            `;
            grid.appendChild(emptyDiv);
        } else if (visibleCount > 0 && emptyState) {
            emptyState.remove();
        }
    }

    // Toggle context menu
    function toggleContextMenu(id) {
        const menu = document.getElementById(`context-menu-${id}`);
        const allMenus = document.querySelectorAll('.context-menu');
        
        allMenus.forEach(m => {
            if (m !== menu) m.classList.remove('show');
        });
        
        menu.classList.toggle('show');
    }

    // Close context menus when clicking outside
    document.addEventListener('click', function() {
        document.querySelectorAll('.context-menu').forEach(m => m.classList.remove('show'));
    });

    // Mark habit as complete
    function confirmComplete(id) {
        if (!confirm("Confirmer que vous avez complété cette habitude aujourd'hui ?")) {
            return;
        }
        markComplete(id);
    }

    // Mark habit as complete
    async function markComplete(id) {
        try {
            const response = await fetch(`/habitude/${id}/complete`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            });

            const result = await response.json();

            if (result.success) {
                alert('✅ Habitude complétée!');
                // Update UI locally before reload or instead of it
                const card = document.querySelector(`.hab-card[data-id="${id}"]`);
                if (card) {
                    card.classList.add('completed-today');
                }
                loadCompletedToday();
                // We reload to update all stats properly, but a smooth update is better
                location.reload(); 
            } else {
                alert('⚠️ ' + result.message);
            }
        } catch (error) {
            alert('❌ Erreur lors de la complétion');
        }
    }

    // Toggle active status
    async function toggleActive(id) {
        try {
            const response = await fetch(`/habitude/${id}/toggle-active`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            });

            const result = await response.json();

            if (result.success) {
                location.reload();
            }
        } catch (error) {
            alert('❌ Erreur lors du changement de statut');
        }
    }

    // Show detail modal
    async function showDetail(id) {
        currentHabitudeId = id;
        const card = document.querySelector(`.hab-card[data-id="${id}"]`);
        
        document.getElementById('modal-category').textContent = card.dataset.category;
        document.getElementById('modal-title').textContent = card.querySelector('.hab-title').textContent;
        document.getElementById('modal-description').textContent = card.querySelector('.hab-desc').textContent;

        // Fetch stats
        try {
            const response = await fetch(`/habitude/api/stats/${id}`);
            const stats = await response.json();

            document.getElementById('modal-streak').textContent = stats.currentStreak;
            document.getElementById('modal-record').textContent = stats.longestStreak;
            document.getElementById('modal-monthly').textContent = stats.monthlyPercentage + '%';

            // Render weekly tracker
            const weeklyTracker = document.getElementById('weekly-tracker');
            weeklyTracker.innerHTML = '';
            
            stats.weekDays.forEach(day => {
                const dayDiv = document.createElement('div');
                dayDiv.className = 'week-day';
                
                if (day.completed) {
                    dayDiv.classList.add('completed');
                } else if (day.isToday) {
                    dayDiv.classList.add('future', 'today');
                } else {
                    dayDiv.classList.add('missed');
                }
                
                dayDiv.innerHTML = `
                    <div>${day.day}</div>
                    <div style="font-size: 0.65rem; margin-top: 4px;">${new Date(day.date).getDate()}</div>
                `;
                
                weeklyTracker.appendChild(dayDiv);
            });

            // Render week history
            const weekHistory = document.getElementById('week-history');
            weekHistory.innerHTML = '';
            
            stats.weekHistory.forEach(week => {
                const weekDiv = document.createElement('div');
                weekDiv.className = 'week-history-item';
                weekDiv.innerHTML = `
                    <div class="week-history-label">
                        <span>Semaine ${week.week}</span>
                        <span>${week.completed}/${week.target} (${week.percentage}%)</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: ${week.percentage}%"></div>
                    </div>
                `;
                weekHistory.appendChild(weekDiv);
            });

        } catch (error) {
            console.error('Error fetching stats:', error);
        }

        document.getElementById('detail-modal').classList.add('show');
    }

    // Close modal
    function closeModal() {
        document.getElementById('detail-modal').classList.remove('show');
        currentHabitudeId = null;
    }

    // Close modal on overlay click
    document.getElementById('detail-modal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeModal();
        }
    });

    // Mark complete from modal
    function markCompleteFromModal() {
        if (currentHabitudeId) {
            confirmComplete(currentHabitudeId);
        }
    }

    // Edit from modal
    function editFromModal() {
        if (currentHabitudeId) {
            window.location.href = `/habitude/${currentHabitudeId}/edit`;
        }
    }

    // Delete from modal
    function deleteFromModal() {
        if (currentHabitudeId && confirm('Êtes-vous sûr de vouloir supprimer cette habitude?')) {
            const card = document.querySelector(`.hab-card[data-id="${currentHabitudeId}"]`);
            const deleteToken = card ? card.dataset.deleteToken : '';
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/habitude/${currentHabitudeId}`;
            
            const tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '_token';
            tokenInput.value = deleteToken;
            
            form.appendChild(tokenInput);
            document.body.appendChild(form);
            form.submit();
        }
    }

    // Delete habit with confirmation
    function deleteHabitude(id) {
        if (confirm('Êtes-vous sûr de vouloir supprimer cette habitude?')) {
            const card = document.querySelector(`.hab-card[data-id="${id}"]`);
            const deleteToken = card ? card.dataset.deleteToken : '';
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/habitude/${id}`;
            
            const tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '_token';
            tokenInput.value = deleteToken;
            
            form.appendChild(tokenInput);
            document.body.appendChild(form);
            form.submit();
        }
    }

    // Card click shows detail
    document.querySelectorAll('.hab-card').forEach(card => {
        card.addEventListener('click', function(e) {
            if (!e.target.closest('.context-menu-trigger') && !e.target.closest('.context-menu')) {
                const id = this.dataset.id;
                showDetail(id);
            }
        });
    });

    // Load completed today count
    async function loadCompletedToday() {
        // This would require a backend endpoint, for now we'll calculate from the data
        const cards = document.querySelectorAll('.hab-card');
        let completedCount = 0;
        // You can enhance this with an API call if needed
        document.getElementById('completed-today').textContent = completedCount;
    }

    // Initialize
    loadCompletedToday();
</script>
{% endblock %}
