{% extends 'base.html.twig' %}

{% block title %}Editer Habitude — Atomic You{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {# Les styles de formulaires sont centralisés dans premium.css #}
{% endblock %}

{% block body %}
<div class="w-narrow">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <a href="{{ path('app_habitude_index') }}" class="btn btn-blue-purple btn-small">← Retour</a>
        {{ include('habitude/_delete_form.html.twig') }}
    </div>
    
    <div class="form-card">
        <h1 class="form-title">Éditer habitude</h1>
        {{ include('habitude/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
    </div>
</div>
{% endblock %}
