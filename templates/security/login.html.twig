{% extends 'base.html.twig' %}
{% block skip_auth_layout %}true{% endblock %}

{% block title %}Login — Atomic You{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        font-family: 'Inter', sans-serif;
        background: #0d0d1a;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    /* Animated background orbs */
    .bg {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
    }
    .orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        animation: float 8s ease-in-out infinite;
    }
    .orb-1 {
        width: 420px; height: 420px;
        background: radial-gradient(circle, rgba(108,99,255,0.35), transparent 70%);
        top: -100px; left: -60px;
        animation-delay: 0s;
    }
    .orb-2 {
        width: 350px; height: 350px;
        background: radial-gradient(circle, rgba(0,210,200,0.25), transparent 70%);
        bottom: -80px; right: -60px;
        animation-delay: -3s;
    }
    .orb-3 {
        width: 260px; height: 260px;
        background: radial-gradient(circle, rgba(255,100,160,0.2), transparent 70%);
        top: 50%; left: 55%;
        animation-delay: -5s;
    }
    @keyframes float {
        0%, 100% { transform: translateY(0) scale(1); }
        50%       { transform: translateY(-30px) scale(1.06); }
    }

    /* Card */
    .card {
        position: relative;
        z-index: 1;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 24px;
        padding: 48px 44px 40px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 30px 80px rgba(0,0,0,0.4);
        animation: slideUp 0.6s cubic-bezier(0.16,1,0.3,1) both;
    }
    @keyframes slideUp {
        from { opacity: 0; transform: translateY(40px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 32px;
    }
    .logo-icon {
        width: 42px; height: 42px;
        background: linear-gradient(135deg, #6c63ff, #00d2c8);
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 22px;
    }
    .logo-text {
        font-size: 1.3rem;
        font-weight: 700;
        color: #fff;
        letter-spacing: -0.5px;
    }
    .logo-text span { color: #6c63ff; }

    h1 {
        font-size: 1.7rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 6px;
        letter-spacing: -0.5px;
    }
    .subtitle {
        font-size: 0.875rem;
        color: rgba(255,255,255,0.45);
        margin-bottom: 32px;
    }

    .alert-error {
        background: rgba(255,80,80,0.12);
        border: 1px solid rgba(255,80,80,0.3);
        border-radius: 12px;
        padding: 12px 16px;
        color: #ff7070;
        font-size: 0.85rem;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .field {
        margin-bottom: 18px;
    }
    label {
        display: block;
        font-size: 0.8rem;
        font-weight: 500;
        color: rgba(255,255,255,0.55);
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    input[type="text"],
    input[type="email"],
    input[type="password"] {
        width: 100%;
        padding: 14px 16px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        color: #fff;
        font-size: 0.95rem;
        font-family: 'Inter', sans-serif;
        outline: none;
        transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
    }
    input[type="text"]:focus,
    input[type="email"]:focus,
    input[type="password"]:focus {
        border-color: #6c63ff;
        background: rgba(108,99,255,0.08);
        box-shadow: 0 0 0 4px rgba(108,99,255,0.15);
    }
    input::placeholder { color: rgba(255,255,255,0.25); }

    .btn-login {
        width: 100%;
        padding: 15px;
        background: linear-gradient(135deg, #6c63ff, #00d2c8);
        border: none;
        border-radius: 12px;
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        cursor: pointer;
        margin-top: 8px;
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
        box-shadow: 0 6px 24px rgba(108,99,255,0.4);
        letter-spacing: 0.2px;
    }
    .btn-login:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        box-shadow: 0 10px 32px rgba(108,99,255,0.5);
    }
    .btn-login:active { transform: translateY(0); }

    .divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 24px 0 20px;
        color: rgba(255,255,255,0.2);
        font-size: 0.78rem;
    }
    .divider::before, .divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: rgba(255,255,255,0.1);
    }

    .footer-link {
        text-align: center;
        font-size: 0.85rem;
        color: rgba(255,255,255,0.4);
    }
    .footer-link a {
        color: #6c63ff;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s;
    }
    .footer-link a:hover { color: #00d2c8; }
</style>
{% endblock %}

{% block body %}
<div class="bg">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
</div>

<div class="card">
    <div class="logo">
        <div class="logo-icon">🧠</div>
        <div class="logo-text">Atomic<span>You</span></div>
    </div>

    <h1>Welcome back</h1>
    <p class="subtitle">Sign in to your account to continue</p>

    {% for message in app.flashes('success') %}
        <div style="background:rgba(0,210,200,0.12);border:1px solid rgba(0,210,200,0.3);border-radius:12px;padding:12px 16px;color:#00d2c8;font-size:0.85rem;margin-bottom:16px;">✓ {{ message }}</div>
    {% endfor %}

    {% if error %}
        <div class="alert-error">
            ⚠️ {{ error.messageKey | trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <div class="field">
            <label for="username">Email</label>
            <input type="text"
                   id="username"
                   name="_username"
                   value="{{ last_username }}"
                   placeholder="you@example.com"
                   autocomplete="email"
                   required>
        </div>

        <div class="field">
            <label for="password">Password</label>
            <input type="password"
                   id="password"
                   name="_password"
                   placeholder="••••••••"
                   autocomplete="current-password"
                   required>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div style="text-align:right; margin-bottom: 4px;">
            <a href="{{ path('app_forgot_password') }}"
               style="font-size:0.8rem; color:rgba(255,255,255,0.4); text-decoration:none; transition:color .2s;"
               onmouseover="this.style.color='#6c63ff'" onmouseout="this.style.color='rgba(255,255,255,0.4)'">
                Mot de passe oublié ?
            </a>
        </div>

        <button type="submit" class="btn-login" id="login-submit">Se connecter</button>
    </form>

    <div class="divider">ou</div>

    <div class="footer-link">
        Pas encore de compte ? <a href="{{ path('app_register') }}">En créer un</a>
    </div>
</div>
{% endblock %}
