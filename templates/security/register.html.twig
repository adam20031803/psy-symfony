{% extends 'base.html.twig' %}
{% block skip_auth_layout %}true{% endblock %}
{% block title %}Créer un compte — Atomic You{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        font-family: 'Inter', sans-serif;
        background: #0d0d1a;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
        overflow-x: hidden;
    }

    .bg { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
    .orb { position: absolute; border-radius: 50%; filter: blur(80px); animation: float 8s ease-in-out infinite; }
    .orb-1 { width: 420px; height: 420px; background: radial-gradient(circle, rgba(108,99,255,0.35), transparent 70%); top: -100px; left: -60px; animation-delay: 0s; }
    .orb-2 { width: 350px; height: 350px; background: radial-gradient(circle, rgba(0,210,200,0.25), transparent 70%); bottom: -80px; right: -60px; animation-delay: -3s; }
    .orb-3 { width: 260px; height: 260px; background: radial-gradient(circle, rgba(255,100,160,0.2), transparent 70%); top: 40%; left: 60%; animation-delay: -5s; }
    @keyframes float { 0%, 100% { transform: translateY(0) scale(1); } 50% { transform: translateY(-28px) scale(1.05); } }

    .card {
        position: relative;
        z-index: 1;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 24px;
        padding: 44px 44px 36px;
        width: 100%;
        max-width: 500px;
        box-shadow: 0 30px 80px rgba(0,0,0,0.4);
        animation: slideUp 0.6s cubic-bezier(0.16,1,0.3,1) both;
    }
    @keyframes slideUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }

    .logo { display: flex; align-items: center; gap: 10px; margin-bottom: 28px; }
    .logo-icon { width: 42px; height: 42px; background: linear-gradient(135deg, #6c63ff, #00d2c8); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; }
    .logo-text { font-size: 1.3rem; font-weight: 700; color: #fff; letter-spacing: -0.5px; }
    .logo-text span { color: #6c63ff; }

    h1 { font-size: 1.6rem; font-weight: 700; color: #fff; margin-bottom: 4px; letter-spacing: -0.5px; }
    .subtitle { font-size: 0.875rem; color: rgba(255,255,255,0.45); margin-bottom: 28px; }

    .alert-error {
        background: rgba(255,80,80,0.12);
        border: 1px solid rgba(255,80,80,0.3);
        border-radius: 12px;
        padding: 12px 16px;
        color: #ff7070;
        font-size: 0.85rem;
        margin-bottom: 20px;
        display: flex; align-items: center; gap: 8px;
    }

    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
    .field-full { grid-column: 1 / -1; }
    .field { display: flex; flex-direction: column; }

    label {
        display: block;
        font-size: 0.78rem;
        font-weight: 500;
        color: rgba(255,255,255,0.5);
        margin-bottom: 7px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    input {
        width: 100%;
        padding: 13px 14px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        color: #fff;
        font-size: 0.92rem;
        font-family: 'Inter', sans-serif;
        outline: none;
        transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
    }
    input:focus { border-color: #6c63ff; background: rgba(108,99,255,0.08); box-shadow: 0 0 0 4px rgba(108,99,255,0.15); }
    input::placeholder { color: rgba(255,255,255,0.22); }

    .password-strength { margin-top: 6px; height: 3px; border-radius: 2px; background: rgba(255,255,255,0.08); overflow: hidden; }
    .strength-bar { height: 100%; border-radius: 2px; width: 0%; transition: width 0.3s, background 0.3s; }
    .match-hint { font-size: 0.75rem; margin-top: 5px; height: 14px; transition: color 0.2s; }

    /* ── Face ID Section ──────────────────────────────────────────── */
    .face-section {
        grid-column: 1 / -1;
        border: 1.5px dashed rgba(108,99,255,0.35);
        border-radius: 16px;
        padding: 18px 20px;
        margin-top: 4px;
        transition: border-color 0.3s, background 0.3s;
    }
    .face-section.captured {
        border-color: rgba(0,210,200,0.5);
        background: rgba(0,210,200,0.04);
        border-style: solid;
    }
    .face-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 4px;
    }
    .face-section-title {
        display: flex; align-items: center; gap: 8px;
        font-size: 0.9rem; font-weight: 600; color: rgba(255,255,255,0.8);
    }
    .face-badge-optional {
        font-size: 0.68rem;
        background: rgba(108,99,255,0.2);
        color: #a09bff;
        border-radius: 20px;
        padding: 2px 8px;
        font-weight: 500;
        letter-spacing: 0.3px;
    }
    .face-section-desc {
        font-size: 0.8rem;
        color: rgba(255,255,255,0.35);
        margin-bottom: 14px;
        line-height: 1.5;
    }
    .face-section-body {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    /* Preview thumbnail */
    .face-thumb {
        width: 56px; height: 56px;
        border-radius: 50%;
        overflow: hidden;
        border: 2px solid rgba(108,99,255,0.3);
        background: rgba(255,255,255,0.04);
        flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.6rem;
        transition: border-color 0.3s;
        position: relative;
    }
    .face-thumb.captured { border-color: #00d2c8; }
    .face-thumb video {
        width: 100%; height: 100%;
        object-fit: cover;
        transform: scaleX(-1);
        display: none;
        border-radius: 50%;
    }
    .face-thumb canvas {
        width: 100%; height: 100%;
        object-fit: cover;
        border-radius: 50%;
        display: none;
    }

    .face-actions { flex: 1; }
    .btn-capture {
        width: 100%;
        padding: 10px 14px;
        background: rgba(108,99,255,0.12);
        border: 1.5px solid rgba(108,99,255,0.4);
        border-radius: 10px;
        color: rgba(255,255,255,0.85);
        font-size: 0.85rem;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        cursor: pointer;
        display: flex; align-items: center; justify-content: center; gap: 8px;
        transition: background 0.2s, border-color 0.2s;
    }
    .btn-capture:hover { background: rgba(108,99,255,0.22); border-color: #6c63ff; }
    .btn-capture.active { background: rgba(255,80,80,0.12); border-color: rgba(255,80,80,0.4); color: #ff9090; }
    .btn-redo {
        width: 100%;
        margin-top: 6px;
        padding: 6px 14px;
        background: none;
        border: none;
        color: rgba(255,255,255,0.25);
        font-size: 0.75rem;
        font-family: 'Inter', sans-serif;
        cursor: pointer;
        text-decoration: underline;
        transition: color 0.2s;
    }
    .btn-redo:hover { color: rgba(255,255,255,0.55); }
    .face-hint {
        font-size: 0.78rem;
        margin-top: 8px;
        min-height: 18px;
        font-weight: 500;
        transition: color 0.3s;
    }
    .face-hint.scanning { color: rgba(255,255,255,0.4); }
    .face-hint.success  { color: #00d2c8; }
    .face-hint.error    { color: #ff7070; }

    /* Scan ring overlay on thumb */
    .face-ring {
        position: absolute; inset: -3px;
        border-radius: 50%;
        border: 2px solid transparent;
        border-top-color: #6c63ff;
        border-right-color: #00d2c8;
        animation: spin 1.2s linear infinite;
        display: none;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── Submit ──────────────────────────────────────────────────── */
    .btn-register {
        width: 100%;
        padding: 15px;
        background: linear-gradient(135deg, #6c63ff, #00d2c8);
        border: none;
        border-radius: 12px;
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        cursor: pointer;
        margin-top: 22px;
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
        box-shadow: 0 6px 24px rgba(108,99,255,0.4);
        letter-spacing: 0.2px;
    }
    .btn-register:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 10px 32px rgba(108,99,255,0.5); }
    .btn-register:active { transform: translateY(0); }

    .footer-link { text-align: center; font-size: 0.85rem; color: rgba(255,255,255,0.4); margin-top: 20px; }
    .footer-link a { color: #6c63ff; text-decoration: none; font-weight: 500; transition: color 0.2s; }
    .footer-link a:hover { color: #00d2c8; }
</style>
{% endblock %}

{% block body %}
<div class="bg">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
</div>

<div class="card">
    <div class="logo">
        <div class="logo-icon">🧠</div>
        <div class="logo-text">Atomic<span>You</span></div>
    </div>

    <h1>Créer un compte</h1>
    <p class="subtitle">Rejoignez Atomic You et prenez soin de votre bien-être</p>

    {% if error %}
        <div class="alert-error">⚠️ {{ error }}</div>
    {% endif %}

    <form method="post" action="{{ path('app_register') }}" id="register-form">

        <div class="form-grid">

            <div class="field">
                <label for="prenom">Prénom *</label>
                <input type="text" id="prenom" name="prenom"
                       value="{{ formData.prenom ?? '' }}"
                       placeholder="Votre prénom" autocomplete="given-name" required>
            </div>

            <div class="field">
                <label for="nom">Nom *</label>
                <input type="text" id="nom" name="nom"
                       value="{{ formData.nom ?? '' }}"
                       placeholder="Votre nom" autocomplete="family-name" required>
            </div>

            <div class="field">
                <label for="age">Âge</label>
                <input type="number" id="age" name="age"
                       value="{{ formData.age ?? '' }}"
                       placeholder="25" min="1" max="120">
            </div>

            <div class="field">
                <label for="telephone">Téléphone</label>
                <input type="tel" id="telephone" name="telephone"
                       value="{{ formData.telephone ?? '' }}"
                       placeholder="+216 00 000 000" autocomplete="tel">
            </div>

            <div class="field field-full">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email"
                       value="{{ formData.email ?? '' }}"
                       placeholder="vous@exemple.com" autocomplete="email" required>
            </div>

            <div class="field field-full">
                <label for="password">Mot de passe *</label>
                <input type="password" id="password" name="password"
                       placeholder="Minimum 6 caractères" autocomplete="new-password" required>
                <div class="password-strength"><div class="strength-bar" id="strength-bar"></div></div>
            </div>

            <div class="field field-full">
                <label for="confirm_password">Confirmer le mot de passe *</label>
                <input type="password" id="confirm_password" name="confirm_password"
                       placeholder="Répétez le mot de passe" autocomplete="new-password" required>
                <div class="match-hint" id="match-hint"></div>
            </div>

            {# ── Face ID — optional ─────────────────────────────── #}
            <div class="face-section field-full" id="face-section">
                <div class="face-section-header">
                    <div class="face-section-title">
                        👤 Face ID
                        <span class="face-badge-optional">Optionnel</span>
                    </div>
                </div>
                <div class="face-section-desc">
                    Connectez-vous instantanément avec votre visage. Cliquez pour activer — vous pouvez ignorer cette étape.
                </div>

                <div class="face-section-body">
                    {# Thumbnail / live preview #}
                    <div class="face-thumb" id="face-thumb">
                        <span id="face-thumb-icon">👤</span>
                        <video id="face-video" autoplay muted playsinline></video>
                        <canvas id="face-canvas" width="56" height="56"></canvas>
                        <div class="face-ring" id="face-ring"></div>
                    </div>

                    <div class="face-actions">
                        <button type="button" class="btn-capture" id="btn-capture">
                            <span id="capture-btn-icon">📷</span>
                            <span id="capture-btn-label">Activer Face ID</span>
                        </button>
                        <button type="button" class="btn-redo" id="btn-redo" style="display:none">↺ Recommencer</button>
                        <div class="face-hint scanning" id="face-hint"></div>
                    </div>
                </div>

                {# Hidden field — filled by JS when face is captured #}
                <input type="hidden" name="face_descriptor" id="face_descriptor_input">
            </div>

        </div>

        <button type="submit" class="btn-register" id="register-submit">Créer mon compte</button>
    </form>

    <div class="footer-link">
        Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
<script>
// ── Password strength ──────────────────────────────────────────
document.getElementById('password').addEventListener('input', function () {
    const val = this.value;
    const bar = document.getElementById('strength-bar');
    let s = 0;
    if (val.length >= 6)          s++;
    if (val.length >= 10)         s++;
    if (/[A-Z]/.test(val))        s++;
    if (/[0-9]/.test(val))        s++;
    if (/[^A-Za-z0-9]/.test(val)) s++;
    const colors = ['', '#ff4d4d', '#ff944d', '#ffd24d', '#6c63ff', '#00d2c8'];
    const widths = ['0%', '20%', '40%', '60%', '80%', '100%'];
    bar.style.width      = widths[s];
    bar.style.background = colors[s];
    checkMatch();
});
document.getElementById('confirm_password').addEventListener('input', checkMatch);
function checkMatch() {
    const p    = document.getElementById('password').value;
    const c    = document.getElementById('confirm_password').value;
    const hint = document.getElementById('match-hint');
    if (!c) { hint.textContent = ''; return; }
    if (p === c) { hint.textContent = '✓ Les mots de passe correspondent';      hint.style.color = '#00d2c8'; }
    else         { hint.textContent = '✗ Les mots de passe ne correspondent pas'; hint.style.color = '#ff7070'; }
}

// ── Face ID ────────────────────────────────────────────────────
const MODELS_URL = '/face-models';

const btnCapture  = document.getElementById('btn-capture');
const btnRedo     = document.getElementById('btn-redo');
const faceVideo   = document.getElementById('face-video');
const faceCanvas  = document.getElementById('face-canvas');
const faceThumb   = document.getElementById('face-thumb');
const faceSect    = document.getElementById('face-section');
const faceRing    = document.getElementById('face-ring');
const faceHint    = document.getElementById('face-hint');
const thumbIcon   = document.getElementById('face-thumb-icon');
const capIcon     = document.getElementById('capture-btn-icon');
const capLabel    = document.getElementById('capture-btn-label');
const hiddenInput = document.getElementById('face_descriptor_input');

let stream       = null;
let scanning     = false;
let modelsLoaded = false;
let captured     = false;

// Load models silently in background after page ready
window.addEventListener('load', () => {
    faceapi.nets.tinyFaceDetector.loadFromUri(MODELS_URL)
        .then(() => faceapi.nets.faceLandmark68TinyNet.loadFromUri(MODELS_URL))
        .then(() => faceapi.nets.faceRecognitionNet.loadFromUri(MODELS_URL))
        .then(() => { modelsLoaded = true; })
        .catch(e => console.warn('Face models preload failed:', e));
});

btnCapture.addEventListener('click', async () => {
    if (scanning) { stopAll(); return; }
    if (captured)  { return; }

    setHint('scanning', 'Chargement des modèles…');
    capIcon.textContent  = '⏳';
    capLabel.textContent = 'Chargement…';
    btnCapture.disabled  = true;

    if (!modelsLoaded) {
        try {
            await faceapi.nets.tinyFaceDetector.loadFromUri(MODELS_URL);
            await faceapi.nets.faceLandmark68TinyNet.loadFromUri(MODELS_URL);
            await faceapi.nets.faceRecognitionNet.loadFromUri(MODELS_URL);
            modelsLoaded = true;
        } catch(e) {
            setHint('error', '❌ Impossible de charger les modèles IA');
            resetBtn();
            return;
        }
    }

    try {
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: 320, height: 320 } });
        faceVideo.srcObject = stream;
        thumbIcon.style.display = 'none';
        faceVideo.style.display  = 'block';
        faceRing.style.display   = 'block';
        await faceVideo.play();
    } catch(e) {
        setHint('error', '❌ Caméra inaccessible');
        resetBtn();
        return;
    }

    scanning = true;
    btnCapture.disabled  = false;
    btnCapture.classList.add('active');
    capIcon.textContent  = '⏹';
    capLabel.textContent = 'Annuler';
    setHint('scanning', '🔍 Recherche du visage…');
    runScan();
});

async function runScan() {
    const opts = new faceapi.TinyFaceDetectorOptions({ inputSize: 224, scoreThreshold: 0.5 });
    for (let i = 0; i < 40 && scanning; i++) {
        await new Promise(r => setTimeout(r, 120));
        const det = await faceapi
            .detectSingleFace(faceVideo, opts)
            .withFaceLandmarks(true)
            .withFaceDescriptor();
        if (det) {
            onFaceCaptured(det);
            return;
        }
    }
    if (scanning) {
        setHint('error', '❌ Aucun visage détecté. Réessayez.');
        stopAll();
        resetBtn();
    }
}

function onFaceCaptured(det) {
    // Snapshot into canvas thumbnail
    const ctx = faceCanvas.getContext('2d');
    faceCanvas.width  = 56;
    faceCanvas.height = 56;
    ctx.save();
    ctx.scale(-1, 1); // mirror
    ctx.drawImage(faceVideo, -56, 0, 56, 56);
    ctx.restore();

    stopAll();

    faceVideo.style.display  = 'none';
    faceCanvas.style.display = 'block';
    faceRing.style.display   = 'none';
    faceThumb.classList.add('captured');
    faceSect.classList.add('captured');

    hiddenInput.value = JSON.stringify(Array.from(det.descriptor));
    captured = true;

    btnCapture.style.display = 'none';
    btnRedo.style.display    = 'block';
    setHint('success', '✅ Visage enregistré !');
}

btnRedo.addEventListener('click', () => {
    // Reset everything
    captured = false;
    hiddenInput.value = '';
    faceCanvas.style.display = 'none';
    thumbIcon.style.display  = '';
    faceThumb.classList.remove('captured');
    faceSect.classList.remove('captured');
    btnRedo.style.display    = 'none';
    btnCapture.style.display = 'flex';
    setHint('scanning', '');
    resetBtn();
});

function stopAll() {
    scanning = false;
    if (stream) { stream.getTracks().forEach(t => t.stop()); stream = null; }
    faceVideo.style.display = 'none';
    faceRing.style.display  = 'none';
    if (!captured) thumbIcon.style.display = '';
}
function resetBtn() {
    btnCapture.classList.remove('active');
    btnCapture.disabled  = false;
    capIcon.textContent  = '📷';
    capLabel.textContent = 'Activer Face ID';
}
function setHint(type, msg) {
    faceHint.className   = 'face-hint ' + type;
    faceHint.textContent = msg;
}
</script>
{% endblock %}
