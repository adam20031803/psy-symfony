{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — Atomic You{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { width: 100%; height: 100%; }
    body {
        font-family: 'Inter', sans-serif;
        background: #0d0d1a;
        width: 100% !important;
        height: 100vh !important;
        margin: 0 !important;
        padding: 0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        overflow: hidden !important;
        flex-direction: column !important;
    }

    /* Hide sidebar and navigation */
    [class*="sidebar"], [class*="nav"], [class*="menu"], nav, aside { display: none !important; }

    /* Animated background orbs */
    .bg { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
    .orb { position: absolute; border-radius: 50%; filter: blur(80px); animation: float 8s ease-in-out infinite; }
    .orb-1 { width: 420px; height: 420px; background: radial-gradient(circle, rgba(108,99,255,0.35), transparent 70%); top: -100px; left: -60px; animation-delay: 0s; }
    .orb-2 { width: 350px; height: 350px; background: radial-gradient(circle, rgba(0,210,200,0.25), transparent 70%); bottom: -80px; right: -60px; animation-delay: -3s; }
    .orb-3 { width: 260px; height: 260px; background: radial-gradient(circle, rgba(255,100,160,0.2), transparent 70%); top: 50%; left: 55%; animation-delay: -5s; }
    @keyframes float {
        0%, 100% { transform: translateY(0) scale(1); }
        50%       { transform: translateY(-30px) scale(1.06); }
    }

    /* Card */
    .card {
        position: relative; z-index: 1;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 24px;
        padding: 48px 44px 40px;
        width: 100%; max-width: 420px;
        box-shadow: 0 30px 80px rgba(0,0,0,0.4);
        animation: slideUp 0.6s cubic-bezier(0.16,1,0.3,1) both;
    }
    @keyframes slideUp {
        from { opacity: 0; transform: translateY(40px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* Logo */
    .logo { display: flex; align-items: center; gap: 10px; margin-bottom: 32px; }
    .logo-icon {
        width: 42px; height: 42px;
        background: linear-gradient(135deg, #6c63ff, #00d2c8);
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 22px;
    }
    .logo-text { font-size: 1.3rem; font-weight: 700; color: #fff; letter-spacing: -0.5px; }
    .logo-text span { color: #6c63ff; }

    /* Icon header */
    .icon-header {
        width: 64px; height: 64px;
        background: linear-gradient(135deg, rgba(108,99,255,0.2), rgba(0,210,200,0.15));
        border: 1px solid rgba(108,99,255,0.3);
        border-radius: 18px;
        display: flex; align-items: center; justify-content: center;
        font-size: 2rem;
        margin-bottom: 20px;
    }

    h1 { font-size: 1.55rem; font-weight: 700; color: #fff; margin-bottom: 8px; letter-spacing: -0.5px; }
    .subtitle { font-size: 0.85rem; color: rgba(255,255,255,0.7); margin-bottom: 28px; line-height: 1.6; }

    /* Alerts */
    .alert { border-radius: 12px; padding: 14px 16px; margin-bottom: 20px; font-size: 0.85rem; }
    .alert-error { background: rgba(255,80,80,0.12); border: 1px solid rgba(255,80,80,0.3); color: #ff7070; }
    .alert-success { background: rgba(0,210,200,0.1); border: 1px solid rgba(0,210,200,0.3); color: #00d2c8; text-align: center; padding: 28px 24px; }
    .alert-success .icon { font-size: 3rem; display: block; margin-bottom: 12px; }
    .alert-success h2 { font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: 8px; }
    .alert-success p { font-size: 0.83rem; color: rgba(255,255,255,0.5); line-height: 1.6; }

    /* Form */
    .field { margin-bottom: 20px; }
    label { display: block; font-size: 0.78rem; font-weight: 600; color: rgba(255,255,255,0.7); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px; }
    input[type="email"] {
        width: 100%; padding: 14px 16px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px; color: #fff; font-size: 0.95rem; font-family: 'Inter', sans-serif;
        outline: none;
        transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
    }
    input[type="email"]:focus {
        border-color: #6c63ff;
        background: rgba(108,99,255,0.08);
        box-shadow: 0 0 0 4px rgba(108,99,255,0.15);
    }
    input::placeholder { color: rgba(255,255,255,0.25); }

    /* Button */
    .btn-submit {
        width: 100%; padding: 15px;
        background: linear-gradient(135deg, #6c63ff, #00d2c8);
        border: none; border-radius: 12px;
        color: #fff; font-size: 1rem; font-weight: 600;
        font-family: 'Inter', sans-serif; cursor: pointer;
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
        box-shadow: 0 6px 24px rgba(108,99,255,0.4);
        letter-spacing: 0.2px;
    }
    .btn-submit:hover:not(:disabled) { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 10px 32px rgba(108,99,255,0.5); }
    .btn-submit:active:not(:disabled) { transform: translateY(0); }
    .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; }

    /* Link */
    .back-link {
        display: flex; align-items: center; justify-content: center; gap: 6px;
        margin-top: 22px; font-size: 0.84rem;
        color: rgba(255,255,255,0.35); text-decoration: none;
        transition: color 0.2s;
    }
    .back-link:hover { color: #6c63ff; }
    .back-link::before { content: '←'; }
</style>
{% endblock %}

{% block body %}
<div class="bg">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
</div>

<div class="card">
    <!-- Logo -->
    <div class="logo">
        <div class="logo-icon">🧠</div>
        <div class="logo-text">Atomic<span>You</span></div>
    </div>

    {% if success %}
        <!-- Success Message -->
        <div class="alert alert-success">
            <span class="icon">📧</span>
            <h2>Email envoyé</h2>
            <p>Si un compte existe avec cette adresse, vous recevrez un lien de réinitialisation.<br>
            Consultez également votre dossier <strong>spam</strong>.</p>
        </div>

        <a href="{{ path('app_login') }}" class="back-link" style="margin-top: 28px;">Retour à la connexion</a>

    {% else %}
        <!-- Form -->
        <div class="icon-header">🔑</div>
        <h1>Mot de passe oublié ?</h1>
        <p class="subtitle">Entrez votre adresse email et nous vous enverrons un lien pour réinitialiser votre mot de passe.</p>

        <div class="alert alert-error" id="js-error" style="display: none;"></div>
        <div class="alert alert-success" id="js-success" style="display: none;">
            <span class="icon">📧</span>
            <h2>Email envoyé</h2>
            <p>Si un compte existe avec cette adresse, vous recevrez un lien de réinitialisation.<br>
            Consultez également votre dossier <strong>spam</strong>.</p>
        </div>

        <form method="post" action="{{ path('app_forgot_password') }}" id="forgot-form" novalidate>
            <div class="field">
                <label for="email">Adresse email *</label>
                <input type="email" id="email" name="email" placeholder="vous@exemple.com" required autofocus>
            </div>
            <button type="submit" class="btn-submit" id="submit-btn" style="margin-top: 10px;">📨 Envoyer le lien</button>
        </form>

        <a href="{{ path('app_login') }}" class="back-link">Retour à la connexion</a>
    {% endif %}
</div>

<script>
document.getElementById('forgot-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const form = this;
    const btn = document.getElementById('submit-btn');
    const errorBox = document.getElementById('js-error');
    const successBox = document.getElementById('js-success');
    
    errorBox.style.display = 'none';
    
    if (btn) {
        btn.disabled = true;
        btn.textContent = '⏳ Envoi en cours…';
    }
    
    const formData = new FormData(form);
    
    try {
        const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        });
        
        const data = await response.json();
        
        if (data.success) {
            form.style.display = 'none';
            successBox.style.display = 'block';
        } else {
            btn.disabled = false;
            btn.textContent = '📨 Envoyer le lien';
            errorBox.textContent = '⚠️ ' + (data.error || 'Erreur inattendue.');
            errorBox.style.display = 'block';
        }
    } catch (err) {
        btn.disabled = false;
        btn.textContent = '📨 Envoyer le lien';
        errorBox.textContent = '⚠️ Problème de connexion au serveur.';
        errorBox.style.display = 'block';
    }
});
</script>
{% endblock %}
