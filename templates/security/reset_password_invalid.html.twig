{% extends 'base.html.twig' %}

{% block title %}Lien invalide — PsyApp{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
        font-family: 'Inter', sans-serif;
        background: #0d0d1a;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        padding: 40px 36px;
        max-width: 420px;
        text-align: center;
    }
    h1 { color: #fff; font-size: 1.25rem; margin-bottom: 12px; }
    p { color: rgba(255,255,255,0.5); font-size: 0.9rem; line-height: 1.6; margin-bottom: 24px; }
    a {
        display: inline-block;
        padding: 12px 20px;
        background: linear-gradient(135deg, #6c63ff, #00d2c8);
        color: #fff;
        text-decoration: none;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.9rem;
    }
</style>
{% endblock %}

{% block body %}
<div class="card">
    <h1>Lien invalide ou expiré</h1>
    <p>Ce lien de réinitialisation n’est plus valide. Demandez un nouvel email depuis la page « mot de passe oublié ».</p>
    <a href="{{ path('app_forgot_password') }}">Demander un nouveau lien</a>
</div>
{% endblock %}
