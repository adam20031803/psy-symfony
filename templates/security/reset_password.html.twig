{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe — Atomic You{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { width: 100%; height: 100%; }
    body {
        font-family: 'Inter', sans-serif;
        background: #0d0d1a;
        width: 100% !important;
        height: 100vh !important;
        margin: 0 !important;
        padding: 0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        overflow: hidden !important;
        flex-direction: column !important;
    }
    /* Hide sidebar and navigation */
    [class*="sidebar"], [class*="nav"], [class*="menu"], nav, aside { display: none !important; }
    .bg { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
    .orb { position: absolute; border-radius: 50%; filter: blur(80px); animation: float 8s ease-in-out infinite; }
    .orb-1 { width: 420px; height: 420px; background: radial-gradient(circle, rgba(108,99,255,0.35), transparent 70%); top: -100px; left: -60px; }
    .orb-2 { width: 350px; height: 350px; background: radial-gradient(circle, rgba(0,210,200,0.25), transparent 70%); bottom: -80px; right: -60px; animation-delay: -3s; }
    .orb-3 { width: 260px; height: 260px; background: radial-gradient(circle, rgba(255,100,160,0.2), transparent 70%); top: 50%; left: 55%; animation-delay: -5s; }
    @keyframes float {
        0%, 100% { transform: translateY(0) scale(1); }
        50%       { transform: translateY(-30px) scale(1.06); }
    }
    .card {
        position: relative; z-index: 1;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        padding: 48px 44px 40px;
        width: 100%; max-width: 420px;
        box-shadow: 0 30px 80px rgba(0,0,0,0.4);
        animation: slideUp 0.6s cubic-bezier(0.16,1,0.3,1) both;
    }
    @keyframes slideUp {
        from { opacity: 0; transform: translateY(40px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .logo { display: flex; align-items: center; gap: 10px; margin-bottom: 32px; }
    .logo-icon {
        width: 42px; height: 42px;
        background: linear-gradient(135deg, #6c63ff, #00d2c8);
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 22px;
    }
    .logo-text { font-size: 1.3rem; font-weight: 700; color: #fff; letter-spacing: -0.5px; }
    .logo-text span { color: #6c63ff; }
    .icon-header {
        width: 64px; height: 64px;
        background: linear-gradient(135deg, rgba(108,99,255,0.2), rgba(0,210,200,0.15));
        border: 1px solid rgba(108,99,255,0.3);
        border-radius: 18px;
        display: flex; align-items: center; justify-content: center;
        font-size: 2rem;
        margin-bottom: 20px;
    }
    h1 { font-size: 1.55rem; font-weight: 700; color: #fff; margin-bottom: 8px; letter-spacing: -0.5px; }
    .subtitle { font-size: 0.85rem; color: rgba(255,255,255,0.7); margin-bottom: 28px; line-height: 1.6; }
    .alert-error {
        background: rgba(255,80,80,0.12); border: 1px solid rgba(255,80,80,0.3);
        border-radius: 12px; padding: 12px 16px; color: #ff7070;
        font-size: 0.85rem; margin-bottom: 20px;
    }
    .field { margin-bottom: 20px; }
    label {
        display: block; font-size: 0.78rem; font-weight: 600;
        color: rgba(255,255,255,0.7); margin-bottom: 8px;
        text-transform: uppercase; letter-spacing: 0.5px;
    }
    input[type="password"] {
        width: 100%; padding: 14px 16px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px; color: #fff;
        font-size: 0.95rem; font-family: 'Inter', sans-serif;
        outline: none;
        transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
    }
    input[type="password"]:focus {
        border-color: #6c63ff;
        background: rgba(108,99,255,0.08);
        box-shadow: 0 0 0 4px rgba(108,99,255,0.15);
    }
    .btn-submit {
        width: 100%; padding: 15px;
        background: linear-gradient(135deg, #6c63ff, #00d2c8);
        border: none; border-radius: 12px;
        color: #fff; font-size: 1rem; font-weight: 600;
        font-family: 'Inter', sans-serif; cursor: pointer;
        box-shadow: 0 6px 24px rgba(108,99,255,0.4);
        letter-spacing: 0.2px;
    }
    .btn-submit:hover { opacity: 0.92; }
    .back-link {
        display: flex; align-items: center; justify-content: center; gap: 6px;
        margin-top: 22px; font-size: 0.84rem;
        color: rgba(255,255,255,0.35); text-decoration: none;
    }
    .back-link:hover { color: #6c63ff; }
    .back-link::before { content: '←'; }
</style>
{% endblock %}

{% block body %}
<div class="bg">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
</div>

<div class="card">
    <div class="logo">
        <div class="logo-icon">🧠</div>
        <div class="logo-text">Atomic<span>You</span></div>
    </div>

    <div class="icon-header">🔐</div>
    <h1>Nouveau mot de passe</h1>
    <p class="subtitle">Choisissez un mot de passe d’au moins 6 caractères.</p>

    {% if error %}
        <div class="alert-error">⚠️ {{ error }}</div>
    {% endif %}

    <form method="post" action="{{ path('app_reset_password', { token: token }) }}" id="reset-form">
        <div class="field">
            <label for="password">Mot de passe</label>
            <input type="password" id="password" name="password" required minlength="6" autocomplete="new-password" autofocus>
        </div>
        <div class="field">
            <label for="confirm_password">Confirmer</label>
            <input type="password" id="confirm_password" name="confirm_password" required minlength="6" autocomplete="new-password">
        </div>
        <button type="submit" class="btn-submit" id="submit-btn">Enregistrer</button>
    </form>

    <a href="{{ path('app_login') }}" class="back-link">Retour à la connexion</a>
</div>

<script>
document.getElementById('reset-form')?.addEventListener('submit', function() {
    const btn = document.getElementById('submit-btn');
    if (btn) { btn.disabled = true; btn.textContent = 'Enregistrement…'; }
});
</script>
{% endblock %}
