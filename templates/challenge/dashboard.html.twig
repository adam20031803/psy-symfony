{% extends 'base.html.twig' %}
{% block title %}Dashboard Motivation — Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* ═══════════════════════════════════════
           MOTIVATION DASHBOARD — GLASS DARK UI
        ═══════════════════════════════════════ */
        .motiv-page {
            padding: 32px 36px 100px;
            max-width: 1500px;
            margin: 0 auto;
        }

        /* ── Page header ── */
        .motiv-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 32px;
            flex-wrap: wrap;
            gap: 16px;
        }
        .motiv-title {
            font-size: 1.7rem;
            font-weight: 900;
            background: linear-gradient(90deg, #fff 0%, #ffd700 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -0.5px;
        }
        .motiv-subtitle { color: rgba(255,255,255,.4); font-size: 0.82rem; margin-top: 3px; }

        /* ── Top KPI cards ── */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 32px;
        }
        @media (max-width: 1100px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 600px)  { .kpi-grid { grid-template-columns: 1fr; } }

        .kpi-card {
            background: rgba(255,255,255,.025);
            border: 1px solid rgba(255,255,255,.07);
            border-radius: 20px;
            padding: 22px 24px;
            display: flex;
            align-items: center;
            gap: 18px;
            transition: border-color .2s, transform .2s;
            position: relative;
            overflow: hidden;
        }
        .kpi-card::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 20px;
            background: var(--glow);
            opacity: 0;
            transition: opacity .3s;
        }
        .kpi-card:hover { border-color: rgba(255,255,255,.15); transform: translateY(-2px); }
        .kpi-card:hover::before { opacity: 1; }

        .kpi-icon {
            width: 52px; height: 52px;
            border-radius: 15px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem;
            flex-shrink: 0;
            position: relative; z-index: 1;
        }
        .kpi-val  { font-size: 2rem; font-weight: 900; color: #fff; line-height: 1; position: relative; z-index: 1; }
        .kpi-lab  { font-size: 0.72rem; color: rgba(255,255,255,.45); text-transform: uppercase; letter-spacing: .08em; margin-top: 4px; position: relative; z-index: 1; }
        .kpi-sub  { font-size: 0.7rem; color: rgba(255,255,255,.3); margin-top: 2px; position: relative; z-index: 1; }

        /* ── Chart grid ── */
        .charts-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }
        .charts-grid-3 {
            display: grid;
            grid-template-columns: 1.4fr 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }
        @media (max-width: 1200px) {
            .charts-grid   { grid-template-columns: 1fr; }
            .charts-grid-3 { grid-template-columns: 1fr; }
        }

        /* ── Chart card ── */
        .chart-card {
            background: rgba(255,255,255,.02);
            border: 1px solid rgba(255,255,255,.07);
            border-radius: 22px;
            padding: 24px;
            transition: border-color .2s;
        }
        .chart-card:hover { border-color: rgba(108,99,255,.2); }
        .chart-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }
        .chart-title {
            font-size: 0.88rem;
            font-weight: 800;
            color: #fff;
        }
        .chart-badge {
            font-size: 0.65rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: .06em;
        }
        .chart-canvas-wrap {
            position: relative;
        }

        /* ── Toolbar actions ── */
        .motiv-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        .motiv-btn {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 9px 18px; border-radius: 12px;
            font-size: 0.8rem; font-weight: 700;
            text-decoration: none; border: none; cursor: pointer;
            transition: all .2s;
        }
        .motiv-btn:hover { opacity: .88; transform: translateY(-1px); }
        .btn-purple { background: linear-gradient(135deg,#6c63ff,#4f46e5); color:#fff; }
        .btn-teal   { background: rgba(0,210,255,.15); color:#5eead4; border:1px solid rgba(0,210,255,.25); }
        .btn-gold   { background: rgba(255,215,0,.12); color:#ffd700; border:1px solid rgba(255,215,0,.25); }

        /* ── Data tables section ── */
        .tables-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 24px;
        }
        @media (max-width: 1100px) { .tables-grid { grid-template-columns: 1fr; } }

        .table-card {
            background: rgba(255,255,255,.02);
            border: 1px solid rgba(255,255,255,.07);
            border-radius: 20px;
            overflow: hidden;
        }
        .table-head {
            padding: 16px 20px;
            border-bottom: 1px solid rgba(255,255,255,.06);
            background: rgba(255,255,255,.02);
            display: flex; align-items: center; justify-content: space-between;
        }
        .table-head h3 { margin: 0; font-size: 0.88rem; font-weight: 800; color: #fff; }
        .table-body { padding: 12px; }
        .table-row {
            display: flex; align-items: center; gap: 12px;
            padding: 10px 12px;
            border-radius: 12px;
            transition: background .15s;
        }
        .table-row:hover { background: rgba(255,255,255,.03); }
        .table-rank { font-size: 0.72rem; font-weight: 800; color: rgba(255,255,255,.3); width: 20px; }
        .table-name { font-size: 0.82rem; font-weight: 600; color: rgba(255,255,255,.8); flex: 1; }
        .table-val  { font-size: 0.78rem; font-weight: 700; }
        .table-bar-wrap { flex: 1; height: 5px; background: rgba(255,255,255,.06); border-radius: 3px; }
        .table-bar { height: 100%; border-radius: 3px; background: linear-gradient(90deg,#6c63ff,#00d2ff); }

        /* ── Flash ── */
        .flash-msg { position:fixed;top:80px;right:20px;z-index:9999;padding:14px 22px;border-radius:12px;font-weight:700;font-size:0.85rem;box-shadow:0 8px 30px rgba(0,0,0,.4);animation:slideIn 0.4s ease;color:white;max-width:380px; }
        .flash-success{ background:rgba(34,197,94,.9); }
        .flash-error  { background:rgba(239,68,68,.9); }
        @keyframes slideIn { from{transform:translateX(120%);opacity:0;}to{transform:translateX(0);opacity:1;} }
    </style>
{% endblock %}

{% block body %}
<div class="motiv-page">

{# Flash messages #}
{% for type, msgs in app.flashes %}
<div class="flash-msg flash-{{ type }}">{% for m in msgs %}{{ m }}{% endfor %}</div>
{% endfor %}

{# ── Header ── #}
<div class="motiv-header">
    <div>
        <h1 class="motiv-title">🏆 Dashboard Motivation</h1>
        <p class="motiv-subtitle">Vue analytique — Challenges, Coaches & Récompenses</p>
    </div>
    <div class="motiv-actions">
        <a href="{{ path('app_challenge_calendar') }}" class="motiv-btn btn-teal">📅 Calendrier</a>
        <a href="{{ path('app_challenge_index') }}" class="motiv-btn btn-purple">🏁 Challenges</a>
        <a href="{{ path('app_challenge_export_pdf') }}" target="_blank" class="motiv-btn btn-gold">📄 Export PDF</a>
    </div>
</div>

{# ── KPI cards ── #}
<div class="kpi-grid">
    <div class="kpi-card" style="--glow:linear-gradient(135deg,rgba(108,99,255,.06),transparent);">
        <div class="kpi-icon" style="background:rgba(108,99,255,.15);">🏁</div>
        <div>
            <div class="kpi-val">{{ stats.ch_total }}</div>
            <div class="kpi-lab">Challenges Total</div>
            <div class="kpi-sub">{{ stats.ch_active }} actifs · {{ stats.ch_done }} terminés</div>
        </div>
    </div>
    <div class="kpi-card" style="--glow:linear-gradient(135deg,rgba(34,211,165,.05),transparent);">
        <div class="kpi-icon" style="background:rgba(34,211,165,.12);">👨‍🏫</div>
        <div>
            <div class="kpi-val">{{ stats.co_total }}</div>
            <div class="kpi-lab">Coaches</div>
            <div class="kpi-sub">{{ stats.co_active }} disponibles</div>
        </div>
    </div>
    <div class="kpi-card" style="--glow:linear-gradient(135deg,rgba(255,215,0,.05),transparent);">
        <div class="kpi-icon" style="background:rgba(255,215,0,.10);">🎁</div>
        <div>
            <div class="kpi-val">{{ stats.rec_total }}</div>
            <div class="kpi-lab">Récompenses</div>
            <div class="kpi-sub">{{ stats.rec_points|number_format(0, ',', ' ') }} pts cumulés</div>
        </div>
    </div>
    <div class="kpi-card" style="--glow:linear-gradient(135deg,rgba(239,68,68,.05),transparent);">
        <div class="kpi-icon" style="background:rgba(239,68,68,.12);">📩</div>
        <div>
            <div class="kpi-val">{{ stats.rec_ouvert }}</div>
            <div class="kpi-lab">Réclamations ouvertes</div>
            <div class="kpi-sub">
                {% if stats.rec_ouvert > 0 %}
                <span style="color:#f87171;">⚠️ Action requise</span>
                {% else %}
                <span style="color:#4ade80;">✅ Tout traité</span>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# ── Rangée 1 de charts : Line + Doughnut ── #}
<div class="charts-grid">

    {# Chart 1 : Timeline mensuelle #}
    <div class="chart-card">
        <div class="chart-header">
            <h3 class="chart-title">📈 Challenges créés — 6 derniers mois</h3>
            <span class="chart-badge" style="background:rgba(108,99,255,.15);color:#a78bfa;">Tendance</span>
        </div>
        <div class="chart-canvas-wrap">
            <canvas id="chartTimeline" height="110"></canvas>
        </div>
    </div>

    {# Chart 2 : Statuts Doughnut #}
    <div class="chart-card">
        <div class="chart-header">
            <h3 class="chart-title">🍩 Répartition par statut</h3>
            <span class="chart-badge" style="background:rgba(34,211,165,.12);color:#22d3a5;">Vue globale</span>
        </div>
        <div class="chart-canvas-wrap" style="max-width:280px;margin:0 auto;">
            <canvas id="chartStatuts" height="180"></canvas>
        </div>
    </div>

</div>

{# ── Rangée 2 : Bar catégories + Polar coaches + Bar récompenses ── #}
<div class="charts-grid-3">

    {# Chart 3 : Catégories #}
    <div class="chart-card">
        <div class="chart-header">
            <h3 class="chart-title">📂 Challenges par catégorie</h3>
            <span class="chart-badge" style="background:rgba(0,210,255,.1);color:#5eead4;">Distribution</span>
        </div>
        <div class="chart-canvas-wrap">
            <canvas id="chartCategories" height="160"></canvas>
        </div>
    </div>

    {# Chart 4 : Coaches polar #}
    <div class="chart-card">
        <div class="chart-header">
            <h3 class="chart-title">🌐 Disponibilité coaches</h3>
            <span class="chart-badge" style="background:rgba(255,107,157,.1);color:#ff6b9d;">RH</span>
        </div>
        <div class="chart-canvas-wrap" style="max-width:220px;margin:0 auto;">
            <canvas id="chartCoaches" height="180"></canvas>
        </div>
    </div>

    {# Chart 5 : Top récompenses #}
    <div class="chart-card">
        <div class="chart-header">
            <h3 class="chart-title">🏅 Top récompenses (pts)</h3>
            <span class="chart-badge" style="background:rgba(255,215,0,.1);color:#ffd700;">Classement</span>
        </div>
        <div class="chart-canvas-wrap">
            <canvas id="chartRecompenses" height="160"></canvas>
        </div>
    </div>

</div>

{# ── Tables de données ── #}
<div class="tables-grid">

    {# Table challenges récents #}
    <div class="table-card">
        <div class="table-head">
            <h3>🔥 Challenges actifs</h3>
            <a href="{{ path('app_challenge_index') }}" style="font-size:0.72rem;color:#a78bfa;text-decoration:none;">Voir tout →</a>
        </div>
        <div class="table-body">
            {% set actifs = challenges|filter(c => c.statut == 'actif') %}
            {% if actifs|length == 0 %}
            <div style="text-align:center;padding:30px;color:rgba(255,255,255,.3);font-size:0.82rem;">Aucun challenge actif</div>
            {% else %}
            {% for c in actifs|slice(0, 7) %}
            <div class="table-row">
                <span class="table-rank">#{{ loop.index }}</span>
                <span class="table-name">{{ c.titre|length > 30 ? c.titre|slice(0,30) ~ '…' : c.titre }}</span>
                <span style="font-size:0.7rem;color:rgba(255,255,255,.35);">{{ c.coaches|length }} 👨‍🏫</span>
                <span class="table-val" style="color:#4ade80;">🔥 Actif</span>
            </div>
            {% endfor %}
            {% endif %}
        </div>
    </div>

    {# Table top récompenses #}
    <div class="table-card">
        <div class="table-head">
            <h3>🎁 Top Récompenses</h3>
            <a href="{{ path('app_recompense_index') }}" style="font-size:0.72rem;color:#ffd700;text-decoration:none;">Gérer →</a>
        </div>
        <div class="table-body">
            {% set pointsArray = recompenses|map(r => r.points) %}
{% set maxPts = pointsArray|length > 0 ? max(pointsArray) : 1 %}
            {% set sortedRecs = recompenses|sort((a, b) => b.points <=> a.points) %}
            {% for r in sortedRecs|slice(0, 7) %}
            <div class="table-row">
                <span class="table-rank">#{{ loop.index }}</span>
                <span class="table-name">{{ r.nom|length > 22 ? r.nom|slice(0,22) ~ '…' : r.nom }}</span>
                <div class="table-bar-wrap">
                    <div class="table-bar" style="width:{{ (r.points / maxPts * 100)|round }}%;background:linear-gradient(90deg,#ffd700,#ff8c00);"></div>
                </div>
                <span class="table-val" style="color:#ffd700;min-width:60px;text-align:right;">{{ r.points }} pts</span>
            </div>
            {% endfor %}
        </div>
    </div>

</div>

</div>{# end motiv-page #}

{# Données JSON pour Chart.js #}
<script>
const CHART_TIMELINE   = {{ chartTimeline|json_encode|raw }};
const CHART_STATUTS    = {{ chartStatuts|json_encode|raw }};
const CHART_CATEGORIES = {{ chartCategories|json_encode|raw }};
const CHART_COACHES    = {{ chartCoaches|json_encode|raw }};
const CHART_RECOMPENSES= {{ chartRecompenses|json_encode|raw }};
</script>
{% endblock %}

{% block javascripts %}
{# Chart.js via CDN #}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
// ── Global Chart defaults ──
Chart.defaults.color = 'rgba(255,255,255,0.45)';
Chart.defaults.borderColor = 'rgba(255,255,255,0.06)';
Chart.defaults.font.family = "'Inter', sans-serif";

// ────────────────────────────────────────────
// 1. LINE — Timeline mensuelle
// ────────────────────────────────────────────
new Chart(document.getElementById('chartTimeline'), {
    type: 'line',
    data: {
        labels: CHART_TIMELINE.labels,
        datasets: [{
            label: 'Challenges créés',
            data: CHART_TIMELINE.data,
            borderColor: '#6c63ff',
            backgroundColor: function(context) {
                const chart = context.chart;
                const { ctx, chartArea } = chart;
                if (!chartArea) return 'transparent';
                const gradient = ctx.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
                gradient.addColorStop(0, 'rgba(108,99,255,0.35)');
                gradient.addColorStop(1, 'rgba(108,99,255,0.02)');
                return gradient;
            },
            fill: true,
            tension: 0.45,
            borderWidth: 2.5,
            pointBackgroundColor: '#6c63ff',
            pointBorderColor: '#fff',
            pointBorderWidth: 2,
            pointRadius: 5,
            pointHoverRadius: 7,
        }]
    },
    options: {
        responsive: true,
        interaction: { mode: 'index', intersect: false },
        plugins: {
            legend: { display: false },
            tooltip: {
                backgroundColor: '#181b30',
                borderColor: 'rgba(108,99,255,0.35)',
                borderWidth: 1,
                titleColor: '#fff',
                bodyColor: 'rgba(255,255,255,0.7)',
                padding: 12,
                cornerRadius: 12,
            }
        },
        scales: {
            x: { grid: { color: 'rgba(255,255,255,0.04)' } },
            y: {
                beginAtZero: true,
                ticks: { stepSize: 1 },
                grid: { color: 'rgba(255,255,255,0.04)' },
            }
        }
    }
});

// ────────────────────────────────────────────
// 2. DOUGHNUT — Statuts
// ────────────────────────────────────────────
new Chart(document.getElementById('chartStatuts'), {
    type: 'doughnut',
    data: {
        labels: CHART_STATUTS.labels,
        datasets: [{
            data: CHART_STATUTS.data,
            backgroundColor: CHART_STATUTS.colors,
            borderColor: '#111328',
            borderWidth: 3,
            hoverBorderWidth: 0,
            hoverOffset: 8,
        }]
    },
    options: {
        responsive: true,
        cutout: '68%',
        plugins: {
            legend: {
                position: 'bottom',
                labels: {
                    padding: 18,
                    boxWidth: 12,
                    boxHeight: 12,
                    borderRadius: 4,
                    usePointStyle: true,
                    pointStyle: 'rectRounded',
                    color: 'rgba(255,255,255,0.6)',
                    font: { size: 11, weight: '700' },
                }
            },
            tooltip: {
                backgroundColor: '#181b30',
                borderColor: 'rgba(108,99,255,0.35)',
                borderWidth: 1,
                padding: 12,
                cornerRadius: 12,
            }
        }
    }
});

// ────────────────────────────────────────────
// 3. BAR — Catégories
// ────────────────────────────────────────────
const catColors = CHART_CATEGORIES.labels.map((_, i) => {
    const palette = ['#6c63ff','#00d2ff','#22d3a5','#ff6b9d','#ffd700','#f97316','#a78bfa','#34d399'];
    return palette[i % palette.length];
});

new Chart(document.getElementById('chartCategories'), {
    type: 'bar',
    data: {
        labels: CHART_CATEGORIES.labels,
        datasets: [{
            label: 'Challenges',
            data: CHART_CATEGORIES.data,
            backgroundColor: catColors.map(c => c + 'cc'),
            borderColor: catColors,
            borderWidth: 2,
            borderRadius: 8,
            borderSkipped: false,
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: { display: false },
            tooltip: {
                backgroundColor: '#181b30',
                borderColor: 'rgba(108,99,255,0.35)',
                borderWidth: 1,
                padding: 12,
                cornerRadius: 12,
            }
        },
        scales: {
            x: {
                grid: { display: false },
                ticks: { maxRotation: 30, font: { size: 10 } },
            },
            y: {
                beginAtZero: true,
                ticks: { stepSize: 1 },
                grid: { color: 'rgba(255,255,255,0.04)' },
            }
        }
    }
});

// ────────────────────────────────────────────
// 4. POLAR AREA — Coaches
// ────────────────────────────────────────────
new Chart(document.getElementById('chartCoaches'), {
    type: 'polarArea',
    data: {
        labels: CHART_COACHES.labels,
        datasets: [{
            data: CHART_COACHES.data,
            backgroundColor: CHART_COACHES.colors,
            borderColor: '#111328',
            borderWidth: 2,
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: {
                position: 'bottom',
                labels: {
                    padding: 14,
                    boxWidth: 10,
                    usePointStyle: true,
                    pointStyle: 'circle',
                    color: 'rgba(255,255,255,0.6)',
                    font: { size: 11, weight: '700' },
                }
            },
            tooltip: {
                backgroundColor: '#181b30',
                borderColor: 'rgba(108,99,255,0.35)',
                borderWidth: 1,
                padding: 12,
                cornerRadius: 12,
            }
        },
        scales: {
            r: {
                grid: { color: 'rgba(255,255,255,0.06)' },
                ticks: { display: false },
                pointLabels: { display: false },
            }
        }
    }
});

// ────────────────────────────────────────────
// 5. HORIZONTAL BAR — Récompenses
// ────────────────────────────────────────────
new Chart(document.getElementById('chartRecompenses'), {
    type: 'bar',
    data: {
        labels: CHART_RECOMPENSES.labels,
        datasets: [{
            label: 'Points',
            data: CHART_RECOMPENSES.data,
            backgroundColor: function(context) {
                const chart = context.chart;
                const { ctx } = chart;
                const gradient = ctx.createLinearGradient(0, 0, 400, 0);
                gradient.addColorStop(0, 'rgba(255,215,0,0.8)');
                gradient.addColorStop(1, 'rgba(255,140,0,0.5)');
                return gradient;
            },
            borderColor: '#ffd700',
            borderWidth: 1.5,
            borderRadius: 7,
            borderSkipped: false,
        }]
    },
    options: {
        indexAxis: 'y',
        responsive: true,
        plugins: {
            legend: { display: false },
            tooltip: {
                backgroundColor: '#181b30',
                borderColor: 'rgba(255,215,0,0.3)',
                borderWidth: 1,
                padding: 12,
                cornerRadius: 12,
                callbacks: {
                    label: (ctx) => ` ${ctx.parsed.x.toLocaleString('fr')} pts`,
                }
            }
        },
        scales: {
            x: {
                beginAtZero: true,
                grid: { color: 'rgba(255,255,255,0.04)' },
                ticks: { callback: (v) => v.toLocaleString('fr') + ' pts', font: { size: 10 } },
            },
            y: { grid: { display: false } }
        }
    }
});

// ── Auto-dismiss flash ──
setTimeout(() => {
    document.querySelectorAll('.flash-msg').forEach(f => {
        f.style.transition = 'opacity .5s';
        f.style.opacity = '0';
        setTimeout(() => f.remove(), 500);
    });
}, 4000);
</script>
{% endblock %}
