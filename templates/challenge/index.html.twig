{% extends 'base.html.twig' %}
{% block title %}Challenge Manager Pro{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/manager.css') }}">
    <link rel="stylesheet" href="{{ asset('css/premium.css') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg:       #0a0c1a;
            --surface:  #111328;
            --card:     #181b30;
            --sidebar:  #0e1025;
            --border:   rgba(255,255,255,0.06);
            --accent:   #6c63ff;
            --accent2:  #00d2ff;
            --success:  #22d3a5;
            --warning:  #f59e0b;
            --pink:     #ec4899;
            --orange:   #f97316;
            --text:     #e2e8f0;
            --muted:    #64748b;
            --radius:   16px;
            --sidebar-w: 280px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* ── Background glow ── */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse 60% 40% at 20% 10%, rgba(108,99,255,.10) 0%, transparent 70%),
                radial-gradient(ellipse 50% 35% at 80% 80%, rgba(0,210,255,.06) 0%, transparent 70%);
            pointer-events: none;
            z-index: 0;
        }

        /* ── Navbar ── */
        .top-nav {
            position: sticky;
            top: 0;
            z-index: 10000;
            background: rgba(14,16,37,.92);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-bottom: 1px solid var(--border);
            padding: 0 32px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 1.1rem;
        }
        .nav-logo .icon {
            width: 34px; height: 34px;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            border-radius: 9px;
            display: flex;
            align-items: center; justify-content: center;
            font-size: 0.95rem;
        }
        .nav-logo span { color: var(--accent2); }
        .nav-logo strong { color: var(--text); }
        .nav-actions { display: flex; align-items: center; gap: 14px; }
        .nav-user {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 5px 14px 5px 5px;
        }
        .nav-avatar {
            width: 28px; height: 28px;
            background: linear-gradient(135deg, var(--accent), var(--pink));
            border-radius: 50%;
            display: flex;
            align-items: center; justify-content: center;
            font-weight: 700;
            font-size: 0.7rem; color: white;
        }
        .nav-name { font-size: 0.8rem; font-weight: 500; }
        .btn-logout {
            text-decoration: none;
            color: var(--muted);
            font-size: 0.78rem;
            font-weight: 500;
            padding: 6px 12px;
            border-radius: 8px;
            border: 1px solid var(--border);
            transition: all .2s;
        }
        .btn-logout:hover { color: var(--text); border-color: rgba(255,255,255,.15); background: var(--card); }

        /* ── Layout ── */
        .app-layout {
            display: flex;
            flex: 1;
            position: relative;
            z-index: 1;
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: var(--sidebar-w);
            min-height: calc(100vh - 60px);
            background: var(--sidebar);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            padding: 24px 0;
            position: sticky;
            top: 60px;
            height: calc(100vh - 60px);
            overflow-y: auto;
            flex-shrink: 0;
        }
        .sidebar-section-label {
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--muted);
            padding: 0 24px;
            margin-bottom: 10px;
            margin-top: 8px;
        }
        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 2px;
            padding: 0 12px;
        }
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 16px;
            border-radius: 12px;
            text-decoration: none;
            color: rgba(255,255,255,0.6);
            font-size: 0.85rem;
            font-weight: 500;
            transition: all .25s cubic-bezier(.4,0,.2,1);
            position: relative;
            overflow: hidden;
        }
        .sidebar-link:hover {
            background: rgba(108,99,255,.08);
            color: var(--text);
            transform: translateX(4px);
        }
        .sidebar-link.active {
            background: linear-gradient(135deg, rgba(108,99,255,.15), rgba(0,210,255,.08));
            color: #fff;
            font-weight: 600;
            border: 1px solid rgba(108,99,255,.2);
            box-shadow: 0 4px 16px rgba(108,99,255,.12);
        }
        .sidebar-link.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 3px;
            height: 60%;
            background: linear-gradient(180deg, var(--accent), var(--accent2));
            border-radius: 0 4px 4px 0;
        }

        .sidebar-icon {
            width: 38px; height: 38px;
            border-radius: 11px;
            display: flex;
            align-items: center; justify-content: center;
            font-size: 1.15rem; flex-shrink: 0;
            transition: transform .25s;
        }
        .sidebar-link:hover .sidebar-icon { transform: scale(1.1); }
        .si-purple   { background: rgba(108,99,255,.12); }
        .si-teal     { background: rgba(0,210,255,.10); }
        .si-green    { background: rgba(34,211,165,.10); }
        .si-pink     { background: rgba(236,72,153,.10); }
        .si-orange   { background: rgba(249,115,22,.10); }
        .si-blue     { background: rgba(59,130,246,.10); }
        .si-yellow   { background: rgba(245,158,11,.10); }

        .sidebar-link-text { display: flex; flex-direction: column; gap: 1px; }
        .sidebar-link-title { font-size: 0.84rem; line-height: 1.3; }
        .sidebar-link-sub { font-size: 0.68rem; color: var(--muted); font-weight: 400; }
        .sidebar-link:hover .sidebar-link-sub,
        .sidebar-link.active .sidebar-link-sub { color: rgba(255,255,255,.45); }

        .sidebar-divider { height: 1px; background: var(--border); margin: 16px 24px; }
        .sidebar-footer { margin-top: auto; padding: 20px; }
        .sidebar-pro-card {
            background: linear-gradient(135deg, rgba(108,99,255,.12), rgba(0,210,255,.08));
            border: 1px solid rgba(108,99,255,.18);
            border-radius: 14px; padding: 18px; text-align: center;
        }

        /* ── Main Area ── */
        .content-area {
            flex: 1;
            padding: 30px;
            max-width: 1300px;
            position: relative;
        }

        /* ── Specific Overrides for Challenge ── */
        .challenge-header-custom {
            margin-bottom: 25px;
        }
        .challenge-container {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 25px;
        }

        @media (max-width: 1100px) {
            .challenge-container { grid-template-columns: 1fr; }
        }
        @media (max-width: 900px) {
            .sidebar { display: none; }
        }
    </style>
{% endblock %}
{% block body_class %}bg-challenge{% endblock %}
{% block body %}

<!-- ── Navbar unifiée ── -->
<nav class="top-nav">
    <div class="nav-logo">
        <div class="icon">🧠</div>
        <div><strong>Psy</strong><span>App</span></div>
    </div>
    <div class="nav-actions">
        {% if app.user %}
        <div class="nav-user">
            <div class="nav-avatar">{{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}</div>
            <span class="nav-name">{{ app.user.prenom }} {{ app.user.nom }}</span>
        </div>
        {% endif %}
        <a href="{{ path('app_logout') }}" class="btn-logout">🚪 Déconnexion</a>
    </div>
</nav>

<div class="app-layout">

    <!-- ══════ SIDEBAR UNIFIÉE ══════ -->
    <aside class="sidebar">
        <div class="sidebar-section-label">🏠 Tableau de bord</div>
        <div class="sidebar-nav">
            <a href="{{ path('app_dashboard') }}" class="sidebar-link">
                <div class="sidebar-icon si-blue">📊</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Dashboard</span>
                    <span class="sidebar-link-sub">Vue d'ensemble</span>
                </div>
            </a>
        </div>

        <div class="sidebar-divider"></div>

        <div class="sidebar-section-label">⚙️ Gestion</div>
        <div class="sidebar-nav">
            <a href="{{ path('app_challenge_index') }}" class="sidebar-link active">
                <div class="sidebar-icon si-purple">🔥</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Motivation</span>
                    <span class="sidebar-link-sub">Challenges & objectifs</span>
                </div>
            </a>

            <a href="#" class="sidebar-link">
                <div class="sidebar-icon si-green">🔄</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Habitudes</span>
                    <span class="sidebar-link-sub">Suivi quotidien</span>
                </div>
            </a>

            <a href="{{ path('post_index') }}" class="sidebar-link">
                <div class="sidebar-icon si-pink">💬</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Forum</span>
                    <span class="sidebar-link-sub">Communauté & partage</span>
                </div>
            </a>
        </div>

        <div class="sidebar-divider"></div>

        <div class="sidebar-section-label">📋 Support</div>
        <div class="sidebar-nav">
            <a href="{{ path('app_reclamation_index') }}" class="sidebar-link">
                <div class="sidebar-icon si-yellow">📬</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Réclamations</span>
                    <span class="sidebar-link-sub">Mes demandes</span>
                </div>
            </a>
        </div>

        <div class="sidebar-footer">
            <div class="sidebar-pro-card">
                <span style="font-size: 1.5rem; display: block; margin-bottom: 5px;">🌟</span>
                <h4 style="font-size: 0.8rem; color: white;">PsyApp Pro</h4>
                <p style="font-size: 0.7rem; color: var(--muted);">Version Motivation étendue</p>
            </div>
        </div>
    </aside>

    <!-- ══════ ZONE DE CONTENU ══════ -->
    <div class="content-area">

{# ============================================================ FLASH MESSAGES #}
{% for type, messages in app.flashes %}
<div class="flash-msg flash-{{ type }}">{% for m in messages %}{{ m }}{% endfor %}</div>
{% endfor %}

{# ============================================================ MODAL: COACHES DU CHALLENGE #}
<div id="modalCoaches" class="modal-overlay" style="display:none;">
  <div class="modal-box card-glass">
    <div class="d-flex justify-between align-center" style="margin-bottom:18px;">
      <h3 class="text-glow m-0" style="color:white;">👨‍🏫 Coaches du Challenge</h3>
      <button onclick="closeModal('modalCoaches')" class="btn btn-grey btn-small">✕ Fermer</button>
    </div>
    <p id="modalCoachTitle" style="color:#a8c0ff;margin:0 0 15px;font-size:13px;"></p>
    <div id="modalCoachesList" style="max-height:350px;overflow-y:auto;" class="d-flex flex-column gap-12"></div>
  </div>
</div>

{# ============================================================ MODAL: EMAIL COACH #}
<div id="modalEmail" class="modal-overlay" style="display:none;">
  <div class="modal-box card-glass" style="max-width:500px;">
    <div class="d-flex justify-between align-center" style="margin-bottom:18px;">
      <h3 class="text-glow m-0" style="color:white;">📧 Contacter le Coach</h3>
      <button onclick="closeModal('modalEmail')" class="btn btn-grey btn-small">✕ Fermer</button>
    </div>
    <form id="emailForm" method="POST" action="" class="d-flex flex-column gap-12">
      <div class="d-flex flex-column gap-5">
        <label style="color:#a8c0ff;font-size:12px;font-weight:bold;">DESTINATAIRE</label>
        <input type="text" id="emailTo" readonly class="form-control" style="opacity:0.7;">
      </div>
      
      {% if app.user %}
        <div class="card-glass p-10" style="background:rgba(102,126,234,0.1);border-radius:8px;">
          <small style="color:white;">📫 L'email sera envoyé en votre nom via : <strong style="color:#a8c0ff;">{{ app.user.userIdentifier }}</strong></small>
        </div>
      {% else %}
        <div class="d-flex flex-column gap-5">
          <label style="color:#a8c0ff;font-size:12px;font-weight:bold;">VOTRE EMAIL (expéditeur)</label>
          <input type="email" name="sender_email" class="form-control" placeholder="votre@email.com" required>
        </div>
      {% endif %}

      <div class="d-flex flex-column gap-5">
        <label style="color:#a8c0ff;font-size:12px;font-weight:bold;">SUJET</label>
        <input type="text" name="subject" class="form-control" value="Message concernant le Challenge" required>
      </div>
      <div class="d-flex flex-column gap-5">
        <label style="color:#a8c0ff;font-size:12px;font-weight:bold;">MESSAGE</label>
        <textarea name="message" class="form-control" rows="5" placeholder="Votre message au coach..." required></textarea>
      </div>
      <button type="submit" class="btn btn-blue-purple" style="border-radius:8px;">📤 Envoyer l'Email</button>
    </form>
  </div>
</div>

{# ============================================================ MODAL: RÉCOMPENSES DU CHALLENGE #}
<div id="modalRecompenses" class="modal-overlay" style="display:none;">
  <div class="modal-box card-glass">
    <div class="d-flex justify-between align-center" style="margin-bottom:18px;">
      <h3 class="text-glow m-0" style="color:white;">🎁 Récompenses du Challenge</h3>
      <button onclick="closeModal('modalRecompenses')" class="btn btn-grey btn-small">✕ Fermer</button>
    </div>
    <p id="modalRecTitle" style="color:#ffd89b;margin:0 0 15px;font-size:13px;"></p>
    <div id="modalRecList" style="max-height:350px;overflow-y:auto;" class="d-flex flex-column gap-12"></div>
  </div>
</div>

{# ============================================================ MODAL: AJOUTER COACH #}
<div id="modalAddCoach" class="modal-overlay" style="display:none;">
  <div class="modal-box card-glass" style="max-width:450px;">
    <div class="d-flex justify-between align-center" style="margin-bottom:18px;">
      <h3 class="text-glow m-0" style="color:white;">➕ Assigner un Coach</h3>
      <button onclick="closeModal('modalAddCoach')" class="btn btn-grey btn-small">✕ Fermer</button>
    </div>
    <p id="modalAddCoachTitle" style="color:#a8c0ff;margin:0 0 15px;font-size:13px;"></p>
    <form id="addCoachForm" method="POST" action="" class="d-flex flex-column gap-12">
      <div class="d-flex flex-column gap-5">
        <label style="color:#a8c0ff;font-size:12px;font-weight:bold;">👨‍🏫 SÉLECTIONNER UN COACH</label>
        <select name="coach_id" class="form-control" required>
          <option value="">-- Choisir un coach --</option>
          {% for coach in coaches %}
          <option value="{{ coach.id }}">{{ coach.nom }} {{ coach.prenom }} ({{ coach.email }})</option>
          {% endfor %}
        </select>
      </div>
      <button type="submit" class="btn btn-purple" style="border-radius:8px;">✅ Assigner le Coach</button>
    </form>
  </div>
</div>

{# ============================================================ MODAL: AJOUTER RÉCOMPENSE #}
<div id="modalAddRec" class="modal-overlay" style="display:none;">
  <div class="modal-box card-glass" style="max-width:450px;">
    <div class="d-flex justify-between align-center" style="margin-bottom:18px;">
      <h3 class="text-glow m-0" style="color:white;">🎁 Ajouter une Récompense</h3>
      <button onclick="closeModal('modalAddRec')" class="btn btn-grey btn-small">✕ Fermer</button>
    </div>
    <p id="modalAddRecTitle" style="color:#ffd89b;margin:0 0 15px;font-size:13px;"></p>
    <form id="addRecForm" method="POST" action="" class="d-flex flex-column gap-12">
      <div class="d-flex flex-column gap-5">
        <label style="color:#ffd89b;font-size:12px;font-weight:bold;">🏆 SÉLECTIONNER UNE RÉCOMPENSE</label>
        <select name="recompense_id" class="form-control" required>
          <option value="">-- Choisir une récompense --</option>
          {% for rec in recompenses %}
          <option value="{{ rec.id }}">{{ rec.nom }} ({{ rec.points }} pts)</option>
          {% endfor %}
        </select>
      </div>
      <button type="submit" class="btn btn-pink" style="border-radius:8px;">🎁 Associer la Récompense</button>
    </form>
  </div>
</div>

  <header class="challenge-header-custom d-flex flex-column gap-0">
    <div class="top-header justify-between d-flex align-center">
      <div class="d-flex align-center gap-15">
        <div class="header-circle challenge-circle animate-pulse"></div>
        <div>
          <h1 class="brand-title text-glow">CHALLENGE MANAGER PRO</h1>
          <p class="brand-subtitle" style="color:#a8c0ff;">Système de gestion intelligente</p>
        </div>
      </div>
      <form method="GET" action="{{ path('app_challenge_index') }}" class="d-flex align-center gap-15 card-glass" style="padding:10px 15px; border-radius:12px;">
        <div class="d-flex align-center gap-10 flex-grow-1">
          <span style="font-size:16px;">🔍</span>
          <input type="text" name="search" value="{{ filters.search ?? '' }}" class="search-input" placeholder="Recherche..." style="background:transparent; border:none; color:white; width:120px; outline:none; font-size:12px;">
        </div>
        
        <select name="statut" class="filter-select" style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:8px; padding:4px 8px; color:white; font-size:11px; outline:none;">
          <option value="">Statut</option>
          <option value="actif" {% if filters.statut == 'actif' %}selected{% endif %}>Actif</option>
          <option value="termine" {% if filters.statut == 'termine' %}selected{% endif %}>Terminé</option>
        </select>

        <button type="submit" class="btn btn-blue-purple" style="border-radius:8px; padding:6px 12px; font-size:11px;">FILTRER</button>
      </form>
    </div>
    <div class="action-bar gap-15 card-glass d-flex align-center justify-between" style="margin-top:10px; padding:12px; border-radius:12px;">
      <div class="d-flex gap-10">
        <a href="{{ path('app_coach_index') }}" class="btn btn-purple btn-small" style="font-size:11px;">👨‍🏫 COACHES</a>
        <a href="{{ path('app_recompense_index') }}" class="btn btn-pink btn-small" style="font-size:11px;">🎁 RÉCOMPENSES</a>
      </div>
      <div class="d-flex gap-10 align-center">
        <div class="stats-mini p-5 d-flex gap-10" style="background:rgba(255,255,255,0.03); border-radius:8px; border:1px solid rgba(255,255,255,0.05);">
          <span style="color:#a8c0ff; font-size:11px;">TOTAL: <strong>{{ stats.total }}</strong></span>
        </div>
        <a href="{{ path('app_challenge_export_pdf') }}" target="_blank" class="btn btn-blue btn-small" style="font-size:11px;">📄 PDF</a>
      </div>
    </div>
  </header>

{# ============================================================ MODAL: DÉTAILS DU CHALLENGE (DBL CLICK) #}
<div id="modalDetails" class="modal-overlay" style="display:none;">
  <div class="modal-box card-glass" style="max-width:850px;padding:0;overflow:hidden;border:none;box-shadow:0 0 50px rgba(0,0,0,0.8);">
    <div style="position:relative;width:100%;height:350px;background:#000;">
      <div id="detailsMediaContainer" style="width:100%;height:100%;">
        {# Image or Video will be injected here #}
      </div>
      <button onclick="closeModal('modalDetails')" style="position:absolute;top:20px;right:20px;background:rgba(0,0,0,0.5);border:none;color:white;width:40px;height:40px;border-radius:50%;cursor:pointer;font-size:20px;backdrop-filter:blur(5px);z-index:10;">✕</button>
      <div style="position:absolute;bottom:0;left:0;right:0;background:linear-gradient(to top, rgba(0,0,0,0.9), transparent);padding:30px;padding-top:60px;">
        <span id="detailsStatut" style="padding:5px 15px;border-radius:20px;font-size:11px;font-weight:bold;margin-bottom:10px;display:inline-block;"></span>
        <h2 id="detailsTitre" class="text-glow" style="color:white;margin:0;font-size:32px;letter-spacing:-1px;"></h2>
      </div>
    </div>
    
    <div style="padding:35px;background:rgba(255,255,255,0.02);">
      <div class="grid-2 gap-30">
        <div>
          <h4 style="color:#a8c0ff;text-transform:uppercase;font-size:12px;letter-spacing:1px;margin-bottom:15px;opacity:0.8;">📚 Description & Objectifs</h4>
          <p id="detailsDesc" style="color:rgba(255,255,255,0.8);font-size:15px;line-height:1.7;margin:0;"></p>
        </div>
        
        <div class="d-flex flex-column gap-20">
          <div class="card-glass" style="padding:20px;background:rgba(255,255,255,0.05);">
            <div class="d-flex align-center gap-15">
              <div style="font-size:24px;">📅</div>
              <div>
                <div style="color:rgba(255,255,255,0.4);font-size:11px;text-transform:uppercase;">Période du challenge</div>
                <div id="detailsDates" style="color:white;font-weight:600;font-size:14px;"></div>
              </div>
            </div>
          </div>
          
          <div class="card-glass" style="padding:20px;background:rgba(255,255,255,0.05);">
            <div class="d-flex align-center gap-15">
              <div style="font-size:24px;">📂</div>
              <div>
                <div style="color:rgba(255,255,255,0.4);font-size:11px;text-transform:uppercase;">Thématique</div>
                <div id="detailsCat" style="color:#c788f5;font-weight:600;font-size:14px;"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div style="margin-top:40px;padding-top:25px;border-top:1px solid rgba(255,255,255,0.05);text-align:right;">
        <button class="btn btn-blue-purple" onclick="closeModal('modalDetails')" style="border-radius:10px;padding:12px 35px;">Compris ! 🚀</button>
      </div>
    </div>
  </div>
</div>

<div class="challenge-container">

  {# COLONNE GAUCHE — Liste #}
  <div class="d-flex flex-column gap-20">
    <div class="stats-grid">
      <div class="stat-card border-blue card-glass">
        <div class="stat-icon text-blue">📊</div><div class="stat-title">TOTAL</div>
        <div class="stat-value text-white text-glow">{{ stats.total }}</div><div class="stat-subtitle">Challenges</div>
      </div>
      <div class="stat-card border-green card-glass">
        <div class="stat-icon text-green-alt">✅</div><div class="stat-title">ACTIFS</div>
        <div class="stat-value text-green text-glow">{{ stats.actifs }}</div><div class="stat-subtitle">En cours</div>
      </div>
      <div class="stat-card border-red card-glass">
        <div class="stat-icon text-red-alt">❌</div><div class="stat-title">INACTIFS</div>
        <div class="stat-value text-red text-glow">{{ stats.inactifs }}</div><div class="stat-subtitle">Archivés</div>
      </div>
    </div>

    <div class="list-wrapper flex-grow-1 card-glass" style="padding:0;overflow:hidden;display:flex;flex-direction:column;">
      <div class="list-header-box bg-header-challenge d-flex align-center justify-center p-15">
        <span style="font-size:22px;">🏆</span>
        <h3 class="form-card-title text-glow m-0" style="margin-left:10px;">LISTE DES CHALLENGES</h3>
      </div>

      <div style="overflow-y:auto;max-height:520px;padding:15px;">
        {% if challenges is empty %}
        <div class="list-placeholder d-flex flex-column align-center gap-15" style="padding:40px;">
          <span style="font-size:48px;">📭</span>
          <span style="color:white;font-weight:bold;">Aucun challenge disponible</span>
        </div>
        {% else %}
        <div class="d-flex flex-column gap-12">
          {% for challenge in challenges %}

          {# Serialize coaches data for JS #}
          {% set coachesJson = [] %}
          {% for cc in challenge.coaches %}
            {% set coachesJson = coachesJson|merge([{
              id: cc.coach.id,
              nom: cc.coach.nom ~ ' ' ~ cc.coach.prenom,
              email: cc.coach.email,
              telephone: cc.coach.telephone ?? '',
              actif: cc.coach.isActive,
              emailUrl: path('app_challenge_email_coach', {id: challenge.id, coachId: cc.coach.id})
            }]) %}
          {% endfor %}

          {# Serialize recompenses data for JS #}
          {% set recsJson = [] %}
          {% for cr in challenge.recompenses %}
            {% set recsJson = recsJson|merge([{
              nom: cr.recompense.nom,
              points: cr.recompense.points,
              description: cr.recompense.description,
              image: cr.recompense.image ?? ''
            }]) %}
          {% endfor %}

          <div class="challenge-row card-glass"
               style="cursor:pointer;transition:all 0.3s ease;padding:25px;"
               data-id="{{ challenge.id }}"
               data-titre="{{ challenge.titre|e('html_attr') }}"
               data-desc="{{ challenge.description|e('html_attr') }}"
               data-statut="{{ challenge.statut }}"
               data-date-debut="{{ challenge.dateDebut ? challenge.dateDebut|date('Y-m-d') : '' }}"
               data-date-fin="{{ challenge.dateFin ? challenge.dateFin|date('Y-m-d') : '' }}"
               data-categorie="{{ challenge.categorie ? challenge.categorie.id : '' }}"
               data-token="{{ csrf_token('delete' ~ challenge.id) }}"
               data-coaches="{{ coachesJson|json_encode|e('html_attr') }}"
               data-recompenses="{{ recsJson|json_encode|e('html_attr') }}"
               data-media-url="{{ challenge.mediaUrl }}"
               data-media-type="{{ challenge.mediaType }}"
               data-cat-nom="{{ challenge.categorie ? challenge.categorie.nom : '--' }}"
               data-add-coach-url="{{ path('app_challenge_add_coach', {id: challenge.id}) }}"
               data-add-rec-url="{{ path('app_challenge_add_recompense', {id: challenge.id}) }}">

            <div class="d-flex justify-between align-start" style="margin-bottom:15px;">
              <div class="d-flex align-center gap-15">
                {# Pro Thumbnail integrated #}
                <div style="width:50px;height:50px;border-radius:12px;overflow:hidden;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.05);flex-shrink:0;">
                  {% if challenge.mediaUrl %}
                    {% if challenge.mediaType == 'video' %}
                      <video src="{{ challenge.mediaUrl }}" style="width:100%;height:100%;object-fit:cover;" muted></video>
                    {% else %}
                      <img src="{{ challenge.mediaUrl }}" style="width:100%;height:100%;object-fit:cover;">
                    {% endif %}
                  {% else %}
                    <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:20px;">🏆</div>
                  {% endif %}
                </div>
                <div>
                  <h4 class="text-white m-0 text-glow" style="font-size:18px;">
                    {% if challenge.categorie and challenge.categorie.icon %}{{ challenge.categorie.icon }} {% endif %}
                    {{ challenge.titre }}
                  </h4>
                </div>
              </div>
              <span style="padding:6px 16px;border-radius:20px;font-size:12px;font-weight:bold;
                {% if challenge.statut == 'actif' %}background:rgba(46,204,113,0.15);color:#2ecc71;border:1px solid #2ecc71;
                {% elseif challenge.statut == 'termine' %}background:rgba(52,152,219,0.15);color:#3498db;border:1px solid #3498db;
                {% else %}background:rgba(231,76,60,0.15);color:#e74c3c;border:1px solid #e74c3c;{% endif %}">
                {{ challenge.statut|upper }}
              </span>
            </div>

            <p style="color:rgba(255,255,255,0.7);font-size:14px;margin:0 0 15px;line-height:1.5;">
              {{ challenge.description|length > 120 ? challenge.description|slice(0,120) ~ '...' : challenge.description }}
            </p>

            <div class="d-flex gap-15" style="flex-wrap:wrap;font-size:12px;color:rgba(255,255,255,0.6);margin-bottom:18px;">
              {% if challenge.dateDebut %}<span>📅 <strong style="color:#a8c0ff;">{{ challenge.dateDebut|date('d/m/Y') }}</strong></span>{% endif %}
              {% if challenge.dateFin %}<span>⏳ <strong style="color:#ffd89b;">{{ challenge.dateFin|date('d/m/Y') }}</strong></span>{% endif %}
              {% if challenge.categorie %}<span>📂 <strong style="color:#c788f5;">{{ challenge.categorie.nom }}</strong></span>{% endif %}
            </div>

            {# Action buttons #}
            <div class="d-flex gap-10" style="flex-wrap:wrap;">
              <button class="btn btn-purple btn-small btn-coaches-popup" onclick="event.stopPropagation()">
                👨‍🏫 {{ challenge.coaches|length }} Coach(s)
              </button>
              <button class="btn btn-pink btn-small btn-recs-popup" onclick="event.stopPropagation()">
                🎁 {{ challenge.recompenses|length }} Récompense(s)
              </button>
              <button class="btn btn-blue-purple btn-small btn-add-coach" onclick="event.stopPropagation()">
                ➕ Ajouter Coach
              </button>
              <button class="btn btn-small btn-add-rec" style="background:linear-gradient(to right,#f7971e,#ffd200);" onclick="event.stopPropagation()">
                ➕ Ajouter Récompense
              </button>
            </div>
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      <div class="list-footer" style="padding:10px;text-align:center;color:rgba(255,255,255,0.5);font-size:12px;">
        👆 Cliquez sur un challenge pour remplir le formulaire d'édition
      </div>
    </div>
  </div>

  {# COLONNE DROITE — Formulaire #}
  <div class="d-flex flex-column gap-20">
    <div class="form-card d-flex flex-column gap-15 card-glass" style="padding:25px;">
      <div class="d-flex align-center gap-12" style="margin-bottom:5px;">
        <div class="form-header-circle bg-form-challenge"></div>
        <h3 class="form-card-title text-glow m-0">ÉDITION CHALLENGE</h3>
      </div>

      <form id="challengeForm" method="POST" action="{{ path('app_challenge_new') }}" class="d-flex flex-column gap-12" enctype="multipart/form-data">
        <input type="hidden" name="id" id="challengeId" value="">

        <div class="form-group d-flex flex-column gap-5">
          <label class="form-group-title" style="color:#a8c0ff;">VISUEL (PHOTO/VIDÉO)</label>
          <input type="file" name="media" id="mediaField" class="form-control" accept="image/*,video/*">
        </div>

        <div class="form-group d-flex flex-column gap-5">
          <label class="form-group-title" style="color:#a8c0ff;">TITRE *</label>
          <input type="text" name="titre" id="titreField" class="form-control" placeholder="Ex: Maîtrise de Java en 30 jours" required>
        </div>

        <div class="form-group d-flex flex-column gap-5">
          <label class="form-group-title" style="color:#a8c0ff;">DESCRIPTION *</label>
          <textarea name="description" id="descField" class="form-control" rows="3" placeholder="Décrivez les objectifs..." required></textarea>
        </div>

        <div class="grid-2 gap-12">
          <div class="form-group d-flex flex-column gap-5">
            <label class="form-group-title" style="color:#a8c0ff;">📅 DATE DÉBUT</label>
            <input type="date" name="dateDebut" id="dateDebutField" class="form-control">
          </div>
          <div class="form-group d-flex flex-column gap-5">
            <label class="form-group-title" style="color:#a8c0ff;">⏳ DATE FIN</label>
            <input type="date" name="dateFin" id="dateFinField" class="form-control">
          </div>
        </div>

        <div class="grid-2 gap-12">
          <div class="form-group d-flex flex-column gap-5">
            <label class="form-group-title" style="color:#a8c0ff;">⚡ STATUT</label>
            <select name="statut" id="statutField" class="form-control">
              <option value="actif">✅ Actif</option>
              <option value="termine">🏁 Terminé</option>
              <option value="annule">❌ Annulé</option>
            </select>
          </div>
          <div class="form-group d-flex flex-column gap-5">
            <label class="form-group-title" style="color:#a8c0ff;">📂 CATÉGORIE</label>
            <select name="categorie" id="categorieField" class="form-control">
              <option value="">-- Aucune --</option>
              {% for cat in categories %}
              <option value="{{ cat.id }}">{{ cat.icon ?? '' }} {{ cat.nom }}</option>
              {% endfor %}
              <option value="autre" style="color:#c788f5;font-weight:bold;">+ Autre thématique...</option>
            </select>
          </div>
        </div>

        <div id="other-cat-group" style="display:none;" class="form-group d-flex flex-column gap-5">
          <label class="form-group-title" style="color:#c788f5;">NOUVELLE THÉMATIQUE</label>
          <input type="text" name="new_categorie" id="newCatField" class="form-control" placeholder="Entrez le nom de la catégorie...">
        </div>

        <div class="grid-2 gap-12" style="margin-top:10px;">
          <button type="submit" id="btnAdd" class="btn btn-blue-purple" style="padding:12px;border-radius:8px;">➕ AJOUTER</button>
          <button type="button" id="btnEdit" class="btn btn-purple" style="padding:12px;border-radius:8px;">✏️ MODIFIER</button>
          <button type="button" id="btnDelete" class="btn btn-orange-red" style="padding:12px;border-radius:8px;">🗑️ SUPPRIMER</button>
          <button type="button" id="btnReset" class="btn" style="padding:12px;border-radius:8px;background:rgba(255,255,255,0.1);color:white;">🔄 VIDER</button>
        </div>
      </form>
    </div>

    <div class="advice-card card-glass d-flex flex-column gap-10" style="padding:20px;background:linear-gradient(135deg,rgba(102,126,234,0.2),rgba(118,75,162,0.2));border:1px solid rgba(102,126,234,0.3);">
      <div class="d-flex align-center gap-10">
        <span style="font-size:24px;">💡</span>
        <span class="advice-title text-glow" style="color:white;">CONSEIL PRO</span>
      </div>
      <p style="color:rgba(255,255,255,0.7);font-size:12px;margin:0;line-height:1.6;">
        Les descriptions détaillées augmentent l'engagement de 40%. Assignez des coaches experts et des récompenses motivantes pour maximiser les résultats!
      </p>
    </div>
  </div>
    </div> {# .challenge-container #}
  </div> {# .content-area #}
</div> {# .app-layout #}

<footer class="main-footer text-white" style="text-align:center; padding: 20px; opacity:0.5; font-size: 0.8rem;">© 2024 PsyApp — Challenge Manager Pro</footer>

{# ============================================================ STYLES MODAUX #}
<style>
  @keyframes slideIn { from{transform:translateX(120%);opacity:0;}to{transform:translateX(0);opacity:1;} }
  @keyframes fadeIn  { from{opacity:0;transform:scale(0.95);}to{opacity:1;transform:scale(1);} }
  .m-0{margin:0;} .gap-12{gap:12px;} .gap-8{gap:8px;} .p-15{padding:15px;}
  .d-flex{display:flex;} .flex-column{flex-direction:column;} .gap-15{gap:15px;}
  .align-center{align-items:center;} .justify-between{justify-content:space-between;}

  .flash-msg {
    position:fixed;top:80px;right:20px;z-index:99999;padding:15px 25px;border-radius:10px;
    font-weight:bold;box-shadow:0 5px 20px rgba(0,0,0,0.4);animation:slideIn 0.4s ease;
    color:white;max-width:400px;
  }
  .flash-success{background:rgba(46,204,113,0.92);}
  .flash-error  {background:rgba(231,76,60,0.92);}
  .flash-info   {background:rgba(52,152,219,0.92);}

  .modal-overlay {
    position:fixed;inset:0;background:rgba(0,0,0,0.8);z-index:90000;
    display:flex;align-items:center;justify-content:center;backdrop-filter:blur(8px);
  }
  .modal-box {
    width:90%;max-width:600px;padding:25px;border-radius:20px;
    animation:fadeIn 0.3s ease;max-height:85vh;overflow-y:auto;
    border:1px solid rgba(255,255,255,0.15);
  }
  .coach-card-popup {
    background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);
    border-radius:12px;padding:14px;
  }
</style>

{# ============================================================ JAVASCRIPT #}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const form      = document.getElementById('challengeForm');
  const idField   = document.getElementById('challengeId');

  /* ---- Utility: open/close modals ---- */
  window.closeModal = (id) => { document.getElementById(id).style.display = 'none'; };
  document.querySelectorAll('.modal-overlay').forEach(m => {
    m.addEventListener('click', e => { if (e.target === m) m.style.display = 'none'; });
  });

  /* ---- Challenge row click → fill form ---- */
  document.querySelectorAll('.challenge-row').forEach(row => {
    row.addEventListener('click', e => {
      if (e.target.closest('button')) return;
      idField.value = row.dataset.id;
      document.getElementById('titreField').value    = row.dataset.titre;
      document.getElementById('descField').value     = row.dataset.desc;
      document.getElementById('dateDebutField').value= row.dataset.dateDebut;
      document.getElementById('dateFinField').value  = row.dataset.dateFin;
      document.getElementById('statutField').value   = row.dataset.statut;
      document.getElementById('categorieField').value= row.dataset.categorie;
      
      // Auto-hide other-cat-group
      document.getElementById('other-cat-group').style.display = 'none';
      document.getElementById('newCatField').removeAttribute('required');

      document.querySelectorAll('.challenge-row').forEach(r => r.style.borderColor='rgba(255,255,255,0.08)');
      row.style.borderColor = '#3498db';
      row.scrollIntoView({behavior:'smooth',block:'nearest'});
    });

    /* ---- Double clic → Aperçu Pro ---- */
    row.addEventListener('dblclick', () => {
      document.getElementById('detailsTitre').textContent = row.dataset.titre;
      document.getElementById('detailsDesc').textContent  = row.dataset.desc;
      document.getElementById('detailsDates').textContent = row.dataset.dateDebut + " au " + row.dataset.dateFin;
      document.getElementById('detailsCat').textContent   = row.dataset.catNom;
      
      // Statut badge style
      const st = row.dataset.statut;
      const b = document.getElementById('detailsStatut');
      b.textContent = st.toUpperCase();
      b.style.background = st==='actif' ? 'rgba(46,204,113,0.3)' : (st==='termine' ? 'rgba(52,152,219,0.3)' : 'rgba(231,76,60,0.3)');
      b.style.color = st==='actif' ? '#2ecc71' : (st==='termine' ? '#3498db' : '#e74c3c');
      b.style.border = '1px solid ' + b.style.color;

      // Media injection
      const container = document.getElementById('detailsMediaContainer');
      const mUrl = row.dataset.mediaUrl;
      const mType = row.dataset.mediaType;
      
      if (mUrl && mUrl !== "null") {
        if (mType === 'video') {
          container.innerHTML = `<video src="${mUrl}" style="width:100%;height:100%;object-fit:cover;" autoplay muted loop></video>`;
        } else {
          container.innerHTML = `<img src="${mUrl}" style="width:100%;height:100%;object-fit:cover;">`;
        }
      } else {
        container.innerHTML = `<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#1a1c2c,#4a192c);"><span style="font-size:120px;opacity:0.2;">🏆</span></div>`;
      }

      document.getElementById('modalDetails').style.display = 'flex';
    });

    /* ---- Bouton COACHES POPUP ---- */
    row.querySelector('.btn-coaches-popup').addEventListener('click', () => {
      const coaches = JSON.parse(row.dataset.coaches || '[]');
      document.getElementById('modalCoachTitle').textContent = '🏆 Challenge: ' + row.dataset.titre;
      const list = document.getElementById('modalCoachesList');
      list.innerHTML = '';

      if (coaches.length === 0) {
        list.innerHTML = '<div style="text-align:center;padding:30px;color:rgba(255,255,255,0.5);"><span style="font-size:40px;">📭</span><p>Aucun coach assigné</p></div>';
      } else {
        coaches.forEach(c => {
          const div = document.createElement('div');
          div.className = 'coach-card-popup d-flex align-center gap-12';
          div.innerHTML = `
            <div style="width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#b224ef,#7579ff);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">👤</div>
            <div style="flex:1;">
              <div style="color:white;font-weight:bold;font-size:14px;">${c.nom}</div>
              <div style="color:#cbb4d4;font-size:12px;">✉️ ${c.email}</div>
              ${c.telephone ? `<div style="color:rgba(255,255,255,0.5);font-size:11px;">📞 ${c.telephone}</div>` : ''}
            </div>
            <span style="padding:3px 10px;border-radius:20px;font-size:10px;font-weight:bold;background:${c.actif?'rgba(46,204,113,0.15)':'rgba(231,76,60,0.15)'};color:${c.actif?'#2ecc71':'#e74c3c'};border:1px solid ${c.actif?'#2ecc71':'#e74c3c'};">
              ${c.actif?'✅ ACTIF':'❌ INACTIF'}
            </span>
            <button class="btn btn-blue-purple btn-small" style="border-radius:8px;font-size:11px;white-space:nowrap;"
              onclick="openEmailModal('${c.emailUrl}','${c.email}','${c.nom}')">
              📧 Contacter
            </button>`;
          list.appendChild(div);
        });
      }
      document.getElementById('modalCoaches').style.display = 'flex';
    });

    /* ---- Bouton RÉCOMPENSES POPUP ---- */
    row.querySelector('.btn-recs-popup').addEventListener('click', () => {
      const recs = JSON.parse(row.dataset.recompenses || '[]');
      document.getElementById('modalRecTitle').textContent = '🏆 Challenge: ' + row.dataset.titre;
      const list = document.getElementById('modalRecList');
      list.innerHTML = '';

      if (recs.length === 0) {
        list.innerHTML = '<div style="text-align:center;padding:30px;color:rgba(255,255,255,0.5);"><span style="font-size:40px;">📭</span><p>Aucune récompense associée</p></div>';
      } else {
        recs.forEach(r => {
          const div = document.createElement('div');
          div.className = 'rec-card-popup d-flex align-center gap-12' || 'rec-card-popup d-flex align-center gap-12';
          div.style.background = 'rgba(255,255,255,0.05)';
          div.style.border = '1px solid rgba(255,255,255,0.1)';
          div.style.borderRadius = '12px';
          div.style.padding = '14px';
          div.innerHTML = `
            <div style="width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#ff0844,#ffb199);display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;">🏆</div>
            <div style="flex:1;">
              <div style="color:white;font-weight:bold;font-size:14px;">${r.nom}</div>
              <div style="color:rgba(255,255,255,0.6);font-size:12px;">${r.description ? r.description.slice(0,70)+'...' : ''}</div>
            </div>
            <div style="background:rgba(255,226,89,0.15);color:#ffe259;border:1px solid rgba(255,226,89,0.4);padding:5px 14px;border-radius:20px;font-weight:bold;font-size:13px;">
              ⭐ ${r.points} pts
            </div>`;
          list.appendChild(div);
        });
      }
      document.getElementById('modalRecompenses').style.display = 'flex';
    });

    /* ---- Bouton AJOUTER COACH ---- */
    row.querySelector('.btn-add-coach').addEventListener('click', () => {
      document.getElementById('modalAddCoachTitle').textContent = 'Challenge: ' + row.dataset.titre;
      document.getElementById('addCoachForm').action = row.dataset.addCoachUrl;
      document.getElementById('modalAddCoach').style.display = 'flex';
    });

    /* ---- Bouton AJOUTER RÉCOMPENSE ---- */
    row.querySelector('.btn-add-rec').addEventListener('click', () => {
      document.getElementById('modalAddRecTitle').textContent = 'Challenge: ' + row.dataset.titre;
      document.getElementById('addRecForm').action = row.dataset.addRecUrl;
      document.getElementById('modalAddRec').style.display = 'flex';
    });
  });

  /* ---- Open email modal ---- */
  window.openEmailModal = (url, email, nom) => {
    closeModal('modalCoaches');
    document.getElementById('emailForm').action = url;
    document.getElementById('emailTo').value = nom + ' <' + email + '>';
    document.getElementById('modalEmail').style.display = 'flex';
  };

  /* ---- MODIFIER ---- */
  document.getElementById('btnEdit').addEventListener('click', () => {
    if (!idField.value) { alert('Sélectionnez un challenge dans la liste.'); return; }
    form.action = '/challenge/' + idField.value + '/edit';
    form.submit();
  });

  /* ---- SUPPRIMER ---- */
  document.getElementById('btnDelete').addEventListener('click', () => {
    if (!idField.value) { alert('Sélectionnez un challenge dans la liste.'); return; }
    if (!confirm('Confirmer la suppression de ce challenge ?')) return;
    form.action = '/challenge/' + idField.value + '/delete';
    const csrf = document.createElement('input');
    csrf.type='hidden'; csrf.name='_token';
    const row = document.querySelector(`.challenge-row[data-id="${idField.value}"]`);
    if (row) csrf.value = row.dataset.token;
    form.appendChild(csrf);
    form.submit();
  });

  /* ---- VIDER ---- */
  document.getElementById('btnReset').addEventListener('click', () => {
    form.reset(); idField.value='';
    form.action='{{ path("app_challenge_new") }}';
    document.getElementById('other-cat-group').style.display = 'none';
    document.getElementById('newCatField').removeAttribute('required');
    document.querySelectorAll('.challenge-row').forEach(r => r.style.borderColor='rgba(255,255,255,0.08)');
  });

  /* ---- Catégorie "Autre" Toggle ---- */
  document.getElementById('categorieField').addEventListener('change', (e) => {
    const otherGroup = document.getElementById('other-cat-group');
    if (e.target.value === 'autre') {
      otherGroup.style.display = 'flex';
      document.getElementById('newCatField').setAttribute('required', 'required');
    } else {
      otherGroup.style.display = 'none';
      document.getElementById('newCatField').removeAttribute('required');
    }
  });

  /* ---- Auto-dismiss flash ---- */
  setTimeout(() => document.querySelectorAll('.flash-msg').forEach(f => {
    f.style.transition='opacity 0.5s'; f.style.opacity='0';
    setTimeout(() => f.remove(), 500);
  }), 4000);
});
</script>
{% endblock %}
