{% extends 'base.html.twig' %}
{% block title %}Challenge Manager Pro{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/manager.css') }}">
    <style>
        /* Layout specific to challenge module */
        .challenge-page {
            width: 100%;
            max-width: 100%;
            padding: 28px 32px;
            box-sizing: border-box;
        }

        .challenge-grid {
            display: grid;
            grid-template-columns: 1.6fr 1fr;
            gap: 40px;
            align-items: start;
            width: 100%;
        }
        @media (max-width: 1300px) { .challenge-grid { grid-template-columns: 1fr; } }

        /* Page header */
        .challenge-header-custom {
            margin-bottom: 28px;
        }
        .challenge-page-title {
            font-size: 1.6rem;
            font-weight: 800;
            background: linear-gradient(90deg, #fff, var(--accent2, #00d2ff));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin: 0;
            letter-spacing: -0.5px;
        }
        .challenge-page-sub {
            color: rgba(255,255,255,0.4);
            font-size: 0.85rem;
            margin-top: 4px;
        }

        /* Stats row */
        .challenge-stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }
        .ch-stat {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 16px;
            padding: 20px 22px;
            display: flex;
            align-items: center;
            gap: 16px;
            transition: border-color .2s;
        }
        .ch-stat:hover { border-color: rgba(108,99,255,.3); }
        .ch-stat-icon {
            width: 48px; height: 48px;
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem; flex-shrink: 0;
        }
        .bg-blue   { background: rgba(59,130,246,.15); }
        .bg-green  { background: rgba(34,211,165,.15); }
        .bg-red    { background: rgba(239,68,68,.15); }
        .ch-stat-val { font-size: 1.8rem; font-weight: 800; color: #fff; line-height: 1; }
        .ch-stat-lab { font-size: 0.72rem; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: .08em; margin-top: 3px; }

        /* Toolbar */
        .challenge-toolbar {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }
        .ch-search {
            flex: 1;
            min-width: 180px;
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 9px 16px;
        }
        .ch-search input {
            background: transparent;
            border: none;
            color: #fff;
            outline: none;
            font-size: 0.85rem;
            width: 100%;
        }
        .ch-search input::placeholder { color: rgba(255,255,255,0.3); }
        .ch-select {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 9px 14px;
            color: #fff;
            font-size: 0.82rem;
            outline: none;
        }
        .ch-btn {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 9px 18px;
            border-radius: 12px;
            font-size: 0.82rem; font-weight: 600;
            text-decoration: none; border: none; cursor: pointer;
            transition: opacity .2s, transform .15s;
        }
        .ch-btn:hover { opacity: .88; transform: translateY(-1px); }
        .ch-btn-primary  { background: linear-gradient(135deg, #6c63ff, #00d2ff); color: #fff; }
        .ch-btn-purple   { background: rgba(108,99,255,.2); color: #a78bfa; border: 1px solid rgba(108,99,255,.3); }
        .ch-btn-pink     { background: rgba(236,72,153,.15); color: #f9a8d4; border: 1px solid rgba(236,72,153,.3); }
        .ch-btn-pdf      { background: rgba(255,255,255,.06); color: rgba(255,255,255,.6); border: 1px solid rgba(255,255,255,.1); }


        /* List panel */
        .ch-panel {
            background: rgba(255,255,255,0.025);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 20px;
            overflow: hidden;
        }
        .ch-panel-header {
            display: flex; align-items: center; gap: 12px;
            padding: 18px 22px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            background: rgba(255,255,255,0.02);
        }
        .ch-panel-header h3 { margin: 0; font-size: 0.95rem; font-weight: 700; color: #fff; }
        .ch-panel-body { padding: 16px; max-height: 580px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; }
        .ch-panel-body::-webkit-scrollbar { width: 4px; }
        .ch-panel-body::-webkit-scrollbar-thumb { background: rgba(108,99,255,.4); border-radius: 4px; }

        /* Challenge card in list */
        .challenge-row {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 14px;
            padding: 16px 18px;
            cursor: pointer;
            transition: border-color .2s, background .2s, transform .15s;
        }
        .challenge-row:hover {
            background: rgba(108,99,255,.06);
            border-color: rgba(108,99,255,.25);
            transform: translateY(-1px);
        }
        .challenge-row.selected {
            border-color: rgba(0,210,255,.5);
            background: rgba(0,210,255,.05);
        }
        .cr-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
        .cr-thumb {
            width: 44px; height: 44px;
            border-radius: 12px; overflow: hidden;
            border: 1px solid rgba(255,255,255,.08);
            background: rgba(255,255,255,.04);
            flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
        }
        .cr-thumb img, .cr-thumb video { width: 100%; height: 100%; object-fit: cover; }
        .cr-title { font-size: 0.92rem; font-weight: 700; color: #fff; margin: 0 0 3px; }
        .cr-meta  { font-size: 0.72rem; color: rgba(255,255,255,.4); }
        .cr-badge {
            padding: 3px 10px; border-radius: 20px;
            font-size: 0.68rem; font-weight: 700;
            flex-shrink: 0;
        }
        .cr-badge.actif    { background: rgba(34,197,94,.12); color: #4ade80; border: 1px solid rgba(34,197,94,.2); }
        .cr-badge.termine  { background: rgba(59,130,246,.12); color: #60a5fa; border: 1px solid rgba(59,130,246,.2); }
        .cr-badge.annule   { background: rgba(239,68,68,.12); color: #f87171; border: 1px solid rgba(239,68,68,.2); }
        .cr-desc { font-size: 0.78rem; color: rgba(255,255,255,.45); line-height: 1.5; margin-bottom: 12px; }
        .cr-actions { display: flex; flex-wrap: wrap; gap: 7px; }
        .cr-action-btn {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 5px 12px; border-radius: 8px;
            font-size: 0.72rem; font-weight: 600;
            border: none; cursor: pointer;
            transition: opacity .2s;
        }
        .cr-action-btn:hover { opacity: .8; }
        .cr-btn-purple { background: rgba(108,99,255,.18); color: #a78bfa; }
        .cr-btn-pink   { background: rgba(236,72,153,.15); color: #f9a8d4; }
        .cr-btn-blue   { background: rgba(59,130,246,.15); color: #93c5fd; }
        .cr-btn-gold   { background: rgba(245,158,11,.15); color: #fcd34d; }

        /* Form panel */
        .ch-form-panel {
            background: rgba(255,255,255,0.025);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 20px;
            overflow: hidden;
            position: sticky;
            top: 80px;
        }
        .ch-form-header {
            padding: 18px 22px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            background: linear-gradient(135deg, rgba(108,99,255,.12), rgba(0,210,255,.06));
        }
        .ch-form-header h3 { margin: 0; font-size: 0.95rem; font-weight: 700; color: #fff; }
        .ch-form-header p  { margin: 3px 0 0; font-size: 0.72rem; color: rgba(255,255,255,.4); }
        .ch-form-body { padding: 20px; display: flex; flex-direction: column; gap: 14px; }
        .cf-label { font-size: 0.72rem; font-weight: 700; color: rgba(255,255,255,.5); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 5px; display: block; }
        .cf-input, .cf-select, .cf-textarea {
            width: 100%;
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.09);
            border-radius: 10px;
            padding: 10px 14px;
            color: #fff;
            font-size: 0.85rem;
            outline: none;
            font-family: inherit;
            transition: border-color .2s;
        }
        .cf-input:focus, .cf-select:focus, .cf-textarea:focus { border-color: rgba(108,99,255,.5); }
        .cf-textarea { resize: vertical; min-height: 80px; }
        .cf-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .cf-btn-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 4px; }
        .cf-btn {
            padding: 11px; border-radius: 10px;
            font-size: 0.8rem; font-weight: 700;
            border: none; cursor: pointer;
            transition: opacity .2s, transform .15s;
            display: flex; align-items: center; justify-content: center; gap: 6px;
        }
        .cf-btn:hover { opacity: .88; transform: translateY(-1px); }
        .cf-btn-add    { background: linear-gradient(135deg, #6c63ff, #00d2ff); color: #fff; }
        .cf-btn-edit   { background: rgba(108,99,255,.2); color: #a78bfa; border: 1px solid rgba(108,99,255,.3); }
        .cf-btn-del    { background: rgba(239,68,68,.15); color: #f87171; border: 1px solid rgba(239,68,68,.2); }
        .cf-btn-reset  { background: rgba(255,255,255,.06); color: rgba(255,255,255,.5); border: 1px solid rgba(255,255,255,.1); }

        /* Pro tip card */
        .ch-tip {
            margin-top: 16px;
            padding: 16px 18px;
            background: linear-gradient(135deg, rgba(108,99,255,.1), rgba(0,210,255,.06));
            border: 1px solid rgba(108,99,255,.2);
            border-radius: 14px;
            font-size: 0.78rem;
            color: rgba(255,255,255,.55);
            line-height: 1.6;
        }
        .ch-tip strong { color: rgba(255,255,255,.85); }

        /* Flash messages */
        .flash-msg {
            position: fixed; top: 80px; right: 20px; z-index: 99999;
            padding: 14px 22px; border-radius: 12px;
            font-weight: 600; font-size: 0.85rem;
            box-shadow: 0 8px 30px rgba(0,0,0,.4);
            animation: slideIn 0.4s ease;
            color: white; max-width: 380px;
        }
        .flash-success { background: rgba(34,197,94,.9); }
        .flash-error   { background: rgba(239,68,68,.9); }
        .flash-info    { background: rgba(59,130,246,.9); }
        @keyframes slideIn { from{transform:translateX(120%);opacity:0;}to{transform:translateX(0);opacity:1;} }

        /* Modals */
        .modal-overlay {
            position: fixed; inset: 0;
            background: rgba(0,0,0,.8); z-index: 90000;
            display: flex; align-items: center; justify-content: center;
            backdrop-filter: blur(8px);
        }
        .modal-box {
            width: 90%; max-width: 600px;
            padding: 28px; border-radius: 20px;
            background: #181b30;
            border: 1px solid rgba(255,255,255,.12);
            animation: fadeIn 0.3s ease;
            max-height: 85vh; overflow-y: auto;
        }
        @keyframes fadeIn { from{opacity:0;transform:scale(0.95);}to{opacity:1;transform:scale(1);} }
        .coach-card-popup {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 12px; padding: 14px;
        }
        .card-glass {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
        }
        /* Utility classes for remaining markup */
        .d-flex{display:flex;} .flex-column{flex-direction:column;}
        .align-center{align-items:center;} .justify-between{justify-content:space-between;}
        .gap-8{gap:8px;} .gap-10{gap:10px;} .gap-12{gap:12px;} .gap-15{gap:15px;} .gap-20{gap:20px;}
        .m-0{margin:0;} .p-15{padding:15px;} .p-5{padding:5px;}
        .text-white{color:#fff!important;} .text-glow{text-shadow:0 0 20px rgba(108,99,255,.4);}
        .grid-2{display:grid;grid-template-columns:1fr 1fr;} .gap-30{gap:30px;}
        .btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:10px;font-size:.8rem;font-weight:700;border:none;cursor:pointer;transition:opacity.2s,transform.15s;text-decoration:none;}
        .btn:hover{opacity:.85;transform:translateY(-1px);}
        .btn-purple{background:rgba(108,99,255,.2);color:#a78bfa;border:1px solid rgba(108,99,255,.3);}
        .btn-pink{background:rgba(236,72,153,.15);color:#f9a8d4;border:1px solid rgba(236,72,153,.3);}
        .btn-blue-purple{background:linear-gradient(135deg,#6c63ff,#00d2ff);color:#fff;}
        .btn-orange-red{background:rgba(239,68,68,.15);color:#f87171;border:1px solid rgba(239,68,68,.2);}
        .btn-blue{background:rgba(59,130,246,.15);color:#93c5fd;border:1px solid rgba(59,130,246,.2);}
        .btn-grey{background:rgba(255,255,255,.07);color:rgba(255,255,255,.5);border:1px solid rgba(255,255,255,.1);}
        .btn-small{padding:5px 12px;font-size:.72rem;}
        .form-control{width:100%;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:10px;padding:9px 13px;color:#fff;font-size:.84rem;outline:none;font-family:inherit;}
        .form-control:focus{border-color:rgba(108,99,255,.5);}
        .flex-grow-1{flex:1;}
           </style>
{% endblock %}

{% block body_class %}bg-challenge{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/chat_bubble.js') }}"></script>
{% endblock %}

{% block body %}

<div class="challenge-page">

{# ── Flash messages ── #}
{% for type, messages in app.flashes %}
<div class="flash-msg flash-{{ type }}">{% for m in messages %}{{ m }}{% endfor %}</div>
{% endfor %}

{# ============================================================ MODAL: COACHES DU CHALLENGE #}
<div id="modalCoaches" class="modal-overlay" style="display:none;">
  <div class="modal-box card-glass">
    <div class="d-flex justify-between align-center" style="margin-bottom:18px;">
      <h3 class="text-glow m-0" style="color:white;">👨‍🏫 Coaches du Challenge</h3>
      <button onclick="closeModal('modalCoaches')" class="btn btn-grey btn-small">✕ Fermer</button>
    </div>
    <p id="modalCoachTitle" style="color:#a8c0ff;margin:0 0 15px;font-size:13px;"></p>
    <div id="modalCoachesList" style="max-height:350px;overflow-y:auto;" class="d-flex flex-column gap-12"></div>
  </div>
</div>

{# ============================================================ MODAL: EMAIL COACH #}
<div id="modalEmail" class="modal-overlay" style="display:none;">
  <div class="modal-box card-glass" style="max-width:500px;">
    <div class="d-flex justify-between align-center" style="margin-bottom:18px;">
      <h3 class="text-glow m-0" style="color:white;">📧 Contacter le Coach</h3>
      <button onclick="closeModal('modalEmail')" class="btn btn-grey btn-small">✕ Fermer</button>
    </div>
    <form id="emailForm" method="POST" action="" class="d-flex flex-column gap-12">
      <div class="d-flex flex-column gap-5">
        <label style="color:#a8c0ff;font-size:12px;font-weight:bold;">DESTINATAIRE</label>
        <input type="text" id="emailTo" readonly class="form-control" style="opacity:0.7;">
      </div>
      
      {% if app.user %}
        <div class="card-glass p-10" style="background:rgba(102,126,234,0.1);border-radius:8px;">
          <small style="color:white;">📫 L'email sera envoyé en votre nom via : <strong style="color:#a8c0ff;">{{ app.user.userIdentifier }}</strong></small>
        </div>
      {% else %}
        <div class="d-flex flex-column gap-5">
          <label style="color:#a8c0ff;font-size:12px;font-weight:bold;">VOTRE EMAIL (expéditeur)</label>
          <input type="email" name="sender_email" class="form-control" placeholder="votre@email.com" required>
        </div>
      {% endif %}

      <div class="d-flex flex-column gap-5">
        <label style="color:#a8c0ff;font-size:12px;font-weight:bold;">SUJET</label>
        <input type="text" name="subject" class="form-control" value="Message concernant le Challenge" required>
      </div>
      <div class="d-flex flex-column gap-5">
        <label style="color:#a8c0ff;font-size:12px;font-weight:bold;">MESSAGE</label>
        <textarea name="message" class="form-control" rows="5" placeholder="Votre message au coach..." required></textarea>
      </div>
      <button type="submit" class="btn btn-blue-purple" style="border-radius:8px;">📤 Envoyer l'Email</button>
    </form>
  </div>
</div>

{# ============================================================ MODAL: RÉCOMPENSES DU CHALLENGE #}
<div id="modalRecompenses" class="modal-overlay" style="display:none;">
  <div class="modal-box card-glass">
    <div class="d-flex justify-between align-center" style="margin-bottom:18px;">
      <h3 class="text-glow m-0" style="color:white;">🎁 Récompenses du Challenge</h3>
      <button onclick="closeModal('modalRecompenses')" class="btn btn-grey btn-small">✕ Fermer</button>
    </div>
    <p id="modalRecTitle" style="color:#ffd89b;margin:0 0 15px;font-size:13px;"></p>
    <div id="modalRecList" style="max-height:350px;overflow-y:auto;" class="d-flex flex-column gap-12"></div>
  </div>
</div>

{# ============================================================ MODAL: AJOUTER COACH #}
<div id="modalAddCoach" class="modal-overlay" style="display:none;">
  <div class="modal-box card-glass" style="max-width:450px;">
    <div class="d-flex justify-between align-center" style="margin-bottom:18px;">
      <h3 class="text-glow m-0" style="color:white;">➕ Assigner un Coach</h3>
      <button onclick="closeModal('modalAddCoach')" class="btn btn-grey btn-small">✕ Fermer</button>
    </div>
    <p id="modalAddCoachTitle" style="color:#a8c0ff;margin:0 0 15px;font-size:13px;"></p>
    <form id="addCoachForm" method="POST" action="" class="d-flex flex-column gap-12">
      <div class="d-flex flex-column gap-5">
        <label style="color:#a8c0ff;font-size:12px;font-weight:bold;">👨‍🏫 SÉLECTIONNER UN COACH</label>
        <select name="coach_id" class="form-control" required>
          <option value="">-- Choisir un coach --</option>
          {% for coach in coaches %}
          <option value="{{ coach.id }}">{{ coach.nom }} {{ coach.prenom }} ({{ coach.email }})</option>
          {% endfor %}
        </select>
      </div>
      <button type="submit" class="btn btn-purple" style="border-radius:8px;">✅ Assigner le Coach</button>
    </form>
  </div>
</div>

{# ============================================================ MODAL: AJOUTER RÉCOMPENSE #}
<div id="modalAddRec" class="modal-overlay" style="display:none;">
  <div class="modal-box card-glass" style="max-width:450px;">
    <div class="d-flex justify-between align-center" style="margin-bottom:18px;">
      <h3 class="text-glow m-0" style="color:white;">🎁 Ajouter une Récompense</h3>
      <button onclick="closeModal('modalAddRec')" class="btn btn-grey btn-small">✕ Fermer</button>
    </div>
    <p id="modalAddRecTitle" style="color:#ffd89b;margin:0 0 15px;font-size:13px;"></p>
    <form id="addRecForm" method="POST" action="" class="d-flex flex-column gap-12">
      <div class="d-flex flex-column gap-5">
        <label style="color:#ffd89b;font-size:12px;font-weight:bold;">🏆 SÉLECTIONNER UNE RÉCOMPENSE</label>
        <select name="recompense_id" class="form-control" required>
          <option value="">-- Choisir une récompense --</option>
          {% for rec in recompenses %}
          <option value="{{ rec.id }}">{{ rec.nom }} ({{ rec.points }} pts)</option>
          {% endfor %}
        </select>
      </div>
      <button type="submit" class="btn btn-pink" style="border-radius:8px;">🎁 Associer la Récompense</button>
    </form>
  </div>
</div>

{# ============================================================ MODAL: DÉTAILS DU CHALLENGE (DBL CLICK) #}
<div id="modalDetails" class="modal-overlay" style="display:none;">
  <div class="modal-box card-glass" style="max-width:850px;padding:0;overflow:hidden;border:none;box-shadow:0 0 50px rgba(0,0,0,0.8);">
    <div style="position:relative;width:100%;height:350px;background:#000;">
      <div id="detailsMediaContainer" style="width:100%;height:100%;">
        {# Image or Video will be injected here #}
      </div>
      <button onclick="closeModal('modalDetails')" style="position:absolute;top:20px;right:20px;background:rgba(0,0,0,0.5);border:none;color:white;width:40px;height:40px;border-radius:50%;cursor:pointer;font-size:20px;backdrop-filter:blur(5px);z-index:10;">✕</button>
      <div style="position:absolute;bottom:0;left:0;right:0;background:linear-gradient(to top, rgba(0,0,0,0.9), transparent);padding:30px;padding-top:60px;">
        <span id="detailsStatut" style="padding:5px 15px;border-radius:20px;font-size:11px;font-weight:bold;margin-bottom:10px;display:inline-block;"></span>
        <h2 id="detailsTitre" class="text-glow" style="color:white;margin:0;font-size:32px;letter-spacing:-1px;"></h2>
      </div>
    </div>
    
    <div style="padding:35px;background:rgba(255,255,255,0.02);">
      <div class="grid-2 gap-30">
        <div>
          <h4 style="color:#a8c0ff;text-transform:uppercase;font-size:12px;letter-spacing:1px;margin-bottom:15px;opacity:0.8;">📚 Description & Objectifs</h4>
          <p id="detailsDesc" style="color:rgba(255,255,255,0.8);font-size:15px;line-height:1.7;margin:0;"></p>
        </div>
        
        <div class="d-flex flex-column gap-20">
          <div class="card-glass" style="padding:20px;background:rgba(255,255,255,0.05);">
            <div class="d-flex align-center gap-15">
              <div style="font-size:24px;">📅</div>
              <div>
                <div style="color:rgba(255,255,255,0.4);font-size:11px;text-transform:uppercase;">Période du challenge</div>
                <div id="detailsDates" style="color:white;font-weight:600;font-size:14px;"></div>
              </div>
            </div>
          </div>
          
          <div class="card-glass" style="padding:20px;background:rgba(255,255,255,0.05);">
            <div class="d-flex align-center gap-15">
              <div style="font-size:24px;">📂</div>
              <div>
                <div style="color:rgba(255,255,255,0.4);font-size:11px;text-transform:uppercase;">Thématique</div>
                <div id="detailsCat" style="color:#c788f5;font-weight:600;font-size:14px;"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div style="margin-top:40px;padding-top:25px;border-top:1px solid rgba(255,255,255,0.05);text-align:right;">
        <button class="btn btn-blue-purple" onclick="closeModal('modalDetails')" style="border-radius:10px;padding:12px 35px;">Compris ! 🚀</button>
      </div>

      <div id="detailsMapContainer" style="margin-top:25px; display:none;">
        <h4 style="color:#a8c0ff;text-transform:uppercase;font-size:12px;letter-spacing:1px;margin-bottom:10px;opacity:0.8;">🌍 Localisation (Google Maps)</h4>
        <iframe id="detailsMapIframe" width="100%" height="200" style="border:1px solid rgba(255,255,255,0.1); border-radius:12px;" loading="lazy" allowfullscreen src=""></iframe>
      </div>
    </div>
  </div>
</div>



  {# HEADER #}
  <div class="challenge-header-custom d-flex justify-between align-center">
    <div>
      <h1 class="challenge-page-title text-glow">Challenge Manager Pro</h1>
      <p class="challenge-page-sub">Gérez vos défis et votre communauté fitness</p>
    </div>
    <div class="d-flex gap-10">
      <a href="{{ path('app_challenge_dashboard') }}" class="ch-btn" style="background:linear-gradient(135deg,rgba(108,99,255,.2),rgba(0,210,255,.2));color:#00d2ff;border:1px solid rgba(0,210,255,.3);">📊 Dashboard</a>
      <a href="{{ path('app_challenge_calendar') }}" class="ch-btn" style="background:rgba(236,72,153,.15);color:#f9a8d4;border:1px solid rgba(236,72,153,.3);">📅 Calendrier</a>
      
      {% if is_granted('ROLE_ADMIN') %}
      <a href="{{ path('app_admin_participations') }}" class="ch-btn ch-btn-primary">📋 Demandes de Participation ({{ userParticipations|length }})</a>
      <a href="{{ path('app_coach_index') }}" class="ch-btn ch-btn-purple">👨‍🏫 Coachs</a>
      <a href="{{ path('app_recompense_index') }}" class="ch-btn ch-btn-pink">🎁 Prix</a>
      {% endif %}
      <a href="{{ path('app_challenge_export_pdf') }}" target="_blank" class="ch-btn ch-btn-pdf">📄 PDF</a>
    </div>
  </div>

  {# STATS #}
  <div class="challenge-stats-row">
    <div class="ch-stat">
      <div class="ch-stat-icon bg-blue">📊</div>
      <div><div class="ch-stat-val">{{ stats.total }}</div><div class="ch-stat-lab">Total Challenges</div></div>
    </div>
    <div class="ch-stat">
      <div class="ch-stat-icon bg-green">🔥</div>
      <div><div class="ch-stat-val">{{ stats.actifs }}</div><div class="ch-stat-lab">En cours</div></div>
    </div>
    <div class="ch-stat">
      <div class="ch-stat-icon bg-red">🏁</div>
      <div><div class="ch-stat-val">{{ stats.inactifs }}</div><div class="ch-stat-lab">Terminés</div></div>
    </div>
  </div>

  {# TOOLBAR #}
  <form method="GET" action="{{ path('app_challenge_index') }}" class="challenge-toolbar">
    <div class="ch-search">
      <span>🔍</span>
      <input type="text" name="search" value="{{ filters.search ?? '' }}" placeholder="Rechercher un défi...">
    </div>
    <select name="statut" class="ch-select">
      <option value="">Tous les statuts</option>
      <option value="actif" {% if filters.statut == 'actif' %}selected{% endif %}>✅ Actif</option>
      <option value="termine" {% if filters.statut == 'termine' %}selected{% endif %}>🏁 Terminé</option>
      <option value="annule" {% if filters.statut == 'annule' %}selected{% endif %}>❌ Annulé</option>
    </select>
    <button type="submit" class="ch-btn ch-btn-primary">Filtrer</button>
  </form>

  {# ── 2-Col Grid (List + Form) ── #}
  <div class="challenge-grid">
    
    {# LEFT COL: LIST #}
    <div class="ch-panel">
      <div class="ch-panel-header">
        <span style="font-size:1.4rem;">🏁</span>
        <h3 class="m-0">Liste des Challenges ({{ challenges|length }})</h3>
      </div>
      <div class="ch-panel-body" style="background:rgba(255,255,255,0.01); display: flex; flex-direction: column; gap: 15px;">
        {% if challenges is empty %}
        <div style="text-align:center;padding:48px 24px;">
          <div style="font-size:3rem;margin-bottom:12px;">📭</div>
          <p style="color:rgba(255,255,255,.4);font-size:.9rem;">Aucun challenge trouvé</p>
        </div>
        {% else %}
          {% for challenge in challenges %}
          {# Serialize coaches data for JS #}
          {% set coachesJson = [] %}
          {% for cc in challenge.coaches %}
            {% set coachesJson = coachesJson|merge([{
              id: cc.coach.id,
              nom: cc.coach.nom ~ ' ' ~ cc.coach.prenom,
              email: cc.coach.email,
              telephone: cc.coach.telephone ?? '',
              actif: cc.coach.isActive,
              emailUrl: path('app_challenge_email_coach', {id: challenge.id, coachId: cc.coach.id})
            }]) %}
          {% endfor %}

          {# Serialize recompenses data for JS #}
          {% set recsJson = [] %}
          {% for cr in challenge.recompenses %}
            {% set recsJson = recsJson|merge([{
              nom: cr.recompense.nom,
              points: cr.recompense.points,
              description: cr.recompense.description,
              image: cr.recompense.image ?? ''
            }]) %}
          {% endfor %}

          <div class="challenge-row card-glass"
               style="cursor:pointer;transition:all 0.3s ease;padding:25px;"
               data-id="{{ challenge.id }}"
               data-titre="{{ challenge.titre|e('html_attr') }}"
               data-desc="{{ challenge.description|e('html_attr') }}"
               data-statut="{{ challenge.statut }}"
               data-date-debut="{{ challenge.dateDebut ? challenge.dateDebut|date('Y-m-d') : '' }}"
               data-date-fin="{{ challenge.dateFin ? challenge.dateFin|date('Y-m-d') : '' }}"
               data-categorie="{{ challenge.categorie ? challenge.categorie.id : '' }}"
               data-token="{{ csrf_token('delete' ~ challenge.id) }}"
               data-coaches="{{ coachesJson|json_encode|e('html_attr') }}"
               data-recompenses="{{ recsJson|json_encode|e('html_attr') }}"
               data-media-url="{{ challenge.mediaUrl }}"
               data-media-type="{{ challenge.mediaType }}"
               data-cat-nom="{{ challenge.categorie ? challenge.categorie.nom : '--' }}"
               data-adresse="{{ challenge.adresse|e('html_attr') }}"
               data-add-coach-url="{{ path('app_challenge_add_coach', {id: challenge.id}) }}"
               data-add-rec-url="{{ path('app_challenge_add_recompense', {id: challenge.id}) }}">

            <div class="d-flex justify-between align-start" style="margin-bottom:15px;">
              <div class="d-flex align-center gap-15">
                <div style="width:50px;height:50px;border-radius:12px;overflow:hidden;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.05);flex-shrink:0;">
                  {% if challenge.mediaUrl %}
                    {% if challenge.mediaType == 'video' %}
                      <video src="{{ challenge.mediaUrl }}" style="width:100%;height:100%;object-fit:cover;" muted></video>
                    {% else %}
                      <img src="{{ challenge.mediaUrl }}" style="width:100%;height:100%;object-fit:cover;">
                    {% endif %}
                  {% else %}
                    <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:20px;">🏆</div>
                  {% endif %}
                </div>
                <div>
                  <h4 class="text-white m-0 text-glow" style="font-size:18px;">
                    {% if challenge.categorie and challenge.categorie.icon %}{{ challenge.categorie.icon }} {% endif %}
                    {{ challenge.titre }}
                  </h4>
                </div>
              </div>
              <span style="padding:6px 16px;border-radius:20px;font-size:12px;font-weight:bold;
                {% if challenge.statut == 'actif' %}background:rgba(46,204,113,0.15);color:#2ecc71;border:1px solid #2ecc71;
                {% elseif challenge.statut == 'termine' %}background:rgba(52,152,219,0.15);color:#3498db;border:1px solid #3498db;
                {% else %}background:rgba(231,76,60,0.15);color:#e74c3c;border:1px solid #e74c3c;{% endif %}">
                {{ challenge.statut|upper }}
              </span>
            </div>

            <p style="color:rgba(255,255,255,0.7);font-size:14px;margin:0 0 15px;line-height:1.5;">
              {{ challenge.description|length > 120 ? challenge.description|slice(0,120) ~ '...' : challenge.description }}
            </p>

            <div class="d-flex gap-15" style="flex-wrap:wrap;font-size:12px;color:rgba(255,255,255,0.6);margin-bottom:18px;">
              {% if challenge.dateDebut %}<span>📅 <strong style="color:#a8c0ff;">{{ challenge.dateDebut|date('d/m/Y') }}</strong></span>{% endif %}
              {% if challenge.dateFin %}<span>⏳ <strong style="color:#ffd89b;">{{ challenge.dateFin|date('d/m/Y') }}</strong></span>{% endif %}
              {% if challenge.categorie %}<span>📂 <strong style="color:#c788f5;">{{ challenge.categorie.nom }}</strong></span>{% endif %}
              {% if challenge.adresse %}<span>📍 <a href="https://maps.google.com/?q={{ challenge.adresse|url_encode }}" target="_blank" style="color:#00d2ff;text-decoration:none;"><strong style="color:#00d2ff;text-decoration:underline;">{{ challenge.adresse }}</strong></a></span>{% endif %}
            </div>

            <div class="d-flex gap-10" style="flex-wrap:wrap;">
              <button class="btn btn-purple btn-small btn-coaches-popup" onclick="event.stopPropagation()">
                👨‍🏫 {{ challenge.coaches|length }} Coach(s)
              </button>
              <button class="btn btn-pink btn-small btn-recs-popup" onclick="event.stopPropagation()">
                🎁 {{ challenge.recompenses|length }} Prix
              </button>
              
              {% if is_granted('ROLE_ADMIN') %}
              <button class="btn btn-blue-purple btn-small btn-add-coach" onclick="event.stopPropagation()">
                ➕ Coach
              </button>
              <button class="btn btn-small btn-add-rec" style="background:linear-gradient(to right,#f7971e,#ffd200);" onclick="event.stopPropagation()">
                ➕ Prix
              </button>
              <a href="{{ path('app_challenge_tasks', {id: challenge.id}) }}"
                 class="btn btn-small"
                 style="background:linear-gradient(135deg,#6c63ff,#00d2ff);color:white;border-radius:8px;"
                 onclick="event.stopPropagation()">
                🤖 Tâches IA
              </a>
              {% else %}
                  {% set p_status = userParticipations[challenge.id] ?? null %}
                  {% if p_status == 'pending' %}
                      <span class="btn btn-small btn-grey" style="cursor:not-allowed;" title="En attente de validation par un admin">⏳ En attente d'approbation</span>
                  {% elseif p_status == 'approved' or p_status == 'completed' %}
                      <a href="{{ path('app_challenge_tasks', {id: challenge.id}) }}" class="btn btn-small btn-blue-purple" onclick="event.stopPropagation()">🎯 Accéder aux Tâches</a>
                  {% elseif p_status == 'rejected' %}
                      <span class="btn btn-small btn-orange-red" style="cursor:not-allowed;">🚫 Participation refusée</span>
                  {% else %}
                      <form method="POST" action="{{ path('app_challenge_participate', {id: challenge.id}) }}" style="margin:0;" onclick="event.stopPropagation()">
                          <button type="submit" class="btn btn-small" style="background:linear-gradient(135deg, #10b981, #34d399); color:white; border-radius:8px; border:none;">🙋‍♂️ Participer</button>
                      </form>
                  {% endif %}
              {% endif %}
            </div>
            
            {% if is_granted('ROLE_ADMIN') %}
            <div style="padding:15px; border-top:1px solid rgba(255,255,255,0.05); text-align:center; color:rgba(255,255,255,0.3); font-size:0.8rem; margin-top:15px;">
                👆 Cliquez pour modifier • Double-clic pour aperçu
            </div>
            {% else %}
            <div style="padding:15px; border-top:1px solid rgba(255,255,255,0.05); text-align:center; color:rgba(255,255,255,0.3); font-size:0.8rem; margin-top:15px;">
                👆 Double-clic pour aperçu du challenge
            </div>
            {% endif %}
          </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>

    {# RIGHT COL: FORM (ADMIN ONLY) #}
    {% if is_granted('ROLE_ADMIN') %}
    <div class="d-flex flex-column gap-20">
      <div class="ch-form-panel card-glass" style="padding:25px; top:20px; position:sticky;">
        <div class="d-flex align-center gap-12" style="margin-bottom:20px;">
          <div style="width:12px;height:12px;border-radius:50%;background:#00d2ff;box-shadow:0 0 10px #00d2ff;"></div>
          <h3 class="text-glow m-0" style="color:white;font-size:1.1rem;">ÉDITION CHALLENGE</h3>
        </div>

        <form id="challengeForm" method="POST" action="{{ path('app_challenge_new') }}" class="d-flex flex-column gap-12" enctype="multipart/form-data">
          <!-- Form content truncated for brevity since it remains the same -->
          <input type="hidden" name="id" id="challengeId" value="">

          <div class="d-flex flex-column gap-5">
            <label class="cf-label">VISUEL (PHOTO/VIDÉO)</label>
            <input type="file" name="media" id="mediaField" class="form-control" accept="image/*,video/*">
          </div>

          <div class="d-flex flex-column gap-5">
            <label class="cf-label">TITRE *</label>
            <input type="text" name="titre" id="titreField" class="form-control" placeholder="Ex: Maîtrise de Java en 30 jours" required>
          </div>

          <div class="d-flex flex-column gap-5">
            <label class="cf-label">DESCRIPTION *</label>
            <textarea name="description" id="descField" class="form-control" rows="3" placeholder="Décrivez les objectifs..." required></textarea>
          </div>

          <div class="d-flex flex-column gap-5">
            <label class="cf-label">🌍 LIEU / ADRESSE (GOOGLE MAPS)</label>
            <div class="d-flex gap-10">
              <input type="text" name="adresse" id="adresseField" class="form-control flex-grow-1" placeholder="Ex: Central Park, New York" style="background-image:url('data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'white\'><path d=\'M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z\'/></svg>'); background-size: 16px; background-repeat: no-repeat; background-position: 10px center; padding-left: 35px;">
              <a id="testMapLink" href="https://maps.google.com/" target="_blank" class="btn btn-blue" style="border-radius:10px; display:none;" title="Tester l'adresse sur Google Maps">Google Maps 📍</a>
            </div>
          </div>

          <div class="cf-grid-2">
            <div class="d-flex flex-column gap-5">
              <label class="cf-label">📅 DÉBUT</label>
              <input type="date" name="dateDebut" id="dateDebutField" class="form-control">
            </div>
            <div class="d-flex flex-column gap-5">
              <label class="cf-label">⏳ FIN</label>
              <input type="date" name="dateFin" id="dateFinField" class="form-control">
            </div>
          </div>

          <div class="cf-grid-2">
            <div class="d-flex flex-column gap-5">
              <label class="cf-label">⚡ STATUT</label>
              <select name="statut" id="statutField" class="form-control">
                <option value="actif">✅ Actif</option>
                <option value="termine">🏁 Terminé</option>
                <option value="annule">❌ Annulé</option>
              </select>
            </div>
            <div class="d-flex flex-column gap-5">
              <label class="cf-label">📂 CATÉGORIE</label>
              <select name="categorie" id="categorieField" class="form-control">
                <option value="">-- Aucune --</option>
                {% for cat in categories %}
                <option value="{{ cat.id }}">{{ cat.icon ?? '' }} {{ cat.nom }}</option>
                {% endfor %}
                <option value="autre" style="color:#c788f5;font-weight:bold;">+ Autre thématique...</option>
              </select>
            </div>
          </div>

          <div id="other-cat-group" style="display:none;" class="d-flex flex-column gap-5">
            <label class="cf-label" style="color:#c788f5;">NOUVELLE THÉMATIQUE</label>
            <input type="text" name="new_categorie" id="newCatField" class="form-control" placeholder="Entrez le nom de la catégorie...">
          </div>

          <div class="cf-grid-2" style="margin-top:10px;">
            <button type="submit" id="btnAdd" class="btn btn-blue-purple" style="padding:12px;border-radius:8px;justify-content:center;">➕ AJOUTER</button>
            <button type="button" id="btnEdit" class="btn btn-purple" style="padding:12px;border-radius:8px;justify-content:center;">✏️ MODIFIER</button>
            <button type="button" id="btnDelete" class="btn btn-orange-red" style="padding:12px;border-radius:8px;justify-content:center;">🗑️ SUPPRIMER</button>
            <button type="button" id="btnReset" class="btn btn-grey" style="padding:12px;border-radius:8px;justify-content:center;">🔄 VIDER</button>
          </div>
        </form>
      </div>

      <div class="advice-card card-glass d-flex flex-column gap-10" style="padding:20px;background:linear-gradient(135deg,rgba(102,126,234,0.2),rgba(118,75,162,0.2));border:1px solid rgba(102,126,234,0.3);">
        <div class="d-flex align-center gap-10">
          <span style="font-size:24px;">💡</span>
          <span class="advice-title text-glow" style="color:white;font-weight:bold;">CONSEIL PRO</span>
        </div>
        <p style="color:rgba(255,255,255,0.7);font-size:12px;margin:0;line-height:1.6;">
          Les descriptions détaillées augmentent l'engagement de 40%. Assignez des coaches experts et des récompenses motivantes pour maximiser les résultats!
        </p>
      </div>
    </div>
    {% endif %}
  </div>




<footer class="main-footer text-white" style="text-align:center; padding: 20px; opacity:0.5; font-size: 0.8rem;">© 2024 Atomic You — Challenge Manager Pro</footer>
</div>

