<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Export Challenges — Challenge Manager Pro</title>
<style>
    body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #2c3e50; padding: 20px; background-color: #ffffff; margin: 0; }
    .header { text-align: center; margin-bottom: 30px; border-bottom: 3px solid #6c63ff; padding-bottom: 20px; }
    .header h1 { color: #6c63ff; margin: 0; font-size: 26px; letter-spacing: 1px; text-transform: uppercase; }
    .header p { color: #7f8c8d; font-size: 13px; margin-top: 5px; font-weight: bold; }
    
    .challenge-card { border: 1px solid #ecf0f1; border-top: 4px solid #6c63ff; margin-bottom: 25px; padding: 15px; page-break-inside: avoid; border-radius: 4px; }
    .challenge-header { border-bottom: 1px dashed #ecf0f1; padding-bottom: 8px; margin-bottom: 10px; }
    .challenge-title { font-size: 18px; color: #2c3e50; margin: 0; font-weight: bold; }
    
    .challenge-meta-container { margin-top: 8px; font-size: 11px; }
    .c-meta { display: inline-block; background: #ecf0f1; color: #34495e; padding: 3px 8px; border-radius: 4px; margin-right: 8px; }
    
    .badge { padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: bold; text-transform: uppercase; float: right; margin-top: -24px; }
    .badge-actif    { background: #d5f5e3; color: #1e8449; }
    .badge-termine  { background: #d6eaf8; color: #1a5276; }
    .badge-annule   { background: #fde8e8; color: #c0392b; }
    
    .challenge-desc { font-size: 13px; color: #34495e; line-height: 1.5; margin: 12px 0; }
    
    .grid-container { width: 100%; border-collapse: collapse; margin-top: 10px; }
    .grid-container td { width: 50%; vertical-align: top; padding: 12px; background: #f9fbfd; border: 1px solid #edf2f7; border-collapse: collapse; }
    
    .section-title { font-size: 12px; color: #6c63ff; font-weight: bold; margin: 0 0 8px 0; border-bottom: 1px solid #e2e8f0; padding-bottom: 5px; text-transform: uppercase; }
    
    .item-list { margin: 0; padding: 0; list-style-type: none; }
    .item-list li { font-size: 12px; color: #2d3748; margin-bottom: 6px; padding-left: 15px; position: relative; }
    .item-list li:before { content: "•"; color: #6c63ff; position: absolute; left: 0; font-weight: bold; }
    .item-highlight { color: #d63031; font-weight: bold; }
    .item-subtext { color: #718096; font-size: 10.5px; }
    
    .empty-text { font-size: 11px; color: #a0aec0; font-style: italic; }
    
    .footer { text-align: center; color: #a0aec0; font-size: 10px; margin-top: 40px; padding-top: 10px; border-top: 1px solid #e2e8f0; width: 100%; }
</style>
</head>
<body>
    <div class="header">
        <h1>🏆 RAPPORT DES CHALLENGES - PSYAPP</h1>
        <p>Généré le {{ generatedAt|date('d/m/Y à H:i') }} · Total: {{ challenges|length }} Challenge(s)</p>
    </div>

    {% for c in challenges %}
    <div class="challenge-card">
        <div class="challenge-header">
            <h2 class="challenge-title">#{{ loop.index }} {{ c.titre }}</h2>
            <span class="badge badge-{{ c.statut }}">{{ c.statut }}</span>
            <div class="challenge-meta-container">
                <span class="c-meta">Catégorie: {{ c.categorie ? c.categorie.nom : '—' }}</span>
                <span class="c-meta">Début: {{ c.dateDebut ? c.dateDebut|date('d/m/Y') : '—' }}</span>
                <span class="c-meta">Fin: {{ c.dateFin ? c.dateFin|date('d/m/Y') : '—' }}</span>
            </div>
        </div>
        
        <p class="challenge-desc"><b>Description:</b> <br>{{ c.description ?: 'Aucune description disponible.' }}</p>
        
        <table class="grid-container">
            <tr>
                <td style="border-right: 1px solid #edf2f7;">
                    <h3 class="section-title">👨‍🏫 COACHES  ({{ c.coaches|length }})</h3>
                    {% if c.coaches|length > 0 %}
                        <ul class="item-list">
                        {% for cc in c.coaches %}
                            <li><b>{{ cc.coach.nom|upper }} {{ cc.coach.prenom }}</b> <br><span class="item-subtext">{{ cc.coach.email }}</span></li>
                        {% endfor %}
                        </ul>
                    {% else %}
                        <span class="empty-text">Aucun coach assigné.</span>
                    {% endif %}
                </td>
                <td>
                    <h3 class="section-title">🎁 RÉCOMPENSES  ({{ c.recompenses|length }})</h3>
                    {% if c.recompenses|length > 0 %}
                        <ul class="item-list">
                        {% for cr in c.recompenses %}
                            <li>{{ cr.recompense.nom }} <br><span class="item-highlight">{{ cr.recompense.points }} pts</span></li>
                        {% endfor %}
                        </ul>
                    {% else %}
                        <span class="empty-text">Aucune récompense attribuée.</span>
                    {% endif %}
                </td>
            </tr>
        </table>
    </div>
    {% endfor %}

    <div class="footer">
        Document généré dynamiquement le {{ generatedAt|date('d/m/Y à H:i') }} par <strong style="color:#6c63ff;">Challenge Manager Pro</strong>.
    </div>
</body>
</html>
