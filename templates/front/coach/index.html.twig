{% extends 'front/base.html.twig' %}

{% block title %}AI Fitness Coach — Atomic You{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
        * { box-sizing: border-box; }

        body { font-family: 'Inter', sans-serif; }

        /* ═══ COACH PAGE LAYOUT ═══ */
        .coach-page {
            min-height: 100vh;
            background: linear-gradient(135deg, #0a0f1e 0%, #0f172a 50%, #0a1628 100%);
            padding: 0;
            position: relative;
            overflow: hidden;
        }
        .coach-page::before {
            content: '';
            position: absolute;
            top: -200px; left: -200px;
            width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(59,130,246,0.08) 0%, transparent 70%);
            pointer-events: none;
        }

        /* ═══ HEADER HERO ═══ */
        .coach-hero {
            text-align: center;
            padding: 60px 20px 40px;
        }
        .coach-avatar {
            width: 80px; height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1d4ed8, #3b82f6);
            display: flex; align-items: center; justify-content: center;
            font-size: 2rem;
            margin: 0 auto 20px;
            box-shadow: 0 0 40px rgba(59,130,246,0.4);
            animation: pulse-glow 2s ease-in-out infinite;
        }
        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 30px rgba(59,130,246,0.4); }
            50% { box-shadow: 0 0 60px rgba(59,130,246,0.7); }
        }
        .coach-hero h1 {
            font-size: 2.2rem; font-weight: 800;
            background: linear-gradient(135deg, #fff 30%, #93c5fd);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
        }
        .coach-hero p {
            color: #64748b; font-size: 1rem;
        }

        /* ═══ STEPS INDICATOR ═══ */
        .steps-bar {
            display: flex; align-items: center; justify-content: center;
            gap: 8px; margin-bottom: 40px;
        }
        .step-dot {
            width: 10px; height: 10px; border-radius: 50%;
            background: rgba(255,255,255,0.1);
            transition: all 0.3s ease;
        }
        .step-dot.active { background: #3b82f6; transform: scale(1.4); }
        .step-dot.done { background: #22c55e; }

        /* ═══ CHAT AREA ═══ */
        .chat-container {
            max-width: 700px;
            margin: 0 auto;
            padding: 0 20px 60px;
        }

        .chat-bubble-wrap {
            display: flex; align-items: flex-end; gap: 10px; margin-bottom: 16px;
        }
        .chat-bubble-wrap.user { flex-direction: row-reverse; }

        .chat-avatar {
            width: 36px; height: 36px; border-radius: 50%;
            background: linear-gradient(135deg, #1d4ed8, #3b82f6);
            display: flex; align-items: center; justify-content: center;
            font-size: 0.9rem; flex-shrink: 0;
        }
        .chat-avatar.user-av {
            background: linear-gradient(135deg, #7c3aed, #a855f7);
        }

        .chat-bubble {
            max-width: 80%;
            padding: 14px 18px;
            border-radius: 20px;
            line-height: 1.5;
            font-size: 0.95rem;
            animation: bubbleIn 0.3s ease;
        }
        @keyframes bubbleIn {
            from { opacity: 0; transform: translateY(10px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .bubble-coach {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.08);
            color: #e2e8f0;
            border-bottom-left-radius: 4px;
        }
        .bubble-user {
            background: linear-gradient(135deg, #1d4ed8, #3b82f6);
            color: #fff;
            border-bottom-right-radius: 4px;
        }

        /* ═══ QUICK REPLIES ═══ */
        .quick-replies {
            display: flex; flex-wrap: wrap; gap: 8px;
            margin: 8px 0 8px 46px;
        }
        .quick-btn {
            padding: 8px 16px;
            background: rgba(59,130,246,0.1);
            border: 1px solid rgba(59,130,246,0.3);
            border-radius: 50px;
            color: #93c5fd;
            font-size: 0.85rem; font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }
        .quick-btn:hover {
            background: rgba(59,130,246,0.25);
            border-color: #3b82f6;
            transform: translateY(-1px);
        }

        /* ═══ INPUT AREA ═══ */
        .input-panel {
            position: sticky; bottom: 0;
            background: linear-gradient(to top, #0a0f1e 70%, transparent);
            padding: 20px;
        }
        .input-row {
            max-width: 700px;
            margin: 0 auto;
            display: flex; gap: 10px; align-items: center;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 16px;
            padding: 8px 8px 8px 16px;
        }
        #userInput {
            flex: 1;
            background: transparent;
            border: none;
            color: #fff;
            font-size: 0.95rem;
            outline: none;
        }
        #userInput::placeholder { color: #475569; }
        #sendBtn {
            width: 40px; height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, #1d4ed8, #3b82f6);
            border: none;
            color: #fff;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: opacity 0.2s;
            flex-shrink: 0;
        }
        #sendBtn:hover { opacity: 0.85; }
        #sendBtn:disabled { opacity: 0.4; cursor: not-allowed; }

        /* ═══ TYPING INDICATOR ═══ */
        .typing-dots {
            display: flex; gap: 4px; padding: 4px 0;
        }
        .typing-dots span {
            width: 8px; height: 8px; border-radius: 50%;
            background: #3b82f6;
            animation: dot-bounce 1.2s ease-in-out infinite;
        }
        .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
        .typing-dots span:nth-child(3) { animation-delay: 0.4s; }
        @keyframes dot-bounce {
            0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
            40% { transform: translateY(-8px); opacity: 1; }
        }

        /* ═══ RESULT CARD ═══ */
        .result-card {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(59,130,246,0.3);
            border-radius: 20px;
            padding: 24px;
            animation: bubbleIn 0.4s ease;
        }
        .result-card h3 {
            color: #93c5fd !important;
            font-size: 1.2rem; font-weight: 700;
            margin-bottom: 16px;
        }
        .exercise-item {
            display: flex; align-items: flex-start; gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255,255,255,0.04);
        }
        .exercise-item:last-child { border-bottom: none; }
        .ex-icon {
            width: 36px; height: 36px; border-radius: 10px;
            background: rgba(59,130,246,0.1);
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem; flex-shrink: 0;
        }
        .ex-name { color: #e2e8f0; font-weight: 600; font-size: 0.9rem; }
        .ex-meta { color: #64748b; font-size: 0.78rem; margin-top: 2px; }

        .email-success {
            background: rgba(34,197,94,0.1);
            border: 1px solid rgba(34,197,94,0.3);
            border-radius: 12px;
            padding: 12px 16px;
            color: #86efac;
            font-size: 0.85rem;
            margin-top: 16px;
            display: flex; align-items: center; gap: 8px;
        }

        /* ═══ FORM FIELDS ═══ */
        .field-group {
            margin: 8px 0 8px 46px;
        }
        .field-group input, .field-group select {
            width: 100%;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            padding: 12px 16px;
            color: #fff;
            font-size: 0.9rem;
            outline: none;
            transition: border-color 0.2s;
        }
        .field-group input:focus, .field-group select:focus {
            border-color: #3b82f6;
        }
        .field-group select option { background: #1e293b; }
    </style>
{% endblock %}

{% block fitness_content %}
<div class="coach-page">

    <!-- HERO -->
    <div class="coach-hero container">
        <div class="coach-avatar">🤖</div>
        <h1>AI Fitness Coach</h1>
        <p>Réponds à quelques questions, et ton programme personnalisé sera envoyé par email !</p>
    </div>

    <!-- STEPS BAR -->
    <div class="steps-bar" id="stepsBar">
        <div class="step-dot active" id="dot0"></div>
        <div class="step-dot" id="dot1"></div>
        <div class="step-dot" id="dot2"></div>
    </div>

    <!-- CHAT -->
    <div class="chat-container" id="chatContainer"></div>

    <!-- INPUT -->
    <div class="input-panel" id="inputPanel">
        <div class="input-row">
            <input type="text" id="userInput" placeholder="Écris ta réponse ici..." autocomplete="off">
            <button id="sendBtn" onclick="sendMessage()">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    </div>
</div>
{% endblock %}

{% block fitness_javascripts %}
<script>
// ════════════════════════════════════════════════════════
// USER DATA FROM SERVER — email & name from DB session
// ════════════════════════════════════════════════════════
const SERVER_EMAIL = {{ userEmail|json_encode|raw }};
const SERVER_NAME  = {{ userName|json_encode|raw }};

// ════════════════════════════════════════════════════════
// COACH FLOW — 3 steps only (goal, level, days)
// Email comes from logged-in user automatically
// ════════════════════════════════════════════════════════
const STEPS = [
    {
        id: 'goal',
        coachMsg: `Bonjour ${SERVER_NAME} ! Je suis ton coach IA 🤖\n\nJe vais créer un programme fitness 100% personnalisé pour toi et l'envoyer à ${SERVER_EMAIL} 📧\n\nQuel est ton objectif principal ?`,
        placeholder: "Ton objectif...",
        quickReplies: ['Perdre du poids', 'Prendre du muscle', 'Améliorer mon endurance', 'Me remettre en forme', 'Réduire le stress']
    },
    {
        id: 'level',
        coachMsg: "Excellent objectif ! Quel est ton niveau actuel en fitness ?",
        placeholder: "Ton niveau...",
        quickReplies: ['Débutant', 'Intermédiaire', 'Avancé']
    },
    {
        id: 'days',
        coachMsg: "Combien de jours par semaine peux-tu t'entraîner ?",
        placeholder: "Nombre de jours (ex: 3)...",
        quickReplies: ['2 jours', '3 jours', '4 jours', '5 jours']
    }
];

const state = { goal: '', level: '', days: 3 };
let currentStep = 0;
let isGenerating = false;

const chat = document.getElementById('chatContainer');
const input = document.getElementById('userInput');
const sendBtn = document.getElementById('sendBtn');

// Hide extra dots (we only have 3 steps now)
document.addEventListener('DOMContentLoaded', () => {
    ['dot3','dot4'].forEach(id => {
        const d = document.getElementById(id);
        if (d) d.style.display = 'none';
    });
});

// ─── Start ───
window.addEventListener('load', () => {
    setTimeout(() => showStep(0), 400);
});

function showStep(stepIndex) {
    const step = STEPS[stepIndex];
    if (!step) return;

    updateDots(stepIndex);
    const msg = typeof step.coachMsg === 'function' ? step.coachMsg(state) : step.coachMsg;
    addCoachBubble(msg);

    if (step.quickReplies && step.quickReplies.length > 0) {
        addQuickReplies(step.quickReplies);
    }

    input.placeholder = step.placeholder;
    input.focus();
}

function sendMessage(value) {
    if (isGenerating) return;
    const text = value !== undefined ? value : input.value.trim();
    if (!text) return;

    input.value = '';
    removeQuickReplies();
    addUserBubble(text);

    const stepId = STEPS[currentStep].id;
    if (stepId === 'goal')  state.goal  = text;
    if (stepId === 'level') state.level = text;
    if (stepId === 'days')  state.days  = parseInt(text) || 3;

    currentStep++;

    if (currentStep < STEPS.length) {
        sendBtn.disabled = true;
        setTimeout(() => {
            showTyping();
            setTimeout(() => {
                hideTyping();
                showStep(currentStep);
                sendBtn.disabled = false;
            }, 900);
        }, 300);
    } else {
        generateProgram();
    }
}

function quickReply(value) { sendMessage(value); }

// ─── Typing ───
function showTyping() {
    const el = document.createElement('div');
    el.className = 'chat-bubble-wrap';
    el.id = 'typingIndicator';
    el.innerHTML = `<div class="chat-avatar">🤖</div>
        <div class="chat-bubble bubble-coach">
            <div class="typing-dots"><span></span><span></span><span></span></div>
        </div>`;
    chat.appendChild(el);
    scrollBottom();
}
function hideTyping() {
    const el = document.getElementById('typingIndicator');
    if (el) el.remove();
}

// ─── Bubbles ───
function addCoachBubble(text) {
    const div = document.createElement('div');
    div.className = 'chat-bubble-wrap';
    div.innerHTML = `<div class="chat-avatar">🤖</div>
        <div class="chat-bubble bubble-coach" style="white-space:pre-line">${escHtml(text)}</div>`;
    chat.appendChild(div);
    scrollBottom();
}
function addUserBubble(text) {
    const div = document.createElement('div');
    div.className = 'chat-bubble-wrap user';
    div.innerHTML = `<div class="chat-avatar user-av">👤</div>
        <div class="chat-bubble bubble-user">${escHtml(text)}</div>`;
    chat.appendChild(div);
    scrollBottom();
}
function addQuickReplies(replies) {
    const div = document.createElement('div');
    div.className = 'quick-replies';
    div.id = 'quickReplies';
    replies.forEach(r => {
        const btn = document.createElement('button');
        btn.className = 'quick-btn';
        btn.textContent = r;
        btn.onclick = () => quickReply(r);
        div.appendChild(btn);
    });
    chat.appendChild(div);
    scrollBottom();
}
function removeQuickReplies() {
    const el = document.getElementById('quickReplies');
    if (el) el.remove();
}

// ─── Generate ───
function generateProgram() {
    isGenerating = true;
    sendBtn.disabled = true;
    document.getElementById('inputPanel').style.display = 'none';
    updateDots(STEPS.length);

    showTyping();
    addCoachBubble("Génération de ton programme avec Gemini AI ✨\nCela prend 10 à 20 secondes...");

    fetch('{{ path("fitness_coach_generate") }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(state)   // email/name come from the PHP session on server
    })
    .then(r => r.json())
    .then(data => {
        hideTyping();
        if (data.success) {
            showResult(data.program, data.emailSent);
        } else {
            addCoachBubble("Oups : " + (data.error || 'Réessaie plus tard.'));
            document.getElementById('inputPanel').style.display = '';
            isGenerating = false; sendBtn.disabled = false;
        }
    })
    .catch(() => {
        hideTyping();
        addCoachBubble("Erreur de connexion. Réessaie.");
        document.getElementById('inputPanel').style.display = '';
        isGenerating = false; sendBtn.disabled = false;
    });
}

function showResult(program, emailSent) {
    const icons = { 'Cardio':'🏃','Musculation':'💪','Yoga':'🧘','HIIT':'⚡','Flexibilité':'🤸' };
    const exHtml = program.exercises.map(ex => `
        <div class="exercise-item">
            <div class="ex-icon">${icons[ex.category] || '🏋️'}</div>
            <div>
                <div class="ex-name">${escHtml(ex.name)}</div>
                <div class="ex-meta">${ex.category} · ${ex.duration} min · ${ex.calories} kcal</div>
            </div>
        </div>`).join('');

    const emailNote = emailSent
        ? `<div class="email-success"><i class="bi bi-envelope-check-fill"></i> Programme envoyé à <strong>${escHtml(SERVER_EMAIL)}</strong> !</div>`
        : `<div class="email-success" style="background:rgba(234,179,8,0.1);border-color:rgba(234,179,8,0.3);color:#fde68a;"><i class="bi bi-envelope-exclamation"></i> Programme créé ! (Config SMTP requise pour l'envoi d'email)</div>`;

    const card = document.createElement('div');
    card.className = 'chat-bubble-wrap';
    card.innerHTML = `
        <div class="chat-avatar">🤖</div>
        <div style="flex:1">
            <div class="result-card">
                <h3>🏋️ ${escHtml(program.title)}</h3>
                <div style="display:flex;gap:16px;margin-bottom:16px;flex-wrap:wrap">
                    <span style="color:#64748b;font-size:.82rem"><b style="color:#94a3b8">Objectif:</b> ${escHtml(program.goal)}</span>
                    <span style="color:#64748b;font-size:.82rem"><b style="color:#94a3b8">Niveau:</b> ${escHtml(program.level)}</span>
                    <span style="color:#64748b;font-size:.82rem"><b style="color:#94a3b8">Durée:</b> ${program.durationWeeks} semaines</span>
                </div>
                <div>${exHtml}</div>
                ${emailNote}
            </div>
        </div>`;
    chat.appendChild(card);
    scrollBottom();

    setTimeout(() => {
        const restartDiv = document.createElement('div');
        restartDiv.style.textAlign = 'center';
        restartDiv.style.marginTop = '24px';
        restartDiv.innerHTML = `<button onclick="location.reload()" class="quick-btn" style="padding:12px 28px;font-size:.92rem;">🔄 Créer un autre programme</button>`;
        chat.appendChild(restartDiv);
        scrollBottom();
    }, 800);
}

// ─── Utilities ───
function updateDots(activeIndex) {
    for (let i = 0; i < STEPS.length; i++) {
        const dot = document.getElementById('dot' + i);
        if (!dot) continue;
        dot.className = 'step-dot';
        if (i < activeIndex) dot.classList.add('done');
        else if (i === activeIndex) dot.classList.add('active');
    }
}
function scrollBottom() {
    setTimeout(() => window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' }), 50);
}
function escHtml(str) {
    const d = document.createElement('div');
    d.appendChild(document.createTextNode(str));
    return d.innerHTML;
}
input.addEventListener('keydown', e => { if (e.key === 'Enter') sendMessage(); });
</script>
{% endblock %}
