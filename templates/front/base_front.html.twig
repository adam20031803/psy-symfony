<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Atomic You{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root{
            --bg: #121826;
            --bg-elevated: #1a2234;
            --card: rgba(26, 34, 52, .76);
            --card-border: rgba(148, 163, 184, .26);
            --text-primary: #e6edf8;
            --text-muted: #a8b4c9;
            --brand1: #6d7cff;
            --brand2: #8f5dff;
            --secondary1: #3b4963;
            --secondary2: #4a5a78;
            --danger1: #d94f72;
            --danger2: #b83256;
        }
        body { background: radial-gradient(1200px 600px at 30% -10%, rgba(99,102,241,.35), transparent 55%),
                         radial-gradient(900px 500px at 90% 10%, rgba(143,93,255,.24), transparent 55%),
                         linear-gradient(180deg, #141b2b 0%, #121826 100%),
                         var(--bg);
               color: var(--text-primary); min-height: 100vh; }
        .topbar {
            background: linear-gradient(90deg, rgba(109,124,255,.92), rgba(143,93,255,.9));
            box-shadow: 0 10px 30px rgba(0,0,0,.35);
        }
        .brand-pill {
            display:inline-flex; gap:.5rem; align-items:center;
            background: rgba(230,237,248,.12);
            border: 1px solid rgba(230,237,248,.22);
            padding: .35rem .7rem;
            border-radius: 999px;
            font-weight: 700;
            letter-spacing: .01em;
        }
        .glass-card{
            background: var(--card);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            box-shadow: 0 18px 40px rgba(6, 10, 20, .42);
            backdrop-filter: blur(6px);
        }
        .nav-link { color: #d8e2f3; }
        .nav-link.active { color:#ffffff; font-weight: 700; background: rgba(255,255,255,.14); }
        .muted { color: var(--text-muted); }
        .btn-brand{
            background: linear-gradient(135deg, var(--brand1), var(--brand2));
            border: 1px solid rgba(255,255,255,.16);
            font-weight: 700;
            color: #fff;
        }
        .btn-brand:hover{ filter: brightness(1.08); color: #fff; }
        .btn-secondary{
            background: linear-gradient(135deg, var(--secondary1), var(--secondary2));
            border: 1px solid rgba(255,255,255,.14);
            color: #f3f6ff;
            font-weight: 700;
        }
        .btn-secondary:hover{ filter: brightness(1.08); color: #fff; }
        .btn-danger{
            background: linear-gradient(135deg, var(--danger1), var(--danger2));
            border: 1px solid rgba(255,255,255,.16);
            color: #fff;
            font-weight: 700;
        }
        .btn-danger:hover{ filter: brightness(1.06); color:#fff; }
        .btn-outline-light{
            border-color: rgba(230,237,248,.28);
            color: #dfe7f7;
        }
        .btn-outline-light:hover{
            background: rgba(230,237,248,.16);
            border-color: rgba(230,237,248,.42);
            color: #fff;
        }
        .table td, .table th { color: #e8eefb; border-color: rgba(148,163,184,.18); }
        .table thead th {
            color: #c6d4eb;
            background: rgba(28, 37, 56, .88);
        }
        .table tbody td {
            background: rgba(18, 25, 40, .72);
        }
        .table tbody tr:nth-child(even) td {
            background: rgba(22, 30, 47, .82);
        }
        .table-hover tbody tr:hover td {
            background: rgba(109,124,255,.18) !important;
            color: #f4f7ff;
        }
        .form-control, .form-select{
            background: rgba(18,24,38,.72);
            border: 1px solid rgba(148,163,184,.28);
            color: var(--text-primary);
        }
        .form-control:focus, .form-select:focus{
            background: rgba(20,28,44,.88);
            border-color: rgba(109,124,255,.85);
            box-shadow: 0 0 0 .2rem rgba(109,124,255,.24);
            color: var(--text-primary);
        }
        .form-control::placeholder { color: #8291ab; }
        .form-text, .invalid-feedback { color: #b8c6de; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<header class="topbar py-3">
    <div class="container d-flex flex-wrap gap-3 align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-3">
            <span class="brand-pill"><i class="bi bi-stars"></i> Atomic You</span>
            <span class="muted small">Espace perso · bien-être</span>
        </div>
        <nav class="nav nav-pills gap-1 flex-wrap">
            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_mental_tip' ? 'active' : '' }}" href="{{ path('app_mental_tip_index') }}">Mental Tips</a>
            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_mental_entry' ? 'active' : '' }}" href="{{ path('app_mental_entry_index') }}">Mental Entries</a>
            <a class="nav-link {{ app.request.attributes.get('_route') == 'app_chatbot' ? 'active' : '' }}" href="{{ path('app_chatbot') }}">Chat IA</a>
            <a class="nav-link" href="{{ path('app_dashboard') }}"><i class="bi bi-house-door"></i> Tableau de bord</a>
        </nav>
    </div>
</header>

<main class="container py-4">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

{% block javascripts %}{% endblock %}
</body>
</html>
