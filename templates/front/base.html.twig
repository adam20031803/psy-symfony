{% extends 'base.html.twig' %}

{% block title %}Fitness{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    
    <style>
        /* Base integrations for the dark theme */
        .fitness-wrapper {
            color: #e2e8f0;
            padding: 20px 0;
            min-height: 100vh;
        }

        .fit-card {
            background: rgba(255,255,255,0.03); 
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px; 
            overflow: hidden;
            transition: transform .2s, box-shadow .2s;
            color: #e2e8f0;
        }

        .fit-card:hover {
            transform: translateY(-4px);
            background: rgba(255,255,255,0.06);
            border-color: rgba(255,255,255,0.12);
        }
        .fit-card .card-img-top { object-fit: cover; height: 200px; }
        .fit-card .card-body { padding: 20px; }

        h1, h2, h3, h4, h5, h6 { color: #fff !important; }
        .text-muted, p { color: #94a3b8 !important; }

        .badge { font-size: 0.7rem; font-weight: 600; border-radius: 6px; padding: 4px 9px; }

        .category-pill {
            display: inline-block; padding: 6px 16px;
            border: 1px solid rgba(255,255,255,0.1); border-radius: 50px;
            font-size: 0.8rem; font-weight: 600; color: #94a3b8;
            text-decoration: none; transition: all .2s;
        }
        .category-pill:hover, .category-pill.active {
            background: #3b82f6; border-color: #3b82f6;
            color: #fff;
        }

        .section-title { font-size: 1.75rem; font-weight: 800; color: #fff; letter-spacing: -0.5px; }
        .section-sub { color: #94a3b8; font-size: 0.95rem; }

        .stat-badge {
            background: rgba(255,255,255,0.05); border-radius: 10px;
            padding: 14px 20px; text-align: center;
        }
        .stat-badge .stat-val { font-size: 1.4rem; font-weight: 700; color: #60a5fa; }
        .stat-badge .stat-lab { font-size: 0.72rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; }

        .btn { border-radius: 10px; font-weight: 600; }
        .btn-primary { background: linear-gradient(135deg, #1d4ed8, #3b82f6); border: none; color: #fff; }
        .btn-primary:hover { opacity: 0.92; color: #fff;}
        .btn-outline-primary { border-color: #3b82f6; color: #3b82f6; }
        .btn-outline-primary:hover { background: #3b82f6; color: #fff; }

        .img-placeholder {
            background: linear-gradient(135deg, #1e293b, #334155);
            display: flex; align-items: center; justify-content: center;
            color: #64748b; font-size: 3rem;
        }

        /* Generic form styling for dark mode */
        .form-control, .form-select {
            background-color: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            color: #fff;
        }
        .form-control:focus, .form-select:focus {
            background-color: rgba(255,255,255,0.08);
            border-color: #3b82f6;
            color: #fff;
        }
    </style>
{% endblock %}

{% block body %}
<div class="fitness-wrapper">
    {# ========== FLASH MESSAGES ========== #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="container mt-3">
                <div class="alert alert-{{ type == 'danger' ? 'danger' : (type == 'warning' ? 'warning' : 'success') }} alert-dismissible fade show" role="alert">
                    <i class="bi bi-{{ type == 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill' }} me-2"></i>
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        {% endfor %}
    {% endfor %}

    {# ========== PAGE CONTENT ========== #}
    <div class="fitness-content">
        {% block fitness_content %}{% endblock %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block fitness_javascripts %}{% endblock %}
{% endblock %}
