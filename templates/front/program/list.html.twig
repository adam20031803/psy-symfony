{% extends 'front/base.html.twig' %}

{% block title %}Programmes Fitness — FitLife{% endblock %}
{% block meta_description %}Découvrez nos programmes fitness publiés, adaptés à tous les niveaux.{% endblock %}

{% block fitness_content %}

{# ---- Page Header ---- #}
<div class="page-header" style="margin-bottom: 32px; padding: 24px 0; border-bottom: 1px solid rgba(255,255,255,0.08);">
    <div>
        <h1 class="fw-bold mb-1 text-white">📋 Programmes Fitness</h1>
        <p style="color: #94a3b8; font-size: 0.95rem;">{{ programs|length }} programme(s) disponible(s)</p>
    </div>
</div>

<div class="py-2">
    {% if programs|length == 0 %}
        <div class="text-center py-5" style="border: 1px dashed rgba(255,255,255,0.1); border-radius: 12px; margin-top: 20px;">
            <i class="bi bi-journal-x display-4 d-block mb-3" style="color: #475569;"></i>
            <h5 style="color: #94a3b8;">Aucun programme disponible pour l'instant.</h5>
            <p style="color: #64748b;">Revenez bientôt, de nouveaux programmes arrivent !</p>
            <a href="{{ path('front_exercise_list') }}" class="btn btn-outline-primary mt-2">
                <i class="bi bi-activity me-1"></i>Voir les exercices
            </a>
        </div>
    {% else %}
        <div class="row g-4">
            {% for program in programs %}
                <div class="col-md-6 col-lg-4">
                    <div class="fit-card h-100 d-flex flex-column">
                        {# Program header #}
                        <div class="p-4 flex-grow-1">
                            {# Level badge #}
                            <div class="mb-3">
                                {% if program.level == 'Débutant' %}
                                    <span class="badge bg-success" style="opacity: 0.85;">{{ program.level }}</span>
                                {% elseif program.level == 'Intermédiaire' %}
                                    <span class="badge bg-warning" style="opacity: 0.85;">{{ program.level }}</span>
                                {% else %}
                                    <span class="badge bg-danger" style="opacity: 0.85;">{{ program.level }}</span>
                                {% endif %}
                            </div>

                            <h5 class="fw-bold mb-2 text-white">{{ program.title }}</h5>
                            <p style="color: #94a3b8; font-size: 0.85rem; margin-bottom: 24px;">
                                <i class="bi bi-bullseye me-1" style="color: #60a5fa;"></i>
                                <span style="font-weight: 500;">Objectif :</span> {{ program.goal }}
                            </p>

                            {# Stats row #}
                            <div class="d-flex gap-3 mb-4">
                                <div class="stat-badge flex-fill" style="padding: 10px; background: rgba(255,255,255,0.02)">
                                    <div class="stat-val" style="font-size:1.1rem; color: #e2e8f0;">{{ program.durationWeeks }}</div>
                                    <div class="stat-lab">semaines</div>
                                </div>
                                <div class="stat-badge flex-fill" style="padding: 10px; background: rgba(255,255,255,0.02)">
                                    <div class="stat-val" style="font-size:1.1rem; color: #e2e8f0;">{{ program.exercises|length }}</div>
                                    <div class="stat-lab">exercices</div>
                                </div>
                            </div>
                        </div>

                        {# Footer #}
                        <div class="px-4 pb-4 mt-auto">
                            <a href="{{ path('front_program_show', {id: program.id}) }}" class="btn btn-primary w-100 py-2" style="background: rgba(59,130,246,0.15); border: 1px solid rgba(59,130,246,0.3); color: #60a5fa;">
                                Découvrir ce programme <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
