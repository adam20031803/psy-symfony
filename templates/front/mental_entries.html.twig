{% extends 'front/base_front.html.twig' %}

{% block title %}Mental Entries — Atomic You{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .btn-meteo-gradient {
        background: linear-gradient(90deg, #6366f1, #7c3aed);
        border: none;
        color: #fff;
        font-weight: 700;
        box-shadow: 0 2px 10px rgba(99, 102, 241, .35);
    }
    .btn-meteo-gradient:hover { filter: brightness(1.08); color: #fff; }
    .weather-panel-inner {
        border: 1px solid rgba(148, 163, 184, .22);
        border-radius: 12px;
        background: rgba(18, 24, 38, .55);
    }
    .mental-entries-table td.mood-cell-clickable {
        cursor: pointer;
        text-decoration: underline;
        text-decoration-color: rgba(109, 124, 255, .55);
        text-underline-offset: 3px;
    }
    .mental-entries-table td.mood-cell-clickable:hover {
        color: #c4d0ff !important;
        text-decoration-color: rgba(196, 208, 255, .9);
    }
</style>
{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-12 col-lg-7">
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
                <div>
                    <h1 class="h4 fw-bold mb-1">Liste des Entries</h1>
                    <p class="muted mb-0 small">Journal, conseil IA, météo (aperçu).</p>
                </div>
                <div class="d-flex flex-wrap gap-2 justify-content-end">
                    <button type="button" id="ia-advice-btn" class="btn btn-sm btn-brand">+ IA Conseil</button>
                    <button type="button" id="weather-advice-btn" class="btn btn-sm btn-meteo-gradient" title="Conseil selon le mood du tableau"><i class="bi bi-cloud-sun me-1"></i>Météo+Conseil</button>
                    <button type="button" id="spotify-suggest-btn" class="btn btn-sm btn-outline-light">Spotify</button>
                    <button type="button" id="youtube-suggest-btn" class="btn btn-sm btn-outline-light">YouTube</button>
                    <a class="btn btn-sm btn-outline-light" href="{{ path('app_mental_tip_index') }}">Tips <i class="bi bi-arrow-right"></i></a>
                    <a class="btn btn-sm btn-outline-light" href="{{ path('app_chatbot') }}">Chat IA</a>
                </div>
            </div>

            <form method="get" action="{{ path('app_mental_entry_index') }}" class="row g-2 mb-3">
                <div class="col-12 col-md-6">
                    <input type="text" name="q" value="{{ filter.q|default('') }}" class="form-control form-control-sm" placeholder="Recherche (mood / activité / note)">
                </div>
                <input type="hidden" name="sort" value="{{ filter.sort|default('date') }}">
                <input type="hidden" name="dir" value="{{ filter.dir|default('DESC') }}">
                <div class="col-6 col-md-3">
                    <button type="submit" class="btn btn-sm btn-brand w-100">Rechercher</button>
                </div>
                <div class="col-6 col-md-3">
                    <a href="{{ path('app_mental_entry_index') }}" class="btn btn-sm btn-secondary w-100">Réinitialiser</a>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 mental-entries-table">
                    <thead>
                    <tr>
                        <th style="width: 140px;">
                            <a class="text-decoration-none text-white" href="{{ path('app_mental_entry_index', { q: filter.q|default(''), sort: 'mood', dir: (filter.sort|default('date') == 'mood' and filter.dir|default('DESC') == 'ASC') ? 'DESC' : 'ASC' }) }}">
                                Mood {% if filter.sort|default('date') == 'mood' %}{{ filter.dir|default('DESC') == 'ASC' ? '↑' : '↓' }}{% endif %}
                            </a>
                        </th>
                        <th style="width: 120px;">
                            <a class="text-decoration-none text-white" href="{{ path('app_mental_entry_index', { q: filter.q|default(''), sort: 'date', dir: (filter.sort|default('date') == 'date' and filter.dir|default('DESC') == 'ASC') ? 'DESC' : 'ASC' }) }}">
                                Date {% if filter.sort|default('date') == 'date' %}{{ filter.dir|default('DESC') == 'ASC' ? '↑' : '↓' }}{% endif %}
                            </a>
                        </th>
                        <th style="width: 70px;">
                            <a class="text-decoration-none text-white" href="{{ path('app_mental_entry_index', { q: filter.q|default(''), sort: 'level', dir: (filter.sort|default('date') == 'level' and filter.dir|default('DESC') == 'ASC') ? 'DESC' : 'ASC' }) }}">
                                Lvl {% if filter.sort|default('date') == 'level' %}{{ filter.dir|default('DESC') == 'ASC' ? '↑' : '↓' }}{% endif %}
                            </a>
                        </th>
                        <th style="width: 160px;">
                            <a class="text-decoration-none text-white" href="{{ path('app_mental_entry_index', { q: filter.q|default(''), sort: 'activity', dir: (filter.sort|default('date') == 'activity' and filter.dir|default('DESC') == 'ASC') ? 'DESC' : 'ASC' }) }}">
                                Activity {% if filter.sort|default('date') == 'activity' %}{{ filter.dir|default('DESC') == 'ASC' ? '↑' : '↓' }}{% endif %}
                            </a>
                        </th>
                        <th>Note</th>
                        <th style="width: 90px;"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for e in entries %}
                        <tr>
                            <td class="fw-bold mood-cell-clickable" role="button" tabindex="0" title="Cliquer : météo + conseil">{{ e.mood.moodName }}</td>
                            <td>{{ e.entryDate|date('d/m/Y') }}</td>
                            <td>{{ e.emotionLevel }}</td>
                            <td>{{ e.activity }}</td>
                            <td>{{ e.note|default('—') }}</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-light" href="{{ path('app_mental_entry_edit', { id: e.id }) }}">Modifier</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center muted py-4">Aucune entry.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            <div id="weather-panel" class="weather-panel-inner p-3 mt-3">
                <div class="fw-bold small mb-2"><i class="bi bi-cloud-sun me-1"></i>Météo : conseil selon le mood</div>
                <p class="small muted mb-2">Clique sur une cellule <strong>Mood</strong> dans le tableau, ajuste la ville si besoin, puis « Afficher météo ».</p>
                <p class="small mb-2">Mood actif : <strong id="weather-mood-active" class="text-white">—</strong></p>
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-8">
                        <label for="weather-city-input" class="form-label small muted mb-0">Ville</label>
                        <input type="text" id="weather-city-input" class="form-control form-control-sm" placeholder="Ex: Tunis" autocomplete="address-level2">
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label small muted mb-0 d-block">&nbsp;</label>
                        <button type="button" id="weather-advice-submit" class="btn btn-sm btn-meteo-gradient w-100">Afficher météo</button>
                    </div>
                </div>
                <div id="weather-advice-box" class="small mt-2 muted">Clique sur un <strong>Mood</strong> dans le tableau pour lancer le conseil.</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="glass-card p-4">
            <h2 class="h5 fw-bold mb-1">{% if editing %}Modifier l’entry{% else %}Nouvelle entry{% endif %}</h2>
            <p class="muted mb-3">Renseigne ton mood, ton niveau d’émotion et une note si besoin.</p>

            {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
                {% include 'form/bootstrap_field.html.twig' with { field: form.mood } %}
                {% include 'form/bootstrap_field.html.twig' with { field: form.entryDate } %}
                {% include 'form/bootstrap_field.html.twig' with { field: form.emotionLevel } %}
                {% include 'form/bootstrap_field.html.twig' with { field: form.activity } %}
                {% include 'form/bootstrap_field.html.twig' with { field: form.note } %}
                {{ form_rest(form) }}

                <button type="submit" class="btn btn-brand w-100">
                    {% if editing %}Enregistrer les modifications{% else %}Ajouter l’entry{% endif %}
                </button>
            {{ form_end(form, { render_rest: false }) }}

            <div class="d-flex gap-2 mt-3">
                {% if editing %}
                    <form method="post" action="{{ path('app_mental_entry_delete', { id: edit_id }) }}" class="m-0 flex-fill" onsubmit="return confirm('Supprimer cette entrée ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ edit_id) }}">
                        <button type="submit" class="btn btn-danger w-100 fw-bold">Supprimer</button>
                    </form>
                {% else %}
                    <button type="button" class="btn btn-danger w-100 fw-bold flex-fill" disabled>Supprimer</button>
                {% endif %}
                <a href="{{ path('app_mental_entry_index') }}" class="btn btn-secondary w-100 fw-bold flex-fill">Réinitialiser</a>
            </div>

            <div class="glass-card p-3 mt-3">
                <h3 class="h6 fw-bold mb-1">Conseil IA par mood</h3>
                <p class="muted small mb-2">Clique sur « IA Conseil » pour obtenir une recommandation.</p>
                <div id="ia-advice-box" class="small">Aucun conseil pour le moment.</div>
            </div>

            <div class="glass-card p-3 mt-3">
                <h3 class="h6 fw-bold mb-1">Spotify</h3>
                <p class="muted small mb-2">Suggestions par mood (double-clic pour ouvrir).</p>
                <div id="spotify-results" class="small">Aucune suggestion Spotify.</div>
                <button type="button" id="add-spotify-note-btn" class="btn btn-sm btn-brand mt-2">+ Ajouter musique dans Note</button>
            </div>

            <div class="glass-card p-3 mt-3">
                <h3 class="h6 fw-bold mb-1">YouTube</h3>
                <p class="muted small mb-2">Suggestions par mood (double-clic pour ouvrir).</p>
                <div id="youtube-results" class="small">Aucune suggestion YouTube.</div>
                <button type="button" id="add-youtube-note-btn" class="btn btn-sm btn-brand mt-2">+ Ajouter vidéo dans Note</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const adviceButton = document.getElementById('ia-advice-btn');
    const adviceBox = document.getElementById('ia-advice-box');
    const spotifyButton = document.getElementById('spotify-suggest-btn');
    const youtubeButton = document.getElementById('youtube-suggest-btn');
    const spotifyResults = document.getElementById('spotify-results');
    const youtubeResults = document.getElementById('youtube-results');
    const addSpotifyNoteButton = document.getElementById('add-spotify-note-btn');
    const addYoutubeNoteButton = document.getElementById('add-youtube-note-btn');
    const moodSelect = document.getElementById('mental_entry_mood');
    const emotionLevelInput = document.getElementById('mental_entry_emotionLevel');
    const activityInput = document.getElementById('mental_entry_activity');
    const noteInput = document.getElementById('mental_entry_note');
    const weatherAdviceBtn = document.getElementById('weather-advice-btn');
    const weatherAdviceSubmit = document.getElementById('weather-advice-submit');
    const weatherCityInput = document.getElementById('weather-city-input');
    const weatherAdviceBox = document.getElementById('weather-advice-box');
    const weatherMoodActive = document.getElementById('weather-mood-active');
    const weatherPanel = document.getElementById('weather-panel');
    const entriesTableBody = document.querySelector('.mental-entries-table tbody');
    let lastWeatherMoodFromTable = '';
    let latestSpotify = [];
    let latestYoutube = [];

    const weatherUrl = {{ path('api_mental_entries_weather_advice')|json_encode|raw }};
    const adviceUrl = {{ path('api_mental_entries_advice')|json_encode|raw }};
    const mediaUrl = {{ path('api_mental_entries_media')|json_encode|raw }};

    function setWeatherMoodActiveLabel(mood) {
        if (!weatherMoodActive) {
            return;
        }
        const t = mood && String(mood).trim() ? String(mood).trim() : '';
        weatherMoodActive.textContent = t || '—';
    }

    function weatherMoodValue() {
        return lastWeatherMoodFromTable.trim();
    }

    async function runWeatherAdvice(triggerBtn, moodOverride) {
        if (!weatherAdviceBox) {
            return;
        }
        const city = weatherCityInput ? weatherCityInput.value.trim() : '';
        const mood = (moodOverride != null && String(moodOverride).trim() !== '')
            ? String(moodOverride).trim()
            : weatherMoodValue();
        if (!mood) {
            weatherAdviceBox.textContent = 'Clique d’abord sur une cellule Mood dans le tableau des entrées.';
            return;
        }

        lastWeatherMoodFromTable = mood;
        setWeatherMoodActiveLabel(mood);

        const btn = triggerBtn;
        const prev = btn ? btn.innerHTML : '';
        if (btn) {
            btn.disabled = true;
            btn.textContent = 'Météo...';
        }
        weatherAdviceBox.textContent = 'Récupération…';

        try {
            const response = await fetch(weatherUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ city: city, mood: mood })
            });
            const data = await response.json();
            if (!data.success) {
                weatherAdviceBox.textContent = data.message || 'Impossible de récupérer les données.';
            } else {
                const w = data.weather || {};
                weatherAdviceBox.innerHTML =
                    '<strong class="text-white">' + (w.city || city || 'Ville') + '</strong> — ' +
                    (w.description || '') + (w.temp != null ? ', <strong>' + w.temp + ' °C</strong>' : '') +
                    (w.feelsLike != null ? ' (ressenti ' + w.feelsLike + ' °C)' : '') + '.<br>' +
                    '<span class="text-light">' + (data.advice || '') + '</span>';
            }
        } catch (e) {
            weatherAdviceBox.textContent = 'Erreur: service indisponible.';
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = prev;
            }
        }
    }

    function activateMoodFromTable(mood) {
        if (weatherPanel) {
            weatherPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
        runWeatherAdvice(null, mood);
    }

    if (entriesTableBody) {
        entriesTableBody.addEventListener('click', function (ev) {
            const td = ev.target.closest('td.mood-cell-clickable');
            if (!td) {
                return;
            }
            const mood = td.textContent.trim();
            if (!mood) {
                return;
            }
            activateMoodFromTable(mood);
        });
        entriesTableBody.addEventListener('keydown', function (ev) {
            const td = ev.target.closest('td.mood-cell-clickable');
            if (!td || (ev.key !== 'Enter' && ev.key !== ' ')) {
                return;
            }
            ev.preventDefault();
            const mood = td.textContent.trim();
            if (mood) {
                activateMoodFromTable(mood);
            }
        });
    }

    if (weatherAdviceBtn) {
        weatherAdviceBtn.addEventListener('click', function () {
            runWeatherAdvice(weatherAdviceBtn);
        });
    }
    if (weatherAdviceSubmit) {
        weatherAdviceSubmit.addEventListener('click', function () {
            runWeatherAdvice(weatherAdviceSubmit);
        });
    }

    if (adviceButton && adviceBox) {
        adviceButton.addEventListener('click', async function () {
            const selectedOption = moodSelect && moodSelect.selectedIndex >= 0 ? moodSelect.options[moodSelect.selectedIndex] : null;
            const mood = selectedOption ? selectedOption.text.trim() : 'Non précisé';
            const emotionLevel = emotionLevelInput ? parseInt(emotionLevelInput.value || '5', 10) : 5;
            const activity = activityInput ? (activityInput.value || '').trim() : '';
            const note = noteInput ? (noteInput.value || '').trim() : '';

            adviceButton.disabled = true;
            adviceButton.textContent = 'Génération...';
            adviceBox.textContent = 'Analyse en cours...';

            try {
                const response = await fetch(adviceUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({
                        mood: mood,
                        emotionLevel: Number.isNaN(emotionLevel) ? 5 : emotionLevel,
                        activity: activity,
                        note: note
                    })
                });
                const data = await response.json();
                adviceBox.textContent = data.advice || 'Aucun conseil généré.';
            } catch (error) {
                adviceBox.textContent = 'Erreur: impossible de récupérer le conseil IA.';
            } finally {
                adviceButton.disabled = false;
                adviceButton.textContent = '+ IA Conseil';
            }
        });
    }

    function currentMood() {
        const selectedOption = moodSelect && moodSelect.selectedIndex >= 0 ? moodSelect.options[moodSelect.selectedIndex] : null;
        const moodFromSelect = selectedOption ? selectedOption.text.trim() : '';
        if (moodFromSelect && moodFromSelect !== 'Choisir…' && moodFromSelect !== 'Choisir...') {
            return moodFromSelect;
        }

        const firstMoodCell = document.querySelector('.mental-entries-table tbody tr td:first-child');
        const moodFromList = firstMoodCell ? firstMoodCell.textContent.trim() : '';
        return moodFromList && moodFromList !== 'Aucune entry.' ? moodFromList : '';
    }

    async function fetchMediaByMood() {
        const mood = currentMood();
        if (!mood || mood === 'Choisir…') {
            if (spotifyResults) spotifyResults.textContent = 'Choisis d’abord un mood.';
            if (youtubeResults) youtubeResults.textContent = 'Choisis d’abord un mood.';
            return false;
        }

        try {
            const response = await fetch(mediaUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ mood: mood })
            });
            const data = await response.json();
            latestSpotify = Array.isArray(data.spotify) ? data.spotify : [];
            latestYoutube = Array.isArray(data.youtube) ? data.youtube : [];
            return true;
        } catch (error) {
            if (spotifyResults) spotifyResults.textContent = 'Erreur Spotify.';
            if (youtubeResults) youtubeResults.textContent = 'Erreur YouTube.';
            return false;
        }
    }

    if (spotifyButton) {
        spotifyButton.addEventListener('click', async function () {
            spotifyButton.disabled = true;
            spotifyButton.textContent = 'Chargement...';
            if (spotifyResults) spotifyResults.textContent = 'Chargement Spotify...';

            const ok = await fetchMediaByMood();
            if (ok && spotifyResults) {
                spotifyResults.innerHTML = latestSpotify.length
                    ? latestSpotify.map(item => '<div class="py-1 media-item" data-url="' + item.url + '">' + item.title + ' — ' + item.artist + '</div>').join('')
                    : 'Aucune suggestion Spotify.';
            }

            spotifyButton.disabled = false;
            spotifyButton.textContent = 'Spotify';
        });
    }

    if (youtubeButton) {
        youtubeButton.addEventListener('click', async function () {
            youtubeButton.disabled = true;
            youtubeButton.textContent = 'Chargement...';
            if (youtubeResults) youtubeResults.textContent = 'Chargement YouTube...';

            const ok = await fetchMediaByMood();
            if (ok && youtubeResults) {
                youtubeResults.innerHTML = latestYoutube.length
                    ? latestYoutube.map(item => '<div class="py-1 media-item" data-url="' + item.url + '">' + item.title + ' — ' + item.channel + '</div>').join('')
                    : 'Aucune suggestion YouTube.';
            }

            youtubeButton.disabled = false;
            youtubeButton.textContent = 'YouTube';
        });
    }

    document.addEventListener('dblclick', function (event) {
        const target = event.target;
        if (!(target instanceof HTMLElement) || !target.classList.contains('media-item')) {
            return;
        }
        const url = target.dataset.url || '';
        if (url) {
            window.open(url, '_blank', 'noopener');
        }
    });

    if (addSpotifyNoteButton) {
        addSpotifyNoteButton.addEventListener('click', function () {
            if (!noteInput) return;
            const lines = latestSpotify.slice(0, 3).map(item => item.title + ' - ' + item.artist + ' (' + item.url + ')');
            if (!lines.length) return;
            noteInput.value = (noteInput.value ? noteInput.value + '\n' : '') + 'Spotify:\n' + lines.join('\n');
        });
    }

    if (addYoutubeNoteButton) {
        addYoutubeNoteButton.addEventListener('click', function () {
            if (!noteInput) return;
            const lines = latestYoutube.slice(0, 3).map(item => item.title + ' (' + item.url + ')');
            if (!lines.length) return;
            noteInput.value = (noteInput.value ? noteInput.value + '\n' : '') + 'YouTube:\n' + lines.join('\n');
        });
    }
});
</script>
{% endblock %}
