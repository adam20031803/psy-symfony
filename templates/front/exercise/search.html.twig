{% extends 'front/base.html.twig' %}

{% block title %}Recherche : "{{ query }}" — FitLife{% endblock %}

{% block fitness_content %}

{# ---- Search Header ---- #}
<div style="background:linear-gradient(135deg,#1d4ed8,#0891b2);color:#fff;padding:48px 0 40px;">
    <div class="container">
        <h1 class="fw-bold mb-3">🔍 Recherche</h1>
        <form action="{{ path('front_exercise_search') }}" method="GET" class="d-flex gap-2" style="max-width:500px;">
            <input type="text" name="q" value="{{ query }}"
                   class="form-control form-control-lg"
                   style="border-radius:12px;border:none;"
                   placeholder="Ex: Squat, Yoga, Cardio...">
            <button type="submit" class="btn btn-lg px-4 fw-semibold"
                    style="background:#fff;color:#1d4ed8;border-radius:12px;white-space:nowrap;">
                <i class="bi bi-search me-1"></i>Chercher
            </button>
        </form>
    </div>
</div>

<div class="container py-5">
    {% if query %}
        <h5 class="mb-4 fw-semibold" style="color:#374151;">
            {% if results|length > 0 %}
                <i class="bi bi-check-circle-fill text-success me-2"></i>
                {{ results|length }} résultat(s) pour "<strong>{{ query }}</strong>"
            {% else %}
                <i class="bi bi-x-circle-fill text-danger me-2"></i>
                Aucun résultat pour "<strong>{{ query }}</strong>"
            {% endif %}
        </h5>
    {% else %}
        <p class="text-muted mb-4">Utilisez la barre de recherche ci-dessus pour trouver un exercice.</p>
    {% endif %}

    {% if results|length > 0 %}
        <div class="row g-4">
            {% for exercise in results %}
                <div class="col-md-6 col-lg-4">
                    <div class="fit-card h-100">
                        {% if exercise.imageUrl %}
                            <img src="{{ exercise.imageUrl }}" alt="{{ exercise.name }}"
                                 class="card-img-top" style="height:180px;object-fit:cover;">
                        {% else %}
                            <div class="img-placeholder" style="height:180px;">
                                <i class="bi bi-activity"></i>
                            </div>
                        {% endif %}
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge" style="background:#eff6ff;color:#2563eb;">{{ exercise.category }}</span>
                                {% if exercise.difficulty == 'Débutant' %}
                                    <span class="badge bg-success">{{ exercise.difficulty }}</span>
                                {% elseif exercise.difficulty == 'Intermédiaire' %}
                                    <span class="badge bg-warning text-dark">{{ exercise.difficulty }}</span>
                                {% else %}
                                    <span class="badge bg-danger">{{ exercise.difficulty }}</span>
                                {% endif %}
                            </div>
                            <h6 class="fw-bold mb-1" style="color:#0f172a;">{{ exercise.name }}</h6>
                            <p class="text-muted mb-3 flex-grow-1" style="font-size:0.82rem;">
                                {{ exercise.description|length > 90 ? exercise.description|slice(0,90) ~ '…' : exercise.description }}
                            </p>
                            <div class="d-flex gap-3 mb-3" style="font-size:0.78rem;color:#64748b;">
                                <span><i class="bi bi-clock me-1 text-primary"></i>{{ exercise.duration }} min</span>
                                <span><i class="bi bi-fire me-1 text-danger"></i>{{ exercise.calories }} kcal</span>
                            </div>
                            <a href="{{ path('front_exercise_show', {id: exercise.id}) }}"
                               class="btn btn-outline-primary btn-sm w-100">
                                Voir l'exercice <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% elseif query %}
        {# No results — suggest categories #}
        <div class="text-center py-4">
            <i class="bi bi-search display-4 text-muted d-block mb-3"></i>
            <p class="text-muted mb-3">Essayez avec un autre mot-clé ou parcourez nos catégories :</p>
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                {% for cat in ['Cardio','Musculation','Yoga','HIIT','Flexibilité'] %}
                    <a href="{{ path('front_exercise_list') }}?category={{ cat }}"
                       class="category-pill">{{ cat }}</a>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
