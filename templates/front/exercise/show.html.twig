{% extends 'front/base.html.twig' %}

{% block title %}{{ exercise.name }} — FitLife{% endblock %}
{% block meta_description %}{{ exercise.description|slice(0,150) }}{% endblock %}

{% block fitness_content %}

{# ---- Breadcrumb ---- #}
<div style="border-bottom:1px solid rgba(255,255,255,0.08); padding:12px 0; margin-bottom: 32px;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0" style="font-size:0.85rem;">
            <li class="breadcrumb-item"><a href="{{ path('front_home') }}" style="color: #64748b; text-decoration:none;">Accueil</a></li>
            <li class="breadcrumb-item"><a href="{{ path('front_exercise_list') }}" style="color: #64748b; text-decoration:none;">Exercices</a></li>
            <li class="breadcrumb-item active" style="color: #e2e8f0;">{{ exercise.name }}</li>
        </ol>
    </nav>
</div>

<div class="py-2">
    <div class="row g-5">

        {# ---- LEFT: Image ---- #}
        <div class="col-lg-5">
            <div style="position:sticky;top:80px;">
                <div class="fit-card p-2 mb-4">
                    {% if exercise.imageUrl %}
                        <img src="{{ exercise.imageUrl }}" alt="{{ exercise.name }}"
                             class="img-fluid rounded-3 w-100"
                             style="object-fit:cover;max-height:400px;">
                    {% else %}
                        <div class="img-placeholder rounded-3" style="height:350px;font-size:6rem;background: rgba(255,255,255,0.02)">
                            <i class="bi bi-activity"></i>
                        </div>
                    {% endif %}
                </div>

                {# Stat badges below image #}
                <div class="row g-3">
                    <div class="col-4">
                        <div class="stat-badge w-100" style="padding: 14px 10px;">
                            <div class="stat-val" style="font-size:1.2rem; margin-bottom: 4px;"><i class="bi bi-clock-fill text-primary"></i></div>
                            <div class="stat-val fw-bold" style="font-size:1rem; color: #e2e8f0;">{{ exercise.duration }}</div>
                            <div class="stat-lab" style="font-size:0.65rem;">min</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-badge w-100" style="padding: 14px 10px;">
                            <div class="stat-val" style="font-size:1.2rem; margin-bottom: 4px; color:#ef4444;"><i class="bi bi-fire"></i></div>
                            <div class="stat-val fw-bold" style="font-size:1rem; color: #e2e8f0;">{{ exercise.calories }}</div>
                            <div class="stat-lab" style="font-size:0.65rem;">kcal</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-badge w-100" style="padding: 14px 10px;">
                            {% if exercise.difficulty == 'Débutant' %}
                                <div class="stat-val" style="color:#22d3a5;font-size:1.2rem; margin-bottom: 4px;">😊</div>
                            {% elseif exercise.difficulty == 'Intermédiaire' %}
                                <div class="stat-val" style="color:#f59e0b;font-size:1.2rem; margin-bottom: 4px;">💪</div>
                            {% else %}
                                <div class="stat-val" style="color:#ff4d6d;font-size:1.2rem; margin-bottom: 4px;">🔥</div>
                            {% endif %}
                            <div class="stat-val fw-bold" style="font-size:0.8rem; color: #e2e8f0;">{{ exercise.difficulty }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ---- RIGHT: Details ---- #}
        <div class="col-lg-7">
            {# Category + Difficulty tags #}
            <div class="d-flex gap-2 mb-3">
                <span class="badge" style="background:rgba(59,130,246,0.15);color:#60a5fa;font-size:0.8rem;padding:6px 12px;border: 1px solid rgba(59,130,246,0.25);">
                    <i class="bi bi-tag me-1"></i>{{ exercise.category }}
                </span>
                {% if exercise.difficulty == 'Débutant' %}
                    <span class="badge bg-success" style="font-size:0.8rem;padding:6px 12px;opacity: 0.85;">{{ exercise.difficulty }}</span>
                {% elseif exercise.difficulty == 'Intermédiaire' %}
                    <span class="badge bg-warning" style="font-size:0.8rem;padding:6px 12px;opacity: 0.85;">{{ exercise.difficulty }}</span>
                {% else %}
                    <span class="badge bg-danger" style="font-size:0.8rem;padding:6px 12px;opacity: 0.85;">{{ exercise.difficulty }}</span>
                {% endif %}
            </div>

            <h1 class="fw-bold mb-3 text-white" style="font-size:2rem;letter-spacing:-0.5px;">
                {{ exercise.name }}
            </h1>

            <div style="font-size:1rem;line-height:1.7;color:#94a3b8;margin-bottom:32px;">
                {{ exercise.description|nl2br }}
            </div>

            {# Details list #}
            <div class="fit-card p-4 mb-4 text-white">
                <h6 class="fw-bold mb-4 text-white" style="font-size:0.85rem;text-transform:uppercase;letter-spacing:0.5px; margin-top:0;">
                    Caractéristiques
                </h6>
                <div class="row g-4">
                    <div class="col-6">
                        <div style="font-size:0.75rem;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">Catégorie</div>
                        <div class="fw-semibold">{{ exercise.category }}</div>
                    </div>
                    <div class="col-6">
                        <div style="font-size:0.75rem;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">Difficulté</div>
                        <div class="fw-semibold">{{ exercise.difficulty }}</div>
                    </div>
                    <div class="col-6">
                        <div style="font-size:0.75rem;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">
                            <i class="bi bi-clock me-1"></i>Durée
                        </div>
                        <div class="fw-semibold">{{ exercise.duration }} minutes</div>
                    </div>
                    <div class="col-6">
                        <div style="font-size:0.75rem;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">
                            <i class="bi bi-fire me-1 text-danger"></i>Calories
                        </div>
                        <div class="fw-semibold">{{ exercise.calories }} kcal</div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 flex-wrap mt-4">
                <a href="{{ path('front_exercise_list') }}?category={{ exercise.category }}"
                   class="btn btn-outline-primary">
                    <i class="bi bi-tag me-1"></i>Plus de {{ exercise.category }}
                </a>
                <a href="{{ path('front_exercise_list') }}" class="btn" style="background: rgba(255,255,255,0.05); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.1);">
                    <i class="bi bi-arrow-left me-1"></i>Tous les exercices
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
