<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mes Réclamations — Atomic You</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg:      #0d0f1a;
            --surface: #141627;
            --card:    #1a1d30;
            --border:  rgba(255,255,255,0.07);
            --accent:  #6c63ff;
            --accent2: #00d2ff;
            --success: #22d3a5;
            --warning: #f59e0b;
            --danger:  #f87171;
            --text:    #e2e8f0;
            --muted:   #64748b;
            --radius:  16px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }
        body::before {
            content: '';
            position: fixed; inset: 0; z-index: 0; pointer-events: none;
            background:
                radial-gradient(ellipse 60% 40% at 20% 10%, rgba(108,99,255,.12) 0%, transparent 70%),
                radial-gradient(ellipse 50% 35% at 80% 80%, rgba(0,210,255,.08) 0%, transparent 70%);
        }

        /* ── Navbar ── */
        nav {
            position: sticky; top: 0; z-index: 100;
            background: rgba(20,22,39,.85);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--border);
            padding: 0 40px; height: 64px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .nav-logo { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.15rem; text-decoration: none; color: var(--text); }
        .nav-logo .icon { width: 36px; height: 36px; background: linear-gradient(135deg, var(--accent), var(--accent2)); border-radius: 10px; display: flex; align-items: center; justify-content: center; }
        .nav-logo span { color: var(--accent2); }
        .nav-actions { display: flex; align-items: center; gap: 14px; }
        .nav-user { display: flex; align-items: center; gap: 10px; background: var(--card); border: 1px solid var(--border); border-radius: 999px; padding: 6px 16px 6px 6px; }
        .nav-avatar { width: 30px; height: 30px; background: linear-gradient(135deg, var(--accent), #ec4899); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.75rem; }
        .nav-name { font-size: 0.83rem; font-weight: 500; }
        .btn-nav { text-decoration: none; color: var(--muted); font-size: 0.82rem; font-weight: 500; padding: 7px 14px; border-radius: 8px; border: 1px solid var(--border); transition: all .2s; }
        .btn-nav:hover { color: var(--text); border-color: rgba(255,255,255,.15); background: var(--card); }

        /* ── Page ── */
        .page { position: relative; z-index: 1; max-width: 900px; margin: 0 auto; padding: 48px 32px 80px; }

        /* ── Breadcrumb ── */
        .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--muted); margin-bottom: 28px; }
        .breadcrumb a { color: var(--accent); text-decoration: none; }
        .breadcrumb a:hover { text-decoration: underline; }
        .breadcrumb span { opacity: .4; }

        /* ── Top bar ── */
        .top-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; gap: 16px; flex-wrap: wrap; }
        .page-title h1 { font-size: 1.7rem; font-weight: 700; margin-bottom: 4px; }
        .page-title h1 span { background: linear-gradient(90deg, var(--accent), var(--accent2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .page-title p { color: var(--muted); font-size: 0.85rem; }
        .btn-new {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 12px 22px;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            border: none; border-radius: 12px;
            color: #fff; font-size: 0.88rem; font-weight: 600;
            text-decoration: none; cursor: pointer;
            transition: opacity .2s, transform .15s;
            box-shadow: 0 4px 16px rgba(108,99,255,.3);
            white-space: nowrap;
        }
        .btn-new:hover { opacity: .88; transform: translateY(-1px); }

        /* ── Flash ── */
        .alert { border-radius: 12px; padding: 14px 18px; font-size: 0.85rem; margin-bottom: 24px; display: flex; align-items: flex-start; gap: 10px; }
        .alert-success { background: rgba(34,211,165,.1); border: 1px solid rgba(34,211,165,.3); color: var(--success); }

        /* ── Empty state ── */
        .empty-state {
            text-align: center; padding: 80px 40px;
            background: var(--card); border: 1px solid var(--border); border-radius: 20px;
        }
        .empty-state .emoji { font-size: 4rem; margin-bottom: 20px; display: block; }
        .empty-state h2 { font-size: 1.2rem; font-weight: 600; margin-bottom: 10px; }
        .empty-state p { color: var(--muted); font-size: 0.85rem; margin-bottom: 28px; }

        /* ── Stats row ── */
        .stats-row { display: flex; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
        .stat-card {
            flex: 1; min-width: 140px;
            background: var(--card); border: 1px solid var(--border); border-radius: 14px;
            padding: 20px; display: flex; align-items: center; gap: 14px;
        }
        .stat-icon { width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
        .si-total   { background: rgba(108,99,255,.15); }
        .si-ouvert  { background: rgba(245,158,11,.12); }
        .si-resolu  { background: rgba(34,211,165,.12); }
        .stat-label { font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px; }
        .stat-value { font-size: 1.4rem; font-weight: 700; }

        /* ── Reclamation list ── */
        .rec-list { display: flex; flex-direction: column; gap: 14px; }

        .rec-card {
            background: var(--card); border: 1px solid var(--border); border-radius: 16px;
            padding: 22px 26px;
            transition: border-color .2s, box-shadow .2s;
        }
        .rec-card:hover { border-color: rgba(108,99,255,.3); box-shadow: 0 8px 24px rgba(0,0,0,.25); }

        .rec-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
        .rec-sujet { font-size: 1rem; font-weight: 600; flex: 1; }
        .badge {
            display: inline-flex; align-items: center; gap: 5px;
            font-size: 0.72rem; font-weight: 600;
            padding: 4px 12px; border-radius: 999px;
            white-space: nowrap; flex-shrink: 0;
        }
        .badge-ouvert   { background: rgba(245,158,11,.15);  color: var(--warning); border: 1px solid rgba(245,158,11,.3); }
        .badge-en_cours { background: rgba(0,210,255,.12);   color: var(--accent2); border: 1px solid rgba(0,210,255,.3); }
        .badge-resolu   { background: rgba(34,211,165,.12);  color: var(--success); border: 1px solid rgba(34,211,165,.3); }
        .badge-ferme    { background: rgba(100,116,139,.12); color: var(--muted);   border: 1px solid rgba(100,116,139,.3); }

        .rec-desc { font-size: 0.83rem; color: var(--muted); line-height: 1.6; margin-bottom: 14px; white-space: pre-wrap; word-break: break-word; }
        .rec-meta { display: flex; align-items: center; gap: 16px; font-size: 0.75rem; color: var(--muted); flex-wrap: wrap; }
        .rec-meta span { display: flex; align-items: center; gap: 4px; }
    </style>
</head>
<body>

<!-- Navbar -->
<nav>
    <a href="{{ path('app_dashboard') }}" class="nav-logo">
        <div class="icon">🧠</div>
        <div><strong>Atomic</strong><span>You</span></div>
    </a>
    <div class="nav-actions">
        <div class="nav-user">
            <div class="nav-avatar">{{ user.prenom|slice(0,1)|upper }}{{ user.nom|slice(0,1)|upper }}</div>
            <span class="nav-name">{{ user.prenom }}</span>
        </div>
        <a href="{{ path('app_logout') }}" class="btn-nav">🚪 Déconnexion</a>
    </div>
</nav>

<div class="page">

    <!-- Breadcrumb -->
    <div class="breadcrumb">
        <a href="{{ path('app_dashboard') }}">🏠 Accueil</a>
        <span>›</span>
        Mes réclamations
    </div>

    <!-- Top bar -->
    <div class="top-bar">
        <div class="page-title">
            <h1>📬 Mes <span>Réclamations</span></h1>
            <p>Suivez l'état de vos demandes et signalez de nouveaux problèmes.</p>
        </div>
        <a href="{{ path('app_reclamation_new') }}" class="btn-new">➕ Nouvelle réclamation</a>
    </div>

    <!-- Flash -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">✅ {{ message }}</div>
    {% endfor %}

    {% if reclamations|length > 0 %}

        {# Stats #}
        {% set total   = reclamations|length %}
        {% set ouverts = reclamations|filter(r => r.statut == 'ouvert')|length %}
        {% set resolus = reclamations|filter(r => r.statut == 'resolu')|length %}

        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon si-total">📊</div>
                <div>
                    <div class="stat-label">Total</div>
                    <div class="stat-value">{{ total }}</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon si-ouvert">⏳</div>
                <div>
                    <div class="stat-label">En attente</div>
                    <div class="stat-value">{{ ouverts }}</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon si-resolu">✅</div>
                <div>
                    <div class="stat-label">Résolues</div>
                    <div class="stat-value">{{ resolus }}</div>
                </div>
            </div>
        </div>

        {# List #}
        <div class="rec-list">
            {% for rec in reclamations %}
                <div class="rec-card">
                    <div class="rec-header">
                        <div class="rec-sujet">{{ rec.sujet }}</div>
                        {% set s = rec.statut %}
                        <span class="badge badge-{{ s }}">
                            {% if s == 'ouvert' %}⏳ Ouvert
                            {% elseif s == 'en_cours' %}🔄 En cours
                            {% elseif s == 'resolu' %}✅ Résolu
                            {% else %}🔒 Fermé
                            {% endif %}
                        </span>
                    </div>
                    <div class="rec-desc">{{ rec.description }}</div>
                    <div class="rec-meta">
                        <span>📅 {{ rec.createdAt|date('d/m/Y à H:i') }}</span>
                        <span>🆔 #{{ rec.id }}</span>
                        {% if rec.updatedAt %}
                            <span>🔄 Mis à jour le {{ rec.updatedAt|date('d/m/Y') }}</span>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

    {% else %}

        <!-- Empty state -->
        <div class="empty-state">
            <span class="emoji">📭</span>
            <h2>Aucune réclamation pour l'instant</h2>
            <p>Vous n'avez pas encore soumis de réclamation.<br>Si vous avez un problème, n'hésitez pas à nous contacter.</p>
            <a href="{{ path('app_reclamation_new') }}" class="btn-new">➕ Soumettre une réclamation</a>
        </div>

    {% endif %}

</div>

</body>
</html>
