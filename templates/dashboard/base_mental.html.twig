{% extends is_granted('ROLE_ADMIN') ? 'admin/base.html.twig' : 'base.html.twig' %}

{% block title %}Santé Mentale — Atomic You{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root {
            --grad-purple-start: #6366f1;
            --grad-purple-end: #7c3aed;
            --grad-green-start: #10b981;
            --grad-green-end: #22c55e;
            --grad-red-start: #ef4444;
            --grad-red-end: #f97316;
            --btn-primary: #4f46e5;
            --btn-primary-hover: #4338ca;
            --btn-pink: #ec4899;
            --btn-pink-hover: #db2777;
            --btn-danger: #ef4444;
            --btn-danger-hover: #dc2626;
            --btn-gray: #6b7280;
            --btn-gray-hover: #4b5563;
            --icon-btn-bg: #e5e7eb;
            --icon-btn-border: #d1d5db;
            --error-border: #ef4444;
            --subtitle-gray: #6b7280;
            --label-dark: #111827;
            --bg-dark: #0f172a;
            --card-radius: 14px;
            --field-radius: 12px;
            --btn-radius: 12px;
            --card-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
            --btn-shadow-hover: 0 8px 20px rgba(0, 0, 0, 0.18);
            --btn-shadow-active: 0 2px 8px rgba(0, 0, 0, 0.12);
        }
        
        .container-mental {
            max-width: 1400px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .page-header-mental {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border);
        }

        .page-title-mental {
            font-size: 1.8rem;
            font-weight: 700;
            background: linear-gradient(90deg, var(--accent), var(--accent2));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .dashboard-root {
            display: flex;
            flex-flow: row wrap;
            align-items: flex-start;
            align-content: flex-start;
            gap: 1.25rem;
        }
        .panel-table, .panel-form {
            background: #ffffff;
            color: #1f2937;
            border-radius: var(--card-radius);
            box-shadow: var(--card-shadow);
        }
        .panel-table { padding: 15px; flex: 1 1 62%; min-width: min(100%, 320px); }
        .panel-form { padding: 18px; flex: 0 1 34%; min-width: min(100%, 300px); max-width: 420px; }
        
        .panel-table h2.h5 { font-size: 16px; font-weight: 700; }
        .panel-table .text-muted.small { font-size: 12px; color: var(--subtitle-gray) !important; }
        .panel-form h3.h6 { font-size: 18px; font-weight: 700; }
        .panel-form p.text-muted.small { font-size: 12px; color: var(--subtitle-gray) !important; }
        .panel-form .form-label { font-weight: 700; color: var(--label-dark); }
        
        .data-table { width: 100%; font-size: 0.875rem; }
        .data-table thead th {
            font-size: 0.72rem;
            text-transform: uppercase;
            color: #475569;
            background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
            border-bottom: 1px solid #e2e8f0;
        }
        
        .btn-export-pdf, .btn-form-add, .btn-form-modify, .btn-form-danger, .btn-form-reset {
            font-weight: 700;
            border-radius: var(--btn-radius);
            transition: all 0.2s ease;
        }
        .btn-form-add { background: var(--btn-primary); color: #fff; }
        .btn-form-add:hover { background: var(--btn-primary-hover); color: #fff; }
        .btn-form-modify { background: var(--btn-pink); color: #fff; }
        .btn-form-modify:hover { background: var(--btn-pink-hover); color: #fff; }
        .btn-form-danger { background: linear-gradient(to right, var(--grad-red-start), var(--grad-red-end)) !important; border: none !important; color: #fff !important; }
        .btn-form-reset { background: var(--btn-gray) !important; color: #fff !important; }

        .nav-pill {
            display: inline-flex;
            align-items: center;
            padding: 8px 16px;
            border-radius: 999px;
            font-weight: 600;
            font-size: 0.875rem;
            color: #fff !important;
            text-decoration: none;
            transition: all 0.2s ease;
            background: var(--surface);
            border: 1px solid var(--border);
        }
        
        .nav-pill:hover {
            transform: translateY(-2px);
            opacity: 0.9;
        }
        
        .nav-pill.active {
            box-shadow: 0 0 0 3px rgba(108,99,255,0.4);
            border-color: var(--accent);
        }
        
        .nav-pill.moods { background: linear-gradient(135deg, #6c63ff, #00d2ff); }
        .nav-pill.tips { background: linear-gradient(135deg, #ec4899, #f97316); }
        .nav-pill.entries { background: linear-gradient(135deg, #22d3a5, #00d2ff); }
    </style>
{% endblock %}

{% block body %}
{% if not is_granted('ROLE_ADMIN') %}
<div class="container-mental">
    <div class="page-header-mental">
        <h1 class="page-title-mental" style="margin: 0;">
            <span style="font-size: 2.2rem; margin-right: 10px;">🧠</span> Santé Mentale
        </h1>
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
            <a href="{{ path('app_mental_tip_index') }}" class="nav-pill tips {{ active_section|default('') == 'tips' ? 'active' : '' }}">Mental Tips</a>
            <a href="{{ path('app_mental_entry_index') }}" class="nav-pill entries {{ active_section|default('') == 'entries' ? 'active' : '' }}">Mental Entries</a>
        </div>
    </div>
    
    <div class="px-3 pt-2">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show py-2" role="alert">{{ message }}</div>
            {% endfor %}
        {% endfor %}
    </div>

    <div class="dashboard-root">
        {% block dashboard_main %}{% endblock %}
    </div>
</div>
{% endif %}
{% endblock %}

{% block content %}
{% if is_granted('ROLE_ADMIN') %}
<div class="container-mental">
    <div class="page-header-mental">
        <h1 class="page-title-mental" style="margin: 0;">
            <span style="font-size: 2.2rem; margin-right: 10px;">🧠</span> Santé Mentale
        </h1>
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
            <a href="{{ path('app_mood_index') }}" class="nav-pill moods {{ active_section|default('') == 'moods' ? 'active' : '' }}">Moods</a>
            <a href="{{ path('app_mental_tip_index') }}" class="nav-pill tips {{ active_section|default('') == 'tips' ? 'active' : '' }}">Mental Tips</a>
            <a href="{{ path('app_mental_entry_index') }}" class="nav-pill entries {{ active_section|default('') == 'entries' ? 'active' : '' }}">Mental Entries</a>
        </div>
    </div>
    
    <div class="px-3 pt-2">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show py-2" role="alert">{{ message }}</div>
            {% endfor %}
        {% endfor %}
    </div>

    <div class="dashboard-root">
        {% block dashboard_main_admin %}{{ block('dashboard_main') }}{% endblock %}
    </div>
</div>
{% endif %}
{% endblock %}
