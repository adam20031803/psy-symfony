<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Atomic You{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        /* Équivalent web de la feuille JavaFX (cartes, couleurs, boutons) */
        :root {
            --grad-purple-start: #6366f1;
            --grad-purple-end: #7c3aed;
            --grad-green-start: #10b981;
            --grad-green-end: #22c55e;
            --grad-red-start: #ef4444;
            --grad-red-end: #f97316;
            --btn-primary: #4f46e5;
            --btn-primary-hover: #4338ca;
            --btn-pink: #ec4899;
            --btn-pink-hover: #db2777;
            --btn-danger: #ef4444;
            --btn-danger-hover: #dc2626;
            --btn-gray: #6b7280;
            --btn-gray-hover: #4b5563;
            --icon-btn-bg: #e5e7eb;
            --icon-btn-border: #d1d5db;
            --error-border: #ef4444;
            --subtitle-gray: #6b7280;
            --label-dark: #111827;
            --bg-dark: #0f172a;
            --bg-sidebar: #1e293b;
            --card-radius: 14px;
            --field-radius: 12px;
            --btn-radius: 12px;
            --card-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
            --btn-shadow-hover: 0 8px 20px rgba(0, 0, 0, 0.18);
            --btn-shadow-active: 0 2px 8px rgba(0, 0, 0, 0.12);
        }
        body { background: var(--bg-dark); min-height: 100vh; color: #fff; }
        .dash-top {
            background: linear-gradient(to right, var(--grad-purple-start), var(--grad-purple-end));
            padding: 0.85rem 1.5rem;
            box-shadow: 0 2px 12px rgba(0,0,0,.35);
        }
        .dash-top .dash-subtitle { font-size: 0.8rem; opacity: 0.92; margin-top: 0.15rem; }
        .dash-search {
            min-width: 200px;
            max-width: 280px;
            border: none;
            font-size: 0.875rem;
            border-radius: var(--field-radius);
        }
        .dash-search-btn {
            background: linear-gradient(to right, var(--grad-green-start), var(--grad-green-end));
            border: none;
            color: #fff;
            padding-left: 1rem;
            padding-right: 1rem;
            border-radius: var(--btn-radius);
            font-weight: 700;
            transition: transform 0.18s ease, box-shadow 0.2s ease, filter 0.15s ease;
        }
        .dash-search-btn:hover {
            color: #fff;
            filter: brightness(1.05);
            transform: translateY(-2px);
            box-shadow: var(--btn-shadow-hover);
        }
        .dash-search-btn:active {
            transform: translateY(0);
            box-shadow: var(--btn-shadow-active);
        }
        .dash-shell { display: flex; min-height: calc(100vh - 88px); }
        .dash-sidebar {
            width: 220px; flex-shrink: 0; padding: 1.25rem 1rem;
            background: var(--bg-sidebar); border-right: 1px solid rgba(255,255,255,.08);
        }
        .dash-sidebar h2 { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: #9ca3af; margin: 0 0 1rem; }
        .nav-pill {
            display: flex; align-items: center; gap: 0.6rem; padding: 0.75rem 1rem; margin-bottom: 0.65rem;
            border-radius: 999px; font-weight: 600; font-size: 0.875rem; color: #fff; text-decoration: none;
            transition: transform 0.15s ease, box-shadow 0.2s ease;
        }
        .nav-pill:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(0,0,0,.2); color: #fff; }
        .nav-pill.moods { background: linear-gradient(to right, var(--grad-purple-start), var(--grad-purple-end)); }
        .nav-pill.tips { background: linear-gradient(to right, #f472b6, var(--btn-pink)); }
        .nav-pill.entries { background: linear-gradient(to right, #22d3ee, #0ea5e9); }
        .nav-pill.active { box-shadow: 0 0 0 3px rgba(255,255,255,.25); }
        .dashboard-root {
            padding: 10px;
            flex: 1;
            display: flex;
            flex-flow: row wrap;
            align-items: flex-start;
            align-content: flex-start;
            gap: 1.25rem;
        }
        .panel-table, .panel-form {
            background: #ffffff;
            color: #1f2937;
            border-radius: var(--card-radius);
            box-shadow: var(--card-shadow);
        }
        .panel-table { padding: 15px; }
        .panel-form { padding: 18px; }
        .dashboard-root > .panel-table {
            flex: 1 1 62%;
            min-width: min(100%, 320px);
        }
        .dashboard-root > .panel-form {
            flex: 0 1 34%;
            min-width: min(100%, 300px);
            max-width: 420px;
        }
        /* Titres type card-title / form-title */
        .panel-table h2.h5 {
            font-size: 16px;
            font-weight: 700;
        }
        .panel-table > .d-flex.mb-3 .text-muted.small,
        .panel-table .text-muted.small.mb-0 {
            font-size: 12px;
            color: var(--subtitle-gray) !important;
        }
        .panel-form h3.h6 {
            font-size: 18px;
            font-weight: 700;
        }
        .panel-form > p.text-muted.small {
            font-size: 12px;
            color: var(--subtitle-gray) !important;
        }
        .panel-form .form-label {
            font-weight: 700;
            color: var(--label-dark);
        }
        /* Bouton icône (engrenage) type icon-btn */
        .panel-table .btn-light.border.btn-sm.text-secondary {
            background: var(--icon-btn-bg) !important;
            border-color: var(--icon-btn-border) !important;
            border-radius: var(--btn-radius);
            font-weight: 700;
            transition: transform 0.15s ease, box-shadow 0.2s ease;
        }
        .panel-table .btn-light.border.btn-sm.text-secondary:hover {
            background: #d1d5db !important;
            transform: translateY(-1px);
            box-shadow: var(--btn-shadow-active);
        }
        .data-table { width: 100%; font-size: 0.875rem; }
        .data-table thead th {
            font-size: 0.72rem;
            text-transform: uppercase;
            color: #475569;
            background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
            border-bottom: 1px solid #e2e8f0;
        }
        .panel-table .btn-outline-primary {
            color: var(--btn-primary);
            border-color: var(--btn-primary);
            border-radius: var(--btn-radius);
            font-weight: 700;
            transition: transform 0.15s ease, box-shadow 0.2s ease, background 0.15s ease;
        }
        .panel-table .btn-outline-primary:hover {
            background: var(--btn-primary);
            border-color: var(--btn-primary);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.35);
        }
        /* Champ en erreur (équivalent .error-field) */
        .panel-form .form-control.is-invalid,
        .panel-form .form-select.is-invalid,
        .panel-form textarea.is-invalid {
            border-color: var(--error-border) !important;
            border-width: 2px;
            border-radius: var(--field-radius);
        }
        /* Texte d’erreur sous le champ (après soumission uniquement — pas d’erreurs au chargement) */
        .panel-form .invalid-feedback,
        .panel-form .form-error-message {
            display: block;
            color: var(--error-border);
            font-size: 11px;
            font-weight: 600;
            margin-top: 0.35rem;
        }
        .panel-form ul.form-error-list {
            margin: 0.35rem 0 0;
            padding-left: 1rem;
            color: var(--error-border);
            font-size: 11px;
        }
        .panel-form .form-control,
        .panel-form .form-select {
            border-color: #d1d5db;
            border-radius: var(--field-radius);
        }
        .panel-form .form-control:focus,
        .panel-form .form-select:focus {
            border-color: var(--btn-primary);
            box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.22);
        }
        /* Effets communs : Ajouter, Modifier, Supprimer, Réinitialiser, Export PDF */
        .btn-export-pdf,
        .btn-form-add,
        .btn-form-modify,
        .btn-form-danger,
        .btn-form-reset {
            font-weight: 700;
            border-radius: var(--btn-radius);
            transition: transform 0.18s ease, box-shadow 0.22s ease, filter 0.15s ease, background 0.15s ease, border-color 0.15s ease;
        }
        .btn-export-pdf {
            background: linear-gradient(135deg, #6366f1, var(--btn-primary));
            border: none;
            color: #fff;
            box-shadow: 0 2px 8px rgba(79, 70, 229, 0.35);
        }
        .btn-export-pdf:hover {
            color: #fff;
            filter: brightness(1.06);
            transform: translateY(-3px);
            box-shadow: var(--btn-shadow-hover);
        }
        .btn-export-pdf:active {
            transform: translateY(-1px);
            box-shadow: var(--btn-shadow-active);
        }
        .btn-form-add {
            background: var(--btn-primary);
            border: none;
            color: #fff;
            box-shadow: 0 2px 10px rgba(79, 70, 229, 0.4);
        }
        .btn-form-add:hover {
            background: var(--btn-primary-hover);
            color: #fff;
            transform: translateY(-3px);
            box-shadow: 0 10px 24px rgba(79, 70, 229, 0.45);
        }
        .btn-form-add:active {
            transform: translateY(-1px);
            box-shadow: var(--btn-shadow-active);
        }
        .btn-form-modify {
            background: var(--btn-pink);
            border: none;
            color: #fff;
            box-shadow: 0 2px 10px rgba(236, 72, 153, 0.35);
        }
        .btn-form-modify:hover {
            background: var(--btn-pink-hover);
            color: #fff;
            transform: translateY(-3px);
            box-shadow: 0 10px 24px rgba(236, 72, 153, 0.4);
        }
        .btn-form-modify:active {
            transform: translateY(-1px);
            box-shadow: var(--btn-shadow-active);
        }
        .btn-form-danger {
            background: linear-gradient(to right, var(--grad-red-start), var(--grad-red-end)) !important;
            border: none !important;
            color: #fff !important;
            box-shadow: 0 2px 10px rgba(239, 68, 68, 0.35);
        }
        .btn-form-danger:hover {
            filter: brightness(1.05);
            color: #fff !important;
            transform: translateY(-3px);
            box-shadow: 0 10px 24px rgba(239, 68, 68, 0.4);
        }
        .btn-form-danger:active {
            transform: translateY(-1px);
            box-shadow: var(--btn-shadow-active);
        }
        .btn-form-reset {
            background: var(--btn-gray) !important;
            border: none !important;
            color: #fff !important;
            box-shadow: 0 2px 8px rgba(107, 114, 128, 0.3);
        }
        .btn-form-reset:hover {
            background: var(--btn-gray-hover) !important;
            color: #fff !important;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(75, 85, 99, 0.35);
        }
        .btn-form-reset:active {
            transform: translateY(-1px);
            box-shadow: var(--btn-shadow-active);
        }
        .btn-form-add:disabled,
        .btn-form-modify:disabled,
        .btn-form-danger:disabled,
        .btn-form-reset:disabled {
            transform: none;
            box-shadow: none;
            opacity: 0.55;
            cursor: not-allowed;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<header class="dash-top">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1 class="h5 mb-0 fw-bold text-white">Atomic You</h1>
            <p class="dash-subtitle text-white mb-0">Système de gestion mentale (Moods / Tips / Entries)</p>
        </div>
        <form class="d-flex flex-wrap gap-2 align-items-center" action="#" method="get" role="search" aria-label="Recherche">
            <input type="search" name="q" class="form-control form-control-sm dash-search rounded-1" placeholder="Rechercher…" autocomplete="off">
            <button type="submit" class="btn btn-sm dash-search-btn rounded-1 fw-semibold">Rechercher</button>
        </form>
    </div>
</header>

<div class="px-3 pt-2">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show py-2" role="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}
</div>

<div class="dash-shell">
    <aside class="dash-sidebar">
        <h2>Actions rapides</h2>
        <a href="{{ path('app_mood_index') }}" class="nav-pill moods {{ active_section|default('') == 'moods' ? 'active' : '' }}">Moods</a>
        <a href="{{ path('app_mental_tip_index') }}" class="nav-pill tips {{ active_section|default('') == 'tips' ? 'active' : '' }}">Mental Tips</a>
        <a href="{{ path('app_mental_entry_index') }}" class="nav-pill entries {{ active_section|default('') == 'entries' ? 'active' : '' }}">Mental Entries</a>
    </aside>

    <div class="dash-main dashboard-root">
        {% block dashboard_main %}{% endblock %}
    </div>
</div>
{% block javascripts %}{% endblock %}
</body>
</html>
