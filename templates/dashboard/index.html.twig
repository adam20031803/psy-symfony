<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon Espace — PsyApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg:       #0d0f1a;
            --surface:  #141627;
            --card:     #1a1d30;
            --border:   rgba(255,255,255,0.07);
            --accent:   #6c63ff;
            --accent2:  #00d2ff;
            --success:  #22d3a5;
            --warning:  #f59e0b;
            --pink:     #ec4899;
            --text:     #e2e8f0;
            --muted:    #64748b;
            --radius:   16px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        /* ── Background glow ── */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse 60% 40% at 20% 10%, rgba(108,99,255,.12) 0%, transparent 70%),
                radial-gradient(ellipse 50% 35% at 80% 80%, rgba(0,210,255,.08) 0%, transparent 70%);
            pointer-events: none;
            z-index: 0;
        }

        /* ── Navbar ── */
        nav {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(20,22,39,.85);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--border);
            padding: 0 40px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 1.15rem;
        }
        .nav-logo .icon {
            width: 36px; height: 36px;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }
        .nav-logo span { color: var(--accent2); }
        .nav-logo strong { color: var(--text); }
        .nav-actions { display: flex; align-items: center; gap: 14px; }
        .nav-user {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 6px 16px 6px 6px;
        }
        .nav-avatar {
            width: 30px; height: 30px;
            background: linear-gradient(135deg, var(--accent), var(--pink));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.75rem;
        }
        .nav-name { font-size: 0.83rem; font-weight: 500; }
        .btn-logout {
            text-decoration: none;
            color: var(--muted);
            font-size: 0.82rem;
            font-weight: 500;
            padding: 7px 14px;
            border-radius: 8px;
            border: 1px solid var(--border);
            transition: all .2s;
        }
        .btn-logout:hover { color: var(--text); border-color: rgba(255,255,255,.15); background: var(--card); }

        /* ── Page ── */
        .page {
            position: relative;
            z-index: 1;
            max-width: 1100px;
            margin: 0 auto;
            padding: 48px 32px 80px;
        }

        /* ── Hero greeting ── */
        .hero {
            background: linear-gradient(135deg, rgba(108,99,255,.15), rgba(0,210,255,.08));
            border: 1px solid rgba(108,99,255,.25);
            border-radius: var(--radius);
            padding: 36px 40px;
            margin-bottom: 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }
        .hero-text h1 { font-size: 1.8rem; font-weight: 700; line-height: 1.3; margin-bottom: 8px; }
        .hero-text h1 span { background: linear-gradient(90deg, var(--accent), var(--accent2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .hero-text p { color: var(--muted); font-size: 0.9rem; }
        .hero-emoji { font-size: 5rem; line-height: 1; user-select: none; }

        /* ── Section ── */
        .section-title {
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 16px;
        }

        /* ── Feature grid ── */
        .feature-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 18px;
            margin-bottom: 40px;
        }
        .feature-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 24px;
            text-decoration: none;
            color: var(--text);
            transition: transform .2s, box-shadow .2s, border-color .2s;
            cursor: pointer;
        }
        .feature-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(0,0,0,.35);
            border-color: rgba(108,99,255,.3);
        }
        .feature-icon {
            width: 48px; height: 48px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            margin-bottom: 16px;
        }
        .fi-purple { background: rgba(108,99,255,.15); }
        .fi-teal   { background: rgba(0,210,255,.12); }
        .fi-green  { background: rgba(34,211,165,.12); }
        .fi-pink   { background: rgba(236,72,153,.12); }
        .fi-orange { background: rgba(245,158,11,.12); }
        .fi-blue   { background: rgba(59,130,246,.12); }
        .feature-card h3 { font-size: 0.95rem; font-weight: 600; margin-bottom: 6px; }
        .feature-card p  { font-size: 0.78rem; color: var(--muted); line-height: 1.5; }

        /* ── Mood bar ── */
        .mood-section {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 28px 30px;
        }
        .mood-section h2 { font-size: 1rem; font-weight: 600; margin-bottom: 6px; }
        .mood-section p  { font-size: 0.82rem; color: var(--muted); margin-bottom: 22px; }
        .mood-row { display: flex; gap: 14px; flex-wrap: wrap; }
        .mood-btn {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px 20px;
            text-align: center;
            cursor: pointer;
            transition: all .2s;
            flex: 1;
            min-width: 80px;
            font-family: inherit;
            color: var(--text);
        }
        .mood-btn:hover, .mood-btn.selected {
            border-color: var(--accent);
            background: rgba(108,99,255,.12);
            transform: scale(1.05);
        }
        .mood-btn .emoji { font-size: 1.8rem; display: block; margin-bottom: 6px; }
        .mood-btn span   { font-size: 0.72rem; color: var(--muted); }
        .mood-submit {
            margin-top: 18px;
            background: linear-gradient(90deg, var(--accent), var(--accent2));
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 10px 28px;
            font-family: inherit;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: opacity .2s;
        }
        .mood-submit:hover { opacity: .85; }

        /* ── Réclamations section ── */
        .rec-section {
            margin-top: 36px;
        }
        .rec-section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }
        .rec-section-header .section-title { margin-bottom: 0; }
        .btn-rec-new {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 8px 16px;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            border: none; border-radius: 10px;
            color: #fff; font-size: 0.78rem; font-weight: 600;
            text-decoration: none; cursor: pointer;
            transition: opacity .2s;
            box-shadow: 0 4px 14px rgba(108,99,255,.3);
        }
        .btn-rec-new:hover { opacity: .88; }
        .rec-empty {
            background: var(--card); border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 32px; text-align: center;
            color: var(--muted); font-size: 0.85rem;
        }
        .rec-empty span { font-size: 2rem; display: block; margin-bottom: 10px; }
        .rec-list { display: flex; flex-direction: column; gap: 10px; }
        .rec-item {
            background: var(--card); border: 1px solid var(--border);
            border-radius: 12px; padding: 16px 20px;
            display: flex; align-items: center; justify-content: space-between; gap: 12px;
            transition: border-color .2s;
        }
        .rec-item:hover { border-color: rgba(108,99,255,.3); }
        .rec-info { flex: 1; min-width: 0; }
        .rec-sujet { font-size: 0.9rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .rec-date  { font-size: 0.72rem; color: var(--muted); margin-top: 3px; }
        .badge {
            display: inline-flex; align-items: center; gap: 4px;
            font-size: 0.7rem; font-weight: 600;
            padding: 4px 10px; border-radius: 999px; white-space: nowrap; flex-shrink: 0;
        }
        .badge-ouvert   { background: rgba(245,158,11,.15);  color: var(--warning); border: 1px solid rgba(245,158,11,.3); }
        .badge-en_cours { background: rgba(0,210,255,.12);   color: var(--accent2); border: 1px solid rgba(0,210,255,.3); }
        .badge-resolu   { background: rgba(34,211,165,.12);  color: var(--success); border: 1px solid rgba(34,211,165,.3); }
        .badge-ferme    { background: rgba(100,116,139,.12); color: var(--muted);   border: 1px solid rgba(100,116,139,.3); }
        .rec-voir-plus {
            text-align: center; margin-top: 14px;
        }
        .rec-voir-plus a {
            font-size: 0.8rem; color: var(--accent); text-decoration: none;
            font-weight: 500; transition: color .2s;
        }
        .rec-voir-plus a:hover { color: var(--accent2); }
    </style>
</head>
<body>

<!-- ── Navbar ── -->
<nav>
    <div class="nav-logo">
        <div class="icon">🧠</div>
        <div><strong>Psy</strong><span>App</span></div>
    </div>
    <div class="nav-actions">
        <div class="nav-user">
            <div class="nav-avatar">{{ user.prenom|slice(0,1)|upper }}{{ user.nom|slice(0,1)|upper }}</div>
            <span class="nav-name">{{ user.prenom }}</span>
        </div>
        <a href="{{ path('app_logout') }}" class="btn-logout">🚪 Déconnexion</a>
    </div>
</nav>

<div class="page">

    <!-- Hero -->
    <div class="hero">
        <div class="hero-text">
            <h1>Bonjour, <span>{{ user.prenom }}</span> 👋</h1>
            <p>Comment vous sentez-vous aujourd'hui ? Votre bien-être mental est notre priorité.</p>
        </div>
        <div class="hero-emoji">🌿</div>
    </div>

    <!-- Features -->
    <div class="section-title">Mes espaces</div>
    <div class="feature-grid">
        <div class="feature-card">
            <div class="feature-icon fi-purple">📓</div>
            <h3>Journal Mental</h3>
            <p>Consignez vos pensées et suivez votre évolution au fil du temps.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon fi-teal">😌</div>
            <h3>Humeur du Jour</h3>
            <p>Enregistrez votre humeur quotidienne et visualisez vos tendances.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon fi-green">✅</div>
            <h3>Mes Habitudes</h3>
            <p>Créez des habitudes positives et suivez vos progrès chaque jour.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon fi-pink">💬</div>
            <h3>Communauté</h3>
            <p>Partagez avec la communauté et trouvez du soutien bienveillant.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon fi-orange">🏋️</div>
            <h3>Mes Workouts</h3>
            <p>Plans d'entraînement adaptés pour le bien-être corps et esprit.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon fi-blue">📊</div>
            <h3>Mes Statistiques</h3>
            <p>Visualisez votre progression globale et vos accomplissements.</p>
        </div>
        <a href="{{ path('app_reclamation_index') }}" class="feature-card">
            <div class="feature-icon fi-orange">📬</div>
            <h3>Mes Réclamations</h3>
            <p>Signalez un problème ou suivez l'état de vos demandes en cours.</p>
        </a>
    </div>

    <!-- Mood check-in -->
    <div class="mood-section">
        <h2>Check-in du moment</h2>
        <p>Comment vous sentez-vous en ce moment ?</p>
        <div class="mood-row">
            <button class="mood-btn" onclick="selectMood(this)">
                <em class="emoji">😄</em><span>Excellent</span>
            </button>
            <button class="mood-btn" onclick="selectMood(this)">
                <em class="emoji">🙂</em><span>Bien</span>
            </button>
            <button class="mood-btn" onclick="selectMood(this)">
                <em class="emoji">😐</em><span>Neutre</span>
            </button>
            <button class="mood-btn" onclick="selectMood(this)">
                <em class="emoji">😔</em><span>Pas top</span>
            </button>
            <button class="mood-btn" onclick="selectMood(this)">
                <em class="emoji">😞</em><span>Difficile</span>
            </button>
        </div>
        <button class="mood-submit">Enregistrer mon humeur</button>
    </div>

    <!-- ── Mes Réclamations ── -->
    <div class="rec-section">
        <div class="rec-section-header">
            <div class="section-title">📬 Mes réclamations récentes</div>
            <a href="{{ path('app_reclamation_new') }}" class="btn-rec-new">➕ Nouvelle réclamation</a>
        </div>

        {% if reclamations|length == 0 %}
            <div class="rec-empty">
                <span>📭</span>
                Vous n'avez aucune réclamation pour l'instant.
            </div>
        {% else %}
            <div class="rec-list">
                {% for rec in reclamations %}
                    <div class="rec-item">
                        <div class="rec-info">
                            <div class="rec-sujet">{{ rec.sujet }}</div>
                            <div class="rec-date">📅 {{ rec.createdAt|date('d/m/Y à H:i') }}</div>
                        </div>
                        {% set s = rec.statut %}
                        <span class="badge badge-{{ s }}">
                            {% if s == 'ouvert' %}⏳ Ouvert
                            {% elseif s == 'en_cours' %}🔄 En cours
                            {% elseif s == 'resolu' %}✅ Résolu
                            {% else %}🔒 Fermé
                            {% endif %}
                        </span>
                    </div>
                {% endfor %}
            </div>
            <div class="rec-voir-plus">
                <a href="{{ path('app_reclamation_index') }}">Voir toutes mes réclamations →</a>
            </div>
        {% endif %}
    </div>

</div>

<script>
function selectMood(el) {
    document.querySelectorAll('.mood-btn').forEach(b => b.classList.remove('selected'));
    el.classList.add('selected');
}
</script>
</body>
</html>
