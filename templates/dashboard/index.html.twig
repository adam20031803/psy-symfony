<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon Espace — PsyApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg:       #0a0c1a;
            --surface:  #111328;
            --card:     #181b30;
            --sidebar:  #0e1025;
            --border:   rgba(255,255,255,0.06);
            --accent:   #6c63ff;
            --accent2:  #00d2ff;
            --success:  #22d3a5;
            --warning:  #f59e0b;
            --pink:     #ec4899;
            --orange:   #f97316;
            --text:     #e2e8f0;
            --muted:    #64748b;
            --radius:   16px;
            --sidebar-w: 280px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ── Background glow ── */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse 60% 40% at 20% 10%, rgba(108,99,255,.10) 0%, transparent 70%),
                radial-gradient(ellipse 50% 35% at 80% 80%, rgba(0,210,255,.06) 0%, transparent 70%);
            pointer-events: none;
            z-index: 0;
        }

        /* ── Navbar ── */
        .top-nav {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(14,16,37,.92);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-bottom: 1px solid var(--border);
            padding: 0 32px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 1.1rem;
        }
        .nav-logo .icon {
            width: 34px; height: 34px;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
        }
        .nav-logo span { color: var(--accent2); }
        .nav-logo strong { color: var(--text); }
        .nav-actions { display: flex; align-items: center; gap: 14px; }
        .nav-user {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 5px 14px 5px 5px;
        }
        .nav-avatar {
            width: 28px; height: 28px;
            background: linear-gradient(135deg, var(--accent), var(--pink));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.7rem;
        }
        .nav-name { font-size: 0.8rem; font-weight: 500; }
        .btn-logout {
            text-decoration: none;
            color: var(--muted);
            font-size: 0.78rem;
            font-weight: 500;
            padding: 6px 12px;
            border-radius: 8px;
            border: 1px solid var(--border);
            transition: all .2s;
        }
        .btn-logout:hover { color: var(--text); border-color: rgba(255,255,255,.15); background: var(--card); }

        /* ── Layout ── */
        .app-layout {
            display: flex;
            flex: 1;
            position: relative;
            z-index: 1;
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: var(--sidebar-w);
            min-height: calc(100vh - 60px);
            background: var(--sidebar);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            padding: 24px 0;
            position: sticky;
            top: 60px;
            height: calc(100vh - 60px);
            overflow-y: auto;
            flex-shrink: 0;
        }
        .sidebar-section-label {
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--muted);
            padding: 0 24px;
            margin-bottom: 10px;
            margin-top: 8px;
        }
        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 2px;
            padding: 0 12px;
        }
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 16px;
            border-radius: 12px;
            text-decoration: none;
            color: rgba(255,255,255,0.6);
            font-size: 0.85rem;
            font-weight: 500;
            transition: all .25s cubic-bezier(.4,0,.2,1);
            position: relative;
            overflow: hidden;
        }
        .sidebar-link:hover {
            background: rgba(108,99,255,.08);
            color: var(--text);
            transform: translateX(4px);
        }
        .sidebar-link.active {
            background: linear-gradient(135deg, rgba(108,99,255,.15), rgba(0,210,255,.08));
            color: #fff;
            font-weight: 600;
            border: 1px solid rgba(108,99,255,.2);
            box-shadow: 0 4px 16px rgba(108,99,255,.12);
        }
        .sidebar-link.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 3px;
            height: 60%;
            background: linear-gradient(180deg, var(--accent), var(--accent2));
            border-radius: 0 4px 4px 0;
        }
        .sidebar-icon {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            flex-shrink: 0;
            transition: transform .25s;
        }
        .sidebar-link:hover .sidebar-icon {
            transform: scale(1.1);
        }
        .si-purple   { background: rgba(108,99,255,.12); }
        .si-teal     { background: rgba(0,210,255,.10); }
        .si-green    { background: rgba(34,211,165,.10); }
        .si-pink     { background: rgba(236,72,153,.10); }
        .si-orange   { background: rgba(249,115,22,.10); }
        .si-blue     { background: rgba(59,130,246,.10); }
        .si-yellow   { background: rgba(245,158,11,.10); }

        .sidebar-link-text {
            display: flex;
            flex-direction: column;
            gap: 1px;
        }
        .sidebar-link-title {
            font-size: 0.84rem;
            line-height: 1.3;
        }
        .sidebar-link-sub {
            font-size: 0.68rem;
            color: var(--muted);
            font-weight: 400;
        }
        .sidebar-link:hover .sidebar-link-sub,
        .sidebar-link.active .sidebar-link-sub { color: rgba(255,255,255,.45); }

        .sidebar-badge {
            margin-left: auto;
            font-size: 0.65rem;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 999px;
            background: rgba(108,99,255,.18);
            color: var(--accent);
            letter-spacing: .02em;
        }

        .sidebar-divider {
            height: 1px;
            background: var(--border);
            margin: 16px 24px;
        }

        .sidebar-footer {
            margin-top: auto;
            padding: 20px 20px 0;
        }
        .sidebar-pro-card {
            background: linear-gradient(135deg, rgba(108,99,255,.12), rgba(0,210,255,.08));
            border: 1px solid rgba(108,99,255,.18);
            border-radius: 14px;
            padding: 18px;
            text-align: center;
        }
        .sidebar-pro-card .pro-emoji { font-size: 2rem; margin-bottom: 8px; display: block; }
        .sidebar-pro-card h4 {
            font-size: 0.82rem;
            font-weight: 700;
            margin-bottom: 4px;
            background: linear-gradient(90deg, var(--accent), var(--accent2));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .sidebar-pro-card p {
            font-size: 0.7rem;
            color: var(--muted);
            line-height: 1.4;
        }

        /* ── Main Content ── */
        .main-content {
            flex: 1;
            padding: 36px 40px 80px;
            max-width: 900px;
        }

        /* ── Hero greeting ── */
        .hero {
            background: linear-gradient(135deg, rgba(108,99,255,.12), rgba(0,210,255,.06));
            border: 1px solid rgba(108,99,255,.18);
            border-radius: var(--radius);
            padding: 32px 36px;
            margin-bottom: 36px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }
        .hero-text h1 { font-size: 1.65rem; font-weight: 700; line-height: 1.3; margin-bottom: 6px; }
        .hero-text h1 span { background: linear-gradient(90deg, var(--accent), var(--accent2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .hero-text p { color: var(--muted); font-size: 0.85rem; margin-bottom: 0; }
        .hero-cta {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 18px;
            padding: 12px 22px;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            color: #fff !important;
            text-decoration: none;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.88rem;
            box-shadow: 0 4px 18px rgba(108,99,255,.28);
            transition: opacity .2s, transform .2s;
        }
        .hero-cta:hover { opacity: .93; transform: translateY(-2px); }
        .hero-emoji { font-size: 4.5rem; line-height: 1; user-select: none; }

        /* ── Section ── */
        .section-title {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 14px;
        }

        /* ── Feature grid ── */
        .feature-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 14px;
            margin-bottom: 36px;
        }
        .feature-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 22px;
            text-decoration: none;
            color: var(--text);
            transition: transform .2s, box-shadow .2s, border-color .2s;
            cursor: pointer;
        }
        .feature-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 28px rgba(0,0,0,.3);
            border-color: rgba(108,99,255,.25);
        }
        .feature-icon {
            width: 44px; height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            margin-bottom: 14px;
        }
        .fi-purple { background: rgba(108,99,255,.15); }
        .fi-teal   { background: rgba(0,210,255,.12); }
        .fi-green  { background: rgba(34,211,165,.12); }
        .fi-pink   { background: rgba(236,72,153,.12); }
        .fi-orange { background: rgba(245,158,11,.12); }
        .fi-blue   { background: rgba(59,130,246,.12); }
        .feature-card h3 { font-size: 0.9rem; font-weight: 600; margin-bottom: 5px; }
        .feature-card p  { font-size: 0.75rem; color: var(--muted); line-height: 1.5; }

        /* ── Mood bar ── */
        .mood-section {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 24px 26px;
        }
        .mood-section h2 { font-size: 0.95rem; font-weight: 600; margin-bottom: 5px; }
        .mood-section p  { font-size: 0.8rem; color: var(--muted); margin-bottom: 18px; }
        .mood-row { display: flex; gap: 12px; flex-wrap: wrap; }
        .mood-btn {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 12px 18px;
            text-align: center;
            cursor: pointer;
            transition: all .2s;
            flex: 1;
            min-width: 72px;
            font-family: inherit;
            color: var(--text);
        }
        .mood-btn:hover, .mood-btn.selected {
            border-color: var(--accent);
            background: rgba(108,99,255,.12);
            transform: scale(1.05);
        }
        .mood-btn .emoji { font-size: 1.6rem; display: block; margin-bottom: 5px; }
        .mood-btn span   { font-size: 0.68rem; color: var(--muted); }
        .mood-submit {
            margin-top: 14px;
            background: linear-gradient(90deg, var(--accent), var(--accent2));
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 9px 24px;
            font-family: inherit;
            font-weight: 600;
            font-size: 0.82rem;
            cursor: pointer;
            transition: opacity .2s;
        }
        .mood-submit:hover { opacity: .85; }

        /* ── Réclamations ── */
        .rec-section { margin-top: 32px; }
        .rec-section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
        }
        .rec-section-header .section-title { margin-bottom: 0; }
        .btn-rec-new {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 7px 14px;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            border: none; border-radius: 10px;
            color: #fff; font-size: 0.75rem; font-weight: 600;
            text-decoration: none; cursor: pointer;
            transition: opacity .2s;
            box-shadow: 0 3px 12px rgba(108,99,255,.25);
        }
        .btn-rec-new:hover { opacity: .88; }
        .rec-empty {
            background: var(--card); border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 28px; text-align: center;
            color: var(--muted); font-size: 0.82rem;
        }
        .rec-empty span { font-size: 1.8rem; display: block; margin-bottom: 8px; }
        .rec-list { display: flex; flex-direction: column; gap: 8px; }
        .rec-item {
            background: var(--card); border: 1px solid var(--border);
            border-radius: 12px; padding: 14px 18px;
            display: flex; align-items: center; justify-content: space-between; gap: 12px;
            transition: border-color .2s;
        }
        .rec-item:hover { border-color: rgba(108,99,255,.25); }
        .rec-info { flex: 1; min-width: 0; }
        .rec-sujet { font-size: 0.85rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .rec-date  { font-size: 0.68rem; color: var(--muted); margin-top: 2px; }
        .badge {
            display: inline-flex; align-items: center; gap: 4px;
            font-size: 0.67rem; font-weight: 600;
            padding: 3px 9px; border-radius: 999px; white-space: nowrap; flex-shrink: 0;
        }
        .badge-ouvert   { background: rgba(245,158,11,.15);  color: var(--warning); border: 1px solid rgba(245,158,11,.3); }
        .badge-en_cours { background: rgba(0,210,255,.12);   color: var(--accent2); border: 1px solid rgba(0,210,255,.3); }
        .badge-resolu   { background: rgba(34,211,165,.12);  color: var(--success); border: 1px solid rgba(34,211,165,.3); }
        .badge-ferme    { background: rgba(100,116,139,.12); color: var(--muted);   border: 1px solid rgba(100,116,139,.3); }
        .rec-voir-plus { text-align: center; margin-top: 12px; }
        .rec-voir-plus a {
            font-size: 0.77rem; color: var(--accent); text-decoration: none;
            font-weight: 500; transition: color .2s;
        }
        .rec-voir-plus a:hover { color: var(--accent2); }

        /* ── Responsive ── */
        @media (max-width: 900px) {
            .sidebar { display: none; }
            .main-content { padding: 24px 16px 60px; }
        }

        /* ── Pulse animation ── */
        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(108,99,255,.15); }
            50% { box-shadow: 0 0 18px 4px rgba(108,99,255,.12); }
        }
        .sidebar-link.active {
            animation: pulse-glow 3s ease-in-out infinite;
        }
    </style>
</head>
<body>

<!-- ── Navbar ── -->
<nav class="top-nav">
    <div class="nav-logo">
        <div class="icon">🧠</div>
        <div><strong>Psy</strong><span>App</span></div>
    </div>
    <div class="nav-actions">
        <div class="nav-user">
            <div class="nav-avatar">{{ user.prenom|slice(0,1)|upper }}{{ user.nom|slice(0,1)|upper }}</div>
            <span class="nav-name">{{ user.prenom }} {{ user.nom }}</span>
        </div>
        <a href="{{ path('app_logout') }}" class="btn-logout">🚪 Déconnexion</a>
    </div>
</nav>

<div class="app-layout">

    <!-- ══════ SIDEBAR ══════ -->
    <aside class="sidebar">
        <div class="sidebar-section-label">🏠 Tableau de bord</div>
        <div class="sidebar-nav">
            <a href="{{ path('app_dashboard') }}" class="sidebar-link active">
                <div class="sidebar-icon si-blue">📊</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Dashboard</span>
                    <span class="sidebar-link-sub">Vue d'ensemble</span>
                </div>
            </a>
        </div>

        <div class="sidebar-divider"></div>

        <div class="sidebar-section-label">⚙️ Gestion</div>
        <div class="sidebar-nav">
            <a href="{{ path('app_challenge_index') }}" class="sidebar-link">
                <div class="sidebar-icon si-purple">🔥</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Motivation</span>
                    <span class="sidebar-link-sub">Challenges & objectifs</span>
                </div>
                <span class="sidebar-badge">PRO</span>
            </a>

            <a href="{{ path('app_habitude_index') }}" class="sidebar-link">
                <div class="sidebar-icon si-green">🔄</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Habitudes</span>
                    <span class="sidebar-link-sub">Suivi quotidien</span>
                </div>
            </a>

            <a href="{{ path('app_store_index') }}" class="sidebar-link">
                <div class="sidebar-icon si-orange">🏪</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Stores</span>
                    <span class="sidebar-link-sub">Parcourir les boutiques</span>
                </div>
            </a>

            <a href="{{ path('post_index') }}" class="sidebar-link">
                <div class="sidebar-icon si-pink">💬</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Posts</span>
                    <span class="sidebar-link-sub">Communauté &amp; partage</span>
                </div>
            </a>
        </div>

        <div class="sidebar-divider"></div>

        <div class="sidebar-section-label">📋 Support</div>
        <div class="sidebar-nav">
            <a href="{{ path('app_reclamation_index') }}" class="sidebar-link">
                <div class="sidebar-icon si-yellow">📬</div>
                <div class="sidebar-link-text">
                    <span class="sidebar-link-title">Réclamations</span>
                    <span class="sidebar-link-sub">Mes demandes</span>
                </div>
            </a>
        </div>

        <!-- Sidebar Pro Card -->
        <div class="sidebar-footer">
            <div class="sidebar-pro-card">
                <span class="pro-emoji">🌟</span>
                <h4>PsyApp Pro</h4>
                <p>Votre bien-être mental est notre priorité quotidienne.</p>
            </div>
        </div>
    </aside>

    <!-- ══════ MAIN CONTENT ══════ -->
    <div class="main-content">

        <!-- Hero -->
        <div class="hero">
            <div class="hero-text">
                <h1>Bonjour, <span>{{ user.prenom }}</span> 👋</h1>
                <p>Heureux de vous revoir. Votre parcours vers le bien-être continue ici.</p>
            </div>
            <div class="hero-emoji">✨</div>
        </div>

        <!-- Statistiques rapides -->
        <div class="section-title">En un coup d'œil</div>
        <div class="stats-row" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 36px;">
            <div class="stat-mini-card" style="background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; display: flex; align-items: center; gap: 15px;">
                <div style="font-size: 1.8rem;">✍️</div>
                <div>
                    <div style="font-size: 0.7rem; color: var(--muted); text-transform: uppercase; font-weight: 600;">Mes Posts</div>
                    <div style="font-size: 1.4rem; font-weight: 700;">{{ userStats.posts_count }}</div>
                </div>
            </div>
            <div class="stat-mini-card" style="background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; display: flex; align-items: center; gap: 15px;">
                <div style="font-size: 1.8rem;">❤️</div>
                <div>
                    <div style="font-size: 0.7rem; color: var(--muted); text-transform: uppercase; font-weight: 600;">Likes reçus</div>
                    <div style="font-size: 1.4rem; font-weight: 700;">{{ userStats.likes_received }}</div>
                </div>
            </div>
            <div class="stat-mini-card" style="background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; display: flex; align-items: center; gap: 15px;">
                <div style="font-size: 1.8rem;">🏆</div>
                <div>
                    <div style="font-size: 0.7rem; color: var(--muted); text-transform: uppercase; font-weight: 600;">Défis relevés</div>
                    <div style="font-size: 1.4rem; font-weight: 700;">{{ userStats.challenges_count }}</div>
                </div>
            </div>
        </div>

        <!-- Challenges Section -->
        <div class="section-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
            <div class="section-title" style="margin-bottom: 0;">🔥 Challenges du moment</div>
            <a href="{{ path('app_challenge_index') }}" style="font-size: 0.75rem; color: var(--accent); text-decoration: none; font-weight: 600;">Voir tout →</a>
        </div>
        <div class="challenges-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-bottom: 36px;">
            {% for ch in activeChallenges %}
                <div class="ch-card" style="background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; transition: transform .2s;">
                    {% if ch.mediaUrl %}
                        <div style="height: 100px; background: url('{{ ch.mediaUrl }}') center/cover;"></div>
                    {% else %}
                        <div style="height: 100px; background: linear-gradient(135deg, var(--accent), var(--accent2)); display: flex; align-items: center; justify-content: center; font-size: 2rem;">🚀</div>
                    {% endif %}
                    <div style="padding: 16px;">
                        <h4 style="font-size: 0.9rem; margin-bottom: 4px;">{{ ch.titre }}</h4>
                        <p style="font-size: 0.75rem; color: var(--muted); margin-bottom: 12px; line-height: 1.4;">{{ ch.description|slice(0, 60) }}...</p>
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 0.65rem; color: var(--accent2); font-weight: 600;">📅 Jusqu'au {{ ch.dateFin|date('d/m') }}</span>
                            <a href="{{ path('app_challenge_index') }}" style="background: rgba(108,99,255,.1); color: var(--accent); padding: 4px 10px; border-radius: 6px; font-size: 0.7rem; font-weight: 600; text-decoration: none;">Participer</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <!-- Forum Feed -->
        <div class="section-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
            <div class="section-title" style="margin-bottom: 0;">💬 Dernières discussions</div>
            <a href="{{ path('post_index') }}" style="font-size: 0.75rem; color: var(--accent); text-decoration: none; font-weight: 600;">Accéder au forum →</a>
        </div>
        <div class="forum-feed" style="background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 8px; margin-bottom: 36px;">
            {% for post in recentPosts %}
                <div class="feed-item" style="padding: 16px; border-bottom: 1px solid var(--border); display: flex; gap: 16px; align-items: flex-start;">
                    <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--surface); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">
                        {% if post.isAnonymous %}🕵️{% else %}👤{% endif %}
                    </div>
                    <div style="flex: 1;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                            <span style="font-size: 0.85rem; font-weight: 600;">{{ post.titre }}</span>
                            <span style="font-size: 0.7rem; color: var(--muted);">{{ post.createdAt|date('d/m H:i') }}</span>
                        </div>
                        <p style="font-size: 0.78rem; color: var(--muted); line-height: 1.5; margin-bottom: 8px;">{{ post.contenu|striptags|slice(0, 100) }}...</p>
                        <div style="display: flex; gap: 12px; font-size: 0.7rem; color: var(--muted);">
                            <span>👍 {{ post.countLikes }}</span>
                            <span>💬 {{ post.commentaires|length }}</span>
                            {% if post.categorie %}
                                <span style="margin-left: auto; color: var(--accent2);">#{{ post.categorie.nom }}</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <!-- ── Mes Réclamations ── -->
        <div class="rec-section">
            <div class="rec-section-header">
                <div class="section-title">📬 Mes demandes de support</div>
                <a href="{{ path('app_reclamation_new') }}" class="btn-rec-new">➕ Nouvelle</a>
            </div>

            {% if reclamations|length == 0 %}
                <div class="rec-empty">
                    <span>📭</span>
                    Aucune demande en cours.
                </div>
            {% else %}
                <div class="rec-list">
                    {% for rec in reclamations %}
                        <div class="rec-item" style="padding: 10px 18px;">
                            <div class="rec-info">
                                <div class="rec-sujet" style="font-size: 0.8rem;">{{ rec.sujet }}</div>
                                <div class="rec-date" style="font-size: 0.65rem;">📅 {{ rec.createdAt|date('d/m') }}</div>
                            </div>
                            {% set s = rec.statut %}
                            <span class="badge badge-{{ s }}" style="font-size: 0.6rem; padding: 2px 8px;">
                                {% if s == 'ouvert' %}⏳ Ouvert
                                {% elseif s == 'en_cours' %}🔄 En cours
                                {% elseif s == 'resolu' %}✅ Résolu
                                {% else %}🔒 Fermé
                                {% endif %}
                            </span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

    </div>
</div>

<script>
function selectMood(el) {
    document.querySelectorAll('.mood-btn').forEach(b => b.classList.remove('selected'));
    el.classList.add('selected');
}
</script>
</body>
</html>
