{% extends 'dashboard/base_mental.html.twig' %}

{% block title %}Mental Entries — Atomic You{% endblock %}

{% block dashboard_main %}
<div class="panel-table">
    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h5 fw-bold mb-1">Liste des Entries</h2>
            <p class="text-muted small mb-0">Gérez et organisez vos entries</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-export-pdf fw-semibold">Export PDF</button>
            <button type="button" class="btn btn-light border btn-sm text-secondary px-2 py-1" title="Paramètres" aria-label="Paramètres"><i class="bi bi-gear fs-5"></i></button>
        </div>
    </div>
    <table class="table data-table table-hover">
        <thead>
        <tr>
            <th>Mood</th>
            <th>Date</th>
            <th>Level</th>
            <th>Activity</th>
            <th>Note</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        {% for e in entries %}
            <tr>
                <td><strong>{{ e.mood.moodName }}</strong></td>
                <td>{{ e.entryDate|date('d/m/Y') }}</td>
                <td>{{ e.emotionLevel }}</td>
                <td>{{ e.activity }}</td>
                <td>{{ e.note|default('—') }}</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" href="{{ path('app_mental_entry_index', { edit: e.id }) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6" class="text-center text-muted py-4">Aucun contenu dans la table</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<div class="panel-form">
    <h3 class="h6 fw-bold mb-1">{% if editing %}Modifier l’entry{% else %}+ Nouvelle Entry{% endif %}</h3>
    <p class="text-muted small mb-3">Créez ou modifiez une entry</p>

    {{ form_start(form, { attr: { id: 'mental-entry-crud', class: 'mental-dashboard-form', novalidate: 'novalidate' } }) }}
        <input type="hidden" name="edit_id" value="{{ editing ? edit_id : 0 }}">

        {% include 'form/bootstrap_field.html.twig' with { field: form.mood } %}
        {% include 'form/bootstrap_field.html.twig' with { field: form.entryDate } %}
        {% include 'form/bootstrap_field.html.twig' with { field: form.emotionLevel } %}
        {% include 'form/bootstrap_field.html.twig' with { field: form.activity } %}
        {% include 'form/bootstrap_field.html.twig' with { field: form.note } %}

        {{ form_rest(form) }}

        <div class="d-grid gap-2" style="grid-template-columns: 1fr 1fr;">
            <button type="submit" class="btn btn-form-add fw-semibold" {% if editing %}disabled{% endif %}>+ Ajouter</button>
            <button type="submit" class="btn btn-form-modify fw-semibold" {% if not editing %}disabled{% endif %}>Modifier</button>
        </div>
    {{ form_end(form, { render_rest: false }) }}

    <div class="d-grid gap-2 mt-2" style="grid-template-columns: 1fr 1fr;">
        {% if editing %}
            <form method="post" action="{{ path('app_mental_entry_delete', { id: edit_id }) }}" class="m-0" onsubmit="return confirm('Supprimer cette entrée ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ edit_id) }}">
                <button type="submit" class="btn btn-danger btn-form-danger w-100 fw-semibold">Supprimer</button>
            </form>
        {% else %}
            <button type="button" class="btn btn-danger btn-form-danger w-100 fw-semibold" disabled>Supprimer</button>
        {% endif %}
        <a href="{{ path('app_mental_entry_index') }}" class="btn btn-secondary btn-form-reset fw-semibold text-center w-100">Réinitialiser</a>
    </div>
</div>
{% endblock %}
